<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/ParameterSettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
 <DataTemplate x:Key="QueryDisclosureHeader"><Grid MinHeight="32"><TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="{x:Static type:UiTypography.Emphasis}"/></Grid></DataTemplate>
 <Style x:Key="QueryHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 <Style x:Key="QueryHint" TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="QueryResultsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Soft}"/><Setter Property="RowHeight" Value="44"/><Setter Property="MinHeight" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/><Setter Property="ColumnHeaderHeight" Value="36"/>
   <Setter Property="CellStyle" Value="{StaticResource WorkstationDataGridCell}"/>
 </Style>
 <Style x:Key="QueryCellText" TargetType="TextBlock"><Setter Property="Margin" Value="8,0"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
<Style x:Key="QueryCodeText" TargetType="TextBlock" BasedOn="{StaticResource QueryCellText}"><Setter Property="FontFamily" Value="{x:Static type:UiTypography.Code}"/></Style>
 <Style x:Key="QueryDatePicker" TargetType="DatePicker" BasedOn="{StaticResource WorkstationDatePicker}"/>
</ResourceDictionary>
