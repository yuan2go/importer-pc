<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf">
  <Style x:Key="OperationsMaintenanceAction" TargetType="Button">
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="MinHeight" Value="68"/>
   <Setter Property="Background" Value="{DynamicResource Soft}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="{TemplateBinding Padding}">
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap"
                   FontWeight="{x:Static type:UiTypography.Emphasis}"/>
        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{DynamicResource FieldLabel}" Margin="0,3,0,0"/>
       </StackPanel>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBackground}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OperationsOfflineAction" TargetType="Button" BasedOn="{StaticResource OperationsMaintenanceAction}">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
   <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
  </Style>
</ResourceDictionary>
