<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/ParameterSettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
 <DataTemplate x:Key="QueryDisclosureHeader"><Grid MinHeight="32"><TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="{x:Static type:UiTypography.Emphasis}"/></Grid></DataTemplate>
 <Style x:Key="QueryHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/><Setter Property="Foreground" Value="#202833"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 <Style x:Key="QueryHint" TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#657184"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="QueryResultsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="RowHeight" Value="40"/><Setter Property="MinHeight" Value="32"/><Setter Property="BorderBrush" Value="#E1E5EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E9EDF2"/><Setter Property="ColumnHeaderHeight" Value="36"/>
  <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F5F7FA"/><Setter Property="Foreground" Value="#586578"/><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E1E5EB"/></Style></Setter.Value></Setter>
  <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="Foreground" Value="#202833"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#0B63F6"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
 </Style>
 <Style x:Key="QueryCellText" TargetType="TextBlock"><Setter Property="Margin" Value="8,0"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
<Style x:Key="QueryCodeText" TargetType="TextBlock" BasedOn="{StaticResource QueryCellText}"><Setter Property="FontFamily" Value="{x:Static type:UiTypography.Code}"/></Style>
 <Style x:Key="QueryDatePicker" TargetType="DatePicker">
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="Height" Value="44"/><Setter Property="BorderBrush" Value="#C9D2DE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Border x:Name="Frame" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
   <DatePickerTextBox x:Name="PART_TextBox" MinHeight="0" Padding="8,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="{TemplateBinding FontSize}"/>
   <Button x:Name="PART_Button" Grid.Column="1" Content="日历" MinHeight="0" MinWidth="0" Padding="0" FontSize="{x:Static type:UiTypography.Label}" Background="Transparent" BorderThickness="0" ToolTip="选择日期"/>
   <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
  </Grid></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#185FBC"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Background" Value="#F3F5F7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
