<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.MaintenancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:local="clr-namespace:Ipc.Application.ParcelFlow.Desktop" FontSize="{x:Static type:UiTypography.Body}" FontWeight="Normal" Background="White">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/ParameterSettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="MaintenanceScope"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Background="{DynamicResource Soft}" LastChildFill="True" Visibility="{Binding Visibility, ElementName=BackToSettings}">

   <Button x:Name="BackToSettings" DockPanel.Dock="Left" Content="返回设置" Click="BackToSettings_Click" Style="{StaticResource ParameterQuietAction}" Margin="12,0,8,0" Visibility="Collapsed"/>
   <TextBlock x:Name="ToolTitle" Text="未保存的修改会保留" FontSize="{x:Static type:UiTypography.Label}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="24,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ParameterConfigurationSummary}"/>
  </DockPanel>
  <local:ParameterSettingsControl x:Name="MainParameterEditor" RuntimeContext="{Binding}" Grid.Row="1" Model="{Binding ParameterEditor}" IsEnabled="{Binding CanEditFormConfiguration}"/>
  <!-- Save bar: draft status on the left; tools, review and the one save action on the right. -->
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,10">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Menu Background="Transparent" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="{x:Static type:UiTypography.Body}" FontWeight="Normal">
      <MenuItem x:Name="AdvancedToggle" Header="更多工具" MinHeight="44" Padding="12,8" Foreground="{DynamicResource Ink}" SubmenuOpened="AdvancedToggle_SubmenuOpened">
       <MenuItem x:Name="ManagementPasswordTool" Header="管理模式与密码…" Click="ManagementMode_Click"/>
       <MenuItem Header="导入设置模板…" Click="ImportTemplate_Click" IsEnabled="{Binding CanStartOperation}"/>
       <MenuItem Header="导出设置模板…" Click="ExportTemplate_Click" IsEnabled="{Binding CanStartOperation}"/>
       <Separator/>
       <MenuItem x:Name="StashDraftTool" Header="暂存未完成的设置" Click="SaveEditor_Click" IsEnabled="{Binding CanConfigure}"/>
       <MenuItem x:Name="ResumeDraftTool" Header="继续编辑暂存的设置" Click="ContinueEditor_Click" IsEnabled="{Binding CanStartOperation}"/>
       <MenuItem Header="重新读取设置…" Click="Load_Click" IsEnabled="{Binding CanStartOperation}"/>
       <Separator/>
       <MenuItem Header="高级工具">
        <MenuItem x:Name="CompareTool" Header="对比当前与待生效设置…" Tag="2" Click="TechnicalTool_Click"/>
        <MenuItem x:Name="ModulesTool" Header="已安装模块描述…" Tag="3" Click="TechnicalTool_Click"/>
        <MenuItem x:Name="InventoryTool" Header="已安装组件…" Tag="4" Click="TechnicalTool_Click"/>
        <MenuItem x:Name="InstallationTool" Header="安装与卸载组件…" Tag="6" Click="TechnicalTool_Click"/>
        <MenuItem x:Name="BindingsTool" Header="实例与角色绑定…" Tag="0" Click="TechnicalTool_Click"/>
        <MenuItem x:Name="JsonTool" Header="高级数据编辑…" Tag="1" Click="TechnicalTool_Click"/>
        <Separator x:Name="AdvancedSeparator"/>
        <MenuItem Header="查看配置记录…" Tag="2" Click="TechnicalTool_Click"/>
        <MenuItem Header="恢复备份后核对…" Tag="5" Click="TechnicalTool_Click"/>
        <MenuItem Header="异常作业处理…" Tag="7" Click="TechnicalTool_Click"/>
       </MenuItem>
       <MenuItem x:Name="ConditionsTool" Header="管理模式与操作条件…" Click="AuthorizeTool_Click"/>
       <MenuItem Header="查看上次保存结果" Click="InspectSave_Click" IsEnabled="{Binding HasUnconfirmedConfigurationSubmission}"/>
       <MenuItem Header="重新连接全部设备和服务" AutomationProperties.AutomationId="ReconnectAllDevices" Click="Reconnect_Click" IsEnabled="{Binding CanStartFreshOperation}"/>
      </MenuItem>
     </Menu>
     <Button x:Name="ViewChanges" Content="查看修改" Click="ReviewChanges_Click" Style="{StaticResource ParameterAction}" IsEnabled="{Binding CanStartOperation}" Margin="0,0,8,0"/>
     <Button x:Name="SaveChanges" Content="{Binding ConfigurationSaveActionText}" Click="SaveChanges_Click" Style="{StaticResource ParameterPrimaryAction}" IsEnabled="{Binding CanReviewConfiguration}" ToolTip="{Binding ConfigurationDraftStatusText}" ToolTipService.ShowOnDisabled="True" MinWidth="120"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
     <TextBlock Text="{Binding ConfigurationDraftStatusText}" Foreground="{DynamicResource Ink}" FontWeight="{x:Static type:UiTypography.Emphasis}" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding ConfigurationSavedStatusText}" Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ParameterConfigurationSummary}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TabControl x:Name="TechnicalTabs" Grid.Row="1" Margin="20,8,20,12" Visibility="Collapsed" Background="White" BorderThickness="0">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="{TemplateBinding Background}"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border></ControlTemplate></TabControl.Template>
   <TabItem Header="高级绑定与兼容策略"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" IsEnabled="{Binding CanEditStructuredConfiguration}">
    <TextBlock Text="{Binding ConfigurationEditorState}" TextWrapping="Wrap"/><TextBlock Text="读码来源和投递位保持完整。稳定设备身份只读；可选能力在库存中新增，再选择角色或本位绑定。表单与高级结构化数据须显式切换编辑来源。" TextWrapping="Wrap" Margin="0,8"/>
    <WrapPanel><Button Content="检查全部设置（不保存）" Click="ValidateStructured_Click"/><Button Content="表单生成高级结构化数据并切换" Click="Advanced_Click"/></WrapPanel>
    <TextBlock Text="全部读码来源 · 选择一行查看原安装模块的参数" FontWeight="{x:Static type:UiTypography.Emphasis}" Margin="0,12,0,4"/>
    <DataGrid IsReadOnly="False" x:Name="ReaderInstances" ItemsSource="{Binding ReaderDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="100" MaxHeight="220" RowHeight="44" SelectionChanged="Reader_Changed"><DataGrid.Columns>
     <DataGridTextColumn Header="稳定设备标识" Binding="{Binding Original.DeviceId,Mode=OneWay}" IsReadOnly="True" Width="*"/>
     <DataGridTextColumn Header="原角色" Binding="{Binding Original.Role,Mode=OneWay}" IsReadOnly="True" Width="150"/>
     <DataGridTemplateColumn Header="已安装提供者" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEnabled="False" ItemsSource="{Binding Capability.Providers}" SelectedItem="{Binding Capability.Provider,UpdateSourceTrigger=PropertyChanged}" ToolTip="提供者必须匹配版本、模块及安装清单校验值"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Implementation, Mode=OneWay}"/><Run Text=" @ "/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Module, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Package.ManifestSha256, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="实例身份" IsReadOnly="True" Binding="{Binding Capability.InstanceId,Mode=OneWay}" Width="180"/>
    </DataGrid.Columns></DataGrid><StackPanel x:Name="ReaderParameterForm"/>
    <TextBlock Text="全部投递位 · 空绑定沿用已显示的默认秤/相机" FontWeight="{x:Static type:UiTypography.Emphasis}" Margin="0,12,0,4"/>
    <DataGrid IsReadOnly="False" ItemsSource="{Binding PositionDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44" MaxHeight="240"><DataGrid.Columns>
     <DataGridTextColumn Header="投递位" Binding="{Binding Id,Mode=OneWay}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="稳定读码来源" Binding="{Binding ReaderDeviceId,Mode=OneWay}" IsReadOnly="True" Width="*"/>
     <DataGridTemplateColumn Header="本位秤" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="本位相机" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid>
    <TextBlock Text="设备分配 · 只显示已安装的组件；分配后需保存并重启才生效" FontWeight="{x:Static type:UiTypography.Emphasis}" Margin="0,12,0,4"/>
    <ItemsControl ItemsSource="{Binding ConfigurationRoles}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4" Visibility="{Binding Visibility}"><TextBlock Text="{Binding Role}" Width="140" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selection,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" MinHeight="44"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="备份、重量、图像与驱动参数统一在四类参数页编辑。此处仅维护实例库存和角色绑定。" TextWrapping="Wrap" Margin="0,16"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="完整配置（高级）"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="完整配置包含全部设备、投递位和组件。检查不会保存；请用底部“保存设置…”保存。保存后需重启软件生效。" TextWrapping="Wrap"/><TextBlock Text="{Binding ConfigurationEditorState}" TextWrapping="Wrap"/><WrapPanel><Button Content="显式切换高级结构化数据编辑" Click="Advanced_Click"/><Button Content="将当前高级结构化数据加载到表单" Click="StructuredFromJson_Click"/><Button Content="检查完整配置" Click="ValidateFull_Click"/></WrapPanel></StackPanel><TextBox x:Name="AdvancedJsonEditor" Text="{Binding ConfigurationDraft,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AdvancedConfigurationReadOnly}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{x:Static type:UiTypography.Code}"/></DockPanel></TabItem>
   <TabItem Header="当前设置 / 待生效设置"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <GroupBox Header="{Binding EffectiveConfigurationHeading}"><TextBox Text="{Binding EffectiveConfiguration,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{x:Static type:UiTypography.Code}"/></GroupBox>
    <GroupBox Grid.Column="1" Header="待生效（重启后）"><TextBox Text="{Binding PendingConfiguration,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{x:Static type:UiTypography.Code}"/></GroupBox></Grid>
   </TabItem>
   <TabItem Header="已安装模块参数"><TextBox Text="{Binding InstalledProviderParameters,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{x:Static type:UiTypography.Code}"/></TabItem>
   <TabItem Header="已安装组件与参数"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel IsEnabled="{Binding CanEditStructuredConfiguration}"><ComboBox ItemsSource="{Binding NewCapabilityKinds}" SelectedItem="{Binding NewCapabilityKind}" Width="180"/><Button Content="新增未绑定能力实例" Click="AddInstance_Click"/><Button Content="移除所选未绑定实例" Click="RemoveInstance_Click"/></WrapPanel>
    <DataGrid IsReadOnly="False" Grid.Row="1" IsEnabled="{Binding CanEditFormConfiguration}" x:Name="Instances" ItemsSource="{Binding CapabilityDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44" SelectionChanged="Instance_Changed"><DataGrid.Columns>
     <DataGridTextColumn Header="能力" Binding="{Binding Role,Mode=OneWay}" IsReadOnly="True" Width="110"/>
     <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled,UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTemplateColumn Header="已安装提供者" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEnabled="False" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider,UpdateSourceTrigger=PropertyChanged}" ToolTip="提供者必须匹配版本、模块及安装清单校验值"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Implementation, Mode=OneWay}"/><Run Text=" @ "/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Module, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Package.ManifestSha256, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="实例身份" IsReadOnly="True" Binding="{Binding InstanceId,Mode=OneWay}" Width="150"/>
     <DataGridTemplateColumn Header="协议目标 / 读码身份" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Target,Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding TargetBoundary}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="合同版本" IsReadOnly="True" Binding="{Binding Contract,Mode=OneWay}" Width="180"/>
    </DataGrid.Columns></DataGrid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterForm" Margin="8" IsEnabled="{Binding CanEditFormConfiguration}"/></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="换机恢复核对"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="恢复后保持隔离、暂停。核对原请求、Unknown、设备及 RCS 外部事实；已删除的原根无法证明备份后没有新增业务，须实际核实编号高水位。确认后仍需明确恢复供包。" TextWrapping="Wrap"/><WrapPanel><Button Content="读取换机核对信息" Click="InspectRestore_Click"/><Button Content="确认已核对恢复，保持暂停" Click="ConfirmRestore_Click" IsEnabled="{Binding CanConfigure}"/></WrapPanel><TextBlock Text="已核实的请求编号高水位（整数；不得低于原永久编号账）" TextWrapping="Wrap"/><TextBox Text="{Binding RestoreVerifiedRequestIdHighWater,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="已核实的请求编号高水位"/><TextBox Text="{Binding RestoreInspectionReason,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="恢复外部事实核对说明"/><TextBox Text="{Binding RestoreInspection,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="220" VerticalScrollBarVisibility="Auto"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="安装管理"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="{Binding InstalledPackages}" TextWrapping="Wrap"/><TextBlock Text="离线签名包路径（系统由受保护提权帮助程序安装后刷新）"/><TextBox Text="{Binding PackagePath,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="原包校验值"/><TextBox Text="{Binding PackageSha256,UpdateSourceTrigger=PropertyChanged}" FontFamily="{x:Static type:UiTypography.Code}"/><Button Content="验证签名并安装" Click="Install_Click" IsEnabled="{Binding Fresh}" HorizontalAlignment="Left"/><TextBlock Text="卸载组件 · 只能卸载未被配置、作业记录或备份使用的组件。" TextWrapping="Wrap" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding InstalledPackageReferences}" SelectedItem="{Binding SelectedInstalledPackage}" MinHeight="44"/><Button Content="安全卸载所选精确包" Click="Uninstall_Click" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Left"/><Expander Header="高级：按原安装操作编号恢复" Margin="0,12,0,0"><StackPanel><TextBlock Text="当前业务没有安装日志枚举接口。仅从原安装日志复制确切操作编号；不猜测身份，也不把业务结果未知当安装恢复。" TextWrapping="Wrap"/><TextBox Text="{Binding OriginalRecoveryOperationId,UpdateSourceTrigger=PropertyChanged}"/><Button Content="恢复原安装操作" Click="RecoverInstall_Click" IsEnabled="{Binding CanConfigure}"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="异常作业处理"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="先在记录中选中作业。格口未确认的作业只会查询结果，不会重发。" TextWrapping="Wrap"/><TextBlock Text="{Binding HistoryCommandTarget}" TextWrapping="Wrap"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="处理说明（已检查并取走包裹）"/><WrapPanel><Button Content="继续未尝试附加上传" Click="Upload_Click" IsEnabled="{Binding CanContinueUpload}" Visibility="{Binding ImageSettingsVisibility}"/><Button Content="取消未发送的请求" Click="Abandon_Click" IsEnabled="{Binding CanAbandon}"/><Button Content="确认已检查积压的包裹" Click="Overload_Click" IsEnabled="{Binding Fresh}"/><Button Content="归档已处理完的作业" Click="Archive_Click" IsEnabled="{Binding Fresh}"/><TextBox Text="{Binding IdentityConflictId,UpdateSourceTrigger=PropertyChanged}" Width="230" ToolTip="冲突的作业编号"/><Button Content="确认已处理作业冲突" Click="Identity_Click" IsEnabled="{Binding Fresh}"/></WrapPanel><TextBlock Text="选中一笔接收记录后读取。只查询结果，不会重发。" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBox Text="{Binding ReceiptOccurrenceId,UpdateSourceTrigger=PropertyChanged}" ToolTip="接收记录编号"/><WrapPanel><Button Content="读取所选作业的接收记录" Click="Receipts_Click" IsEnabled="{Binding Fresh}"/><Button Content="查询未返回结果的请求" Click="ReceiptQuery_Click" IsEnabled="{Binding CanConfigure}"/></WrapPanel><TextBox Text="{Binding ReceiptInventory,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" VerticalScrollBarVisibility="Auto" FontFamily="{x:Static type:UiTypography.Code}"/>
    <Separator Margin="0,20,0,12"/>
    <TextBlock Text="未处理的扫码核对" FontSize="{x:Static type:UiTypography.Group}" FontWeight="{x:Static type:UiTypography.Emphasis}"/>
    <TextBlock Text="扫码已收到但可能还没生成作业。请先暂停供包，核对包裹后记录处理结果；不会重新发送。" TextWrapping="Wrap" Margin="0,8"/>
    <Button Content="读取未处理的扫码" Click="Inputs_Click" IsEnabled="{Binding Fresh}" HorizontalAlignment="Left" MinHeight="44"/>
    <ComboBox ItemsSource="{Binding InterruptedInputs}" SelectedItem="{Binding SelectedIngress}" DisplayMemberPath="Label" AutomationProperties.Name="待核对的扫码" MinHeight="44" Margin="0,8"/>
    <TextBox Text="{Binding IngressInspectionDetail,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="扫码详情"/>
    <TextBlock Text="核对说明" Margin="0,12,0,4"/>
    <TextBox Text="{Binding IngressInspectionReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="1024" MinHeight="44" TextWrapping="Wrap" AutomationProperties.Name="核对说明"/>
    <Button Content="确认本笔已核对" Click="InspectInput_Click" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Left" MinHeight="44" Margin="0,8"/>
    <TextBlock Text="{Binding IngressInspectionStatus}" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="完整备份"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="备份保存位置（不会覆盖已有文件）" FontSize="{x:Static type:UiTypography.Group}"/><TextBlock Text="备份包含数据库文件和同名 .recovery 文件夹，恢复时请使用维护工具。" TextWrapping="Wrap" Margin="0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="创建完整备份" Click="Backup_Click" IsEnabled="{Binding CanConfigure}"/><TextBox Text="{Binding BackupPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新备份完整路径"/></DockPanel><Button Content="管理模式与操作条件…" Click="AuthorizeTool_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="模板与显示"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="设置模板" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/><TextBlock Text="模板可以把设置复制到另一台供包台，不包含编号、设备地址、密码、备份路径和业务数据。" TextWrapping="Wrap" Margin="0,8"/><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="导出设置模板…" Click="ExportTemplate_Click"/><Button Content="导入并预览模板…" Click="ImportTemplate_Click"/></WrapPanel><TextBlock Text="本机显示偏好" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}" Margin="0,24,0,8"/><TextBlock Text="在“系统 → 显示偏好”中修改，按当前 Windows 用户保存，不影响业务设置。" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
