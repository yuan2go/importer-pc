<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationPosition">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border x:Name="InputTargetOutline" BorderBrush="{Binding InputTargetBrush}" BorderThickness="3" Margin="2" CornerRadius="4">
  <Border x:Name="PositionOutline" Style="{StaticResource StationPositionCard}">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" SharedSizeGroup="PositionHeading"/>
     <RowDefinition Height="Auto" SharedSizeGroup="PositionScan"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto" SharedSizeGroup="PositionTaskFields"/>
     <RowDefinition Height="Auto" SharedSizeGroup="PositionActions"/>
    </Grid.RowDefinitions>
    <DockPanel Style="{StaticResource StationPositionSection}">
     <Grid>
      <Grid.Resources>
       <Style x:Key="SupplySwitch" TargetType="Button" BasedOn="{StaticResource StationButton}">
        <Setter Property="MinWidth" Value="64"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MinWidth" Value="52"/></DataTrigger></Style.Triggers>
       </Style>
      </Grid.Resources>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="{Binding Heading}" VerticalAlignment="Center" FontSize="{x:Static type:UiTypography.Position}" FontWeight="{x:Static type:UiTypography.Emphasis}" AutomationProperties.Name="投递位"/>
       <Button x:Name="EnableSupply" Content="启用" Click="EnableSupply_Click" IsEnabled="{Binding CanChangeSupply}" Style="{StaticResource SupplySwitch}" Margin="10,0,0,0" Background="{Binding EnableBackground}" Foreground="{Binding EnableForeground}" AutomationProperties.Name="启用本投递位" AutomationProperties.HelpText="{Binding SupplyStateText}"/>
       <Button x:Name="DisableSupply" Content="{Binding DisableLabel}" Click="DisableSupply_Click" IsEnabled="{Binding CanChangeSupply}" Style="{StaticResource SupplySwitch}" Background="{Binding DisableBackground}" Foreground="{Binding DisableForeground}" AutomationProperties.Name="停用本投递位" AutomationProperties.HelpText="{Binding SupplyStateText}"/>
      </StackPanel>
      <Grid x:Name="VehicleState" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding VehicleStatusText}">
       <Grid.Resources>
        <Style TargetType="TextBlock">
         <Setter Property="Foreground" Value="{Binding VehicleStatusForeground}"/>
         <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
         <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
         <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
       </Grid.Resources>
       <TextBlock Text="{Binding VehicleStatusText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding VehicleStatusText}">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="{Binding VehicleNumberText}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding VehicleNumberText}"/>
        <TextBlock Text="{Binding CompactVehicleStatusText}" AutomationProperties.Name="{Binding VehicleStatusText}"/>
       </StackPanel>
      </Grid>
     </Grid>
    </DockPanel>
    <Grid Grid.Row="1" x:Name="ScanInformation" Style="{StaticResource StationPositionSection}">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBox x:Name="BarcodeEntry" MinHeight="48" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0" VerticalContentAlignment="Center" FontSize="{x:Static type:UiTypography.BarcodeCompact}" FontFamily="{x:Static type:UiTypography.Code}" MaxLength="4096" AcceptsReturn="False" AcceptsTab="False" TextChanged="InputChanged" GotKeyboardFocus="Entry_GotKeyboardFocus" PreviewKeyDown="BarcodeEntry_KeyDown" PreviewTextInput="Entry_PreviewTextInput" AutomationProperties.Name="本次条码，可输入，回车提交" ToolTip="点击本位后输入；保留前导零。直接输入将替换已显示的整条旧码。完整条码输入后按回车或点击提交。">
      <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
       <Setter Property="MaxHeight" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="48"/></DataTrigger></Style.Triggers>
      </Style></TextBox.Style>
      <TextBox.ContextMenu>
       <ContextMenu>
        <MenuItem Header="剪切" Command="ApplicationCommands.Cut"/>
        <MenuItem Header="复制" Command="ApplicationCommands.Copy"/>
        <MenuItem Header="粘贴" Command="ApplicationCommands.Paste"/>
        <MenuItem Header="全选" Command="ApplicationCommands.SelectAll"/>
        <Separator/>
        <MenuItem Header="清空输入" Click="ClearInput_Click"/>
       </ContextMenu>
      </TextBox.ContextMenu>
     </TextBox>
     <TextBlock x:Name="BarcodePlaceholder" Text="{Binding BarcodePlaceholder}" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Body}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BarcodePlaceholder}">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Text.Length,ElementName=BarcodeEntry}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <Button x:Name="CurrentBarcode" Grid.Column="1" Content="图片" Click="Picture_Click" IsEnabled="{Binding CanViewCurrentPicture}" Style="{StaticResource StationButton}" MinWidth="64" Margin="8,0,0,0" AutomationProperties.Name="查看当前包裹图片"/>
    </Grid>
    <!-- The result owns the remaining height. Auxiliary metadata never scrolls it away. -->
    <Grid Grid.Row="2">
     <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="PositionSupplyNotice"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="DisablingNotice" Text="{Binding SupplyNotice}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SupplyDisabling}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    <Border x:Name="ResultPanel" Grid.Row="1" Background="{Binding ResultBackground}" Style="{StaticResource StationResultPanel}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel x:Name="DetailedStatus" Grid.ColumnSpan="2">
       <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding ShowCenteredState}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding ShowConfirmedTask}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></DockPanel.Style>
       <TextBlock Text="{Binding DisplayPresentation.Icon}" Foreground="{Binding ResultForeground}" FontSize="{x:Static type:UiTypography.Exception}" Margin="0,0,8,0" AutomationProperties.Name="本位状态符号"/>
       <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding ResultForeground}" FontSize="{x:Static type:UiTypography.Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
      <Grid Grid.Row="1" x:Name="SlotViewport">
       <Grid.Style>
        <Style TargetType="Grid">
         <Setter Property="Margin" Value="0,4"/>
         <Setter Property="Grid.ColumnSpan" Value="2"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding ShowConfirmedTask}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Grid.ColumnSpan" Value="1"/></MultiDataTrigger>
         </Style.Triggers>
        </Style>
       </Grid.Style>
       <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
       <TextBox x:Name="CurrentSlot" Text="{Binding DisplaySlot,Mode=OneWay}" FontSize="{Binding DisplaySlotFontSize}" MaxWidth="{Binding ActualWidth,ElementName=SlotViewport}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{Binding ResultForeground}" Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True" FontFamily="{x:Static type:UiTypography.Interface}" FontWeight="{x:Static type:UiTypography.Emphasis}" AutomationProperties.Name="{Binding DisplaySlotLabel}">
        <TextBox.Style>
         <Style TargetType="TextBox">
          <Style.Triggers>
           <DataTrigger Binding="{Binding DisplaySlotVisible}" Value="False">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBox.Style>
       </TextBox>
      </Viewbox>
      </Grid>
      <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" x:Name="PositionBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
         <Style.Triggers>
          <DataTrigger Binding="{Binding DisplaySlotVisible}" Value="True">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ShowCenteredState}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers>
        </Style>
       </ScrollViewer.Style>
       <StackPanel>
        <TextBox x:Name="AttentionReason" Text="{Binding DisplayAttentionReason,Mode=OneWay}" Foreground="{Binding ResultForeground}" Style="{StaticResource StationValue}" Margin="0" AutomationProperties.Name="本位原因，可选择复制"/>
       </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="NextStep" Text="{Binding DisplayNextStep}" Foreground="{Binding ResultForeground}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StationInstruction}">
        <Setter Property="FontSize" Value="{x:Static type:OperatorTokens.InstructionSize}"/>
        <Setter Property="Grid.Row" Value="2"/><Setter Property="Grid.ColumnSpan" Value="2"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/></DataTrigger>
         <DataTrigger Binding="{Binding DisplayNextStep}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         <DataTrigger Binding="{Binding ShowCenteredState}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding ShowConfirmedTask}" Value="True"/></MultiDataTrigger.Conditions>
         <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
         <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0,0,0"/>
        </MultiDataTrigger></Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
      <TextBox x:Name="RecentChuteBarcode" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" MaxHeight="48"
               Text="{Binding RecentChuteBarcode,Mode=OneWay}" Foreground="{Binding ResultForeground}"
               Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True"
               FontSize="{x:Static type:UiTypography.Body}"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center"
               AutomationProperties.Name="上一件条码，仅供查看">
       <TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding ShowRecentChute}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
       </Style></TextBox.Style>
      </TextBox>
      <Border x:Name="CenteredSupplyPanel" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="Transparent">
       <Border.Style>
        <Style TargetType="Border">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Setter Property="Padding" Value="8"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding ShowCenteredState}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
          <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="8,2"/></DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
       <Grid x:Name="CenteredSupplyContent" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="CenteredStateTitle" Text="{Binding CenteredStateTitle}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{Binding CenteredStateForeground}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Barcode}"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.PageTitle}"/></DataTrigger><DataTrigger Binding="{Binding CenteredRcsRejection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBox x:Name="CenteredRcsMessage" Text="{Binding CenteredStateTitle,Mode=OneWay}" Foreground="{Binding CenteredStateForeground}"
                 TextAlignment="Center" FontWeight="{x:Static type:UiTypography.Emphasis}" IsTabStop="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="RCS 返回消息，可选择复制" AutomationProperties.LiveSetting="Polite">
         <TextBox.Style>
          <Style TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}">
           <Setter Property="FontSize" Value="{x:Static type:UiTypography.Barcode}"/>
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding CenteredRcsRejection}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.PageTitle}"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBox.Style>
        </TextBox>
        <TextBlock x:Name="CenteredStateReason" Grid.Row="1" Text="{Binding CenteredStateReason}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.TaskValue}"/><Setter Property="Margin" Value="0,12,0,0"/><Style.Triggers><DataTrigger Binding="{Binding SupplyDisabled}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/></DataTrigger><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="Margin" Value="0"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding CenteredAttention}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,4,0,0"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding SupplyDisabled}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Row="2">
         <Border x:Name="CenteredRcsDivider" Height="1" MaxWidth="280" Background="{DynamicResource Line}">
          <Border.Style>
           <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,10,0,8"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding CenteredAttention}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
             <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0,4,0,3"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </Border.Style>
         </Border>
         <TextBlock x:Name="CenteredInstruction" Text="{Binding CenteredStateInstruction}" ToolTip="{Binding CenteredStateFullInstruction}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static type:UiTypography.TaskValue}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/></DataTrigger>
             <DataTrigger Binding="{Binding CenteredAttention}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="Margin" Value="0"/></DataTrigger>
             <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding CenteredAttention}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/></MultiDataTrigger>
             <DataTrigger Binding="{Binding CenteredStateInstruction}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
        <Button x:Name="CenteredEnableSupply" Grid.Row="3" Content="{Binding EnableLabel}" Click="EnableSupply_Click" IsEnabled="{Binding CanChangeSupply}" MinHeight="44" Background="{DynamicResource Success}" Foreground="{DynamicResource Surface}">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="Margin" Value="0,12,0,0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SupplyDisabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0,4,0,0"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Button x:Name="ConfirmPlacementRemoval" Grid.Row="3" Content="已取下包裹" Click="ConfirmPlacementRemoval_Click" MinHeight="44">
         <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource StationButton}">
           <Setter Property="Margin" Value="0,8,0,0"/>
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers>
            <MultiDataTrigger>
             <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding CanConfirmPlacementRemoval}" Value="True"/>
              <Condition Binding="{Binding ShowConfirmedPlacementRemoval}" Value="False"/>
             </MultiDataTrigger.Conditions>
             <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
           </Style.Triggers>
          </Style>
         </Button.Style>
        </Button>
       </Grid>
      </Border>
     </Grid>
    </Border>
    </Grid>
    <!-- Site requirement: wave, task, SKU and returned quantity stay on the work surface with the confirmed chute.
         They belong to the same confirmed identity, so they follow ShowConfirmedTask and never outlive the slot.
         Shared rows align the two cards; hidden retains measured space during processing.
         Two rows keep labels and values readable; values are selectable and wrap without ellipsis. -->
    <Grid Grid.Row="3" x:Name="TaskFields">
     <Grid.Style>
      <Style TargetType="Grid">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Setter Property="MinHeight" Value="104"/>
       <Setter Property="Margin" Value="0,8,0,0"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsTight}" Value="True">
         <Setter Property="MinHeight" Value="72"/>
         <Setter Property="Margin" Value="0,2,0,0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
         <Setter Property="Visibility" Value="Hidden"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowConfirmedTask}" Value="True">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Grid.Style>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,4">
      <TextBlock Text="波次号" Style="{StaticResource StationTaskLabel}"/>
      <TextBox x:Name="WaveValue" Text="{Binding WaveNo,Mode=OneWay}" ToolTip="{Binding WaveNo}" Style="{StaticResource StationTaskValue}" AutomationProperties.Name="本次任务波次号"/>
     </DockPanel>
     <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
      <TextBlock Text="任务号" Style="{StaticResource StationTaskLabel}"/>
      <TextBox x:Name="TaskValue" Text="{Binding TaskId,Mode=OneWay}" ToolTip="{Binding TaskId}" Style="{StaticResource StationTaskValue}" AutomationProperties.Name="本次调度任务号"/>
     </DockPanel>
     <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
      <TextBlock Text="商品编码" Style="{StaticResource StationTaskLabel}"/>
      <TextBox x:Name="SkuValue" Text="{Binding SkuId,Mode=OneWay}" ToolTip="{Binding SkuId}" Style="{StaticResource StationTaskValue}" AutomationProperties.Name="本次任务商品编码"/>
     </DockPanel>
     <DockPanel Grid.Row="1" Grid.Column="1">
      <TextBlock Text="返回数量" Style="{StaticResource StationTaskLabel}"/>
      <TextBox x:Name="QuantityValue" Text="{Binding ResponseQuantity,Mode=OneWay}" ToolTip="{Binding ResponseQuantity}" Style="{StaticResource StationTaskValue}" FontFamily="{x:Static type:UiTypography.Interface}" AutomationProperties.Name="本次调度返回数量"/>
     </DockPanel>
    </Grid>
    <StackPanel Grid.Row="4" x:Name="FixedActions" Style="{StaticResource StationPositionActions}">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto" SharedSizeGroup="PositionInputFeedback"/>
       <RowDefinition Height="Auto" SharedSizeGroup="PositionActionButtons"/>
       <RowDefinition Height="Auto" SharedSizeGroup="PositionDeviceInformation"/>
      </Grid.RowDefinitions>
     <TextBlock x:Name="InputFeedback" TextWrapping="Wrap" MaxHeight="52" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource StationNotice}" AutomationProperties.LiveSetting="Polite"/>
     <Grid Grid.Row="1" x:Name="PositionActionButtons">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="1" Width="{x:Static type:OperatorTokens.TouchGap}"/>
      <Button x:Name="SubmitBarcode" Content="提交" Click="SubmitBarcode_Click">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource StationPrimaryTouch}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding Visibility,ElementName=RebaseInput}" Value="Visible">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
      <Button x:Name="RebaseInput" Content="确认本位包裹" Click="RebaseInput_Click" Visibility="Collapsed" Style="{StaticResource StationTouch}" ToolTip="本位状态已变化。请确认手上的包裹属于本位后再提交。"/>
      <Button x:Name="ConfirmManualPlacementRemoval" Grid.Column="2" Content="已取下包裹" Click="ConfirmPlacementRemoval_Click"
              ToolTip="取下本件后确认，准备接收下一件">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource StationTouch}">
         <Setter Property="Margin" Value="0,0,8,0"/>
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding ShowConfirmedPlacementRemoval}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
      <Button x:Name="WorkDetails" Grid.Column="3" Content="查看详情" Click="Details_Click" IsEnabled="{Binding CanViewWorkDetails}" Style="{StaticResource StationTouch}"/>
     </Grid>
     <Grid Grid.Row="2" x:Name="PositionDeviceFooter">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,4,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CameraConnection" VerticalAlignment="Center" Text="{Binding DevicePresentation.Text}" Foreground="{Binding DevicePresentation.Foreground}" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="相机连接状态" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Grid.Column="1" FontSize="{x:Static type:UiTypography.Label}" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="{Binding DataContext.PaceVisibility,RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="Text" Value="{Binding DataContext.LeftPaceText,RelativeSource={RelativeSource AncestorType=Window}}"/><Style.Triggers><DataTrigger Binding="{Binding PositionId}" Value="right"><Setter Property="Text" Value="{Binding DataContext.RightPaceText,RelativeSource={RelativeSource AncestorType=Window}}"/></DataTrigger><DataTrigger Binding="{Binding DataContext.IsCompact,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     </Grid>
