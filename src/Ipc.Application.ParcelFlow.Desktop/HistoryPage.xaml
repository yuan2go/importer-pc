<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ipc.Application.ParcelFlow.Desktop">
 <UserControl.Resources><local:ParcelStateTextConverter x:Key="ParcelStateText"/></UserControl.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Height" Value="3*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
  <StackPanel Grid.ColumnSpan="2">
   <TextBlock Text="作业记录" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/><Expander x:Name="HistoryFilters" Header="筛选条件" IsExpanded="False"><ScrollViewer MaxHeight="238" VerticalScrollBarVisibility="Auto"><StackPanel>
   <WrapPanel><StackPanel><TextBlock Text="完整条码（保留前导零）"/><TextBox Text="{Binding HistoryBarcode,UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="历史完整条码"/></StackPanel><StackPanel><TextBlock Text="投递位（留空表示全部）"/><TextBox Text="{Binding HistoryPosition,UpdateSourceTrigger=PropertyChanged}" Width="130" AutomationProperties.Name="历史投递位"/></StackPanel><StackPanel><TextBlock Text="业务状态"/><ComboBox ItemsSource="{Binding HistoryStates}" SelectedItem="{Binding HistoryState}" Width="180" MinHeight="44" AutomationProperties.Name="历史业务状态"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ParcelStateText}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel><TextBlock Text="原请求ID"/><TextBox Text="{Binding HistoryRequest,UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="历史原请求ID"/></StackPanel></WrapPanel>
   <WrapPanel Margin="4,8"><StackPanel Margin="0,0,16,0"><TextBlock Text="开始（含）" FontWeight="SemiBold"/><local:DateTimeInput Timestamp="{Binding HistoryFrom,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史开始含时区"/></StackPanel><StackPanel><TextBlock Text="结束（不含）" FontWeight="SemiBold"/><local:DateTimeInput Timestamp="{Binding HistoryToExclusive,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史结束不含含时区"/></StackPanel></WrapPanel>
   <WrapPanel><Button Content="今天" Click="Today_Click"/><Button Content="最近24小时" Click="LastDay_Click"/><Button Content="不限时间" Click="AnyTime_Click"/></WrapPanel>
   <Expander Header="高级：精确时间原文（含UTC偏移）"><WrapPanel><TextBox Text="{Binding HistoryFrom,UpdateSourceTrigger=PropertyChanged}" Width="320" AutomationProperties.Name="高级开始时间原文"/><TextBox Text="{Binding HistoryToExclusive,UpdateSourceTrigger=PropertyChanged}" Width="320" AutomationProperties.Name="高级结束时间原文"/></WrapPanel></Expander>
   <TextBlock Text="{Binding HistoryMetricsSummary}" FontSize="13" Margin="4,8"/></StackPanel></ScrollViewer></Expander>
   <WrapPanel><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="查询并固定范围" Click="Refresh_Click"/><Button Content="下一页" Click="Next_Click" IsEnabled="{Binding HasNextHistory}"/><Button Content="导出当前筛选CSV…" Click="Export_Click"/></WrapPanel><Button Content="取消导出" Click="CancelExport_Click" IsEnabled="{Binding HistoryExportRunning}"/></WrapPanel>

  </StackPanel>
  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding HistoryStatus}" TextWrapping="Wrap" Margin="4,4,4,8" AutomationProperties.LiveSetting="Polite"/>
  <DataGrid x:Name="HistoryRows" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" RowHeight="52"><DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="Grid.Row" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns><DataGridTemplateColumn Header="观察时间 / UTC偏移" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Operation.ObservedAt,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/><TextBlock Text="{Binding Operation.ObservedAt,StringFormat={}{0:zzz}}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="位" Binding="{Binding Operation.PositionId,Mode=OneWay}" Width="50"/><DataGridTextColumn Header="包裹号" Binding="{Binding Operation.ParcelCode,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Operation.State,Converter={StaticResource ParcelStateText},Mode=OneWay}" Width="*"/><DataGridTextColumn Header="格口" Binding="{Binding Operation.Slot,Mode=OneWay}" Width="70"/><DataGridCheckBoxColumn Header="归档" Binding="{Binding Archived}"/></DataGrid.Columns></DataGrid>
  <DockPanel><DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Grid.Row" Value="2"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="12,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.Row" Value="3"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,8,0,0"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
   <WrapPanel x:Name="HistoryActions" DockPanel.Dock="Top" IsEnabled="{Binding CanStartOperation}" ToolTip="{Binding OperationStatus}" ToolTipService.ShowOnDisabled="True"><Button Content="核对所选原请求" Click="Query_Click" IsEnabled="{Binding CanHistoryQuery}"/><Button Content="继续所选未尝试阶段" Click="Continue_Click" IsEnabled="{Binding CanHistoryContinue}"/><Button Content="复制完整原件JSON" Click="Copy_Click"/></WrapPanel>
   <ScrollViewer x:Name="HistoryDetailsScroll" VerticalScrollBarVisibility="Auto"><StackPanel><Expander x:Name="HistoryInspection" Header="原实体检查说明与命令归属"><StackPanel><TextBlock Text="{Binding HistoryCommandTarget}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding HistorySelectionState}" FontSize="12" TextWrapping="Wrap"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="不替代现场安全许可"/></StackPanel></Expander><TextBox Text="{Binding StructuredDetails,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" FontSize="14"/><Expander Header="高级详情 · 完整原作业 / 请求 / 回执 JSON"><TextBox Text="{Binding Details,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/></Expander></StackPanel></ScrollViewer>
  </DockPanel>
 </Grid>
</UserControl>
