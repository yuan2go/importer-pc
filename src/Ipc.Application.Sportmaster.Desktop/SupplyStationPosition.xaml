<UserControl x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationPosition" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="16,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource StationCard}" Padding="14,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{Binding Accent}" CornerRadius="2"/>
    <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="Bold" Foreground="{Binding Accent}"/><TextBlock Text="{Binding ReaderId}" Foreground="{StaticResource StationMuted}" FontSize="12"/><TextBlock Text="{Binding DeviceStatus}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
   </Grid>
  </Border>
  <TextBlock Grid.Row="1" Text="{Binding ObservedAt}" Foreground="{StaticResource StationMuted}" FontSize="12" Margin="2,10"/>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
     <StackPanel><TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="19"/><TextBlock Text="{Binding BlockingReasons}" Margin="0,6,0,0" Foreground="#92400E"/><TextBlock Text="{Binding ResultReason}" Margin="0,4,0,0" Foreground="{StaticResource Danger}"/></StackPanel>
    </Border>
    <Border Style="{StaticResource StationCard}" Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="SCAN INFO · 识别信息" Style="{StaticResource StationLabel}"/>
     <Border Height="1" Background="{StaticResource StationLine}" Margin="0,2,0,14"/>
     <TextBlock Text="包裹号 · 原始观察" Style="{StaticResource StationLabel}"/>
     <TextBox Text="{Binding Barcode,Mode=OneWay}" Style="{StaticResource StationValue}" FontSize="25" FontWeight="Bold"/>
     <TextBlock Text="实体准入身份" Style="{StaticResource StationLabel}"/>
     <TextBox Text="{Binding Admission,Mode=OneWay}" Style="{StaticResource StationValue}"/>
     <TextBlock Text="{Binding ImageStatus}" Foreground="{StaticResource StationMuted}" FontSize="12"/>
    </StackPanel></Border>
    <Border Style="{StaticResource StationCard}" Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="TASK INFO · 原作业信息" Style="{StaticResource StationLabel}"/>
     <Border Height="1" Background="{StaticResource StationLine}" Margin="0,2,0,14"/>
     <TextBlock Text="目标格口 · WCS 原结果" Style="{StaticResource StationLabel}"/>
     <TextBox Text="{Binding Slot,Mode=OneWay}" Style="{StaticResource StationValue}" Foreground="{Binding Accent}" FontSize="34" FontWeight="Bold"/>
     <TextBlock Text="作业身份" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding OperationId,Mode=OneWay}" Style="{StaticResource StationValue}"/>
     <TextBlock Text="原 WCS 请求" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding RequestId,Mode=OneWay}" Style="{StaticResource StationValue}"/>
     <TextBlock Text="格口取得表示 WCS 阶段结果；物理完成以权威事实为准。" FontSize="12" Foreground="{StaticResource StationMuted}"/>
    </StackPanel></Border>
    <Expander Header="本位最近作业 · 当前保留记录" Margin="0,0,0,10">
     <DataGrid ItemsSource="{Binding Recent}" Height="180" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
      <DataGridTextColumn Header="包裹号" Binding="{Binding ParcelCode}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="格口" Binding="{Binding Slot}" Width="90"/>
     </DataGrid.Columns></DataGrid>
    </Expander>
    <Expander Header="显式参考输入 · Simulation" Visibility="{Binding DataContext.SimulationVisibility,RelativeSource={RelativeSource AncestorType=Window}}">
     <StackPanel><TextBlock Text="新包裹身份需显式创建；相同条码不代表同一实体。" FontSize="12"/>
      <TextBox Text="{Binding ParcelCode,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模拟包裹号"/>
      <TextBox Text="{Binding AdmissionId,Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="模拟实体准入身份"/>
      <WrapPanel><Button Content="新包裹身份" Click="New_Click" Style="{StaticResource StationButton}"/><Button Content="模拟本位读码" Click="Emit_Click" IsEnabled="{Binding CanAdmit}" Style="{StaticResource StationButton}"/></WrapPanel>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource StationLine}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
   <StackPanel><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="重启后检查原实体的说明，用于继续本位原阶段" AutomationProperties.Name="本位原实体检查说明" MinHeight="36"/>
   <WrapPanel><Button Content="查看详情" Click="Details_Click" IsEnabled="{Binding CanReconcile}" Style="{StaticResource StationButton}"/><Button Content="核对原请求" Click="Reconcile_Click" IsEnabled="{Binding CanReconcile}" Style="{StaticResource StationButton}"/><Button Content="继续未尝试原阶段" Click="Continue_Click" IsEnabled="{Binding CanContinue}" Style="{StaticResource StationButton}"/></WrapPanel></StackPanel>
  </Border>
 </Grid>
</UserControl>
