<Window x:Class="Ipc.Application.ParcelFlow.Desktop.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="1440" Height="900" MinWidth="640" MinHeight="420" UseLayoutRounding="True">
 <Grid x:Name="ClientArea"><Grid.Resources><Style x:Key="Navigation" TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style><Style x:Key="CompactNavigation" TargetType="Menu"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="12,2"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Menu Style="{StaticResource CompactNavigation}" VerticalAlignment="Center"><MenuItem Header="页面与窗口" MinHeight="44"><MenuItem Header="工作台" Click="Workstation_Click"/><MenuItem Header="作业记录" Click="History_Click"/><MenuItem Header="设备与维护" Click="Maintenance_Click"/><MenuItem Header="帮助与支持" Click="Support_Click"/><Separator/><MenuItem Header="辅助窗口" Click="Window_Click"/><MenuItem Header="切换紧凑布局" Click="Layout_Click"/></MenuItem></Menu><WrapPanel Style="{StaticResource Navigation}"><Button Content="工作台" Click="Workstation_Click"/><Button Content="作业记录" Click="History_Click"/><Button Content="设备与维护" Click="Maintenance_Click"/><Button Content="帮助与支持" Click="Support_Click"/><Button Content="辅助窗口" Click="Window_Click"/><Button Content="紧凑布局" Click="Layout_Click"/></WrapPanel><Button Content="暂停新入场" Click="Pause_Click"/><Button Content="恢复新入场" Click="Resume_Click" IsEnabled="{Binding CanResumeInViewport}"/></StackPanel><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
  <Expander x:Name="StationDiagnostics" Grid.Row="1" Header="站位、会话、操作员登录与设备诊断" Margin="12,0"><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><ScrollViewer x:Name="StationDiagnosticsScroll" MaxHeight="128" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Flow}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Health}" TextWrapping="Wrap"/><TextBlock Text="{Binding CapacityState}"/><TextBlock Text="{Binding AuxiliaryState}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/><TextBlock Text="{Binding ConfigurationState}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Session}"/><TextBlock Text="{Binding OperationOperator}"/><TextBlock Text="{Binding CurrentImage}"/><TextBlock Text="{Binding CaptureState}" TextWrapping="Wrap"/><TextBlock Text="{Binding UploadState}"/><Expander Header="原实体检查说明"><StackPanel><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="重启原实体检查说明；不替代现场安全许可"/></StackPanel></Expander><WrapPanel Visibility="{Binding LoginVisibility}"><TextBlock Text="操作员账号" VerticalAlignment="Center"/><TextBox Text="{Binding OperatorSubject,UpdateSourceTrigger=PropertyChanged}" Width="140"/><PasswordBox x:Name="LoginProof" Width="160" AutomationProperties.Name="操作员口令"/><Button Content="验证身份" Click="Login_Click" IsEnabled="{Binding CanStartFreshOperation}"/><Button Content="登出" Click="Logout_Click" IsEnabled="{Binding CanStartFreshOperation}"/></WrapPanel></StackPanel></ScrollViewer></Expander>
  <Border Grid.Row="2" BorderBrush="{Binding StatusPresentation.Border}" BorderThickness="3,0,0,0" Background="{Binding StatusPresentation.Background}" Padding="8,4" Margin="12,4"><StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="48"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="20"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel><TextBlock Text="{Binding NextAction}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.Name="当前影响与下一动作"/><TextBlock Text="{Binding StatusPresentation.Text}" Foreground="{Binding StatusPresentation.Foreground}" FontWeight="Bold"/><TextBlock Text="{Binding BlockingReasons}" TextWrapping="Wrap"/></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="48"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="20"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><TextBlock x:Name="OperationFeedback" Text="{Binding Feedback}" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding Feedback}" AutomationProperties.LiveSetting="Polite"/></ScrollViewer><TextBlock Text="{Binding ReadStatus}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
  <ContentControl x:Name="PageHost" Grid.Row="3" IsEnabled="{Binding ViewportReady}" Margin="6,4"/>
  <StackPanel Grid.Row="4" Margin="12,2"><DockPanel><WrapPanel DockPanel.Dock="Right" IsEnabled="{Binding CanStartOperation}" ToolTip="{Binding OperationStatus}" ToolTipService.ShowOnDisabled="True"><ComboBox ItemsSource="{Binding PositionIds}" SelectedItem="{Binding SelectedPositionId}" Width="90" AutomationProperties.Name="原作业命令投递位"/><Button Content="核对原请求" Click="Reconcile_Click" IsEnabled="{Binding CanQueryCurrent}"/><Button Content="继续未尝试原阶段" Click="Continue_Click" IsEnabled="{Binding CanContinue}"/></WrapPanel><TextBlock Text="{Binding CurrentCommandTarget}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding EnvironmentStatus}" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
  <Border Grid.RowSpan="5" Visibility="{Binding ViewportWarningVisibility}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding ViewportStatus}" FontSize="24" FontWeight="Bold"/><TextBlock Text="有效客户区至少800 × 420 DIP。新操作已禁用，软件暂停以应用回执为准；在途请求继续保留。空间恢复后须人工确认，业务保持暂停。" TextWrapping="Wrap" Margin="0,16"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding ReadStatus}" TextWrapping="Wrap"/><WrapPanel><Button Content="最大化窗口" Click="Maximize_Click"/><Button Content="重试软件暂停" Click="ViewportPause_Click"/><Button Content="确认视图，保持暂停" Click="ViewportAcknowledge_Click" IsEnabled="{Binding CanAcknowledgeViewport}"/></WrapPanel></StackPanel></ScrollViewer></Border>
 </Grid>
</Window>
