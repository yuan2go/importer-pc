    <WrapPanel><Button Content="导出脱敏诊断" Click="ExportClick"/><Button Tag="Backup" Content="一致性备份" Click="BackupClick"/></WrapPanel><TextBlock Text="选择具体来源证据后核对；新版本或另一来源不会被本次确认解除。"/><ListBox x:Name="ObservationReviews" SelectionMode="Multiple" MaxHeight="180"/><TextBox x:Name="ReviewEvidence" AutomationProperties.Name="来源或恢复检查依据"/><WrapPanel><Button Tag="ReviewObservations" Content="来源观察核对完成" Click="ReviewClick"/><Button Tag="ClearOverload" x:Name="OverloadButton" Content="确认过载检查依据" Click="OverloadClick"/><Button Tag="ClearQuarantine" Content="解除恢复隔离（有依据）" Click="QuarantineClick"/></WrapPanel><TextBlock Text="{Binding RecoveryHint}"/>
