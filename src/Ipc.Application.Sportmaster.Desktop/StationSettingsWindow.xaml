<Window x:Class="Ipc.Application.Sportmaster.Desktop.StationSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf"
 Title="供包台设置" Width="1220" Height="800" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Background}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
   <DockPanel><Button x:Name="EditSettings" DockPanel.Dock="Right" Content="验证密码并编辑" Click="Edit_Click"/><StackPanel Margin="0,0,16,0"><TextBlock Text="供包台设置" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/><TextBlock x:Name="AuthorizationText" TextWrapping="Wrap" Text="只读查看，不暂停供包。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></DockPanel>
  </Border>
  <Grid Grid.Row="1"><ScrollViewer x:Name="ReadOnlyBody" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
   <TextBlock x:Name="ReadOnlyTitle" Text="当前生效设置" FontSize="{x:Static type:UiTypography.Position}" FontWeight="{x:Static type:UiTypography.Emphasis}"/>
   <TextBox x:Name="ReadOnlySettings" Style="{DynamicResource ReadonlyValue}" Margin="0,16,0,0"/>
   <TextBlock TextWrapping="Wrap" Text="开始修改时验证管理密码。保存继续核验完整配置、并发修订和实际设备责任；保存不等于已生效。" Foreground="{DynamicResource Muted}" Margin="0,20,0,0"/>
  </StackPanel></ScrollViewer><ContentControl x:Name="EditorHost" Visibility="Collapsed"/></Grid>
  <Border Grid.Row="2" Style="{StaticResource OperatorActionFooter}" Padding="20,10"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ReturnToWorkstation" Content="返回作业" Click="Return_Click" Margin="0,0,8,0"/><Button Content="关闭设置" Click="Close_Click"/></StackPanel><TextBlock x:Name="SettingsFeedback" Text="{Binding WorkFeedback}" Margin="0,0,16,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
 </Grid>
</Window>
