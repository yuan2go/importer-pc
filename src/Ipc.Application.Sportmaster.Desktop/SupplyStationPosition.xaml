<UserControl x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationPosition" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="TaskField" TargetType="TextBox" BasedOn="{StaticResource StationValue}"><Setter Property="FontFamily" Value="{x:Static type:UiTypography.Code}"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="MaxHeight" Value="56"/></Style>
  <Style x:Key="CurrentResultPanel" TargetType="Border"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,0,8"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="0,0,0,4"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="CurrentBarcodeLabel" TargetType="TextBlock" BasedOn="{StaticResource StationLabel}"><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0,0,0,2"/></DataTrigger></Style.Triggers></Style>
 </ResourceDictionary></UserControl.Resources>
 <Border Style="{StaticResource StationCard}" Margin="4" Padding="0">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="12,8">
   <DockPanel LastChildFill="True">
    <Border x:Name="CameraConnection" DockPanel.Dock="Right" Background="{Binding DevicePresentation.Background}" BorderBrush="{Binding DevicePresentation.Border}" BorderThickness="1" Padding="10,6" Margin="8,0,0,0" ToolTip="{Binding DeviceStatus}">
     <TextBlock Text="{Binding DevicePresentation.Text}" Foreground="{Binding DevicePresentation.Foreground}" FontSize="{x:Static type:UiTypography.Body}" FontWeight="{x:Static type:UiTypography.Emphasis}" AutomationProperties.Name="相机连接状态" AutomationProperties.LiveSetting="Polite"/>
    </Border>
    <TextBlock Text="{Binding Heading}" VerticalAlignment="Center" FontSize="{x:Static type:UiTypography.Position}" FontWeight="{x:Static type:UiTypography.Emphasis}" AutomationProperties.Name="相机位置"/>
   </DockPanel>
   <TextBlock Text="{Binding CameraAddress}" Margin="0,6,0,0" Foreground="{StaticResource StationMuted}" FontSize="{x:Static type:UiTypography.Label}" TextWrapping="Wrap" ToolTip="{Binding ReaderIdentity}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </StackPanel>
  <ScrollViewer x:Name="PositionBody" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12,0,12,8">
    <Grid x:Name="ScanInformation">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="扫描信息"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CurrentBarcodeLabel}"><Setter Property="Grid.ColumnSpan" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <TextBox x:Name="CurrentBarcode" Text="{Binding Barcode,Mode=OneWay}" FontFamily="{x:Static type:UiTypography.Code}" FontWeight="Normal" MinHeight="36" Margin="0" AutomationProperties.Name="本次条码，可选择复制"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource StationValue}"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="FontSize" Value="{x:Static type:UiTypography.Barcode}"/><Setter Property="MaxHeight" Value="72"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.BarcodeCompact}"/></DataTrigger><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="MaxHeight" Value="48"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
     <TextBlock x:Name="ScanSummary" Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ScanSummary}" ToolTip="{Binding SelectionSummary}" FontSize="{x:Static type:UiTypography.Diagnostic}" Foreground="{StaticResource StationMuted}" Margin="0,4,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <TextBlock Text="任务信息" FontWeight="{x:Static type:UiTypography.Emphasis}" FontSize="{x:Static type:UiTypography.Group}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,12,0,6"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0,4,0,4"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Border Background="{Binding Presentation.Background}" BorderBrush="{Binding Presentation.Border}" BorderThickness="1" Style="{StaticResource CurrentResultPanel}">
     <StackPanel>
      <TextBlock Text="{Binding Status}" Foreground="{Binding Presentation.Foreground}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Status}"/><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding HasCurrentInput}" Value="False"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Placeholder}"/></DataTrigger><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Exception}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBox x:Name="CurrentSlot" Text="{Binding Slot,Mode=OneWay}" FontSize="{Binding SlotFontSize}" Foreground="{Binding Presentation.Foreground}" MinHeight="48" Margin="0" AutomationProperties.Name="本次有效格口，可选择复制">
       <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource StationValue}"><Setter Property="FontWeight" Value="Normal"/><Setter Property="MaxHeight" Value="104"/><Style.Triggers><DataTrigger Binding="{Binding SlotAvailable}" Value="True"><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/></DataTrigger><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="64"/></DataTrigger><DataTrigger Binding="{Binding CurrentTaskAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
      </TextBox>
      <TextBox x:Name="AttentionReason" Text="{Binding AttentionReason,Mode=OneWay}" Foreground="{Binding Presentation.Foreground}" Margin="0,4,0,0" AutomationProperties.Name="本位原因，可选择复制">
       <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource StationValue}"><Setter Property="MaxHeight" Value="64"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="48"/></DataTrigger><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBox.Style>
      </TextBox>
      <TextBlock x:Name="RetainedResponsibility" Text="{Binding OriginalResultSummary}" ToolTip="{Binding OriginalResponsibility}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Style="{StaticResource StationNotice}"/>
     </StackPanel>
    </Border>
    <Grid x:Name="TaskFields" Margin="0,8,0,0"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding CurrentTaskAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="波次" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding WaveNo,Mode=OneWay}" Style="{StaticResource TaskField}" AutomationProperties.Name="本次任务波次"/><TextBlock Text="商品编码" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding SkuId,Mode=OneWay}" Style="{StaticResource TaskField}" AutomationProperties.Name="本次任务商品编码"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="任务号" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding TaskId,Mode=OneWay}" Style="{StaticResource TaskField}" AutomationProperties.Name="本次调度任务号"/><TextBlock Text="返回数量" Style="{StaticResource StationLabel}"/><TextBox FontFamily="{x:Static type:UiTypography.Interface}" Text="{Binding ResponseQuantity,Mode=OneWay}" Style="{StaticResource TaskField}" AutomationProperties.Name="本次调度返回数量"/></StackPanel>
    </Grid>
    <Expander Header="扫描与相机详情" Margin="0,8,0,8" Visibility="{Binding DataContext.ManagementModeVisibility,RelativeSource={RelativeSource AncestorType=Window}}">
     <StackPanel><TextBlock Text="{Binding ReaderIdentity}" TextWrapping="Wrap"/><TextBlock Text="{Binding DeviceStatus}"/><TextBlock Text="{Binding RcsServiceStatus}"/><TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding ScanTime,StringFormat=读取时间：{0}}"/><TextBox Text="{Binding ObservationIdentity,Mode=OneWay}" Style="{StaticResource StationValue}"/><TextBlock Text="完整原始候选" Style="{StaticResource StationLabel}"/><TextBox FontFamily="{x:Static type:UiTypography.Code}" Text="{Binding RawCandidates,Mode=OneWay}" Style="{StaticResource StationValue}" MaxHeight="120" AutomationProperties.Name="完整原始条码候选"/><TextBlock Text="业务选中码" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding SelectedCode,Mode=OneWay}" Style="{StaticResource StationValue}"/></StackPanel>
    </Expander>
  <Expander Visibility="{Binding DataContext.ManagementModeVisibility,RelativeSource={RelativeSource AncestorType=Window}}" Header="原作业与恢复详情" IsExpanded="False" Margin="0,2,0,4" FontSize="{x:Static type:UiTypography.Body}">
   <ScrollViewer x:Name="PositionDetailsScroll" VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="200"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="120"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel>
    <TextBlock Text="{Binding ReaderId}" Foreground="{StaticResource StationMuted}"/><TextBlock Text="{Binding DeviceStatus}"/><TextBlock Text="{Binding BlockingReasons}"/><TextBlock Text="{Binding ResultReason}" Foreground="{Binding Presentation.Foreground}"/><TextBlock Text="{Binding OriginalResponsibility}" Foreground="{StaticResource Warning}"/><TextBlock Text="{Binding LatestInputSummary}" FontSize="{x:Static type:UiTypography.Body}"/><TextBlock Text="{Binding ObservedAt}" FontSize="{x:Static type:UiTypography.Body}" Foreground="{StaticResource StationMuted}"/>
    <TextBlock Text="实体准入身份 · 当前观察" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding Admission,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="原作业身份 · 命令目标" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding OperationId,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="原取格口请求" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding RequestId,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="格口取得只表示上游结果；不表示物理完成。" FontSize="{x:Static type:UiTypography.Body}" Foreground="{StaticResource StationMuted}"/>
    <TextBlock Text="原实体检查说明 · 继续原阶段时使用" Style="{StaticResource StationLabel}" Margin="0,12,0,4"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="本位原实体检查说明" MinHeight="44"/>
    <Expander Header="本位最近作业"><DataGrid ItemsSource="{Binding Recent}" Height="180" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="包裹号" Binding="{Binding ParcelCode,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State,Converter={StaticResource ParcelStateText},Mode=OneWay}" Width="*"/><DataGridTextColumn Header="格口" Binding="{Binding Slot,Mode=OneWay}" Width="70"/></DataGrid.Columns></DataGrid></Expander>
    <Expander Header="显式参考输入 · 模拟模式" Visibility="{Binding DataContext.SimulationVisibility,RelativeSource={RelativeSource AncestorType=Window}}"><StackPanel><TextBlock Text="新实体须显式创建身份；同码不等于同一实体。" FontSize="{x:Static type:UiTypography.Body}"/><TextBox Text="{Binding ParcelCode,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模拟包裹号"/><TextBox Text="{Binding AdmissionId,Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="模拟实体准入身份"/><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="新包裹身份" Click="New_Click" Style="{StaticResource StationButton}"/><Button Content="模拟本位读码" Click="Emit_Click" IsEnabled="{Binding CanAdmit}" Style="{StaticResource StationButton}"/></WrapPanel></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </Expander>
   </StackPanel>
  </ScrollViewer>
  <Border IsEnabled="{Binding CanStartOperation}" x:Name="FixedActions" Grid.Row="2" BorderBrush="{StaticResource StationLine}" BorderThickness="0,1,0,0" Background="#FBFCFD" Padding="12,8">
   <StackPanel>
      <TextBlock x:Name="NextStep" Text="{Binding NextStep}" Foreground="{Binding Presentation.Foreground}" FontSize="{x:Static type:UiTypography.Label}" TextWrapping="Wrap" Margin="0,0,0,6"/>
   <DockPanel LastChildFill="True">
    <WrapPanel DockPanel.Dock="Right">
     <Button Content="查看详情" Click="Details_Click" IsEnabled="{Binding CanReconcile}" Style="{StaticResource StationButton}" ToolTip="当前位保留的原作业与原请求；未准入的新观察另见扫描依据"/>
     <Button x:Name="PositionDiagnostics" Visibility="{Binding DataContext.ManagementModeVisibility,RelativeSource={RelativeSource AncestorType=Window}}" Content="本位诊断" Click="Diagnostics_Click" Style="{StaticResource StationButton}"/>

     <Button x:Name="ContinueOriginal" Content="继续原阶段" Click="Continue_Click" IsEnabled="{Binding CanContinue}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasContinuation}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    </WrapPanel>

   </DockPanel>
   </StackPanel>
  </Border>
 </Grid></Border>
</UserControl>
