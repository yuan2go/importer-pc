<Window x:Class="Ipc.Application.Sportmaster.Desktop.StationSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf"
 Title="供包台设置" Width="1220" Height="800" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Background}">
 <Window.Resources>
  <Style x:Key="SettingsCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
   <Setter Property="Padding" Value="16,12"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="SettingsCardHeading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Position}"/>
   <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <DataTemplate x:Key="ReadOnlySettingsField">
   <StackPanel Margin="0,0,12,8">
    <TextBlock x:Name="Label" Text="{Binding Label}" Style="{DynamicResource FieldLabel}" Margin="0,0,0,3"/>
    <TextBox Style="{DynamicResource ReadonlyValue}" Text="{Binding Value,Mode=OneWay}" IsTabStop="True"
             AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.LabeledBy="{Binding ElementName=Label}"/>
   </StackPanel>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="SettingsTwoColumns"><UniformGrid Columns="2"/></ItemsPanelTemplate>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
   <DockPanel>
    <Button x:Name="EditSettings" DockPanel.Dock="Right" Content="授权编辑" Click="Edit_Click" Style="{DynamicResource Primary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
    <StackPanel>
     <TextBlock Text="供包台设置" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/>
     <Border Style="{DynamicResource OperatorStatusBadge}" Background="{DynamicResource AccentBackground}" BorderBrush="{DynamicResource Line}" HorizontalAlignment="Left" Margin="0,6,0,0">
      <TextBlock x:Name="AuthorizationText" Text="只读查看，不暂停供包。" Foreground="{DynamicResource Ink}" AutomationProperties.LiveSetting="Polite"/>
     </Border>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <ScrollViewer x:Name="ReadOnlyBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
     <TextBlock x:Name="ReadOnlyTitle" Text="当前生效设置" Style="{StaticResource SettingsCardHeading}"/>
     <TextBox x:Name="ReadOnlySettings" Style="{DynamicResource ReadonlyValue}" IsTabStop="True" Margin="0,0,0,12" AutomationProperties.Name="设置读取和修订状态"/>
     <StackPanel x:Name="EffectiveSettingsCards">
      <Border Style="{StaticResource SettingsCard}">
       <StackPanel>
        <TextBlock Text="本站与 RCS" Style="{StaticResource SettingsCardHeading}"/>
        <ItemsControl x:Name="StationFields" ItemsPanel="{StaticResource SettingsThreeColumns}" ItemTemplate="{StaticResource ReadOnlySettingsField}"/>
       </StackPanel>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
         <TextBlock Text="左相机" Style="{StaticResource SettingsCardHeading}"/>
         <TextBlock Text="{Binding Left.DevicePresentation.Text}" Foreground="{Binding Left.DevicePresentation.Foreground}" TextWrapping="Wrap" Margin="0,0,0,6"/>
         <ItemsControl x:Name="LeftCameraFields" ItemTemplate="{StaticResource ReadOnlySettingsField}"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Style="{StaticResource SettingsCard}">
        <StackPanel>
         <TextBlock Text="右相机" Style="{StaticResource SettingsCardHeading}"/>
         <TextBlock Text="{Binding Right.DevicePresentation.Text}" Foreground="{Binding Right.DevicePresentation.Foreground}" TextWrapping="Wrap" Margin="0,0,0,6"/>
         <ItemsControl x:Name="RightCameraFields" ItemTemplate="{StaticResource ReadOnlySettingsField}"/>
        </StackPanel>
       </Border>
      </Grid>
     </StackPanel>
     <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
       <TextBlock Text="显示与提示音" Style="{StaticResource SettingsCardHeading}"/>
       <ItemsControl x:Name="PreferenceFields" ItemsPanel="{StaticResource SettingsThreeColumns}" ItemTemplate="{StaticResource ReadOnlySettingsField}"/>
       <Expander x:Name="PreferenceReadDetails" Header="部分本机偏好无法读取，原文件保留" Visibility="Collapsed">
        <TextBox x:Name="PreferenceReadFailure" Style="{DynamicResource ReadonlyValue}" IsTabStop="True" Padding="8" VerticalScrollBarVisibility="Auto" MaxHeight="160" AutomationProperties.Name="本机偏好读取诊断，可复制"/>
       </Expander>
      </StackPanel>
     </Border>
     <TextBlock Text="开始修改时验证管理密码。保存继续核验完整配置、并发修订和实际设备责任；保存不等于已生效。" Foreground="{DynamicResource Muted}"/>
    </StackPanel>
   </ScrollViewer>
   <ContentControl x:Name="EditorHost" Visibility="Collapsed"/>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource OperatorActionFooter}" Padding="20,10">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="ReturnToWorkstation" Content="返回作业" Click="Return_Click" Style="{DynamicResource Primary}" Margin="0,0,8,0"
             ToolTip="暂时隐藏设置，保留当前草稿和有效编辑授权"/>
     <Button Content="关闭设置" Click="Close_Click" Margin="0"
             ToolTip="关闭本窗并结束本窗编辑授权"/>
    </StackPanel>
    <TextBlock x:Name="SettingsFeedback" Text="{Binding WorkFeedback}" Margin="0,0,16,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
