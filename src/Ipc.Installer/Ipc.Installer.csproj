<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Ipc.Desktop/Assets/importer-pc.ico</ApplicationIcon>
    <Product>菜鸟供包台安装程序</Product>
    <AssemblyTitle>菜鸟供包台安装程序</AssemblyTitle>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <BusinessModule Condition="'$(BusinessModule)' == ''">Sportmaster</BusinessModule>
    <NuGetLockFilePath Condition="'$(NuGetLockFilePath)' == ''">packages.$([System.String]::Copy('$(BusinessModule)').ToLowerInvariant()).win-x64.lock.json</NuGetLockFilePath>
    <Version Condition="'$(InstallerBusinessVersion)' != ''">$(InstallerBusinessVersion)</Version>
    <FileVersion Condition="'$(InstallerBusinessVersion)' != ''">$(InstallerBusinessVersion).0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ipc.Desktop/Ipc.Desktop.csproj"/>
    <Resource Include="../Ipc.Desktop/Assets/importer-pc.ico" Link="Assets/importer-pc.ico"/>
    <Resource Include="../Ipc.Desktop/Assets/cainiao.png" Link="Assets/cainiao.png"/>
    <EmbeddedResource Include="$(InstallerPayload)" LogicalName="Ipc.Installer.payload.zip" Condition="'$(InstallerPayload)' != ''"/>
    <EmbeddedResource Include="$(InstallerDescriptor)" LogicalName="Ipc.Installer.payload.json" Condition="'$(InstallerDescriptor)' != ''"/>
  </ItemGroup>
  <Target Name="RequireInstallerPayload" BeforeTargets="Publish">
    <Error Condition="!Exists('$(InstallerPayload)') Or !Exists('$(InstallerDescriptor)')" Text="Use scripts/package-installer.py with a verified frozen Windows medium."/>
  </Target>
</Project>
