<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf">
 <Style x:Key="ParameterAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="16,8"/>
 </Style>
 <Style x:Key="ParameterPrimaryAction" TargetType="Button" BasedOn="{StaticResource Primary}">
  <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="16,8"/>
 </Style>
 <Style x:Key="ParameterQuietAction" TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Padding" Value="12,6"/></Style>
 <Style x:Key="ParameterResultAction" TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,8"/></Style>

 <Style TargetType="TextBox" BasedOn="{StaticResource WorkstationTextBox}">
  <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="10,7"/>
  <Style.Triggers><Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource Soft}"/></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="PasswordBox" BasedOn="{StaticResource WorkstationPasswordBox}">
  <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="10,7"/>
 </Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource WorkstationComboBox}">
  <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="40"/>
 </Style>

 <DataTemplate x:Key="ParameterObjectTemplate"><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Body}"/></DataTemplate>
 <DataTemplate x:Key="ParameterSearchTemplate"><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Body}"/><TextBlock Text="{Binding Context}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Label}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></DataTemplate>
 <GroupStyle x:Key="ParameterDirectoryGroup"><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}" FontWeight="{x:Static type:UiTypography.Emphasis}" Margin="12,20,8,6"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle>
 <Style TargetType="ListBoxItem">
  <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
  <Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Grid>
    <Border x:Name="Chrome" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentBackground}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WizardStep" TargetType="Button" BasedOn="{StaticResource ParameterAction}">
  <Setter Property="Background" Value="{DynamicResource Surface}"/>
  <Setter Property="Padding" Value="8,5"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
           CornerRadius="{DynamicResource RadiusControl}" Padding="{TemplateBinding Padding}">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Border x:Name="Number" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Soft}" Margin="0,0,8,0">
      <TextBlock x:Name="NumberText" Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                 Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}"/>
     </Border>
     <TextBlock x:Name="Caption" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}"
                FontSize="{x:Static type:UiTypography.Label}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="AutomationProperties.ItemStatus" Value="当前步骤">
     <Setter TargetName="Number" Property="Background" Value="{DynamicResource Accent}"/>
     <Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource OnAccent}"/>
     <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Accent}"/>
     <Setter TargetName="Caption" Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
    </Trigger>
    <Trigger Property="AutomationProperties.ItemStatus" Value="已检查">
     <Setter TargetName="Number" Property="Background" Value="{DynamicResource SuccessBackground}"/>
     <Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource Success}"/>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
