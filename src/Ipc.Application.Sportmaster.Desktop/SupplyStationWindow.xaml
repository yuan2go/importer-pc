<Window x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop" Title="Importer PC · Sportmaster · 供包工作台" Width="1440" Height="980" MinWidth="640" MinHeight="420" Background="{DynamicResource StationBackground}" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid x:Name="ClientArea"><Grid.Resources>
   <Style x:Key="ExpandedNavigation" TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
   <Style x:Key="CompactNavigation" TargetType="Menu"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  </Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,0,1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="16,8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12,4"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
     <Menu Background="White" VerticalAlignment="Center"><MenuItem Header="展示设置" MinHeight="44" Padding="10,6"><MenuItem Header="操作员登录" Click="OperatorLogin_Click" Visibility="{Binding LoginVisibility}"/><MenuItem Header="站位与设备诊断" Click="Diagnostics_Click"/><MenuItem Header="辅助窗口" Click="Window_Click"/><MenuItem Header="标准 / 紧凑布局" Click="Layout_Click"/></MenuItem></Menu>
     <Border BorderBrush="{StaticResource StationLine}" BorderThickness="1,0,0,0" Margin="8,4"/>
     <Button Content="暂停新入场" Click="Pause_Click" Style="{StaticResource StationButton}"/>
     <Button Content="恢复新入场" Click="Resume_Click" IsEnabled="{Binding CanResumeInViewport}" Style="{StaticResource StationButton}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="供包工作台" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding Station}" FontSize="12" Foreground="{StaticResource StationMuted}"/></StackPanel>
    <Grid VerticalAlignment="Center">
     <Menu Style="{StaticResource CompactNavigation}" Background="White"><MenuItem Header="{Binding PageTitle,StringFormat={}{0} ▾}" MinHeight="44" Padding="12,6"><MenuItem Header="工作台" Click="Workstation_Click"/><MenuItem Header="作业记录" Click="History_Click"/><MenuItem Header="设备与维护" Click="Maintenance_Click"/><Separator/><MenuItem Header="帮助与支持" Click="Support_Click"/></MenuItem></Menu>
     <WrapPanel Style="{StaticResource ExpandedNavigation}">
      <Button Content="工作台" Click="Workstation_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="workstation"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button Content="作业记录" Click="History_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="history"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button Content="设备与维护" Click="Maintenance_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="maintenance"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button Content="帮助与支持" Click="Support_Click" Style="{StaticResource StationNavigation}"/>
     </WrapPanel>
    </Grid>
   </DockPanel>
  </Border>
  <ScrollViewer x:Name="HeaderDiagnostics" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="132"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="20,10"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12,2"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <Expander Header="站位、设备与服务来源诊断" IsExpanded="False"><StackPanel>
    <WrapPanel><TextBlock Text="{Binding Station}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Margin="0,0,20,0"/><TextBlock Text="{Binding TopologyStatus}" Foreground="#6B7280"/><TextBlock Text="{Binding Session}" Margin="20,0,0,0"/></WrapPanel>
    <TextBlock Text="{Binding ConfigurationState}" Foreground="#6B7280" FontSize="12" Margin="0,5,0,0"/>
    <TextBlock Text="{Binding Health}" Foreground="#6B7280" FontSize="12" Margin="0,3,0,0"/>
    <TextBlock Text="{Binding CapacityState}" Foreground="#6B7280" FontSize="12" Margin="0,3,0,0"/>
    <TextBlock Text="{Binding BlockingReasons}" Foreground="{StaticResource Warning}"/><TextBlock Text="{Binding ReadStatus}"/><TextBlock Text="{Binding AuxiliaryState}" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,3,0,0"/>
    <WrapPanel Visibility="{Binding LoginVisibility}" IsEnabled="{Binding CanStartOperation}"><TextBox Text="{Binding OperatorSubject,UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="操作员账号"/><PasswordBox x:Name="LoginProof" Width="150" AutomationProperties.Name="操作员口令"/><Button Content="验证身份" Click="Login_Click" Style="{StaticResource StationButton}"/><Button Content="登出" Click="Logout_Click" Style="{StaticResource StationButton}"/></WrapPanel>
   </StackPanel></Expander>
  </Border></ScrollViewer>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{Binding StatusPresentation.Background}" BorderBrush="{Binding StatusPresentation.Border}" BorderThickness="1" CornerRadius="8"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="16,12,16,0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="8,4,8,0"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><ScrollViewer x:Name="StatusDiagnostics" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="96"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="48"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel><TextBlock Text="{Binding NextAction}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.Name="当前影响与下一动作"/><TextBlock Text="{Binding StatusPresentation.Text}" Foreground="{Binding StatusPresentation.Foreground}" FontSize="13"/></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="48"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="20"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><TextBlock x:Name="OperationFeedback" Text="{Binding OperatorFeedback}" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding Feedback}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></ScrollViewer></StackPanel></Border>
   <ContentControl x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding ViewportReady}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Margin" Value="8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="4"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="20,8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12,2"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><TextBlock x:Name="LastReadTime" DockPanel.Dock="Right" Text="{Binding UpdatedAt,StringFormat=最后读取：{0}}" FontSize="12" Foreground="{StaticResource StationMuted}"/><TextBlock Text="{Binding EnvironmentStatus}" FontSize="12" Foreground="{StaticResource StationMuted}"/></DockPanel></Border>
  <Border x:Name="ViewportWarning" Grid.RowSpan="4" Background="{StaticResource StationBackground}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24" Visibility="{Binding ViewportWarningVisibility}">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding ViewportStatus}" FontSize="24" FontWeight="Bold"/>
    <TextBlock Text="有效客户区至少需要 800 × 420 DIP。当前窗口的新操作已禁用，已请求软件暂停；暂停结果以下方应用快照为准。" FontSize="16" Margin="0,16"/>
    <TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Message}"/><TextBlock Text="{Binding ReadStatus}" Margin="0,12"/>
    <TextBlock Text="在途作业与原请求保持。空间恢复不会自动恢复入场；应用暂停且快照有效后，先确认视图，再核对现场并显式恢复。软件暂停不是安全急停。"/>
    <WrapPanel Margin="0,16"><Button Content="最大化窗口" Click="Maximize_Click" Style="{StaticResource StationButton}"/><Button Content="重试软件暂停" Click="ViewportPause_Click" Style="{StaticResource StationButton}"/><Button Content="确认视图，保持暂停" Click="ViewportAcknowledge_Click" IsEnabled="{Binding CanAcknowledgeViewport}" Style="{StaticResource StationButton}"/></WrapPanel>
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
</Window>
