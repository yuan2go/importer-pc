<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:local="clr-namespace:Ipc.Application.ParcelFlow.Desktop" Background="{DynamicResource Surface}" FontSize="{x:Static type:UiTypography.Body}" FontWeight="Normal">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/QueryWorkspaceTheme.xaml"/></ResourceDictionary.MergedDictionaries><local:ParcelStateTextConverter x:Key="ParcelStateText"/><local:ParcelToneConverter x:Key="ParcelTone"/><local:LocalTimestampConverter x:Key="LocalTimestamp"/><local:PositionNameTextConverter x:Key="PositionName"/><local:RcsReturnedTaskIdConverter x:Key="RcsReturnedTaskId"/>  <Style x:Key="HistoryPreset" TargetType="Button" BasedOn="{StaticResource ParameterAction}">
   <Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Background" Value="{DynamicResource Soft}"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="MinHeight" Value="44"/>
   <Style.Triggers>
    <Trigger Property="AutomationProperties.ItemStatus" Value="已选">
     <Setter Property="Background" Value="{DynamicResource AccentBackground}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
     <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
     <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <ControlTemplate x:Key="HistoryFilterBody" TargetType="Expander">
   <ContentPresenter x:Name="Filters" ContentSource="Content" Visibility="Collapsed" Margin="0,8,0,0"/>
   <ControlTemplate.Triggers>
    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Filters" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid x:Name="HistoryLayout" Margin="12,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel x:Name="HistoryFilterBar">
   <TextBlock x:Name="HistoryHeading" DockPanel.Dock="Top" Text="{DynamicResource History.Title}" Style="{StaticResource QueryHeading}" Margin="0,0,0,4"/>
   <ContentControl x:Name="HistoryPresetHost" DockPanel.Dock="Bottom" Focusable="False"/>
   <WrapPanel x:Name="HistoryQueryActions" DockPanel.Dock="Bottom" Margin="0,6,0,0"><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="{DynamicResource Common.Query}" Click="Refresh_Click" AutomationProperties.AutomationId="History.Query" Style="{StaticResource ParameterPrimaryAction}" Margin="0,0,8,0"/><Button Content="{DynamicResource History.Clear}" Click="ClearFilters_Click" Margin="0,0,8,0"/><Button Content="{DynamicResource History.FirstPage}" Click="First_Click" IsEnabled="{Binding HasPreviousHistory}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Style.Triggers><DataTrigger Binding="{Binding UsesHistoryPaging}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="{DynamicResource Common.Previous}" Click="Previous_Click" IsEnabled="{Binding HasPreviousHistory}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Style.Triggers><DataTrigger Binding="{Binding UsesHistoryPaging}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="{DynamicResource History.More}" Click="Next_Click" IsEnabled="{Binding HasNextHistory}" Margin="0,0,8,0"/><Button Content="{DynamicResource History.Export}" Click="Export_Click" IsEnabled="{Binding CanExportHistory}" ToolTip="{DynamicResource History.ExportHelp}" ToolTipService.ShowOnDisabled="True"/></WrapPanel><Button Content="{DynamicResource Common.CancelQuery}" Click="CancelQuery_Click" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HistoryLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="{DynamicResource History.CancelExport}" Click="CancelExport_Click" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HistoryExportRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel>
   <Expander x:Name="AllHistoryFilters" Header="{DynamicResource History.Filters}" IsExpanded="False"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource WorkstationExpander}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCompact}" Value="True"/><Condition Binding="{Binding IsExpanded,RelativeSource={RelativeSource Self}}" Value="False"/><Condition Binding="{Binding DesktopProfile.UsesCompactHistoryLayout}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Expander.Style><ScrollViewer x:Name="HistoryFilterScroll" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <WrapPanel x:Name="PrimaryHistoryFilters">
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="{DynamicResource History.Barcode}" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><TextBox Text="{Binding HistoryBarcode,UpdateSourceTrigger=PropertyChanged}" KeyDown="BarcodeQuery_KeyDown" AutomationProperties.Name="{DynamicResource History.BarcodeAccessible}" ToolTip="{DynamicResource History.BarcodeHelp}"/></StackPanel>
     <StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{DynamicResource Work.Lane}" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding HistoryPositionChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding HistoryPosition,Mode=OneWay}" SelectionChanged="PositionChanged" AutomationProperties.Name="{DynamicResource History.LaneAccessible}" ToolTip="{DynamicResource History.LaneHelp}"/></StackPanel>
     <StackPanel Width="170" Margin="0,0,12,8"><TextBlock Text="{DynamicResource History.BusinessState}" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding HistoryStates}" SelectedItem="{Binding HistoryState}" AutomationProperties.Name="{DynamicResource History.StateAccessible}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ParcelStateText}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    </WrapPanel>
    <Expander x:Name="HistoryFilters" Header="{DynamicResource History.TimeRange}" IsExpanded="False"><StackPanel Margin="0,8,0,4">
     <WrapPanel x:Name="HistoryTimePresets" Margin="0,0,0,8"><Button Content="{DynamicResource Common.DateToday}" Click="Today_Click" Style="{StaticResource HistoryPreset}"/><Button Content="{DynamicResource Common.LastDay}" Click="LastDay_Click" Style="{StaticResource HistoryPreset}"/><Button Content="{DynamicResource History.LastWeek}" Click="LastWeek_Click" Style="{StaticResource HistoryPreset}"/><Button Content="{DynamicResource History.AnyTime}" Click="AnyTime_Click" Style="{StaticResource HistoryPreset}"/></WrapPanel>
     <WrapPanel><StackPanel Width="352" Margin="0,0,24,8"><TextBlock Text="{DynamicResource History.Start}" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><local:DateTimeInput Timestamp="{Binding HistoryFrom,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource History.StartAccessible}"/></StackPanel><StackPanel Width="352" Margin="0,0,0,8"><TextBlock Text="{DynamicResource History.End}" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><local:DateTimeInput Timestamp="{Binding HistoryToExclusive,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource History.EndAccessible}"/></StackPanel></WrapPanel>
     <TextBlock Text="{DynamicResource History.RangeHelp}" Style="{StaticResource QueryHint}"/>
    </StackPanel></Expander>
    <Expander Header="{DynamicResource History.MoreFilters}"><StackPanel Margin="0,8,0,8">
     <WrapPanel><StackPanel Width="260" Margin="0,0,16,8"><TextBlock Text="{DynamicResource History.Request}" Style="{StaticResource QueryHint}"/><TextBox Text="{Binding HistoryRequest,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource History.OriginalRequest}"/></StackPanel><StackPanel Width="220" Margin="0,0,0,8"><TextBlock Text="{DynamicResource History.ExactLane}" Style="{StaticResource QueryHint}"/><TextBox Text="{Binding HistoryPosition,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource History.ExactLaneAccessible}"/></StackPanel></WrapPanel>
     <TextBlock Text="{Binding AppliedHistoryRange}" Style="{StaticResource QueryHint}"/><TextBlock Text="{Binding HistoryMetricsDetail}" Style="{StaticResource QueryHint}"/>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer></Expander>
  </DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}"
          BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,6,0,8">
   <TextBlock x:Name="HistoryStatusLine" Text="{Binding HistorySummary}" Foreground="{DynamicResource Ink}"
              FontSize="{x:Static type:UiTypography.Label}" TextTrimming="CharacterEllipsis"
              AutomationProperties.LiveSetting="Polite">
    <TextBlock.ToolTip>
     <StackPanel>
      <TextBlock Text="{Binding HistoryRangeSummary}" TextWrapping="Wrap" MaxWidth="480"/>
      <TextBlock Text="{Binding HistoryStatus}" TextWrapping="Wrap" MaxWidth="480"/>
     </StackPanel>
    </TextBlock.ToolTip>
   </TextBlock>
  </Border>
  <Grid Grid.Row="2" x:Name="HistoryBody"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DataGrid x:Name="HistoryRows" RowHeight="44" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource QueryResultsGrid}"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="ColumnHeaderHeight" Value="36"/></DataTrigger><DataTrigger Binding="{Binding Visibility,ElementName=HistoryDetailPanel}" Value="Collapsed"><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns>
    <DataGridTextColumn Header="{Binding [History.ScannedAt], Source={x:Static type:UiText.Current}}" Width="170" Binding="{Binding Operation.ObservedAt,Converter={StaticResource LocalTimestamp},StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" ElementStyle="{StaticResource QueryCellText}"/>
    <DataGridTextColumn Header="{Binding [Work.Lane], Source={x:Static type:UiText.Current}}" Binding="{Binding Operation.PositionId,Converter={StaticResource PositionName},Mode=OneWay}" Width="90" ElementStyle="{StaticResource QueryCellText}"/>
    <DataGridTextColumn Header="{Binding [History.Chute], Source={x:Static type:UiText.Current}}" Binding="{Binding Operation.Slot,Mode=OneWay}" Width="SizeToCells" MinWidth="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource QueryCodeText}"><Setter Property="TextTrimming" Value="None"/><Setter Property="ToolTip" Value="{Binding Operation.Slot}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    <DataGridTemplateColumn Header="{Binding [History.BarcodeImage], Source={x:Static type:UiText.Current}}" Width="*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
     <TextBlock Text="{Binding Operation.ParcelCode}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QueryCodeText}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.DesktopProfile.UsesCompactHistoryLayout,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Button Click="Picture_Click" HorizontalContentAlignment="Left" MinHeight="40" Padding="4,2" FontFamily="{x:Static type:UiTypography.Code}" ToolTip="{DynamicResource History.OpenPicture}" AutomationProperties.Name="{DynamicResource History.OpenRecordPicture}" Cursor="Hand"><TextBlock Text="{Binding Operation.ParcelCode}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextDecorations="Underline" ToolTip="{Binding Operation.ParcelCode}"/><Button.Style><Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.DesktopProfile.UsesCompactHistoryLayout,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="{Binding [History.InputSource], Source={x:Static type:UiText.Current}}" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QueryCellText}"><Setter Property="Text" Value="手动调试"/><Style.Triggers><DataTrigger Binding="{Binding Operation.DebugRequest}" Value="{x:Null}"><Setter Property="Text" Value="设备读码"/></DataTrigger><DataTrigger Binding="{Binding Operation.OperatorInput.Kind}" Value="Keyboard"><Setter Property="Text" Value="手动键盘"/></DataTrigger><DataTrigger Binding="{Binding Operation.OperatorInput.Kind}" Value="PdaKeyboard"><Setter Property="Text" Value="PDA键盘"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn x:Name="RcsTaskColumn" Header="{DynamicResource Work.Task}" Visibility="Collapsed" Width="180" MinWidth="140" CanUserSort="False" Binding="{Binding Operation,Converter={StaticResource RcsReturnedTaskId},Mode=OneWay}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource QueryCodeText}"><Setter Property="ToolTip" Value="{Binding Operation,Converter={StaticResource RcsReturnedTaskId}}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    <DataGridTemplateColumn Header="{Binding [Common.Status], Source={x:Static type:UiText.Current}}" Width="*" MinWidth="110" SortMemberPath="Operation.State"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button x:Name="HistoryStatusDetailsAction" Click="StatusDetails_Click" MinHeight="40" Padding="0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{DynamicResource History.OpenTask}" AutomationProperties.Name="{DynamicResource History.ViewTask}"><TextBlock Text="{Binding Operation.State,Converter={StaticResource ParcelStateText},Mode=OneWay}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QueryCellText}"><Style.Triggers><DataTrigger Binding="{Binding Operation,Converter={StaticResource ParcelTone}}" Value="Accepted"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger><DataTrigger Binding="{Binding Operation,Converter={StaticResource ParcelTone}}" Value="Unknown"><Setter Property="Foreground" Value="{DynamicResource Warning}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/></DataTrigger><DataTrigger Binding="{Binding Operation,Converter={StaticResource ParcelTone}}" Value="Rejected"><Setter Property="Foreground" Value="{DynamicResource Danger}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns></DataGrid>
   <ContentControl x:Name="HistoryDetailPanel" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="16,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,8,0,0"/></DataTrigger><DataTrigger Binding="{Binding DetailsOpen,RelativeSource={RelativeSource AncestorType=local:HistoryPage}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ContentControl.Style><DockPanel x:Name="HistoryDetails">
    <Button x:Name="TechnicalLogAction" DockPanel.Dock="Top" Content="{DynamicResource History.TaskLog}" Click="Logs_Click" Visibility="{Binding ManagementModeVisibility}" MinHeight="44" HorizontalAlignment="Left"/>
    <WrapPanel Visibility="{Binding ManagementModeVisibility}" x:Name="HistoryActions" DockPanel.Dock="Top" IsEnabled="{Binding CanStartOperation}" ToolTip="{Binding OperationStatus}" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,8"><Button Content="{DynamicResource History.QuerySelected}" Click="Query_Click" IsEnabled="{Binding CanHistoryQuery}" Margin="0,0,6,4"/><Button Content="{DynamicResource History.ContinueSelected}" Click="Continue_Click" IsEnabled="{Binding CanHistoryContinue}" Margin="0,0,6,4"/><Button Content="{DynamicResource History.CopyData}" Click="Copy_Click" Margin="0,0,0,4"/></WrapPanel>
    <ScrollViewer x:Name="HistoryDetailsScroll" VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="100"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel>
     <StackPanel x:Name="StructuredDetailsPanel" Margin="0,0,0,12" AutomationProperties.Name="{DynamicResource History.TaskDetails}">
      <TextBlock Text="{Binding StructuredDetails}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Body}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding StructuredSheet}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ContentControl Content="{Binding StructuredSheet}" Focusable="False"><ContentControl.ContentTemplate><DataTemplate DataType="{x:Type local:ParcelDetailSheet}"><StackPanel>
       <Border CornerRadius="6" BorderThickness="1" Padding="14,12" Margin="0,0,0,12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers>
         <DataTrigger Binding="{Binding Tone}" Value="Accepted"><Setter Property="Background" Value="{DynamicResource SuccessBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Success}"/></DataTrigger>
         <DataTrigger Binding="{Binding Tone}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource WarningBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Warning}"/></DataTrigger>
         <DataTrigger Binding="{Binding Tone}" Value="Rejected"><Setter Property="Background" Value="{DynamicResource DangerBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Danger}"/></DataTrigger>
        </Style.Triggers></Style></Border.Style><StackPanel>
        <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Group}" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{DynamicResource Ink}" AutomationProperties.HeadingLevel="Level2"/>
        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="{x:Static type:UiTypography.Body}" Foreground="{DynamicResource Ink}"/>
       </StackPanel></Border>
       <ItemsControl ItemsSource="{Binding Sections}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:DetailSection}"><StackPanel Margin="0,0,0,14">
        <TextBlock Text="{Binding Title}" FontSize="{x:Static type:UiTypography.Label}" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{DynamicResource Muted}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level3"/>
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}"><ItemsControl ItemsSource="{Binding Rows}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:DetailRow}"><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Body}"/>
         <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Body}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><DataTrigger Binding="{Binding Attention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
        <Button Click="Picture_Click" HorizontalAlignment="Left" Margin="0,6,0,0" MinHeight="36" Padding="0,4" Cursor="Hand" AutomationProperties.Name="{DynamicResource History.OpenParcelImage}"><TextBlock Text="{DynamicResource History.ViewPicture}" TextDecorations="Underline"/><Button.Style><Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowsPicture}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{x:Static type:UiTypography.Label}" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl>
     </StackPanel><TextBlock Text="{Binding HistoryQueryGuidance}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Label}" Margin="0,0,0,8"/><Expander Visibility="{Binding ManagementModeVisibility}" x:Name="HistoryInspection" Header="{DynamicResource History.Inspection}"><StackPanel><TextBlock Text="{Binding HistoryCommandTarget}" Style="{StaticResource QueryHint}"/><TextBlock Text="{Binding HistorySelectionState}" Style="{StaticResource QueryHint}"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource History.Safety}"/></StackPanel></Expander><Expander x:Name="HistoryTechnicalDetails" Visibility="{Binding ManagementModeVisibility}" Header="{DynamicResource History.Technical}"><TextBox x:Name="RawDetailsText" Text="{Binding Details,Mode=OneWay}" FontFamily="{x:Static type:UiTypography.Code}" FontSize="{x:Static type:UiTypography.Log}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/></Expander></StackPanel></ScrollViewer>
   </DockPanel></ContentControl>
  </Grid>
 </Grid>
</UserControl>
