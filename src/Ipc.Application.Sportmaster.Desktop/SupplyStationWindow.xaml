<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:parameters="clr-namespace:Ipc.Application.ParcelFlow.Desktop;assembly=Ipc.Application.ParcelFlow.Desktop" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop" x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationWindow" Title="菜鸟供包台" Width="1600" Height="900" MinWidth="640" MinHeight="420" Background="{DynamicResource StationBackground}" UseLayoutRounding="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid x:Name="ClientArea" Background="{StaticResource StationBackground}">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Grid.Resources>
   <Style x:Key="StationIconNavigation" TargetType="Button" BasedOn="{StaticResource StationNavigation}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="ContentTemplate">
     <Setter.Value>
      <DataTemplate>
       <StackPanel Orientation="Horizontal">
        <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
       </StackPanel>
      </DataTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="ExpandedNavigation" TargetType="WrapPanel">
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsCompact}" Value="True">
      <Setter Property="Visibility" Value="Collapsed"/>
     </DataTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="CompactNavigation" TargetType="Menu">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsCompact}" Value="True">
      <Setter Property="Visibility" Value="Visible"/>
     </DataTrigger>
    </Style.Triggers>
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,0,1">
   <Border.Style>
    <Style TargetType="Border">
     <Setter Property="Padding" Value="16,8"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsCompact}" Value="True">
       <Setter Property="Padding" Value="12,4"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Border.Style>
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
     <TextBlock x:Name="AccountIdentity" Text="{Binding AccountDisplay}" Focusable="True" FontSize="{x:Static type:UiTypography.Body}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountDisplay}" Margin="0,0,8,0">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="230"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsCompact}" Value="True">
          <Setter Property="MaxWidth" Value="120"/>
         </DataTrigger>
         <DataTrigger Binding="{Binding AccountDisplay}" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <parameters:ManagementModeMenu Status="{Binding ManagementStatus}" ModeActionRequested="ManagementMode_Click" RenewalRequested="ManagementRenew_Click"/>
     <Button x:Name="OperatorAccess" Content="操作员" Click="OperatorLogin_Click" Visibility="{Binding LoginVisibility}" Style="{StaticResource StationButton}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
     <Image Source="pack://application:,,,/Ipc.Application.ParcelFlow.Desktop;component/Assets/cainiao.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="菜鸟标志"/>
     <TextBlock Text="菜鸟供包台" FontSize="{x:Static type:UiTypography.Body}" FontWeight="{x:Static type:UiTypography.Emphasis}" VerticalAlignment="Center" ToolTip="{Binding Station}"/>
     <TextBlock x:Name="StationClock" FontSize="{x:Static type:UiTypography.Label}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="本机时间"/>
    </StackPanel>
    <Grid VerticalAlignment="Center">
     <Menu Style="{StaticResource CompactNavigation}" Background="White">
      <MenuItem Header="页面" MinHeight="44">
       <MenuItem Header="作业" Click="Workstation_Click"/>
       <MenuItem Header="记录" Click="History_Click"/>
       <MenuItem Header="异常" Click="Exceptions_Click" Visibility="{Binding ExceptionAndStatisticsEntryVisibility}"/>
       <MenuItem Header="统计" Click="Statistics_Click" Visibility="{Binding ExceptionAndStatisticsEntryVisibility}"/>
       <MenuItem Header="设备与诊断" Click="Diagnostics_Click" Visibility="{Binding ManagementModeVisibility}"/>
       <MenuItem Header="设置" Click="Maintenance_Click" Visibility="{Binding ManagementModeVisibility}"/>
       <MenuItem Header="调试" Click="Debug_Click" Visibility="{Binding ManagementModeVisibility}"/>
       <MenuItem Header="日志" Click="Logs_Click" Visibility="{Binding ManagementModeVisibility}"/>
       <Separator/>
      </MenuItem>
     </Menu>
    </Grid>
   </DockPanel>
  </Border>
  <Border x:Name="DailyNavigation" Grid.Row="1" Grid.RowSpan="2" Width="176" Background="White" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,1,0">
   <Border.Style>
    <Style TargetType="Border">
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsCompact}" Value="True">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Border.Style>
   <DockPanel Margin="12,20,12,12">
    <StackPanel>
     <Button Tag="M 3,6 L 12,2 21,6 21,18 12,22 3,18 Z M 3,6 L 12,10 21,6 M 12,10 L 12,22 M 7.5,4 L 16.5,8 16.5,12" Content="作业" Click="Workstation_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding SelectedPage}" Value="workstation">
          <Setter Property="Background" Value="{StaticResource AccentBackground}"/>
          <Setter Property="Foreground" Value="{StaticResource Accent}"/>
          <Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
     <Button Tag="M 8,4 L 4,4 4,22 20,22 20,4 16,4 M 8,2 L 16,2 16,6 8,6 Z M 8,11 L 9,11 M 12,11 L 17,11 M 8,16 L 9,16 M 12,16 L 17,16" Content="记录" Click="History_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding SelectedPage}" Value="history">
          <Setter Property="Background" Value="{StaticResource AccentBackground}"/>
          <Setter Property="Foreground" Value="{StaticResource Accent}"/>
          <Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
     <Button Content="异常处理" Visibility="{Binding ExceptionAndStatisticsEntryVisibility}" Click="Exceptions_Click" MinHeight="44" Margin="0,0,0,8" HorizontalContentAlignment="Left" Tag="M 12,3 L 22,21 2,21 Z M 12,9 L 12,14 M 12,17 L 12,18"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="exceptions"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button Content="统计与班次" Visibility="{Binding ExceptionAndStatisticsEntryVisibility}" Click="Statistics_Click" MinHeight="44" Margin="0,0,0,8" HorizontalContentAlignment="Left" Tag="M 3,3 L 3,21 22,21 M 7,17 L 7,12 M 12,17 L 12,7 M 17,17 L 17,4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="statistics"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <TextBlock Text="管理模式" Visibility="{Binding ManagementModeVisibility}" Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}" Margin="12,12,0,8"/>
     <Button Content="设备与诊断" Click="Diagnostics_Click" MinHeight="44" Margin="0,0,0,8" HorizontalContentAlignment="Left" Visibility="{Binding ManagementModeVisibility}" Tag="M 4,4 L 9,4 9,9 4,9 Z M 15,4 L 20,4 20,9 15,9 Z M 4,15 L 9,15 9,20 4,20 Z M 15,15 L 20,15 20,20 15,20 Z">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="diagnostics"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>

     <Button Tag="M 3,6 L 8,6 M 12,6 L 21,6 M 3,12 L 14,12 M 18,12 L 21,12 M 3,18 L 6,18 M 10,18 L 21,18 M 8,3 L 12,3 12,9 8,9 Z M 14,9 L 18,9 18,15 14,15 Z M 6,15 L 10,15 10,21 6,21 Z" Content="设置" Click="Maintenance_Click" Visibility="{Binding ManagementModeVisibility}" Margin="0,0,0,8" HorizontalContentAlignment="Left">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsSettingsNavigation}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentBackground}"/>
          <Setter Property="Foreground" Value="{StaticResource Accent}"/>
          <Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
     <Button Tag="M 8,3 L 3,3 3,8 M 16,3 L 21,3 21,8 M 3,16 L 3,21 8,21 M 21,16 L 21,21 16,21 M 3,12 L 21,12 M 8,8 L 8,10 M 12,7 L 12,10 M 16,8 L 16,10 M 8,14 L 8,16 M 12,14 L 12,17 M 16,14 L 16,16" Content="调试" Click="Debug_Click" Visibility="{Binding ManagementModeVisibility}" Margin="0,8,0,0">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding SelectedPage}" Value="debug">
          <Setter Property="Background" Value="{StaticResource AccentBackground}"/>
          <Setter Property="Foreground" Value="{StaticResource Accent}"/>
          <Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
     <Button Tag="M 5,2 L 15,2 20,7 20,22 5,22 Z M 15,2 L 15,7 20,7 M 9,12 L 16,12 M 9,16 L 16,16" Content="日志" Click="Logs_Click" Visibility="{Binding ManagementModeVisibility}">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding SelectedPage}" Value="logs">
          <Setter Property="Background" Value="{StaticResource AccentBackground}"/>
          <Setter Property="Foreground" Value="{StaticResource Accent}"/>
          <Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2" Grid.Column="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <StackPanel>
    <Border x:Name="PendingConfigurationBanner" Padding="16,6" Background="{StaticResource AccentBackground}">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasConfigurationActivationNotice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCompact}" Value="True"/><Condition Binding="{Binding SelectedPage}" Value="workstation"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel><Button x:Name="ActivationOutcomeAction" Content="{Binding ConfigurationActivationActionText}" Click="ProductRestart_Click" IsEnabled="{Binding CanOpenConfigurationActivation}" DockPanel.Dock="Right" MinHeight="44"/><TextBlock Text="{Binding ConfigurationActivationBannerText}" ToolTip="{Binding ConfigurationActivationOutcome}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    </Border>
    <Border Padding="8,4" Background="{DynamicResource AccentBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,4">
     <Border.Style>
      <Style TargetType="Border">
       <Style.Triggers>
        <DataTrigger Binding="{Binding HasGlobalOperationFeedback}" Value="False">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding GlobalReceiptCommitted}" Value="True"/>
          <Condition Binding="{Binding IsTight}" Value="True"/>
          <Condition Binding="{Binding SelectedPage}" Value="workstation"/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <DockPanel>
      <Button Content="关闭提示" Click="DismissGlobalFeedback_Click" DockPanel.Dock="Right" MinHeight="44" Padding="8,4" FontSize="{x:Static type:UiTypography.Body}" Margin="8,0,0,0"/>
      <TextBox x:Name="GlobalOperationFeedback" MinHeight="0" Padding="0" VerticalAlignment="Center" Text="{Binding GlobalOperationFeedback,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" MaxHeight="44" VerticalScrollBarVisibility="Auto" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="最近一次操作结果，可选择复制" AutomationProperties.LiveSetting="Assertive"/>
     </DockPanel>
    </Border>
    <Border x:Name="OperationalStatusBar" Background="{Binding WorkspaceStatusBackground}" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,0,1">
     <Border.Style>
      <Style TargetType="Border">
       <Setter Property="Padding" Value="16,8"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedPage}" Value="maintenance"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding SelectedPage}" Value="history">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SelectedPage}" Value="diagnostics">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SelectedPage}" Value="debug">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsTight}" Value="True">
         <Setter Property="Padding" Value="16,0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
         <Setter Property="Padding" Value="20,6"/>
        </DataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding SelectedPage}" Value="maintenance"/>
          <Condition Binding="{Binding WorkFeedback}" Value=""/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding SelectedPage}" Value="logs"/>
          <Condition Binding="{Binding HasOperationalAttention}" Value="False"/>
          <Condition Binding="{Binding WorkFeedback}" Value=""/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <DockPanel LastChildFill="True">
      <Border x:Name="RcsConnection" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0" Background="{Binding RcsPresentation.Background}" BorderBrush="{Binding RcsPresentation.Border}" BorderThickness="1" Padding="10,6">
       <Border.Style>
        <Style TargetType="Border">
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
       <TextBlock Text="{Binding RcsPresentation.Text}" Foreground="{Binding RcsPresentation.Foreground}" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="RCS 连接状态" AutomationProperties.LiveSetting="Polite" ToolTip="RCS 在线只表示服务可连接；每件包裹以本件返回的格口为准。"/>
      </Border>
      <StackPanel>
       <DockPanel LastChildFill="True">
       <Button x:Name="CompactActivationAction" Content="{Binding ConfigurationActivationCompactText}" Click="ProductRestart_Click" IsEnabled="{Binding CanOpenConfigurationActivation}" DockPanel.Dock="Right" HorizontalAlignment="Right" MinHeight="32" Margin="8,0,0,0" ToolTip="{Binding ConfigurationActivationOutcome}">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasConfigurationActivationNotice}" Value="True"/><Condition Binding="{Binding IsCompact}" Value="True"/><Condition Binding="{Binding SelectedPage}" Value="workstation"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
       </Button>
       <Border x:Name="PaceSummary" Visibility="{Binding PaceVisibility}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0" Focusable="False"><TextBlock x:Name="PaceBadge" AutomationProperties.Name="{Binding PaceText}" Visibility="{Binding PaceVisibility}" FontSize="{x:Static type:UiTypography.Label}" VerticalAlignment="Center" ToolTip="按原请求准备时间统计取得格口次数；读取持久事实，不代表实物落格件数。管理模式可右键隐藏。"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding PaceText}"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Text" Value="{Binding PaceCompact}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
       </DockPanel>
       <ScrollViewer x:Name="StatusDiagnostics" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Style>
         <Style TargetType="ScrollViewer">
          <Setter Property="MaxHeight" Value="64"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsTight}" Value="True">
            <Setter Property="MaxHeight" Value="48"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
            <Setter Property="MaxHeight" Value="48"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding SelectedPage}" Value="maintenance">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding IsTight}" Value="True"/>
             <Condition Binding="{Binding SelectedPage}" Value="workstation"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Collapsed"/>
           </MultiDataTrigger>
          </Style.Triggers>
         </Style>
        </ScrollViewer.Style>
        <DockPanel LastChildFill="True">
         <TextBlock x:Name="WorkStatus" Text="{Binding OperatorStatus}" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{Binding WorkspaceStatusForeground}">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
              <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
              <Setter Property="DockPanel.Dock" Value="Left"/>
              <Setter Property="Margin" Value="0,0,16,0"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <TextBlock x:Name="SettingsRunMode" DockPanel.Dock="Left" Text="{Binding SettingsRunMode}" FontSize="{x:Static type:UiTypography.Label}" Margin="0,0,16,0" Foreground="{StaticResource StationMuted}">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <TextBlock x:Name="ActiveBlockingReasons" Text="{Binding OperatorNotice}" Foreground="{Binding WorkspaceStatusForeground}" AutomationProperties.Name="暂不能供包的原因">
          <TextBlock.Style>
           <Style TargetType="TextBlock" BasedOn="{StaticResource StationNotice}">
            <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
              <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </DockPanel>
       </ScrollViewer>
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style>
         <Style TargetType="ScrollViewer">
          <Setter Property="MaxHeight" Value="40"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding WorkFeedback}" Value="">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding IsTight}" Value="True">
            <Setter Property="MaxHeight" Value="24"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </ScrollViewer.Style>
        <TextBlock x:Name="OperationFeedback" Text="{Binding WorkFeedback}" ToolTip="{Binding Feedback}" AutomationProperties.LiveSetting="Polite">
         <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource StationNotice}">
           <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
             <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </ScrollViewer>
      </StackPanel>
     </DockPanel>
    </Border>
   </StackPanel>
   <ContentControl x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding ViewportReady}">
    <ContentControl.Style>
     <Style TargetType="ContentControl">
      <Setter Property="Margin" Value="8"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsCompact}" Value="True">
        <Setter Property="Margin" Value="4"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
        <Setter Property="Margin" Value="0"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </ContentControl.Style>
   </ContentControl>
  </Grid>
  <Border x:Name="WorkstationFooter" Grid.Row="3" Grid.ColumnSpan="2" Padding="16,4" Background="White">
   <Border.Style>
    <Style TargetType="Border">
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsTight}" Value="True">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Border.Style>
   <TextBlock Text="{Binding EnvironmentStatus}" Foreground="{StaticResource StationMuted}" FontSize="{x:Static type:UiTypography.Label}" TextTrimming="CharacterEllipsis"/>
  </Border>
  <Border x:Name="ViewportWarning" Grid.RowSpan="4" Grid.ColumnSpan="2" Background="{StaticResource StationBackground}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24" Visibility="{Binding ViewportWarningVisibility}">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="{Binding ViewportStatus}" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/>
     <TextBlock Text="窗口太小，无法完整显示作业信息（至少需要 800 × 420）。请最大化窗口；相机和当前任务不受影响。" FontSize="{x:Static type:UiTypography.Body}" Margin="0,16"/>
     <TextBlock Text="{Binding Status}"/>
     <TextBlock Text="{Binding Message}"/>
     <TextBlock Text="{Binding ReadStatus}" Margin="0,12"/>
     <WrapPanel Margin="0,16">
      <Button Content="最大化窗口" Click="Maximize_Click" Style="{StaticResource StationButton}"/>
     </WrapPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</Window>
