<Window x:Class="Ipc.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ipc.Desktop" Title="菜鸟供包台" Icon="/Assets/importer-pc.ico" Width="1600" Height="960" MinWidth="640" MinHeight="420" UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="WindowClosing" SizeChanged="WindowSizeChanged" PreviewKeyDown="WindowPreviewKeyDown">
 <Grid x:Name="ClientArea">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="ShellHeader" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,4">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image Source="/Assets/cainiao.png" Width="32" Height="32" Stretch="Uniform" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="菜鸟标志"/><TextBlock Text="菜鸟供包台" FontSize="21" FontWeight="Bold"/><TextBlock Text="{Binding Station}" Margin="18,0,8,0" FontFamily="Consolas" FontWeight="SemiBold"/><Border Background="{StaticResource AccentBackground}" CornerRadius="5" Padding="8,4"><TextBlock x:Name="ModeBadge" Text="SIMULATION" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/></Border></StackPanel>
    <WrapPanel HorizontalAlignment="Right"><Button x:Name="NavHistory" Content="作业记录" Click="OpenHistoryClick"/><Button x:Name="NavRecovery" Content="{Binding AlarmSummary}" Click="OpenRecoveryClick"/><Button x:Name="NavDevices" Content="设备与设置" Click="OpenDevicesClick"/><Button Tag="Pause" Content="暂停入场" Click="PauseClick"/><Button Tag="Resume" Content="恢复入场" Click="ResumeClick"/><Button Content="{Binding Identity}" Click="OpenIdentityClick"/><Button Tag="Logout" Content="登出" Click="LogoutClick"/></WrapPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,5"><DockPanel><StackPanel><TextBlock Text="{Binding HealthSummary}" FontSize="13"/><TextBlock Text="{Binding ControlFeedback}" FontSize="13" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock Text="{Binding SoundStatus}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0" FontSize="12" Foreground="{StaticResource Muted}"/></DockPanel></Border>
    <Border x:Name="SharedContext" Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
     <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="5*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="CurrentBoxPanel"><TextBlock Text="当前周转箱" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BoxBarcode}" Style="{StaticResource ReadonlyValue}" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding SessionStatus}" FontSize="13"/></StackPanel>
      <StackPanel x:Name="BoxEntryPanel" Orientation="Horizontal"><TextBox x:Name="BoxInput" Text="{Binding BoxDraft,UpdateSourceTrigger=PropertyChanged}" Width="200" AutomationProperties.Name="周转箱条码草稿" ToolTip="仅供周转箱专用扫码；Item来源与焦点无关" KeyDown="BoxKeyDown"/><Button Tag="OpenContext" Content="校验周转箱" Click="OpenClick" Style="{StaticResource Primary}"/><TextBlock Text="{Binding SessionStatus}" FontSize="13" Margin="6,0"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="所属波次 · 接收端已校验" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BoxWave}" Style="{StaticResource ReadonlyValue}" FontSize="20"/></StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0"><TextBlock Text="本箱唯一业务接受量" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Accepted}" FontSize="30" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Success}"/></StackPanel>
      <StackPanel Grid.Column="3" Margin="12,0,0,0"><Button x:Name="CloseButton" Tag="CheckClose" Content="结束供包" Click="CheckClick"/><Button x:Name="CloseDecisionButton" Tag="ConfirmClose" Content="查看少货关闭检查" Click="ConfirmCloseClick" Visibility="Collapsed"/></StackPanel>
     </Grid><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding BoxResult}" FontSize="14" FontWeight="SemiBold" Margin="0,4"/><TextBlock Text="{Binding BoxAvailability}" FontSize="13" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding CommandFeedback}" FontSize="13" Foreground="{StaticResource Warning}"/></StackPanel></ScrollViewer></StackPanel>
    </Border>
  <Border x:Name="StatusBanner" Grid.Row="3" Background="{StaticResource AccentBackground}" BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0" Padding="12,6" Margin="18,6,18,4"><ScrollViewer MaxHeight="40" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding GlobalStatus}" AutomationProperties.LiveSetting="Assertive" FontSize="14"/></ScrollViewer></Border>
  <Grid Grid.Row="4">
   <Grid x:Name="WorkstationPage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="LaneGrid" Grid.Row="0" Margin="18,4,18,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><local:LaneControl x:Name="LeftLane"/><local:LaneControl x:Name="RightLane" Grid.Column="2"/></Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="18,0,18,4"><StackPanel><DockPanel Margin="12,0"><Button Content="查看全部作业记录" Click="OpenHistoryClick" DockPanel.Dock="Right"/><TextBlock Text="最近作业 · 一次作业一条记录，发送尝试见详情" FontSize="14"/></DockPanel><DataGrid x:Name="RecentGrid" MaxHeight="114" RowHeight="44" SelectionChanged="HistorySelected" MouseDoubleClick="HistoryDoubleClick" KeyDown="HistoryKeyDown"><DataGrid.Columns><DataGridTextColumn Header="时间与时区" Binding="{Binding Time}" Width="220"/><DataGridTextColumn Header="通道" Binding="{Binding Lane}"/><DataGridTextColumn Header="Item条码" Binding="{Binding Barcode}" Width="*"/><DataGridTextColumn Header="目标格口" Binding="{Binding Destination}" Width="110"/><DataGridTextColumn Header="供给 / 单位" Binding="{Binding Quantity}" Width="120"/><DataGridTextColumn Header="处理结果" Binding="{Binding Status}" Width="210"/></DataGrid.Columns></DataGrid></StackPanel></Border>
   </Grid>
   <Grid x:Name="EntryOverlay" Background="{StaticResource Background}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Width="660" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"><StackPanel>
    <TextBlock x:Name="EntryTitle" Text="启动自检" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="EntryDescription" Text="从当前运行所有者读取实际配置、存储、来源和未决事实。" Margin="0,8,0,16"/>
    <TextBlock x:Name="StartupChecks" Text="正在读取；不使用进度百分比代替事实。" Margin="0,6"/>
    <StackPanel x:Name="IdentityEntry"><TextBlock Text="SIMULATION · 模拟身份入口" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock Text="选择固定参考角色，仅用于本地合成闭环。没有真实认证合同，不收集密码，也不声称WCS认证成功。" Foreground="{StaticResource Muted}"/><WrapPanel Margin="0,12"><Button Tag="Login" Content="以模拟操作员登录" Click="OperatorClick" Style="{StaticResource Primary}"/><Button Tag="Login" Content="以模拟维护员登录" Click="MaintenanceClick"/></WrapPanel></StackPanel>
    <WrapPanel><Button Content="查看诊断" Click="OpenDevicesClick"/><Button Content="组件管理与恢复" Click="OpenExtensionsClick"/><Button x:Name="EntryRecoveryButton" Content="核对原请求与恢复" Click="OpenRecoveryClick"/><Button x:Name="EntryContinueButton" Content="返回当前工作台" Click="ContinueEntryClick"/></WrapPanel><TextBlock Text="恢复不自动重发；旧箱、原请求和实体责任持续保留。" Foreground="{StaticResource Warning}" Margin="0,14,0,0"/>
   </StackPanel></Border></ScrollViewer></Grid>
   <Border x:Name="SmallAreaWarning" Background="{StaticResource Background}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="28" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel VerticalAlignment="Top"><TextBlock Text="窗口空间不足 · 新业务已暂停" FontSize="28" Foreground="{StaticResource Danger}"/><TextBlock Text="有效客户区至少需要 1280 × 680 DIP。请最大化窗口或调整经批准的显示设置；不通过缩小文字继续供包。" Margin="0,16" FontSize="18"/><TextBlock Text="{Binding Context}" FontFamily="Consolas" Margin="0,8"/><TextBlock Text="{Binding OtherLane}" Margin="0,8"/><TextBlock Text="已发请求和后台继续保留。恢复有效区域后仍须人工核对并恢复入场；不会自动重发。" FontSize="18"/><Button Content="组件管理与恢复" Click="OpenExtensionsClick"/><Button Content="最大化窗口" Click="MaximizeClick" HorizontalAlignment="Left" Margin="0,16"/></StackPanel></ScrollViewer></Border>
  </Grid>
   <Grid x:Name="DrawerOverlay" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed">
    <Border Background="#59132233"/>
    <Border x:Name="DrawerPanel" HorizontalAlignment="Right" Width="1100" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="22,12"><Button x:Name="DrawerClose" Content="返回工作台  ×" DockPanel.Dock="Right" Click="CloseDrawerClick"/><StackPanel><TextBlock x:Name="DrawerTitle" Text="作业记录" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="DrawerDescription" Text="只读追溯；后台继续处理原请求。" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock Text="{Binding Context}" FontSize="13" MaxHeight="22" ToolTip="{Binding Context}"/><ScrollViewer MaxHeight="40" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding GlobalStatus}" FontSize="13" Foreground="{StaticResource Warning}" AutomationProperties.LiveSetting="Assertive"/></ScrollViewer></StackPanel></DockPanel>
      <TabControl x:Name="Pages" Grid.Row="1" SelectionChanged="TabChanged" Style="{StaticResource ContentOnlyTabs}">
   <TabItem Style="{StaticResource ContentOnlyTab}" x:Name="HistoryPage" Header="记录与请求"><Grid x:Name="HistoryBody" Margin="16,4">
    <Grid x:Name="HistoryList"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"><StackPanel>
      <WrapPanel>
       <StackPanel><TextBlock Text="记录对象" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="HistoryEntityBox" Width="110" SelectedIndex="0"><ComboBoxItem Content="箱会话"/><ComboBoxItem Content="Item作业"/></ComboBox></StackPanel>
       <StackPanel><TextBlock Text="箱码 · 精确匹配" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FilterBox" Width="150" AutomationProperties.Name="历史箱码"/></StackPanel>
       <StackPanel><TextBlock Text="Item条码 · 精确匹配" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemFilter" Width="150" AutomationProperties.Name="历史Item条码"/></StackPanel>
       <StackPanel><TextBlock Text="SKU" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SkuFilter" Width="130" AutomationProperties.Name="历史SKU"/></StackPanel>
       <StackPanel><TextBlock Text="任务ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TaskFilter" Width="150" AutomationProperties.Name="历史任务ID"/></StackPanel>
       <StackPanel><TextBlock Text="通道" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="HistoryLaneBox" Width="110" SelectedIndex="0"><ComboBoxItem Content="全部通道"/><ComboBoxItem Content="左通道"/><ComboBoxItem Content="右通道"/></ComboBox></StackPanel>
      </WrapPanel>
      <WrapPanel>
       <StackPanel><TextBlock Text="箱会话状态" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SessionStatusFilter" Width="150" DisplayMemberPath="Label"/></StackPanel>
       <StackPanel><TextBlock Text="Item作业状态" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="OperationStatusFilter" Width="170" DisplayMemberPath="Label"/></StackPanel>
       <StackPanel><TextBlock Text="原请求状态" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RequestStatusFilter" Width="165" DisplayMemberPath="Label"/></StackPanel>
       <StackPanel><TextBlock Text="开始日期与时间 · 含边界" Style="{StaticResource FieldLabel}"/><WrapPanel><DatePicker x:Name="HistoryFromDate" Width="135" MinHeight="44" AutomationProperties.Name="历史开始日期"/><TextBox x:Name="HistoryFrom" Width="95" Text="00:00" AutomationProperties.Name="历史开始本地时间"/></WrapPanel></StackPanel>
       <StackPanel><TextBlock Text="结束日期与时间 · 不含边界" Style="{StaticResource FieldLabel}"/><WrapPanel><DatePicker x:Name="HistoryUntilDate" Width="135" MinHeight="44" AutomationProperties.Name="历史结束日期"/><TextBox x:Name="HistoryUntil" Width="95" Text="00:00" AutomationProperties.Name="历史结束本地时间"/></WrapPanel></StackPanel>
      </WrapPanel>
      <WrapPanel><Button Content="查询" Tag="ReadHistory" Click="HistoryClick" Style="{StaticResource Primary}"/><Button Content="导出当前筛选" Tag="ReadHistory" Click="ExportHistoryClick"/><TextBlock x:Name="HistoryTimezone" Text="本地时区" FontSize="12" Foreground="{StaticResource Muted}"/></WrapPanel>
      <TextBlock Text="日期留空不限定边界；时间为24小时。字段精确匹配，会话模式的子条件分别匹配作业/请求。" FontSize="12"/><TextBlock x:Name="HistoryFeedback" Text="尚未查询" FontWeight="SemiBold"/>
     </StackPanel></ScrollViewer>
     <DataGrid x:Name="HistoryGrid" Grid.Row="1" SelectionChanged="HistorySelected" MouseDoubleClick="HistoryDoubleClick" KeyDown="HistoryKeyDown"><DataGrid.Columns>
      <DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="165"/>
      <DataGridTextColumn Header="已接受" Binding="{Binding Accepted}" Width="75"/>
      <DataGridTextColumn Header="对象" Binding="{Binding EntityType}" Width="85"/>
      <DataGridTextColumn Header="对象条码" Binding="{Binding ObjectCode}" Width="*" MinWidth="130"/>
      <DataGridTextColumn Header="通道" Binding="{Binding Lane}" Width="65"/>
      <DataGridTextColumn Header="请求 / 尝试 / 接收" Binding="{Binding Attempts}" Width="180"/>
      <DataGridTextColumn Header="日期与时区" Binding="{Binding Time}" Width="210"/>
     </DataGrid.Columns></DataGrid>
     <WrapPanel Grid.Row="2"><Button x:Name="BackToBoxHistory" Content="返回原筛选与页码" Click="BackToBoxHistoryClick" Visibility="Collapsed"/><Button x:Name="HistoryPrevious" Content="上一页" Click="PreviousClick"/><Button x:Name="HistoryNext" Content="下一页" Click="NextClick"/><Button Content="查看选中记录详情" Tag="ReadHistory" Click="SelectedRecordDetailClick"/><Button Content="选中箱的全部作业" Tag="ReadHistory" Click="SessionOperationsClick"/><Button Content="选中箱的关闭链" Tag="ReadHistory" Click="SelectedSessionClick"/></WrapPanel>
    </Grid>
    <Grid x:Name="HistoryDetail" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><Button Content="← 返回记录列表" Click="BackToHistoryClick" DockPanel.Dock="Left"/><TextBlock Text="业务对象与结果 · 原请求及技术证据按需展开" FontWeight="SemiBold" Margin="12,4"/></DockPanel><TreeView x:Name="DetailTree" Grid.Row="1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid>
   </Grid></TabItem>
   <TabItem Style="{StaticResource ContentOnlyTab}" x:Name="RecoveryPage" Header="报警与恢复"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="540" Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding AlarmSummary}"/><TextBlock Text="已读不代表恢复。历史分页不影响活动报警。"/></StackPanel>
    <TabControl Grid.Row="1">
     <TabItem Header="活动报警"><DataGrid x:Name="AlarmGrid" SelectionChanged="AlarmSelected"><DataGrid.Columns>
      <DataGridTextColumn Header="发生 UTC" Binding="{Binding RaisedAt}" Width="180"/><DataGridTextColumn Header="范围" Binding="{Binding Scope}"/><DataGridTextColumn Header="原因" Binding="{Binding Code,Converter={StaticResource OperatorLabel}}" Width="*"/><DataGridTextColumn Header="对象" Binding="{Binding OwnerId}" Width="240"/><DataGridTextColumn Header="已读" Binding="{Binding AckedBy}"/>
     </DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="已恢复历史"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="AlarmHistoryFeedback" Text="尚未查询报警历史" Margin="4"/><WrapPanel><Button Content="刷新历史" Tag="ReadHistory" Click="AlarmHistoryClick"/><Button Content="上一页" Tag="ReadHistory" Click="AlarmPreviousClick"/><Button Content="下一页" Tag="ReadHistory" Click="AlarmNextClick"/></WrapPanel></StackPanel><DataGrid x:Name="AlarmHistoryGrid" SelectionChanged="AlarmSelected"><DataGrid.Columns>
      <DataGridTextColumn Header="发生 UTC" Binding="{Binding RaisedAt}" Width="180"/><DataGridTextColumn Header="原因" Binding="{Binding Code,Converter={StaticResource OperatorLabel}}" Width="*"/><DataGridTextColumn Header="对象" Binding="{Binding OwnerId}" Width="240"/><DataGridTextColumn Header="恢复 UTC" Binding="{Binding ClearedAt}" Width="180"/><DataGridTextColumn Header="已读" Binding="{Binding AckedBy}"/>
     </DataGrid.Columns></DataGrid></DockPanel></TabItem>
    </TabControl>
    <DataGrid x:Name="RecoveryGrid" Grid.Row="2" SelectionChanged="RecoverySelected"><DataGrid.Columns>
     <DataGridTextColumn Header="原请求" Binding="{Binding Id}" Width="240"/><DataGridTextColumn Header="状态" Binding="{Binding Status,Converter={StaticResource OperatorLabel}}" Width="120"/><DataGridTextColumn Header="阻断 / 本地终结禁止原因" Binding="{Binding Reasons}" Width="*"/><DataGridTextColumn Header="下一步" Binding="{Binding NextStep}" Width="280"/>
    </DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="3"><TextBox x:Name="RequestIdBox" MinWidth="260" AutomationProperties.Name="原请求身份"/><Button Tag="Reconcile" Content="查询原请求结果" Click="ReconcileClick"/><Button Tag="CancelPrepared" x:Name="CancelPreparedButton" Content="终结选中未交付请求" Click="CancelPreparedClick" IsEnabled="False"/><Button Tag="AckAlarm" Content="已读选中报警" Click="AckClick"/><Button Content="查看关联详情" Tag="ReadHistory" Click="AlarmDetailClick"/><Button Content="当前关闭详情" Tag="ReadHistory" Click="CloseDetailClick"/></WrapPanel>
    <StackPanel Grid.Row="4"><TextBlock Text="本地终结保留原记录；此前预留与实体仍须另行处置。"/><WrapPanel><TextBox x:Name="EvidenceBox" MinWidth="350" AutomationProperties.Name="人工核对证据"/><Button Tag="RecordReconciliation" Content="记录核对依据" Click="RecordEvidenceClick"/><Button Tag="CancelClose" Content="取消少货关闭" Click="CancelCloseClick"/><Button Tag="ConfirmClose" Content="确认当前检查并关闭" Click="ConfirmCloseClick"/></WrapPanel></StackPanel>
   </Grid></ScrollViewer></TabItem>

   <TabItem Style="{StaticResource ContentOnlyTab}" x:Name="MaintenancePage" Header="维护配置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <WrapPanel><Button Content="设备与连接" Click="OpenDevicesClick"/><Button Content="维护配置" Click="OpenMaintenanceClick"/><Button Content="组件与部署" Click="OpenExtensionsClick"/></WrapPanel><TextBlock Text="站点配置草稿" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ConfigLifecycle" FontWeight="SemiBold"/><TextBlock x:Name="ConfigRevisionSummary" Text="已保存修订尚未读取"/><TextBlock Text="编辑 → 验证并保存 → 待激活 → 受控重启。激活失败保留上一有效配置。活动箱或未决请求阻止激活。" Margin="0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="站点 ID / 配置版本"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="StationIdField" Width="180" IsReadOnly="True" ToolTip="当前数据根与资源租约绑定此站点；本包不支持重命名"/><TextBox x:Name="VersionField" Width="180"/></StackPanel><TextBlock Grid.Row="1" Text="接收端点"/><TextBox x:Name="EndpointField" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="接收端点"/><TextBlock Grid.Row="2" Text="目标版本 / 合同"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="BindingVersionField" Width="180"/><TextBox x:Name="ContractField" Width="220" IsReadOnly="True"/></StackPanel><TextBlock Grid.Row="3" Text="超时 / 队列容量"/><WrapPanel Grid.Row="3" Grid.Column="1"><TextBox x:Name="TimeoutField" Width="90" ToolTip="请求超时毫秒"/><TextBox x:Name="EventCapacityField" Width="90" ToolTip="观察队列容量"/><TextBox x:Name="CommandCapacityField" Width="90" ToolTip="命令队列容量"/><TextBox x:Name="OutboxCapacityField" Width="90" ToolTip="待决请求容量"/></WrapPanel><TextBlock Grid.Row="4" Text="磁盘低水位 MB"/><TextBox x:Name="MinimumFreeField" Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left"/><TextBlock Grid.Row="5" Text="合成需求 / 包装上限"/><WrapPanel Grid.Row="5" Grid.Column="1"><TextBox x:Name="FixtureDemandField" Width="100" ToolTip="仅 SIMULATION 合成初始需求"/><TextBox x:Name="MaximumPackageField" Width="100" ToolTip="仅 SIMULATION 包装上限"/><TextBox x:Name="PolicyField" Width="240" IsReadOnly="True" ToolTip="数量策略不可由界面另造生产规则"/></WrapPanel></Grid>
    <TextBlock Text="已安装驱动绑定 · 仅列出产品允许的驱动" FontWeight="SemiBold" Margin="0,12,0,8"/><DataGrid x:Name="DeviceConfigGrid" IsReadOnly="False" CanUserAddRows="False" Height="140"><DataGrid.Columns><DataGridTextColumn Header="逻辑角色" Binding="{Binding Role}" IsReadOnly="True" Width="100"/><DataGridComboBoxColumn x:Name="DriverColumn" Header="已安装驱动" SelectedItemBinding="{Binding Driver,UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="绑定版本" Binding="{Binding Revision,UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="回放文件（仅 replay）" Binding="{Binding ReplayFile,UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid>
    <WrapPanel><Button Content="预览差异与校验" Click="PreviewConfigClick"/><Button Tag="SaveConfig" Content="验证并保存草稿" Click="SaveConfigClick"/><Button Content="刷新修订记录" Tag="ReadHistory" Click="ConfigsClick"/><Button Tag="ActivateConfig" Content="激活选中修订 · 待重启" Click="ActivateClick"/></WrapPanel><ListBox x:Name="ConfigFieldErrors" MaxHeight="130" SelectionChanged="ConfigurationFieldErrorSelected" AutomationProperties.Name="配置字段错误，选择可定位"/><TextBlock x:Name="ConfigFeedback" Text="更改仅写入草稿；全部字段在后台再次校验。" Margin="4,8"/><Expander Header="本窗草稿与当前有效值对照（选字段可定位）"><DataGrid x:Name="ConfigComparison" MaxHeight="250" SelectionChanged="ConfigComparisonSelected"><DataGrid.Columns><DataGridTextColumn Header="字段" Binding="{Binding Field}" Width="180"/><DataGridTextColumn Header="当前有效" Binding="{Binding Effective}" Width="*"/><DataGridTextColumn Header="本窗草稿" Binding="{Binding Draft}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="180"/></DataGrid.Columns></DataGrid></Expander><ListBox x:Name="ConfigDiff" MinHeight="70" MaxHeight="180"/><DataGrid x:Name="ConfigsList" Height="150" SelectionChanged="ConfigurationRevisionSelected"><DataGrid.Columns><DataGridTextColumn Header="修订 ID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status,Converter={StaticResource OperatorLabel}}" Width="150"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="时间" Binding="{Binding At}" Width="200"/></DataGrid.Columns></DataGrid>
    <Expander Header="高级诊断 · JSON 草稿（不会自动覆盖表单）" Margin="0,12"><StackPanel><TextBox x:Name="ConfigDraft" Height="220" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"/><Button Content="将 JSON 导入表单并校验" Click="ImportConfigClick"/></StackPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
