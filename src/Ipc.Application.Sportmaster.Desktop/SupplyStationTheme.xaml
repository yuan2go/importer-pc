<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:pf="clr-namespace:Ipc.Application.ParcelFlow.Desktop;assembly=Ipc.Application.ParcelFlow.Desktop">
 <pf:ParcelStateTextConverter x:Key="ParcelStateText"/>
 <!-- Native UI derived under explicit user authorization. Typography uses the shared offline OFL resources. -->
 <SolidColorBrush x:Key="StationBackground" Color="{Binding Color, Source={x:Static type:OperatorBrushes.Surface}}"/>
 <SolidColorBrush x:Key="StationInk" Color="{Binding Color, Source={x:Static type:OperatorBrushes.Ink}}"/>
 <SolidColorBrush x:Key="StationMuted" Color="{Binding Color, Source={x:Static type:OperatorBrushes.Muted}}"/>
 <SolidColorBrush x:Key="StationLine" Color="{Binding Color, Source={x:Static type:OperatorBrushes.Line}}"/>
 <Style x:Key="StationCard" TargetType="Border">
  <Setter Property="Background" Value="White"/>
  <Setter Property="BorderBrush" Value="{StaticResource StationLine}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="4"/>
  <Setter Property="Padding" Value="16"/>
 </Style>
 <Style x:Key="StationLabel" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource StationMuted}"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
  <Setter Property="Margin" Value="0,0,0,6"/>
 </Style>
 <Style x:Key="StationValue" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}">
  <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
  <Setter Property="Margin" Value="0,0,0,12"/>
  <Setter Property="IsTabStop" Value="True"/>
  <Setter Property="AutomationProperties.Name" Value="只读作业标识，可选择复制"/>
 </Style>
 <Style x:Key="StationTaskLabel" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource StationMuted}"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
 </Style>
 <Style x:Key="StationTaskValue" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}">
  <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Code}"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
  <Setter Property="MaxHeight" Value="48"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
  <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  <Setter Property="Margin" Value="0"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="IsTabStop" Value="True"/>
 </Style>
 <Style x:Key="StationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="BorderBrush" Value="{StaticResource StationLine}"/>
  <Setter Property="Foreground" Value="{StaticResource StationInk}"/>
  <Setter Property="MinHeight" Value="44"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
  <Setter Property="Padding" Value="8,6"/>
  <Setter Property="Margin" Value="0,0,4,0"/>
 </Style>
 <Style x:Key="StationNavigation" TargetType="Button" BasedOn="{StaticResource StationButton}">
  <Setter Property="MinHeight" Value="44"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Padding" Value="8,6"/>
  <Setter Property="Margin" Value="2,0"/>
 </Style>
 <Style x:Key="StationNotice" TargetType="TextBlock">
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Style.Triggers>
   <Trigger Property="Text" Value="">
    <Setter Property="Visibility" Value="Collapsed"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StationTouch" TargetType="Button" BasedOn="{StaticResource StationButton}">
  <Setter Property="MinHeight" Value="{x:Static type:OperatorTokens.TouchHeight}"/>
  <Setter Property="Margin" Value="0"/>
  <Setter Property="Padding" Value="12,8"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="4" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Chrome" Property="BorderBrush" Value="{x:Static type:OperatorBrushes.Accent}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="Chrome" Property="Opacity" Value="0.8"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Chrome" Property="BorderBrush" Value="{x:Static type:OperatorBrushes.Accent}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="Chrome" Property="Background" Value="{x:Static type:OperatorBrushes.Neutral}"/>
       <Setter Property="Foreground" Value="{x:Static type:OperatorBrushes.Muted}"/>
       <Setter TargetName="Chrome" Property="BorderBrush" Value="{x:Static type:OperatorBrushes.Line}"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="StationPrimaryTouch" TargetType="Button" BasedOn="{StaticResource StationTouch}">
  <Setter Property="Background" Value="{x:Static type:OperatorBrushes.Accent}"/>
  <Setter Property="Foreground" Value="{x:Static type:OperatorBrushes.Surface}"/>
  <Setter Property="BorderBrush" Value="{x:Static type:OperatorBrushes.Accent}"/>
 </Style>
 <Style x:Key="StationInstruction" TargetType="TextBlock">
  <Style.Triggers>
   <Trigger Property="Text" Value="">
    <Setter Property="Visibility" Value="Collapsed"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StationResultPanel" TargetType="Border">
  <Setter Property="Padding" Value="12,8"/><Setter Property="CornerRadius" Value="4"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="12,4"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="StationPositionCard" TargetType="Border" BasedOn="{StaticResource StationCard}">
  <Setter Property="Padding" Value="8"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="8,4"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="StationPositionSection" TargetType="FrameworkElement">
  <Setter Property="Margin" Value="0,0,0,8"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0,0,0,4"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="StationPositionActions" TargetType="StackPanel">
  <Setter Property="Margin" Value="0,8,0,0"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0,4,0,0"/></DataTrigger></Style.Triggers>
 </Style>
</ResourceDictionary>
