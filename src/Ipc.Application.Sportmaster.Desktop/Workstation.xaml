<UserControl x:Class="Ipc.Application.Sportmaster.Desktop.Workstation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <ItemsControl ItemsSource="{Binding PositionRows}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,0,12,16"><StackPanel><TextBlock Text="{Binding Id}" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding DeviceId}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Availability}" TextWrapping="Wrap"/><TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="24"/><TextBlock Text="{Binding State}"/><TextBlock Text="{Binding Slot}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{StaticResource Warning}"/><Button Content="选择此位作为命令目标" Tag="{Binding Id}" Click="Position_Click"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{Binding CurrentCommandTarget}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding CurrentStage}" FontSize="29" FontWeight="Bold" Margin="0,0,0,20"/><TextBlock Text="包裹号 · 原始相机观察" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Current.ParcelCode}" IsReadOnly="True" FontFamily="Consolas" FontSize="32" TextWrapping="Wrap" BorderThickness="0"/><TextBlock Text="{Binding Current.AdmissionId}" Foreground="{StaticResource Muted}"/><TextBlock Text="目标格口 · WCS 原结果" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding CurrentSlot}" FontSize="38" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,8"/><TextBlock Text="本业务不连接 PLC；按配置选择重量与传图，取得格口仅代表 WCS 阶段结果。"/><TextBlock Text="{Binding CurrentWeight}"/><TextBlock Text="{Binding Current.Reason}" Foreground="{StaticResource Warning}" Margin="0,16"/>
  </StackPanel></ScrollViewer></Border>
  <Expander Visibility="{Binding SimulationVisibility}" Grid.Row="1" Header="显式参考输入 · 不接入生产设备" Margin="0,12,0,0"><StackPanel><TextBlock Text="实体身份保留至显式新包裹；同码不自动合并，也不因重复点击创建新实体。"/><WrapPanel><TextBox Text="{Binding ParcelCode,UpdateSourceTrigger=PropertyChanged}" Width="260"/><TextBox Text="{Binding AdmissionId,UpdateSourceTrigger=PropertyChanged}" Width="330"/><Button Content="新包裹身份" Click="New_Click"/><Button Content="模拟相机读码" Click="Emit_Click" IsEnabled="{Binding CanAdmit}"/><TextBox Text="{Binding MeasurementValue,UpdateSourceTrigger=PropertyChanged}" Width="140"/><Button Content="同包裹模拟实测重量" Click="Weight_Click"/></WrapPanel></StackPanel></Expander>
 </Grid>
</UserControl>
