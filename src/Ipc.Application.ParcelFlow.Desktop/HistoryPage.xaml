<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:local="clr-namespace:Ipc.Application.ParcelFlow.Desktop" Background="White" FontSize="{x:Static type:UiTypography.Body}" FontWeight="Normal">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/QueryWorkspaceTheme.xaml"/></ResourceDictionary.MergedDictionaries><local:ParcelStateTextConverter x:Key="ParcelStateText"/><local:ParcelToneConverter x:Key="ParcelTone"/><local:LocalTimestampConverter x:Key="LocalTimestamp"/><local:PositionNameTextConverter x:Key="PositionName"/></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="HistoryLayout" Margin="12,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel>
   <TextBlock x:Name="HistoryHeading" DockPanel.Dock="Top" Text="作业记录" Style="{StaticResource QueryHeading}" Margin="0,0,0,4"/>
   <WrapPanel x:Name="HistoryQueryActions" DockPanel.Dock="Bottom" Margin="0,6,0,0"><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="查询" Click="Refresh_Click" Style="{StaticResource ParameterPrimaryAction}" Margin="0,0,8,0"/><Button Content="清除筛选" Click="ClearFilters_Click" Margin="0,0,8,0"/><Button Content="首屏" Click="First_Click" IsEnabled="{Binding HasPreviousHistory}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Style.Triggers><DataTrigger Binding="{Binding UsesHistoryPaging}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="上一页" Click="Previous_Click" IsEnabled="{Binding HasPreviousHistory}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Style.Triggers><DataTrigger Binding="{Binding UsesHistoryPaging}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="加载更早记录" Click="Next_Click" IsEnabled="{Binding HasNextHistory}" Margin="0,0,8,0"/><Button Content="导出表格…" Click="Export_Click" IsEnabled="{Binding CanExportHistory}" ToolTip="先查询，再导出当前查询结果" ToolTipService.ShowOnDisabled="True"/></WrapPanel><Button Content="取消查询" Click="CancelQuery_Click" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HistoryLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="取消导出" Click="CancelExport_Click" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HistoryExportRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel>
   <Expander x:Name="AllHistoryFilters" Header="筛选条件 · 条码、投递位、状态与时间" IsExpanded="False"><Expander.Style><Style TargetType="Expander"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCompact}" Value="True"/><Condition Binding="{Binding IsExpanded,RelativeSource={RelativeSource Self}}" Value="False"/><Condition Binding="{Binding Snapshot.ApplicationId}" Value="sportmaster"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Expander.Style><ScrollViewer x:Name="HistoryFilterScroll" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <WrapPanel x:Name="PrimaryHistoryFilters">
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="完整条码" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><TextBox Text="{Binding HistoryBarcode,UpdateSourceTrigger=PropertyChanged}" KeyDown="BarcodeQuery_KeyDown" AutomationProperties.Name="历史完整条码" ToolTip="输入完整条码，保留前导零"/></StackPanel>
     <StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="投递位" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding HistoryPositionChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding HistoryPosition,Mode=OneWay}" SelectionChanged="PositionChanged" AutomationProperties.Name="历史投递位" ToolTip="按投递位筛选；已停用的投递位可在“更多筛选”中按编号查询"/></StackPanel>
     <StackPanel Width="170" Margin="0,0,12,8"><TextBlock Text="业务状态" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding HistoryStates}" SelectedItem="{Binding HistoryState}" AutomationProperties.Name="历史业务状态"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ParcelStateText}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    </WrapPanel>
    <Expander x:Name="HistoryFilters" Header="时间范围" IsExpanded="False"><StackPanel Margin="0,8,0,4">
     <WrapPanel x:Name="HistoryTimePresets" Margin="0,0,0,8"><Button Content="今天" Click="Today_Click" Style="{StaticResource ParameterQuietAction}"/><Button Content="最近24小时" Click="LastDay_Click" Style="{StaticResource ParameterQuietAction}"/><Button Content="最近7天" Click="LastWeek_Click" Style="{StaticResource ParameterQuietAction}"/><Button Content="不限时间" Click="AnyTime_Click" Style="{StaticResource ParameterQuietAction}"/></WrapPanel>
     <WrapPanel><StackPanel Width="352" Margin="0,0,24,8"><TextBlock Text="开始时间" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><local:DateTimeInput Timestamp="{Binding HistoryFrom,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史开始含时区"/></StackPanel><StackPanel Width="352" Margin="0,0,0,8"><TextBlock Text="结束时间" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><local:DateTimeInput Timestamp="{Binding HistoryToExclusive,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史结束不含含时区"/></StackPanel></WrapPanel>
     <TextBlock Text="按本机时间查询，包含开始时刻，不包含结束时刻；留空表示不限。" Style="{StaticResource QueryHint}"/>
    </StackPanel></Expander>
    <Expander Header="更多筛选与查询信息"><StackPanel Margin="0,8,0,8">
     <WrapPanel><StackPanel Width="260" Margin="0,0,16,8"><TextBlock Text="请求编号" Style="{StaticResource QueryHint}"/><TextBox Text="{Binding HistoryRequest,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史原请求编号"/></StackPanel><StackPanel Width="220" Margin="0,0,0,8"><TextBlock Text="历史投递位编号" Style="{StaticResource QueryHint}"/><TextBox Text="{Binding HistoryPosition,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史投递位精确ID"/></StackPanel></WrapPanel>
     <TextBlock Text="{Binding AppliedHistoryRange}" Style="{StaticResource QueryHint}"/><TextBlock Text="{Binding HistoryMetricsDetail}" Style="{StaticResource QueryHint}"/>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer></Expander>
  </DockPanel>
  <StackPanel Grid.Row="1"><TextBox Text="{Binding HistoryRangeSummary,Mode=OneWay}" IsReadOnly="True" MinHeight="0" Padding="0" Margin="0,8,0,0" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="{x:Static type:UiTypography.Label}" MaxHeight="54" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="已应用历史范围"><TextBox.Style><Style TargetType="TextBox"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><TextBlock Text="{Binding HistoryMetricsSummary}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{x:Static type:UiTypography.Body}" Foreground="{DynamicResource Ink}" AutomationProperties.Name="本次查询统计"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding HistoryMetricsSummary}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock x:Name="HistoryStatusLine" Grid.Row="1" ToolTip="{Binding HistoryStatus}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QueryHint}"><Setter Property="Text" Value="{Binding HistoryStatus}"/><Setter Property="Margin" Value="0,6,0,8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Text" Value="{Binding CompactHistoryStatus}"/><Setter Property="Margin" Value="0,2,0,4"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
  <Grid Grid.Row="2" x:Name="HistoryBody"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DataGrid x:Name="HistoryRows" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource QueryResultsGrid}"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="36"/></DataTrigger><DataTrigger Binding="{Binding Visibility,ElementName=HistoryDetailPanel}" Value="Collapsed"><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns>
    <DataGridTextColumn Header="扫描时间" Width="170" Binding="{Binding Operation.ObservedAt,Converter={StaticResource LocalTimestamp},StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" ElementStyle="{StaticResource QueryCellText}"/>
    <DataGridTextColumn Header="投递位" Binding="{Binding Operation.PositionId,Converter={StaticResource PositionName},Mode=OneWay}" Width="90" ElementStyle="{StaticResource QueryCellText}"/>
    <DataGridTextColumn Header="格口" Binding="{Binding Operation.Slot,Mode=OneWay}" Width="SizeToCells" MinWidth="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource QueryCodeText}"><Setter Property="TextTrimming" Value="None"/><Setter Property="ToolTip" Value="{Binding Operation.Slot}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    <DataGridTemplateColumn Header="条码 / 图片" Width="*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
     <TextBlock Text="{Binding Operation.ParcelCode}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QueryCodeText}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.Snapshot.ApplicationId,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="sportmaster"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Button Click="Picture_Click" HorizontalContentAlignment="Left" MinHeight="40" Padding="4,2" FontFamily="{x:Static type:UiTypography.Code}" ToolTip="查看此作业的包裹图片" AutomationProperties.Name="查看此记录的包裹图片" Cursor="Hand"><TextBlock Text="{Binding Operation.ParcelCode}" TextWrapping="NoWrap" TextDecorations="Underline"/><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Snapshot.ApplicationId,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="sportmaster"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="输入来源" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QueryCellText}"><Setter Property="Text" Value="手动调试"/><Style.Triggers><DataTrigger Binding="{Binding Operation.DebugRequest}" Value="{x:Null}"><Setter Property="Text" Value="设备读码"/></DataTrigger><DataTrigger Binding="{Binding Operation.OperatorInput.Kind}" Value="Keyboard"><Setter Property="Text" Value="手动键盘"/></DataTrigger><DataTrigger Binding="{Binding Operation.OperatorInput.Kind}" Value="PdaKeyboard"><Setter Property="Text" Value="PDA键盘"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="状态" Width="*" MinWidth="110" SortMemberPath="Operation.State"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button x:Name="HistoryStatusDetailsAction" Click="StatusDetails_Click" MinHeight="40" Padding="0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="查看这条作业的任务详情" AutomationProperties.Name="查看任务详情"><TextBlock Text="{Binding Operation.State,Converter={StaticResource ParcelStateText},Mode=OneWay}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QueryCellText}"><Style.Triggers><DataTrigger Binding="{Binding Operation,Converter={StaticResource ParcelTone}}" Value="Accepted"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger><DataTrigger Binding="{Binding Operation,Converter={StaticResource ParcelTone}}" Value="Unknown"><Setter Property="Foreground" Value="{DynamicResource Warning}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/></DataTrigger><DataTrigger Binding="{Binding Operation,Converter={StaticResource ParcelTone}}" Value="Rejected"><Setter Property="Foreground" Value="{DynamicResource Danger}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns></DataGrid>
   <ContentControl x:Name="HistoryDetailPanel" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="16,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,8,0,0"/></DataTrigger><DataTrigger Binding="{Binding DetailsOpen,RelativeSource={RelativeSource AncestorType=local:HistoryPage}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ContentControl.Style><DockPanel x:Name="HistoryDetails">
    <Button DockPanel.Dock="Top" Content="查看该作业的日志" Click="Logs_Click" Visibility="{Binding ManagementModeVisibility}" MinHeight="44" HorizontalAlignment="Left"/>
    <WrapPanel Visibility="{Binding ManagementModeVisibility}" x:Name="HistoryActions" DockPanel.Dock="Top" IsEnabled="{Binding CanStartOperation}" ToolTip="{Binding OperationStatus}" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,8"><Button Content="查询所选作业的结果" Click="Query_Click" IsEnabled="{Binding CanHistoryQuery}" Margin="0,0,6,4"/><Button Content="继续处理所选作业" Click="Continue_Click" IsEnabled="{Binding CanHistoryContinue}" Margin="0,0,6,4"/><Button Content="复制完整数据" Click="Copy_Click" Margin="0,0,0,4"/></WrapPanel>
    <ScrollViewer x:Name="HistoryDetailsScroll" VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="100"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel>
     <StackPanel x:Name="StructuredDetailsPanel" Margin="0,0,0,12" AutomationProperties.Name="任务详情">
      <TextBlock Text="{Binding StructuredDetails}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Body}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding StructuredSheet}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ContentControl Content="{Binding StructuredSheet}" Focusable="False"><ContentControl.ContentTemplate><DataTemplate DataType="{x:Type local:ParcelDetailSheet}"><StackPanel>
       <Border CornerRadius="6" BorderThickness="1" Padding="14,12" Margin="0,0,0,12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers>
         <DataTrigger Binding="{Binding Tone}" Value="Accepted"><Setter Property="Background" Value="{DynamicResource SuccessBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Success}"/></DataTrigger>
         <DataTrigger Binding="{Binding Tone}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource WarningBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Warning}"/></DataTrigger>
         <DataTrigger Binding="{Binding Tone}" Value="Rejected"><Setter Property="Background" Value="{DynamicResource DangerBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Danger}"/></DataTrigger>
        </Style.Triggers></Style></Border.Style><StackPanel>
        <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Group}" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{DynamicResource Ink}" AutomationProperties.HeadingLevel="Level2"/>
        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="{x:Static type:UiTypography.Body}" Foreground="{DynamicResource Ink}"/>
       </StackPanel></Border>
       <ItemsControl ItemsSource="{Binding Sections}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:DetailSection}"><StackPanel Margin="0,0,0,14">
        <TextBlock Text="{Binding Title}" FontSize="{x:Static type:UiTypography.Label}" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{DynamicResource Muted}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level3"/>
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}"><ItemsControl ItemsSource="{Binding Rows}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:DetailRow}"><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Body}"/>
         <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Body}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><DataTrigger Binding="{Binding Attention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
        <Button Click="Picture_Click" HorizontalAlignment="Left" Margin="0,6,0,0" MinHeight="36" Padding="0,4" Cursor="Hand" AutomationProperties.Name="查看这件包裹的图片"><TextBlock Text="查看图片" TextDecorations="Underline"/><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowsPicture}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{x:Static type:UiTypography.Label}" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl>
     </StackPanel><TextBlock Text="{Binding HistoryQueryGuidance}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Label}" Margin="0,0,0,8"/><Expander Visibility="{Binding ManagementModeVisibility}" x:Name="HistoryInspection" Header="包裹检查说明"><StackPanel><TextBlock Text="{Binding HistoryCommandTarget}" Style="{StaticResource QueryHint}"/><TextBlock Text="{Binding HistorySelectionState}" Style="{StaticResource QueryHint}"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="不替代现场安全许可"/></StackPanel></Expander><Expander Visibility="{Binding ManagementModeVisibility}" Header="技术详情（维护人员）"><TextBox x:Name="RawDetailsText" Text="{Binding Details,Mode=OneWay}" FontFamily="{x:Static type:UiTypography.Code}" FontSize="{x:Static type:UiTypography.Log}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/></Expander></StackPanel></ScrollViewer>
   </DockPanel></ContentControl>
  </Grid>
 </Grid>
</UserControl>
