<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:local="clr-namespace:Ipc.Application.ParcelFlow.Desktop" Background="White" FontSize="{x:Static type:UiTypography.Body}" FontWeight="Normal">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/QueryWorkspaceTheme.xaml"/></ResourceDictionary.MergedDictionaries><local:ParcelStateTextConverter x:Key="ParcelStateText"/><local:LocalTimestampConverter x:Key="LocalTimestamp"/></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="HistoryLayout" Margin="20,16,20,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel>
   <WrapPanel x:Name="HistoryQueryActions" DockPanel.Dock="Bottom" Margin="0,6,0,0"><TextBlock x:Name="HistoryHeading" Text="作业记录" Style="{StaticResource QueryHeading}" Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="按条件查询固定范围；选择记录查看对应任务与原请求。"/><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="查询" Click="Refresh_Click" Style="{StaticResource ParameterPrimaryAction}" Margin="0,0,8,0"/><Button Content="清除筛选" Click="ClearFilters_Click" Margin="0,0,8,0"/><Button Content="下一页" Click="Next_Click" IsEnabled="{Binding HasNextHistory}" Margin="0,0,8,0"/><Button Content="导出表格…" Click="Export_Click"/></WrapPanel><Button Content="取消导出" Click="CancelExport_Click" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HistoryExportRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel>
   <ScrollViewer x:Name="HistoryFilterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <WrapPanel>
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="完整条码" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><TextBox Text="{Binding HistoryBarcode,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史完整条码" ToolTip="精确匹配并保留前导零"/></StackPanel>
     <StackPanel Width="110" Margin="0,0,12,8"><TextBlock Text="投递位" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><TextBox Text="{Binding HistoryPosition,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史投递位" ToolTip="留空表示全部投递位"/></StackPanel>
     <StackPanel Width="170" Margin="0,0,12,8"><TextBlock Text="业务状态" Style="{StaticResource QueryHint}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding HistoryStates}" SelectedItem="{Binding HistoryState}" AutomationProperties.Name="历史业务状态"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ParcelStateText}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    </WrapPanel>
    <Expander x:Name="HistoryFilters" Header="更多筛选与时间范围" IsExpanded="False"><StackPanel Margin="0,6,0,0">
     <StackPanel MaxWidth="420" HorizontalAlignment="Left" Margin="0,0,0,8"><TextBlock Text="原请求编号" Style="{StaticResource QueryHint}"/><TextBox Text="{Binding HistoryRequest,UpdateSourceTrigger=PropertyChanged}" MinWidth="260" AutomationProperties.Name="历史原请求编号"/></StackPanel>
     <WrapPanel><StackPanel Margin="0,0,20,8"><TextBlock Text="开始时间（含）" FontWeight="{x:Static type:UiTypography.Emphasis}"/><local:DateTimeInput Timestamp="{Binding HistoryFrom,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史开始含时区"/></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="结束时间（不含）" FontWeight="{x:Static type:UiTypography.Emphasis}"/><local:DateTimeInput Timestamp="{Binding HistoryToExclusive,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="历史结束不含含时区"/></StackPanel></WrapPanel>
     <WrapPanel><Button Content="今天" Click="Today_Click" Style="{StaticResource ParameterQuietAction}"/><Button Content="最近24小时" Click="LastDay_Click" Style="{StaticResource ParameterQuietAction}"/><Button Content="不限时间" Click="AnyTime_Click" Style="{StaticResource ParameterQuietAction}"/></WrapPanel>
     <Expander Header="精确时间与统计口径"><StackPanel><WrapPanel><TextBox Text="{Binding HistoryFrom,UpdateSourceTrigger=PropertyChanged}" Width="320" AutomationProperties.Name="高级开始时间原文"/><TextBox Text="{Binding HistoryToExclusive,UpdateSourceTrigger=PropertyChanged}" Width="320" AutomationProperties.Name="高级结束时间原文"/></WrapPanel><TextBlock Text="{Binding HistoryMetricsSummary}" Style="{StaticResource QueryHint}" Margin="0,8,0,0"/></StackPanel></Expander>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </DockPanel>
  <TextBlock Grid.Row="1" Text="{Binding HistoryStatus}" ToolTip="{Binding HistoryStatus}" Margin="0,6,0,8" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QueryHint}"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Grid Grid.Row="2" x:Name="HistoryBody"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DataGrid x:Name="HistoryRows" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource QueryResultsGrid}"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="36"/></DataTrigger><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns>
    <DataGridTextColumn Header="观察时间（本地）" Width="206" Binding="{Binding Operation.ObservedAt,Converter={StaticResource LocalTimestamp},StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" ElementStyle="{StaticResource QueryCellText}"/>
    <DataGridTextColumn Header="投递位" Binding="{Binding Operation.PositionId,Mode=OneWay}" Width="64" ElementStyle="{StaticResource QueryCellText}"/>
    <DataGridTextColumn Header="条码" Binding="{Binding Operation.ParcelCode,Mode=OneWay}" Width="*" MinWidth="90" ElementStyle="{StaticResource QueryCodeText}"/>
    <DataGridTextColumn Header="状态" Binding="{Binding Operation.State,Converter={StaticResource ParcelStateText},Mode=OneWay}" Width="*" MinWidth="90" ElementStyle="{StaticResource QueryCellText}"/>
    <DataGridTextColumn Header="格口" Binding="{Binding Operation.Slot,Mode=OneWay}" Width="80" ElementStyle="{StaticResource QueryCodeText}"/><DataGridCheckBoxColumn Header="归档" Binding="{Binding Archived}" Width="48"/>
   </DataGrid.Columns></DataGrid>
   <Expander x:Name="HistoryDetailExpander" Header="任务详情"><Expander.Style><Style TargetType="Expander"><Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="16,0,0,0"/><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,8,0,0"/><Setter Property="IsExpanded" Value="False"/></DataTrigger><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style><DockPanel x:Name="HistoryDetails">
    <WrapPanel Visibility="{Binding ManagementModeVisibility}" x:Name="HistoryActions" DockPanel.Dock="Top" IsEnabled="{Binding CanStartOperation}" ToolTip="{Binding OperationStatus}" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,8"><Button Content="核对所选原请求" Click="Query_Click" IsEnabled="{Binding CanHistoryQuery}" Margin="0,0,6,4"/><Button Content="继续所选未尝试阶段" Click="Continue_Click" IsEnabled="{Binding CanHistoryContinue}" Margin="0,0,6,4"/><Button Content="复制完整原件数据" Click="Copy_Click" Margin="0,0,0,4"/></WrapPanel>
    <ScrollViewer x:Name="HistoryDetailsScroll" VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="100"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel><Expander Visibility="{Binding ManagementModeVisibility}" x:Name="HistoryInspection" Header="实体检查说明"><StackPanel><TextBlock Text="{Binding HistoryCommandTarget}" Style="{StaticResource QueryHint}"/><TextBlock Text="{Binding HistorySelectionState}" Style="{StaticResource QueryHint}"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="不替代现场安全许可"/></StackPanel></Expander><TextBox Text="{Binding StructuredDetails,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="{x:Static type:UiTypography.Body}"/><Expander Visibility="{Binding ManagementModeVisibility}" Header="诊断详情 · 原作业、请求及回执"><TextBox Text="{Binding Details,Mode=OneWay}" FontFamily="{x:Static type:UiTypography.Code}" FontSize="{x:Static type:UiTypography.Log}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/></Expander></StackPanel></ScrollViewer>
   </DockPanel></Expander>
  </Grid>
 </Grid>
</UserControl>
