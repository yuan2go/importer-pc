<Window x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop" Title="Sportmaster · 供包工作台" Width="1440" Height="980" MinWidth="1000" MinHeight="700" Background="#F0F2F5" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="Supply Station" FontSize="19" FontWeight="Bold"/><TextBlock Text="SPORTMASTER · 双位读码工作台" FontSize="11" Foreground="#6B7280"/></StackPanel>
    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="工作台" Click="Workstation_Click" Style="{StaticResource StationButton}"/><Button Content="作业记录" Click="History_Click" Style="{StaticResource StationButton}"/><Button Content="设备与维护" Click="Maintenance_Click" Style="{StaticResource StationButton}"/><Button Content="辅助窗口" Click="Window_Click" Style="{StaticResource StationButton}"/><Button Content="紧凑布局" Click="Layout_Click" Style="{StaticResource StationButton}"/><Button Content="暂停新入场" Click="Pause_Click" Style="{StaticResource StationButton}"/><Button Content="恢复新入场" Click="Resume_Click" IsEnabled="{Binding CanResume}" Style="{StaticResource StationButton}"/></WrapPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,10">
   <StackPanel>
    <WrapPanel><TextBlock Text="{Binding Station}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Margin="0,0,20,0"/><TextBlock Text="{Binding TopologyStatus}" Foreground="#6B7280"/><TextBlock Text="{Binding Session}" Margin="20,0,0,0"/></WrapPanel>
    <TextBlock Text="{Binding ConfigurationState}" Foreground="#6B7280" FontSize="12" Margin="0,5,0,0"/>
    <TextBlock Text="{Binding Health}" Foreground="#6B7280" FontSize="12" Margin="0,3,0,0"/>
    <WrapPanel Visibility="{Binding LoginVisibility}"><TextBox Text="{Binding OperatorSubject,UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="操作员账号"/><PasswordBox x:Name="LoginProof" Width="150" AutomationProperties.Name="操作员口令"/><Button Content="验证身份" Click="Login_Click" Style="{StaticResource StationButton}"/><Button Content="登出" Click="Logout_Click" Style="{StaticResource StationButton}"/></WrapPanel>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Margin="16,12,16,0" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12,8"><StackPanel><TextBlock Text="{Binding Status}" FontWeight="Bold"/><TextBlock Text="{Binding BlockingReasons}"/><TextBlock Text="{Binding Message}" FontSize="13"/><TextBlock Text="{Binding ReadStatus}" FontSize="12" Foreground="#6B7280"/></StackPanel></Border>
   <ContentControl x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding Fresh}"/>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,8"><TextBlock Text="{Binding EnvironmentStatus}" FontSize="12" Foreground="#6B7280"/></Border>
 </Grid>
</Window>
