<UserControl x:Class="Ipc.Desktop.ExtensionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="受控组件与部署" FontSize="22" FontWeight="Bold"/><ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Status" Text="尚未读取" Margin="0,4"/></ScrollViewer><TextBlock x:Name="AccessFeedback" Text="参数/部署需要有效维护身份；安装和恢复另需OS授权。" FontSize="13"/><Expander Header="安装与生效边界"><TextBlock Text="安装只增加受信任包；参数、实例与角色绑定组成同一部署修订，受控重启后取得生效回执。普通运行账户不写安装目录。" FontSize="13"/></Expander></StackPanel>
  <WrapPanel Grid.Row="1"><Button Content="刷新包与操作记录" Click="RefreshClick"/><Button Content="选择离线扩展包" Click="ChooseClick"/><Button x:Name="Install" Content="确认计划并安装（OS授权）" Click="InstallClick" IsEnabled="False"/><Button Content="恢复选中安装操作（OS授权）" Click="RecoverClick"/><Button Content="卸载选中未引用包（OS授权）" Click="UninstallClick"/></WrapPanel>
  <TabControl Grid.Row="2" Margin="0,8,0,0">
   <TabItem Header="包与信任 / 安装计划"><Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
    <DataGrid x:Name="Packages" SelectionChanged="PackageSelected"><DataGrid.Columns><DataGridTextColumn Header="包" Binding="{Binding Package.Id}" Width="*"/><DataGridTextColumn Header="版本" Binding="{Binding Package.Version}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130"/><DataGridTextColumn Header="签名包SHA" Binding="{Binding PackageSha256}" Width="240"/><DataGridTextColumn Header="安装说明" Binding="{Binding Reason}" Width="2*"/></DataGrid.Columns></DataGrid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBox x:Name="Plan" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" AutomationProperties.Name="扩展静态验证与安装计划"/></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="实例 / 参数 / 角色绑定"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <DockPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="选定包的一个精确版本进入草稿；升级保留旧包与原业务账。" FontSize="13"/><Button Content="选中包加入/升级部署草稿" Click="UsePackageClick"/><Button Content="从部署草稿移出选中包" Click="RemovePackageClick"/><TextBox x:Name="DesiredPackages" IsReadOnly="True" TextWrapping="Wrap" MinHeight="70"/></StackPanel><ListBox x:Name="Instances" DisplayMemberPath="Id" SelectionChanged="InstanceSelected"/></DockPanel>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Editor" Margin="16,0,0,0">
     <TextBlock Text="设备驱动 / 外部集成实例" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="EditorIdentity" Text="先选择一个精确包版本或实例" FontSize="13"/><TextBlock Text="模块"/><ComboBox x:Name="Module" DisplayMemberPath="Id" SelectionChanged="ModuleSelected"/><TextBlock Text="实例ID（小写字母开头；与设备和角色分别标识）"/><TextBox x:Name="InstanceId" AutomationProperties.Name="扩展实例身份"/><TextBlock Text="稳定设备ID（同一设备不能改实例名规避独占）"/><TextBox x:Name="DeviceId" AutomationProperties.Name="扩展稳定设备身份"/><StackPanel x:Name="ServiceTarget" Visibility="Collapsed"><TextBlock Text="外部服务端口（供包主请求为 requests）"/><TextBox x:Name="ServicePort" Text="requests"/><TextBlock Text="服务目标身份 / 目标修订 / 合同 / 地址（与设备身份分开）"/><TextBox x:Name="TargetId"/><TextBox x:Name="TargetRevision"/><TextBox x:Name="TargetContract" Text="SIMULATION-v1"/><TextBox x:Name="TargetEndpoint" AutomationProperties.Name="集成实例目标地址"/></StackPanel><WrapPanel><CheckBox x:Name="EnabledInstance" Content="启用此实例（仍需保存及重启）" IsChecked="True" Margin="4,12"/><ComboBox x:Name="Role" Width="180" SelectedIndex="0"><ComboBoxItem Content="left"/><ComboBoxItem Content="right"/></ComboBox></WrapPanel>
     <TextBlock Text="参数草稿 / 当前有效值" FontSize="18" FontWeight="Bold" Margin="0,12"/><StackPanel x:Name="Parameters"/><Button Content="校验并写入本窗部署草稿" Click="SaveInstanceClick"/><Button Content="停用/移除选中实例的草稿绑定" Click="RemoveInstanceClick"/><TextBlock Text="这些操作尚未保存到应用，也未启动或停止设备。" FontSize="13"/>
    </StackPanel></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="统一部署 / 生效回执"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="Effective" Text="有效部署尚未取得"/><WrapPanel><TextBox x:Name="Revision" MinWidth="220" ToolTip="新的不可复用部署修订身份"/><Button Content="校验差异并保存部署草稿" Click="SaveDeploymentClick"/><Button Content="选中修订申请受控重启激活" Click="ActivateClick"/></WrapPanel><TextBlock Text="站点参数沿用同一维护表单；有活动箱、未决副作用、版本竞争或包变化时后台拒绝激活。失败保留旧Effective。" FontSize="13"/><TextBox x:Name="Difference" IsReadOnly="True" MinHeight="70" MaxHeight="160" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
    <DataGrid x:Name="Revisions"><DataGrid.Columns><DataGridTextColumn Header="部署修订" Binding="{Binding Content.Version}" Width="180"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="150"/><DataGridTextColumn Header="原版本" Binding="{Binding BaseVersion}" Width="150"/><DataGridTextColumn Header="回执/原因" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="集成运行诊断"><DataGrid x:Name="IntegrationDiagnostics"><DataGrid.Columns><DataGridTextColumn Header="服务实例" Binding="{Binding InstanceId}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="150"/><DataGridTextColumn Header="在途" Binding="{Binding InFlight}" Width="100"/><DataGridTextColumn Header="最近故障" Binding="{Binding LastFailure}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="安装与恢复审计"><DataGrid x:Name="Operations"><DataGrid.Columns><DataGridTextColumn Header="原操作ID" Binding="{Binding Id}" Width="260"/><DataGridTextColumn Header="包" Binding="{Binding Package.Id}" Width="150"/><DataGridTextColumn Header="阶段" Binding="{Binding State}" Width="170"/><DataGridTextColumn Header="时间UTC" Binding="{Binding At}" Width="230"/><DataGridTextColumn Header="错误/恢复依据" Binding="{Binding Error}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </Grid>
</UserControl>
