<UserControl x:Class="Ipc.Desktop.LaneControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="0" UseLayoutRounding="True">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="16,8"><TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding Health}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}"/></DockPanel>
   <Border Grid.Row="1" Background="{Binding StatusBackground}" BorderBrush="{StaticResource Line}" BorderThickness="0,1" Padding="16,8"><StackPanel><TextBlock x:Name="ResultTitle" Text="{Binding Status}" FontSize="29" FontWeight="Bold" Foreground="{Binding StatusBrush}"/><TextBlock Text="{Binding Reason}" FontSize="13" Foreground="{StaticResource Muted}"/></StackPanel></Border>
   <ScrollViewer x:Name="CriticalScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="CriticalScrollChanged">
    <StackPanel x:Name="CriticalReview" Margin="16,8">
     <DockPanel><Button Content="复制" DockPanel.Dock="Right" Click="CopyBarcodeClick" ToolTip="复制完整Item条码"/><StackPanel><TextBlock Text="Item条码 · 只读观察" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BarcodeValue" Text="{Binding Barcode}" Style="{StaticResource ReadonlyValue}" FontSize="27" FontWeight="Bold" AutomationProperties.Name="本通道完整Item条码"/><TextBlock Text="{Binding ObservationSource}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
     <Grid x:Name="FactGrid" Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <UniformGrid x:Name="Metadata" Columns="3"><StackPanel><TextBlock Text="SKU" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Sku}" Style="{StaticResource ReadonlyValue}" FontSize="15" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="10,0"><TextBlock Text="分拨任务ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TaskId}" Style="{StaticResource ReadonlyValue}" FontSize="15" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="目标格口" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Destination}" Style="{StaticResource ReadonlyValue}" FontSize="23" Foreground="{StaticResource Accent}" FontWeight="Bold"/></StackPanel></UniformGrid>
      <Border x:Name="QuantityPanel" Grid.Row="1" Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Margin="0,6"><UniformGrid Columns="3"><StackPanel Margin="12,6"><TextBlock Text="包装内SKU数量" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PackageValue" Text="{Binding Package}" FontSize="31" FontFamily="Consolas" FontWeight="Bold"/></StackPanel><StackPanel Margin="12,6"><TextBlock Text="剩余需求数量" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="DemandValue" Text="{Binding Remaining}" FontSize="31" FontFamily="Consolas" FontWeight="Bold"/></StackPanel><Border Background="{StaticResource AccentBackground}" Padding="12,6"><StackPanel><TextBlock Text="本次供给 / 保留" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SupplyValue" Text="{Binding Supply}" FontSize="31" FontFamily="Consolas" Foreground="{StaticResource Accent}" FontWeight="Bold"/></StackPanel></Border></UniformGrid></Border>
     </Grid>
     <TextBlock Text="{Binding ItemWave}" FontSize="12" Foreground="{StaticResource Muted}"/>
     <StackPanel Visibility="{Binding SplitVisible,Converter={StaticResource VisibleWhenTrue}}" Margin="0,6"><DockPanel><TextBlock Text="{Binding SplitProgress}" FontWeight="SemiBold"/><TextBlock Text="{Binding Remove}" DockPanel.Dock="Right" Foreground="{StaticResource Warning}"/></DockPanel><ProgressBar Value="{Binding SplitCount}" Maximum="{Binding SplitTarget}" Height="8" Margin="0,5" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding SplitPolicy}" FontSize="12" Foreground="{StaticResource Warning}"/></StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="3" Background="#FBFCFD" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
    <StackPanel>
     <DockPanel Visibility="{Binding SplitVisible,Converter={StaticResource VisibleWhenTrue}}"><Button Content="清空重扫" Click="ClearClick" DockPanel.Dock="Right" IsEnabled="{Binding CanClear}"/><Button Content="计入保留件" Click="ScanClick" DockPanel.Dock="Right" IsEnabled="{Binding CanScan}"/><TextBox Text="{Binding RetainedDraft,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="本通道保留件独立身份" ToolTip="仅Simulation保留件独立身份，不以回调次数计件" KeyDown="RetainedKeyDown"/></DockPanel>
     <DockPanel><Button x:Name="PrimaryAction" Content="{Binding ActionLabel}" Click="PrimaryClick" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsEnabled="{Binding CanPrimary}" MinWidth="150" ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"/><StackPanel><TextBlock Text="{Binding ActionSummary}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding DisabledReason}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Occupancy}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
     <WrapPanel x:Name="SecondaryActions"><Button Content="处置未提交草稿" Click="CancelClick" IsEnabled="{Binding CanCancel}"/><Button Content="作业 / 原请求详情" Click="DetailClick" IsEnabled="{Binding CanDetail}"/></WrapPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Border>
</UserControl>
