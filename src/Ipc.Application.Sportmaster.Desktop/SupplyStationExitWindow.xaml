<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf"
 x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationExitWindow" Title="{DynamicResource Work.Exit}" Width="580" Height="340"
 WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Surface}">
 <Window.Resources>
  <Style x:Key="ExitDialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Margin" Value="0"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="88"/>
   <Setter Property="Padding" Value="16,6"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Frame" CornerRadius="{DynamicResource RadiusControl}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <Border x:Name="KeyboardOutline" Margin="3" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyboardOutline" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style x:Key="ExitCopyableText" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
   <Setter Property="IsTabStop" Value="True"/>
  </Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Surface}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
    <Grid Margin="24,0,8,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ExitHeading" Text="{DynamicResource Work.ExitPrompt}" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}" VerticalAlignment="Center" MouseLeftButtonDown="DragHeader"/>
     <Button x:Name="CancelExitX" Grid.Column="1" MinWidth="44" Width="44" Height="44" Style="{StaticResource ExitDialogButton}" Padding="0" Background="{DynamicResource Surface}" BorderThickness="0" ToolTip="{DynamicResource Work.CancelExit}" AutomationProperties.Name="{DynamicResource Work.CancelExit}" Click="CancelExit">
      <Path Data="M 1,1 L 15,15 M 15,1 L 1,15" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     </Button>
    </Grid>
   </Border>
   <ScrollViewer x:Name="ExitBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,12">
    <StackPanel>
     <TextBox x:Name="ExitDescription" Style="{StaticResource ExitCopyableText}" Text="{DynamicResource Work.ExitScope}" FontSize="{x:Static type:UiTypography.Body}"/>
     <Grid Margin="0,12,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox Style="{StaticResource ExitCopyableText}" Margin="0,0,0,6" Text="{type:LocalizedFormat Work.ExitVisible, ExitVisibleOperationCount}"/>
      <TextBox Grid.Column="2" Style="{StaticResource ExitCopyableText}" Margin="0,0,0,6" Text="{type:LocalizedFormat Work.ExitUnknown, ExitUnknownStageCount}"/>
      <TextBox Grid.Row="1" Style="{StaticResource ExitCopyableText}" Text="{type:LocalizedFormat Work.ExitSnapshot, ExitSnapshotStatus}"/>
      <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource ExitCopyableText}" Text="{type:LocalizedFormat Work.ExitPending, ExitPendingConfiguration}"/>
     </Grid>
     <TextBox Foreground="{DynamicResource Muted}" Style="{StaticResource ExitCopyableText}" Text="{DynamicResource Work.ExitRequests}"/>
     <TextBox Foreground="{DynamicResource Muted}" Style="{StaticResource ExitCopyableText}" Margin="0,4,0,0" Text="{DynamicResource Work.ExitWithDrafts}"/>
     <TextBox Foreground="{DynamicResource Muted}" Style="{StaticResource ExitCopyableText}" Margin="0,12,0,0" Text="{DynamicResource Work.EmergencyNotice}"/>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" Style="{StaticResource OperatorActionFooter}" Padding="24,11">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="CancelExitButton" Content="{DynamicResource Common.Cancel}" IsCancel="True" IsDefault="True" Style="{StaticResource ExitDialogButton}" Click="CancelExit"/>
     <Button x:Name="ContinueExitButton" Content="{DynamicResource Work.ContinueExit}" Margin="12,0,0,0" Background="{DynamicResource Ink}" BorderBrush="{DynamicResource Ink}" Foreground="{DynamicResource Surface}" Style="{StaticResource ExitDialogButton}" Click="ContinueExit"/>
    </StackPanel>
   </Border>
  </Grid>
 </Border>
</Window>
