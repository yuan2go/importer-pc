<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pf="clr-namespace:Ipc.Application.ParcelFlow.Desktop;assembly=Ipc.Application.ParcelFlow.Desktop">
 <pf:ParcelStateTextConverter x:Key="ParcelStateText"/>
 <!-- Native UI derived under explicit user authorization. No HTML, CDN or font binaries. -->
 <SolidColorBrush x:Key="StationBackground" Color="White"/>
 <SolidColorBrush x:Key="StationInk" Color="#202833"/>
 <SolidColorBrush x:Key="StationMuted" Color="#586B80"/>
 <SolidColorBrush x:Key="StationLine" Color="#E1E5EB"/>
 <Style x:Key="StationCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource StationLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="16"/></Style>
 <Style x:Key="StationLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource StationMuted}"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 <Style x:Key="StationValue" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="IsTabStop" Value="True"/><Setter Property="AutomationProperties.Name" Value="只读作业标识，可选择复制"/></Style>
 <Style x:Key="StationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderBrush" Value="{StaticResource StationLine}"/><Setter Property="Foreground" Value="{StaticResource StationInk}"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
 <Style x:Key="StationNavigation" TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="MinHeight" Value="38"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2,0"/></Style>
 <Style x:Key="StationNotice" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
