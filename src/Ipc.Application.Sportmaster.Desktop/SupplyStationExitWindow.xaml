<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf"
 x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationExitWindow" Title="退出供包台" Width="580" Height="340"
 WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Surface}">
 <Window.Resources>
  <Style x:Key="ExitDialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Margin" Value="0"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="88"/>
   <Setter Property="Padding" Value="16,6"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Frame" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <Border x:Name="KeyboardOutline" Margin="3" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyboardOutline" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Surface}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
    <Grid Margin="24,0,8,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ExitHeading" Text="确认退出供包台？" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}" VerticalAlignment="Center" MouseLeftButtonDown="DragHeader"/>
     <Button x:Name="CancelExitX" Grid.Column="1" MinWidth="44" Width="44" Height="44" Style="{StaticResource ExitDialogButton}" Padding="0" Background="{DynamicResource Surface}" BorderThickness="0" ToolTip="取消退出" AutomationProperties.Name="取消退出" Click="CancelExit">
      <Path Data="M 1,1 L 15,15 M 15,1 L 1,15" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     </Button>
    </Grid>
   </Border>
   <ScrollViewer x:Name="ExitBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,12">
    <StackPanel>
     <TextBlock x:Name="ExitDescription" Text="将停止当前供包业务，并关闭所有相关窗口。" FontSize="{x:Static type:UiTypography.Body}"/>
     <Grid Margin="0,12,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock FontSize="{x:Static type:UiTypography.Label}" Margin="0,0,0,6"><Run Text="本次可见作业："/><Run Text="{Binding ExitVisibleOperationCount, Mode=OneTime}"/></TextBlock>
      <TextBlock Grid.Column="2" FontSize="{x:Static type:UiTypography.Label}" Margin="0,0,0,6"><Run Text="结果未知阶段："/><Run Text="{Binding ExitUnknownStageCount, Mode=OneTime}"/></TextBlock>
      <TextBlock Grid.Row="1" FontSize="{x:Static type:UiTypography.Label}"><Run Text="状态读取："/><Run Text="{Binding ExitSnapshotStatus, Mode=OneTime}"/></TextBlock>
      <TextBlock Grid.Row="1" Grid.Column="2" FontSize="{x:Static type:UiTypography.Label}"><Run Text="待生效配置："/><Run Text="{Binding ExitPendingConfiguration, Mode=OneTime}"/></TextBlock>
     </Grid>
     <TextBlock Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}" Text="已发送请求及未确认结果仍保留，请继续核对原记录。"/>
     <TextBlock Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}" Margin="0,4,0,0" Text="下一步逐窗处理未保存设置；停止失败会保留当前窗口。"/>
     <TextBlock Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}" Margin="0,12,0,0" Text="软件暂停不是安全急停，紧急情况请使用现场急停按钮。"/>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,11">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="CancelExitButton" Content="取消" IsCancel="True" IsDefault="True" Style="{StaticResource ExitDialogButton}" Click="CancelExit"/>
     <Button x:Name="ContinueExitButton" Content="继续退出" Margin="12,0,0,0" Background="{DynamicResource Ink}" BorderBrush="{DynamicResource Ink}" Foreground="{DynamicResource Surface}" Style="{StaticResource ExitDialogButton}" Click="ContinueExit"/>
    </StackPanel>
   </Border>
  </Grid>
 </Border>
</Window>
