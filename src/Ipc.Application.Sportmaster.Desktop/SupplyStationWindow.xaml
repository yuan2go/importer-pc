<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:parameters="clr-namespace:Ipc.Application.ParcelFlow.Desktop;assembly=Ipc.Application.ParcelFlow.Desktop" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop" x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationWindow" Title="菜鸟供包台" Width="1600" Height="900" MinWidth="640" MinHeight="420" Background="{DynamicResource StationBackground}" UseLayoutRounding="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid x:Name="ClientArea" Background="{StaticResource StationBackground}">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Grid.Resources>
   <Style x:Key="FullScreenWindowAction" TargetType="Button" BasedOn="{StaticResource StationNavigation}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers><DataTrigger Binding="{Binding Path=(parameters:WindowOpeningPreference.IsFullScreen), RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
   </Style>
   <Style x:Key="StationIconNavigation" TargetType="Button" BasedOn="{StaticResource StationNavigation}">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="84"/>
    <Setter Property="ContentTemplate">
     <Setter.Value>
      <DataTemplate>
       <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" HorizontalAlignment="Center" IsHitTestVisible="False"><Path.Style><Style TargetType="Path"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
        <TextBlock Text="{Binding}" Margin="0,6,0,0" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel>
      </DataTemplate>
     </Setter.Value>
    </Setter>
    <Style.Triggers><DataTrigger Binding="{Binding IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Width" Value="44"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers>
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border x:Name="TimeHeader" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,0,1">
   <Border.Style>
    <Style TargetType="Border">
     <Setter Property="Padding" Value="16,4"/><Setter Property="MinHeight" Value="52"/>
     <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="16,0"/><Setter Property="MinHeight" Value="28"/></DataTrigger></Style.Triggers>
    </Style>
   </Border.Style>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StationClock" Grid.Column="1" FontSize="{x:Static type:UiTypography.Body}" Foreground="{DynamicResource Ink}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="本机时间"/>
    <Button x:Name="MinimizeFullScreen" Grid.Column="2" Click="MinimizeFullScreen_Click" HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="44" MinHeight="44" Style="{StaticResource FullScreenWindowAction}" ToolTip="最小化到任务栏" AutomationProperties.Name="最小化到任务栏">
     <Path Data="M 3,10 L 17,10" Stroke="{DynamicResource Ink}" StrokeThickness="1.7" Width="20" Height="20"/>
    </Button>
    <Button x:Name="ExitFullScreen" Grid.Column="3" Click="ExitFullScreen_Click" Margin="4,0,0,0" MinWidth="44" MinHeight="44" Style="{StaticResource FullScreenWindowAction}" ToolTip="退出供包台" AutomationProperties.Name="退出供包台">
     <Path Data="M 4,4 L 16,16 M 16,4 L 4,16" Stroke="{DynamicResource Ink}" StrokeThickness="1.7" Width="20" Height="20"/>
    </Button>
   </Grid>
  </Border>
  <Border x:Name="DailyNavigation" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Surface}" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,1,0">
   <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="120"/><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Width" Value="52"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel LastChildFill="True">
    <DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Margin" Value="8,12,8,8"/><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Margin" Value="4,8,4,4"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
    <StackPanel DockPanel.Dock="Bottom">
     <Button x:Name="OperatorAccess" Content="操作员" Click="OperatorLogin_Click" Visibility="{Binding LoginVisibility}" Style="{StaticResource StationIconNavigation}" Tag="M 8,6 A 4,4 0 1 0 16,6 A 4,4 0 1 0 8,6 M 3,22 L 3,19 C 3,12 21,12 21,19 L 21,22" ToolTip="操作员身份" AutomationProperties.Name="操作员身份"/>
     <Button x:Name="ManagementCenterEntry" Content="管理中心" Click="ManagementMode_Click" Style="{StaticResource StationIconNavigation}" Tag="M 10,2 L 14,2 14.6,5 16.4,6 19.3,5 21.3,8.5 19,10.5 19,13.5 21.3,15.5 19.3,19 16.4,18 14.6,19 14,22 10,22 9.4,19 7.6,18 4.7,19 2.7,15.5 5,13.5 5,10.5 2.7,8.5 4.7,5 7.6,6 9.4,5 Z M 16,12 A 4,4 0 1 1 8,12 A 4,4 0 1 1 16,12" ToolTip="管理中心（需要管理密码）" AutomationProperties.Name="管理中心，需要管理密码"/>
    </StackPanel>
    <StackPanel>
     <Button Tag="M 3,6 L 12,2 21,6 21,18 12,22 3,18 Z M 3,6 L 12,10 21,6 M 12,10 L 12,22 M 7.5,4 L 16.5,8 16.5,12" Content="作业" Click="Workstation_Click" Margin="0,0,0,8" ToolTip="作业" AutomationProperties.Name="作业">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="workstation"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
     <Button Tag="M 8,4 L 4,4 4,22 20,22 20,4 16,4 M 8,2 L 16,2 16,6 8,6 Z M 8,11 L 9,11 M 12,11 L 17,11 M 8,16 L 9,16 M 12,16 L 17,16" Content="记录" Click="History_Click" Margin="0,0,0,8" ToolTip="记录" AutomationProperties.Name="记录">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="history"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
    </StackPanel>
   </DockPanel>
  </Border>
  <Button x:Name="NavigationToggle" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="10" Click="NavigationToggle_Click" Content="收起菜单" ToolTip="收起菜单" AutomationProperties.Name="收起菜单" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-12,0" Width="44" Height="44" MinWidth="44" MinHeight="44" FocusVisualStyle="{x:Null}" Cursor="Hand">
   <Button.Template>
    <ControlTemplate TargetType="Button">
     <Grid Background="Transparent">
      <Border x:Name="NavigationHandle" Width="18" Height="36" CornerRadius="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
       <Path x:Name="NavigationChevron" Data="M 9,3 L 3,9 L 9,15" Width="8" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Ink}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Border>
     </Grid>
     <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter TargetName="NavigationChevron" Property="Data" Value="M 3,3 L 9,9 L 3,15"/></DataTrigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationHandle" Property="Background" Value="{DynamicResource Soft}"/><Setter TargetName="NavigationHandle" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavigationHandle" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Button.Template>
  </Button>
  <Grid Grid.Row="2" Grid.Column="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <StackPanel>
    <Border x:Name="PendingConfigurationBanner" Padding="16,6" Background="{StaticResource AccentBackground}">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasConfigurationActivationNotice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCompact}" Value="True"/><Condition Binding="{Binding SelectedPage}" Value="workstation"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel><Button x:Name="ActivationOutcomeAction" Content="{Binding ConfigurationActivationActionText}" Click="ProductRestart_Click" IsEnabled="{Binding CanOpenConfigurationActivation}" DockPanel.Dock="Right" MinHeight="44"/><TextBlock Text="{Binding ConfigurationActivationBannerText}" ToolTip="{Binding ConfigurationActivationOutcome}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    </Border>
    <Border Padding="8,4" Background="{DynamicResource AccentBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,4">
     <Border.Style>
      <Style TargetType="Border">
       <Style.Triggers>
        <DataTrigger Binding="{Binding HasGlobalOperationFeedback}" Value="False">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding GlobalReceiptCommitted}" Value="True"/>
          <Condition Binding="{Binding IsTight}" Value="True"/>
          <Condition Binding="{Binding SelectedPage}" Value="workstation"/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <DockPanel>
      <Button Content="关闭提示" Click="DismissGlobalFeedback_Click" DockPanel.Dock="Right" MinHeight="44" Padding="8,4" FontSize="{x:Static type:UiTypography.Body}" Margin="8,0,0,0"/>
      <TextBox x:Name="GlobalOperationFeedback" MinHeight="0" Padding="0" VerticalAlignment="Center" Text="{Binding GlobalOperationFeedback,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" MaxHeight="44" VerticalScrollBarVisibility="Auto" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="最近一次操作结果，可选择复制" AutomationProperties.LiveSetting="Assertive"/>
     </DockPanel>
    </Border>
    <Border x:Name="OperationalStatusBar" Background="{Binding WorkspaceStatusBackground}" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,0,1">
     <Border.Style>
      <Style TargetType="Border">
       <Setter Property="Padding" Value="16,4"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedPage}" Value="maintenance"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding SelectedPage}" Value="history">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SelectedPage}" Value="diagnostics">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SelectedPage}" Value="debug">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsTight}" Value="True">
         <Setter Property="Padding" Value="16,0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
         <Setter Property="Padding" Value="20,6"/>
        </DataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding SelectedPage}" Value="maintenance"/>
          <Condition Binding="{Binding WorkFeedback}" Value=""/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding SelectedPage}" Value="logs"/>
          <Condition Binding="{Binding HasOperationalAttention}" Value="False"/>
          <Condition Binding="{Binding WorkFeedback}" Value=""/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="SupplyStatusLine" MinHeight="36">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="ResumeSupply" Grid.Column="4" Content="恢复供包" Click="ResumeSupply_Click" Visibility="{Binding ResumeVisibility}" IsEnabled="{Binding CanResumeInViewport}" MinHeight="44" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource StationButton}" ToolTip="核对当前供包条件后恢复；未确认的原请求仍须核对，不会重新发送。"/>
       <ScrollViewer x:Name="StatusDiagnostics" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" MaxHeight="40" VerticalAlignment="Center">
        <DockPanel LastChildFill="True">
         <TextBlock x:Name="WorkStatus" DockPanel.Dock="Left" Text="{Binding OperatorStatus}" ToolTip="{Binding OperatorStatus}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0" FontSize="{x:Static type:UiTypography.Body}" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{Binding WorkspaceStatusForeground}" VerticalAlignment="Center"/>
         <TextBlock x:Name="SettingsRunMode" DockPanel.Dock="Left" Text="{Binding SettingsRunMode}" FontSize="{x:Static type:UiTypography.Label}" Margin="0,0,16,0" Foreground="{StaticResource StationMuted}" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
         <TextBlock x:Name="ActiveBlockingReasons" Text="{Binding OperatorNotice}" ToolTip="{Binding OperatorNotice}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="{x:Static type:UiTypography.Label}" Foreground="{Binding WorkspaceStatusForeground}" VerticalAlignment="Center" AutomationProperties.Name="暂不能供包的原因"/>
        </DockPanel>
       </ScrollViewer>
       <Button x:Name="CompactActivationAction" Grid.Column="1" Content="{Binding ConfigurationActivationCompactText}" Click="ProductRestart_Click" IsEnabled="{Binding CanOpenConfigurationActivation}" MinHeight="44" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ConfigurationActivationOutcome}">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasConfigurationActivationNotice}" Value="True"/><Condition Binding="{Binding IsCompact}" Value="True"/><Condition Binding="{Binding SelectedPage}" Value="workstation"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
       </Button>
       <Border x:Name="PaceSummary" Grid.Column="2" Visibility="{Binding PaceVisibility}" Margin="12,0,0,0" VerticalAlignment="Center" Focusable="False">
        <TextBlock x:Name="PaceBadge" AutomationProperties.Name="{Binding PaceText}" FontSize="{x:Static type:UiTypography.Label}" TextWrapping="NoWrap" ToolTip="{Binding PaceText}">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding PaceText}"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Text" Value="{Binding PaceCompact}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Border>
       <Button x:Name="RcsConnection" Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0"
               Content="{Binding RcsButtonText}" Click="RcsConnection_Click" IsEnabled="{Binding CanCheckRcs}"
               Background="{Binding RcsPresentation.Background}" BorderBrush="{Binding RcsPresentation.Border}"
               Foreground="{Binding RcsPresentation.Foreground}" FontSize="{x:Static type:UiTypography.Label}" Padding="10,6"
               AutomationProperties.Name="检查 RCS 心跳" AutomationProperties.ItemStatus="{Binding RcsButtonText}"
               ToolTip="点击发送一次 RCS 心跳。每件包裹以本件返回的格口为准。">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
       </Button>
      </Grid>
      <Border x:Name="OperationalFeedbackBar" Grid.Row="1">
       <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding WorkFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="40">
        <TextBlock x:Name="OperationFeedback" Text="{Binding WorkFeedback}" ToolTip="{Binding WorkFeedback}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.LiveSetting="Polite"/>
       </ScrollViewer>
      </Border>
     </Grid>
    </Border>
   </StackPanel>
   <ContentControl x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding ViewportReady}">
    <ContentControl.Style>
     <Style TargetType="ContentControl">
      <Setter Property="Margin" Value="8"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsCompact}" Value="True">
        <Setter Property="Margin" Value="4"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
        <Setter Property="Margin" Value="0"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </ContentControl.Style>
   </ContentControl>
  </Grid>
  <Border x:Name="WorkstationFooter" Grid.Row="3" Grid.ColumnSpan="2" Padding="16,4" Background="White">
   <Border.Style>
    <Style TargetType="Border">
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsTight}" Value="True">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Border.Style>
   <TextBlock Text="{Binding EnvironmentStatus}" Foreground="{StaticResource StationMuted}" FontSize="{x:Static type:UiTypography.Label}" TextTrimming="CharacterEllipsis"/>
  </Border>
  <Border x:Name="ViewportWarning" Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="{StaticResource StationBackground}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24" Visibility="{Binding ViewportWarningVisibility}">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="{Binding ViewportStatus}" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/>
     <TextBlock Text="窗口太小，无法完整显示作业信息（至少需要 800 × 420）。请最大化窗口；相机和当前任务不受影响。" FontSize="{x:Static type:UiTypography.Body}" Margin="0,16"/>
     <TextBlock Text="{Binding Status}"/>
     <TextBlock Text="{Binding Message}"/>
     <TextBlock Text="{Binding ReadStatus}" Margin="0,12"/>
     <WrapPanel Margin="0,16">
      <Button Content="最大化窗口" Click="Maximize_Click" Style="{StaticResource StationButton}"/>
     </WrapPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</Window>
