<Window x:Class="Ipc.Application.Sportmaster.Desktop.StationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf"
        Title="供包台设置" Width="1220" Height="800" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="{x:Static type:UiTypography.Interface}" FontSize="{x:Static type:UiTypography.Body}" FontWeight="{x:Static type:UiTypography.Regular}"
        Background="{DynamicResource Background}">
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="SettingsSummaryCard" TargetType="Border" BasedOn="{StaticResource CommercialCard}">
   <Setter Property="Padding" Value="16,14"/>
  </Style>
  <Style x:Key="SettingsSummaryHeading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Position}"/>
   <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
  </Style>
  <Style x:Key="SettingsSummaryDivider" TargetType="Border">
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Padding" Value="0,0,0,8"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="SettingsSummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
   <Setter Property="Margin" Value="0,4,0,2"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <DataTemplate x:Key="SettingsCameraCard">
   <Border Style="{StaticResource SettingsSummaryCard}">
    <StackPanel>
     <Border Style="{StaticResource SettingsSummaryDivider}">
      <DockPanel>
       <Border DockPanel.Dock="Right" Background="{Binding DevicePresentation.Background}" BorderBrush="{Binding DevicePresentation.Border}"
               BorderThickness="1" CornerRadius="{DynamicResource RadiusBadge}" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding DevicePresentation.Text}" Foreground="{Binding DevicePresentation.Foreground}"
                   FontSize="{x:Static type:UiTypography.Label}" MaxWidth="180" TextWrapping="Wrap"/>
       </Border>
       <TextBlock TextWrapping="Wrap">
        <TextBlock.Style>
         <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsSummaryHeading}">
          <Setter Property="Text" Value="左相机"/>
          <Style.Triggers><DataTrigger Binding="{Binding PositionId}" Value="right"><Setter Property="Text" Value="右相机"/></DataTrigger></Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
      </DockPanel>
     </Border>
     <TextBlock Text="投递位状态" Style="{StaticResource SettingsSummaryLabel}"/>
     <TextBlock Text="{Binding SupplyStateText}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </DataTemplate>
 </ResourceDictionary></Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource GlobalHeaderBar}" MinHeight="60" Padding="20,8">
   <DockPanel>
    <Button x:Name="AuthorizeEdit" DockPanel.Dock="Right" Content="授权编辑" Click="AuthorizeEdit_Click" ToolTip="验证管理密码后编辑本站设置" AutomationProperties.Name="授权编辑本站设置"
            VerticalAlignment="Center" Margin="12,0,0,0"/>
    <ContentControl DockPanel.Dock="Right" Style="{StaticResource PreferenceNoticeHost}" VerticalAlignment="Center"/>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="供包台设置" Style="{StaticResource PageTitleText}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
     <Border Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource RadiusBadge}"
             Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
       <Ellipse Width="7" Height="7" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <TextBlock x:Name="HeaderStatus" Text="只读查看 · 不暂停供包" Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}"/>
      </StackPanel>
     </Border>
    </WrapPanel>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Style="{StaticResource OperatorActionFooter}" Height="64" Padding="20,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="ReviewSettings" Content="查看修改" Click="Review_Click" Visibility="Collapsed" IsEnabled="{Binding CanStartOperation}" Margin="0,0,8,0"/>
     <Button Content="关闭设置" Click="Close_Click" Margin="0,0,8,0"/>
     <Button Content="返回作业" Click="Return_Click" Background="{DynamicResource AccentBackground}" BorderBrush="{DynamicResource AccentBorder}" Foreground="{DynamicResource Accent}"/>
     <Button x:Name="SaveSettings" Content="{Binding ConfigurationSaveActionText}" Click="Save_Click" Visibility="Collapsed" IsEnabled="{Binding CanReviewConfiguration}" Style="{StaticResource Primary}" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="FooterStatus" Text="只读模式" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Top" x:Name="AuthorizationFeedback" Visibility="Collapsed" Padding="20,6" Background="{DynamicResource Soft}">
   <TextBlock x:Name="AuthorizationFeedbackText" Text="暂时无法进入编辑，请重试或检查管理授权服务。" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <Grid>
   <DockPanel x:Name="EditSurface" Visibility="Collapsed">
    <TextBox DockPanel.Dock="Top" Text="{Binding WorkFeedback,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="72" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="设置操作结果">
     <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource OperatorCopyableNotice}">
      <Setter Property="Margin" Value="20,4"/>
      <Style.Triggers><DataTrigger Binding="{Binding WorkFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
     </Style></TextBox.Style>
    </TextBox>
    <ContentControl x:Name="EditHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </DockPanel>
   <ScrollViewer x:Name="ReadOnlyOverview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="20,16">
    <Border Style="{StaticResource SettingsSummaryCard}" Margin="0,0,0,12">
     <StackPanel>
      <Border Style="{StaticResource SettingsSummaryDivider}">
       <DockPanel>
        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Text" Value="{Binding Snapshot.Configuration.Revision, StringFormat='修订 {0}', FallbackValue='修订待确认'}"/>
           <Style.Triggers><DataTrigger Binding="{Binding Fresh}" Value="False"><Setter Property="Text" Value="修订待确认"/></DataTrigger></Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="本站与 RCS" Style="{StaticResource SettingsSummaryHeading}"/>
       </DockPanel>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0">
        <TextBlock Text="供包台编码" Style="{StaticResource SettingsSummaryLabel}"/>
        <TextBox Text="{Binding Snapshot.Configuration.Effective.StationCode,Mode=OneWay,FallbackValue=待确认}" Style="{StaticResource ReadonlyValue}" IsTabStop="True" AutomationProperties.Name="供包台编码"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,12,0">
        <TextBlock Text="RCS 连接" Style="{StaticResource SettingsSummaryLabel}"/>
        <TextBlock Text="{Binding RcsPresentation.Text}" Foreground="{Binding RcsPresentation.Foreground}" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="配置状态" Style="{StaticResource SettingsSummaryLabel}"/>
        <TextBlock TextWrapping="Wrap">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Text" Value="待确认"/>
           <Style.Triggers>
            <MultiDataTrigger>
             <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Fresh}" Value="True"/>
              <Condition Binding="{Binding Snapshot.HasPendingConfiguration}" Value="True"/>
             </MultiDataTrigger.Conditions>
             <Setter Property="Text" Value="有待生效设置"/>
             <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
             <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Fresh}" Value="True"/>
              <Condition Binding="{Binding Snapshot.HasPendingConfiguration}" Value="False"/>
             </MultiDataTrigger.Conditions>
             <Setter Property="Text" Value="无待生效设置"/>
            </MultiDataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </Grid>
     </StackPanel>
    </Border>
    <Grid Margin="0,0,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource SettingsCameraCard}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <ContentControl Grid.Column="2" Content="{Binding Right}" ContentTemplate="{StaticResource SettingsCameraCard}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
    <Border Style="{StaticResource SettingsSummaryCard}">
     <StackPanel>
      <Border Style="{StaticResource SettingsSummaryDivider}">
       <TextBlock Text="本机显示与提示音偏好" Style="{StaticResource SettingsSummaryHeading}"/>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0">
        <TextBlock Text="默认打开方式" Style="{StaticResource SettingsSummaryLabel}"/>
        <TextBlock x:Name="OpeningModeValue" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,12,0">
        <TextBlock Text="效率显示" Style="{StaticResource SettingsSummaryLabel}"/>
        <TextBlock x:Name="ShowPaceValue" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="提示音音量" Style="{StaticResource SettingsSummaryLabel}"/>
        <TextBlock x:Name="CueVolumeValue" TextWrapping="Wrap"/>
       </StackPanel>
      </Grid>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
