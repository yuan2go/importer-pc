<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.MaintenancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="设备与能力维护" FontSize="21" FontWeight="Bold"/><TextBlock Text="安装、启用、业务绑定与运行健康分别管理。先暂停并认证维护；保存只形成待重启修订，旧件参数不变。" TextWrapping="Wrap"/>
   <WrapPanel><TextBox Text="{Binding MaintenanceSubject}" Width="150"/><PasswordBox x:Name="MaintenanceProof" Width="150"/><Button Content="认证维护权限" Click="Authorize_Click" IsEnabled="{Binding Fresh}"/><Button Content="重新读取并替换本窗草稿" Click="Load_Click"/><Button Content="保存表单待重启修订" Click="Save_Click" IsEnabled="{Binding CanConfigure}"/><Button Content="受控重连" Click="Reconnect_Click" IsEnabled="{Binding Fresh}"/></WrapPanel>
   <DockPanel><TextBlock Text="维护变更原因" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBox Text="{Binding ConfigurationReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="校验不保存；保存必须记录维护原因"/></DockPanel>
  </StackPanel>
  <TabControl Grid.Row="1" Margin="0,12">
   <TabItem Header="结构化拓扑与策略"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" IsEnabled="{Binding CanEditStructuredConfiguration}">
    <TextBlock Text="{Binding ConfigurationEditorState}" TextWrapping="Wrap"/><TextBlock Text="读码来源和投递位保持完整。稳定设备身份只读；可选能力在库存中新增，再选择角色或本位绑定。表单与高级JSON须显式切换编辑来源。" TextWrapping="Wrap" Margin="0,8"/>
    <WrapPanel><Button Content="校验表单完整候选（不保存）" Click="ValidateStructured_Click"/><Button Content="表单生成高级JSON并切换" Click="Advanced_Click"/></WrapPanel>
    <TextBlock Text="全部读码来源 · 选择一行查看原安装模块的参数" FontWeight="Bold" Margin="0,12,0,4"/>
    <DataGrid x:Name="ReaderInstances" ItemsSource="{Binding ReaderDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="100" MaxHeight="220" RowHeight="44" SelectionChanged="Reader_Changed"><DataGrid.Columns>
     <DataGridTextColumn Header="稳定设备ID" Binding="{Binding Original.DeviceId}" IsReadOnly="True" Width="*"/>
     <DataGridTextColumn Header="原角色" Binding="{Binding Original.Role}" IsReadOnly="True" Width="150"/>
     <DataGridTemplateColumn Header="已安装提供者" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Capability.Providers}" SelectedItem="{Binding Capability.Provider,UpdateSourceTrigger=PropertyChanged}" ToolTip="提供者必须匹配版本、模块及安装清单SHA256"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Implementation}"/><Run Text=" @ "/><Run Text="{Binding Version}"/><Run Text=" · "/><Run Text="{Binding Module}"/><Run Text=" · "/><Run Text="{Binding Package.ManifestSha256}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="实例身份" Binding="{Binding Capability.InstanceId,UpdateSourceTrigger=PropertyChanged}" Width="180"/>
    </DataGrid.Columns></DataGrid><StackPanel x:Name="ReaderParameterForm"/>
    <TextBlock Text="全部投递位 · 空绑定沿用已显示的默认秤/相机" FontWeight="Bold" Margin="0,12,0,4"/>
    <DataGrid ItemsSource="{Binding PositionDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44" MaxHeight="240"><DataGrid.Columns>
     <DataGridTextColumn Header="投递位" Binding="{Binding Id}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="稳定读码来源" Binding="{Binding ReaderDeviceId}" IsReadOnly="True" Width="*"/>
     <DataGridTemplateColumn Header="本位秤" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="本位相机" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid>
    <TextBlock Text="Application角色绑定 · 仅显示已安装能力库存；安装和绑定不代表已生效" FontWeight="Bold" Margin="0,12,0,4"/>
    <ItemsControl ItemsSource="{Binding ConfigurationRoles}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><TextBlock Text="{Binding Role}" Width="140" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selection,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" MinHeight="44"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="全局重量策略 · 配置重量与实测不同；协议要求实测时配置补全拒绝" FontWeight="Bold" Margin="0,16,0,4"/>
    <WrapPanel><ComboBox ItemsSource="{Binding WeightSources}" SelectedItem="{Binding StructuredPolicy.WeightSource}" Width="170"/><ComboBox ItemsSource="{Binding WeightUnits}" SelectedItem="{Binding StructuredPolicy.Unit}" Width="90"/><TextBlock Text="精度(0～6)"/><TextBox Text="{Binding StructuredPolicy.Precision,UpdateSourceTrigger=PropertyChanged}" Width="80"/><TextBlock Text="配置重量(所选kg/g)"/><TextBox Text="{Binding StructuredPolicy.ConfiguredWeight,UpdateSourceTrigger=PropertyChanged}" Width="120"/></WrapPanel>
    <WrapPanel><TextBlock Text="本件等待(ms)"/><TextBox Text="{Binding StructuredPolicy.WaitTimeoutMs,UpdateSourceTrigger=PropertyChanged}" Width="120"/><TextBlock Text="测量新鲜度(ms)"/><TextBox Text="{Binding StructuredPolicy.MaximumAgeMs,UpdateSourceTrigger=PropertyChanged}" Width="120"/><ComboBox ItemsSource="{Binding WeightValidities}" SelectedItem="{Binding StructuredPolicy.Validity}" Width="200"/></WrapPanel>
    <TextBlock Text="图片策略仅用于已选装图像能力的Application；不因本表单为Sportmaster新增图片需求" TextWrapping="Wrap" Margin="0,12,0,4"/>
    <WrapPanel><ComboBox ItemsSource="{Binding UploadStrategies}" SelectedItem="{Binding StructuredPolicy.UploadStrategy}" Width="170"/><TextBlock Text="单件最大字节"/><TextBox Text="{Binding StructuredPolicy.ImageBytes,UpdateSourceTrigger=PropertyChanged}" Width="120"/><TextBlock Text="缓存总字节"/><TextBox Text="{Binding StructuredPolicy.TotalBytes,UpdateSourceTrigger=PropertyChanged}" Width="140"/><TextBlock Text="待处理件数"/><TextBox Text="{Binding StructuredPolicy.MaximumPending,UpdateSourceTrigger=PropertyChanged}" Width="90"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="完整候选配置（高级）"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="完整修订包含全部设备、投递位和能力库存。校验不保存；保存形成Pending，受控重启且原责任清偿后生效。" TextWrapping="Wrap"/><TextBlock Text="{Binding ConfigurationEditorState}" TextWrapping="Wrap"/><TextBox Text="{Binding ConfigurationReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="必须填写维护变更原因"/><WrapPanel><Button Content="显式切换高级JSON编辑" Click="Advanced_Click"/><Button Content="将当前高级JSON加载到表单" Click="StructuredFromJson_Click"/><Button Content="校验完整候选" Click="ValidateFull_Click"/><Button Content="保存完整待重启修订" Click="SaveFull_Click" IsEnabled="{Binding CanConfigure}"/></WrapPanel></StackPanel><TextBox Text="{Binding ConfigurationDraft,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AdvancedConfigurationReadOnly}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel></TabItem>
   <TabItem Header="运行输入 / 待重启"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <GroupBox Header="{Binding EffectiveConfigurationHeading}"><TextBox Text="{Binding EffectiveConfiguration}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></GroupBox>
    <GroupBox Grid.Column="1" Header="已保存 Pending"><TextBox Text="{Binding PendingConfiguration}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></GroupBox></Grid>
    <GroupBox Grid.Row="1" Header="旧配置账核对" Margin="0,12,0,0"><DockPanel Margin="8">
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="旧账中的Effective不代表资源曾成功启动。先读取原记录、原字节SHA256和当前运行输入；暂停并认证维护后说明核对结论。确认后仍保持软件暂停。" TextWrapping="Wrap"/><TextBlock Text="{Binding ConfigurationConfirmationState}" TextWrapping="Wrap"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="维护核对说明"/><TextBox Text="{Binding ConfigurationConfirmationReason,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="44" MaxHeight="100" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><WrapPanel><Button Content="读取待确认原账" Click="ConfirmationLoad_Click" MinHeight="44"/><Button Content="确认已核对当前运行输入" Click="ConfirmationSave_Click" MinHeight="44" IsEnabled="{Binding CanConfirmConfiguration}"/></WrapPanel></StackPanel>
     <TextBox Text="{Binding ConfigurationConfirmationEvidence}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </DockPanel></GroupBox></Grid></TabItem>
   <TabItem Header="已安装模块参数"><TextBox Text="{Binding InstalledProviderParameters}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></TabItem>
   <TabItem Header="能力库存与参数"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel IsEnabled="{Binding CanEditStructuredConfiguration}"><ComboBox ItemsSource="{Binding NewCapabilityKinds}" SelectedItem="{Binding NewCapabilityKind}" Width="180"/><Button Content="新增未绑定能力实例" Click="AddInstance_Click"/><Button Content="移除所选未绑定实例" Click="RemoveInstance_Click"/></WrapPanel>
    <DataGrid Grid.Row="1" IsEnabled="{Binding CanEditFormConfiguration}" x:Name="Instances" ItemsSource="{Binding CapabilityDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44" SelectionChanged="Instance_Changed"><DataGrid.Columns>
     <DataGridTextColumn Header="能力" Binding="{Binding Role}" IsReadOnly="True" Width="110"/>
     <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled,UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTemplateColumn Header="旧版绑定"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Bound,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LegacyBindingEditable}" ToolTip="schema3在拓扑与角色中绑定"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="已安装提供者" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider,UpdateSourceTrigger=PropertyChanged}" ToolTip="提供者必须匹配版本、模块及安装清单SHA256"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Implementation}"/><Run Text=" @ "/><Run Text="{Binding Version}"/><Run Text=" · "/><Run Text="{Binding Module}"/><Run Text=" · "/><Run Text="{Binding Package.ManifestSha256}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="实例身份" Binding="{Binding InstanceId,UpdateSourceTrigger=PropertyChanged}" Width="150"/>
     <DataGridTemplateColumn Header="协议目标 / 读码身份" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsTargetReadOnly}" ToolTip="{Binding TargetBoundary}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="合同版本" Binding="{Binding Contract,UpdateSourceTrigger=PropertyChanged}" Width="180"/>
    </DataGrid.Columns></DataGrid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterForm" Margin="8" IsEnabled="{Binding CanEditFormConfiguration}"/></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="旧schema1/2策略"><ScrollViewer><StackPanel Margin="16" IsEnabled="{Binding CanEditLegacyConfiguration}">
    <TextBlock Text="称重来源 · 配置补全与实测不同；协议强制实测时配置补全拒绝"/><WrapPanel><ComboBox ItemsSource="{Binding WeightSources}" SelectedItem="{Binding DraftWeightSource}" Width="170"/><ComboBox ItemsSource="{Binding WeightUnits}" SelectedItem="{Binding DraftUnit}" Width="90"/><TextBlock Text="精度"/><TextBox Text="{Binding DraftPrecision}" Width="80"/><TextBlock Text="配置值"/><TextBox Text="{Binding DraftConfiguredWeight}" Width="100"/></WrapPanel>
    <WrapPanel><TextBlock Text="本件等待期限(ms)"/><TextBox Text="{Binding DraftWaitMs}" Width="120"/><TextBlock Text="测量新鲜度(ms)"/><TextBox Text="{Binding DraftFreshMs}" Width="120"/></WrapPanel>
    <TextBlock Text="重量有效期：UntilDispatch持续到提交，AtAssociation仅关联时新鲜；真实现场须有资格证据" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding WeightValidities}" SelectedItem="{Binding DraftWeightValidity}" Width="240" HorizontalAlignment="Left"/>
    <TextBlock Text="图片上传 · BeforeMain前置成功后进入主链 / Attached独立恢复" Margin="0,16,0,8"/><ComboBox ItemsSource="{Binding UploadStrategies}" SelectedItem="{Binding DraftUploadStrategy}" Width="240" HorizontalAlignment="Left"/>
    <WrapPanel><TextBlock Text="单件最大字节"/><TextBox Text="{Binding DraftImageBytes}" Width="120"/><TextBlock Text="缓存总字节"/><TextBox Text="{Binding DraftTotalBytes}" Width="120"/><TextBlock Text="待处理件数"/><TextBox Text="{Binding DraftPending}" Width="100"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="安装管理"><StackPanel Margin="16"><TextBlock Text="{Binding InstalledPackages}" TextWrapping="Wrap"/><TextBlock Text="离线签名包路径（Windows由受保护提权帮助程序安装后刷新）"/><TextBox Text="{Binding PackagePath,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="原包 SHA256"/><TextBox Text="{Binding PackageSha256,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/><Button Content="验证签名并安装" Click="Install_Click" IsEnabled="{Binding Fresh}" HorizontalAlignment="Left"/><TextBlock Text="安全卸载 · 从实际安装目录返回的精确包身份选择；仍被配置、原件、备份或资源引用时原Store拒绝。" TextWrapping="Wrap" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding InstalledPackageReferences}" SelectedItem="{Binding SelectedInstalledPackage}" MinHeight="44"/><Button Content="安全卸载所选精确包" Click="Uninstall_Click" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Left"/><Expander Header="高级：按原安装操作ID恢复" Margin="0,12,0,0"><StackPanel><TextBlock Text="当前Application没有安装日志枚举接口。仅从原安装日志复制确切操作ID；不猜测身份，也不把业务Unknown当安装恢复。" TextWrapping="Wrap"/><TextBox Text="{Binding OriginalRecoveryOperationId,UpdateSourceTrigger=PropertyChanged}"/><Button Content="恢复原安装操作" Click="RecoverInstall_Click" IsEnabled="{Binding CanConfigure}"/></StackPanel></Expander></StackPanel></TabItem>
   <TabItem Header="异常与恢复"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="先在记录中选择原作业；未知只查询，不重发。处置仅限无未知外部责任且PLC尚未尝试；原WCS接受及原意图保留。" TextWrapping="Wrap"/><TextBlock Text="{Binding HistoryCommandTarget}" TextWrapping="Wrap"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="已检查并移除实体的处置说明"/><WrapPanel><Button Content="继续未尝试附加上传" Click="Upload_Click" IsEnabled="{Binding CanContinueUpload}"/><Button Content="检查后取消未发送意图" Click="Abandon_Click" IsEnabled="{Binding CanAbandon}"/><Button Content="确认已检查过载现场" Click="Overload_Click" IsEnabled="{Binding Fresh}"/><Button Content="受控归档已清偿原件" Click="Archive_Click" IsEnabled="{Binding Fresh}"/><TextBox Text="{Binding IdentityConflictId,UpdateSourceTrigger=PropertyChanged}" Width="230" ToolTip="阻断投影中的原身份冲突ID"/><Button Content="确认已检查身份冲突" Click="Identity_Click" IsEnabled="{Binding Fresh}"/></WrapPanel><TextBlock Text="原接收发生：读取后选择确切ID。暂停并认证维护；只按原Query核对结果，保留旧缺raw证据，不重发。RawDurable原件缺失仍隔离。" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBox Text="{Binding ReceiptOccurrenceId,UpdateSourceTrigger=PropertyChanged}" ToolTip="原Awaiting发生ID"/><WrapPanel><Button Content="读取所选作业接收责任" Click="Receipts_Click" IsEnabled="{Binding Fresh}"/><Button Content="核对原缺回执结果" Click="ReceiptQuery_Click" IsEnabled="{Binding CanConfigure}"/></WrapPanel><TextBox Text="{Binding ReceiptInventory}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Content="创建一致备份" Click="Backup_Click" IsEnabled="{Binding Fresh}"/><TextBox Text="{Binding BackupPath,UpdateSourceTrigger=PropertyChanged}" ToolTip="新备份完整路径；已有文件拒绝覆盖"/></DockPanel>
 </Grid>
</UserControl>
