<UserControl x:Class="Ipc.Application.Sportmaster.Desktop.Workstation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ItemsControl ItemsSource="{Binding PositionRows}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Border BorderBrush="{Binding StatusBorder}" Background="{StaticResource Surface}" BorderThickness="1" Padding="8" Margin="6,4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="16" FontWeight="Bold"><Run Text="{Binding Id}"/><Run Text=" · "/><Run Text="{Binding DeviceId}"/></TextBlock>
    <Border Grid.Row="1" Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" Padding="4" Margin="0,4"><StackPanel><TextBlock Foreground="{Binding StatusForeground}" FontWeight="Bold" TextWrapping="Wrap"><Run Text="{Binding StatusIcon}"/><Run Text=" "/><Run Text="{Binding State}"/></TextBlock><TextBlock Tag="RetainedResponsibility" Text="{Binding OriginalState}" FontSize="12" MaxHeight="36" TextWrapping="Wrap" ToolTip="{Binding Reason}"/></StackPanel></Border>
    <Grid Grid.Row="2" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本次包裹号" FontSize="12" Foreground="{StaticResource Muted}"/><TextBox Tag="CurrentBarcode" Text="{Binding Code,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="21" TextWrapping="Wrap" BorderThickness="0" MinHeight="0" Padding="0" Margin="0" MaxHeight="36" VerticalScrollBarVisibility="Auto"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="本次格口" FontSize="12" Foreground="{StaticResource Muted}"/><TextBox Tag="CurrentSlot" Text="{Binding Slot,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" MinHeight="0" Padding="0" Margin="0" MaxHeight="50" FontSize="27" FontWeight="Bold" Foreground="{Binding StatusForeground}" TextWrapping="Wrap"/></StackPanel></Grid>
    <Expander Grid.Row="3" Header="观察、原作业与原因详情"><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsCompact,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Availability}" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{Binding StatusForeground}" FontSize="13"/><TextBlock Text="{Binding InputSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Admission}" TextWrapping="Wrap"/><TextBlock Text="{Binding MainResult}"/><TextBlock Text="{Binding Background}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Expander>
    <Button Tag="{Binding Id}" Grid.Row="4" Content="选择此位为命令目标" Click="Position_Click" MinHeight="44"/>
   </Grid></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Expander IsEnabled="{Binding CanStartOperation}" Visibility="{Binding SimulationVisibility}" Grid.Row="1" Header="显式参考输入 · 不接入生产设备" Margin="6,2"><StackPanel><TextBlock Text="实体身份保留至显式新包裹；同码不自动合并，重复点击不创建新实体。"/><WrapPanel><TextBox Text="{Binding ParcelCode,UpdateSourceTrigger=PropertyChanged}" Width="220"/><TextBox Text="{Binding AdmissionId,UpdateSourceTrigger=PropertyChanged}" Width="260"/><Button Content="新包裹身份" Click="New_Click"/><Button Content="模拟相机读码" Click="Emit_Click" IsEnabled="{Binding CanAdmit}"/><TextBox Text="{Binding MeasurementValue,UpdateSourceTrigger=PropertyChanged}" Width="140"/><Button Content="同包裹模拟实测重量" Click="Weight_Click"/></WrapPanel></StackPanel></Expander>
 </Grid>
</UserControl>
