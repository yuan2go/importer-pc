<Window x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:parameters="clr-namespace:Ipc.Application.ParcelFlow.Desktop;assembly=Ipc.Application.ParcelFlow.Desktop" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop" Title="菜鸟供包台" Width="1600" Height="900" MinWidth="640" MinHeight="420" Background="{DynamicResource StationBackground}" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid x:Name="ClientArea" Background="{StaticResource StationBackground}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.Resources>
   <Style x:Key="ExpandedNavigation" TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
   <Style x:Key="CompactNavigation" TargetType="Menu"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  </Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,0,1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="16,8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12,4"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
     <TextBlock x:Name="AccountIdentity" Text="{Binding AccountDisplay}" FontSize="{x:Static type:UiTypography.Body}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountDisplay}" Margin="0,0,8,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="MaxWidth" Value="230"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxWidth" Value="120"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <parameters:ManagementModeMenu Status="{Binding ManagementStatus}" ModeActionRequested="ManagementMode_Click"/>
     <Button x:Name="OperatorAccess" Content="操作员" Click="OperatorLogin_Click" Visibility="{Binding LoginVisibility}" Style="{StaticResource StationButton}"/>
     <Button Content="暂停供包" Click="Pause_Click" Visibility="{Binding PauseVisibility}" Style="{StaticResource StationButton}"/>
     <Button Content="恢复供包" Click="Resume_Click" Visibility="{Binding ResumeVisibility}" IsEnabled="{Binding CanResumeInViewport}" Style="{StaticResource StationButton}"/>
    </StackPanel>
    <Button x:Name="ReturnToWork" DockPanel.Dock="Left" Content="返回作业" Click="Workstation_Click" Margin="0,0,16,0" MinHeight="44" FontSize="{x:Static type:UiTypography.Body}" FontWeight="Normal"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsInternalWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"><Image Source="pack://application:,,,/Ipc.Application.ParcelFlow.Desktop;component/Assets/cainiao.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="菜鸟标志"/><TextBlock Text="菜鸟供包台" FontSize="{x:Static type:UiTypography.Body}" FontWeight="{x:Static type:UiTypography.Emphasis}" VerticalAlignment="Center" ToolTip="{Binding Station}"/></StackPanel>
    <Grid VerticalAlignment="Center">
     <Menu Style="{StaticResource CompactNavigation}" Background="White"><MenuItem Header="页面" MinHeight="44"><MenuItem Header="作业" Click="Workstation_Click"/><MenuItem Header="作业记录" Click="History_Click"/><MenuItem Header="参数设置" Click="Maintenance_Click" Visibility="{Binding ManagementModeVisibility}"/><MenuItem Header="日志查询" Click="Logs_Click" Visibility="{Binding ManagementModeVisibility}"/></MenuItem></Menu>

    </Grid>
   </DockPanel>
  </Border>
  <Border x:Name="DailyNavigation" Grid.Row="1" Grid.RowSpan="2" Width="176" Background="White" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,1,0">
   <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel Margin="12,20,12,12">
    <StackPanel><Button Content="作业" Click="Workstation_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="workstation"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="作业记录" Click="History_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="history"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="参数设置" Click="Maintenance_Click" Visibility="{Binding ManagementModeVisibility}" Margin="0,0,0,8" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="maintenance"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="日志查询" Click="Logs_Click" Visibility="{Binding ManagementModeVisibility}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="logs"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DockPanel></Border>
  <Grid Grid.Row="2" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
   <Border Padding="8,4" Background="#EEF4FF" BorderBrush="#BDD2F3" BorderThickness="1" Margin="0,0,0,4"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasGlobalOperationFeedback}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button Content="收起回执" Click="DismissGlobalFeedback_Click" DockPanel.Dock="Right" MinHeight="44" Padding="8,4" FontSize="{x:Static type:UiTypography.Body}" Margin="8,0,0,0"/><TextBox x:Name="GlobalOperationFeedback" MinHeight="0" Padding="0" VerticalAlignment="Center" Text="{Binding GlobalOperationFeedback,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#25384B" TextWrapping="Wrap" MaxHeight="44" VerticalScrollBarVisibility="Auto" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="当前全局操作回执，可选择复制" AutomationProperties.LiveSetting="Assertive"/></DockPanel></Border>
  <Border Background="{Binding WorkspaceStatusBackground}" BorderBrush="{Binding StatusPresentation.Border}" BorderThickness="0,0,0,1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="16,8"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="16,0"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Padding" Value="20,6"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedPage}" Value="logs"/><Condition Binding="{Binding HasOperationalAttention}" Value="False"/><Condition Binding="{Binding WorkFeedback}" Value=""/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
    <StackPanel>
     <ScrollViewer x:Name="StatusDiagnostics" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="64"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="48"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="MaxHeight" Value="48"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
      <DockPanel LastChildFill="True">
       <TextBlock x:Name="WorkStatus" Text="{Binding WorkStatus}" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{Binding WorkspaceStatusForeground}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="DockPanel.Dock" Value="Left"/><Setter Property="Margin" Value="0,0,16,0"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="DockPanel.Dock" Value="Left"/><Setter Property="Margin" Value="0,0,16,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock x:Name="SettingsRunMode" DockPanel.Dock="Left" Text="{Binding SettingsRunMode}" FontSize="{x:Static type:UiTypography.Label}" Margin="0,0,16,0" Foreground="{StaticResource StationMuted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock x:Name="ActiveBlockingReasons" Text="{Binding DisplayWorkNotice}" Foreground="{Binding WorkspaceStatusForeground}" AutomationProperties.Name="当前作业阻断原因" ToolTip="{Binding WorkNotice}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StationNotice}"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </DockPanel>
     </ScrollViewer>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="40"/><Style.Triggers><DataTrigger Binding="{Binding WorkFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="24"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><TextBlock x:Name="OperationFeedback" Text="{Binding WorkFeedback}" ToolTip="{Binding Feedback}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StationNotice}"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></ScrollViewer>
    </StackPanel>
   </Border>
  </StackPanel>
   <ContentControl x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding ViewportReady}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Margin" Value="8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="4"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
  </Grid>
  <Border x:Name="WorkstationFooter" Grid.Row="3" Grid.ColumnSpan="2" Padding="16,4" Background="White"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding EnvironmentStatus}" Foreground="{StaticResource StationMuted}" FontSize="{x:Static type:UiTypography.Label}" TextTrimming="CharacterEllipsis"/></Border>
  <Border x:Name="ViewportWarning" Grid.RowSpan="4" Grid.ColumnSpan="2" Background="{StaticResource StationBackground}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24" Visibility="{Binding ViewportWarningVisibility}">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding ViewportStatus}" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/>
    <TextBlock Text="有效客户区至少需要 800 × 420 逻辑像素。当前窗口的新操作已禁用，已请求软件暂停；暂停结果以下方应用快照为准。" FontSize="{x:Static type:UiTypography.Body}" Margin="0,16"/>
    <TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Message}"/><TextBlock Text="{Binding ReadStatus}" Margin="0,12"/>
    <TextBlock Text="在途作业与原请求保持。空间恢复不会自动恢复入场；应用暂停且快照有效后，先确认视图，再核对现场并显式恢复。软件暂停不是安全急停。"/>
    <WrapPanel Margin="0,16"><Button Content="最大化窗口" Click="Maximize_Click" Style="{StaticResource StationButton}"/><Button Content="重试软件暂停" Click="ViewportPause_Click" Style="{StaticResource StationButton}"/><Button Content="确认视图，保持暂停" Click="ViewportAcknowledge_Click" IsEnabled="{Binding CanAcknowledgeViewport}" Style="{StaticResource StationButton}"/></WrapPanel>
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
</Window>
