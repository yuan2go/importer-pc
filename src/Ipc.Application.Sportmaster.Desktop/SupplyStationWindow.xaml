<Window x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop" Title="Sportmaster · 供包工作台" Width="1440" Height="980" MinWidth="640" MinHeight="420" Background="#F0F2F5" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid x:Name="ClientArea"><Grid.Resources>
   <Style x:Key="ExpandedNavigation" TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
   <Style x:Key="CompactNavigation" TargetType="Menu"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  </Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#D8E0E7" BorderThickness="0,0,0,1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="12,6"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12,2"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Menu Style="{StaticResource CompactNavigation}" VerticalAlignment="Center" Background="White"><MenuItem Header="页面与窗口" MinHeight="44"><MenuItem Header="工作台" Click="Workstation_Click"/><MenuItem Header="作业记录" Click="History_Click"/><MenuItem Header="设备与维护" Click="Maintenance_Click"/><Separator/><MenuItem Header="辅助窗口" Click="Window_Click"/><MenuItem Header="切换紧凑布局" Click="Layout_Click"/></MenuItem></Menu>
     <WrapPanel Style="{StaticResource ExpandedNavigation}"><Button Content="工作台" Click="Workstation_Click" Style="{StaticResource StationButton}"/><Button Content="作业记录" Click="History_Click" Style="{StaticResource StationButton}"/><Button Content="设备与维护" Click="Maintenance_Click" Style="{StaticResource StationButton}"/><Button Content="辅助窗口" Click="Window_Click" Style="{StaticResource StationButton}"/><Button Content="紧凑布局" Click="Layout_Click" Style="{StaticResource StationButton}"/></WrapPanel>
     <Button Content="暂停新入场" Click="Pause_Click" Style="{StaticResource StationButton}"/><Button Content="恢复新入场" Click="Resume_Click" IsEnabled="{Binding CanResumeInViewport}" Style="{StaticResource StationButton}"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Supply Station" FontSize="19" FontWeight="Bold"/><TextBlock Text="SPORTMASTER · 双位读码工作台" FontSize="11" Foreground="#536577"/></StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer x:Name="HeaderDiagnostics" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="132"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="132"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="20,10"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12,2"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <Expander Header="站位、设备与服务来源诊断"><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel>
    <WrapPanel><TextBlock Text="{Binding Station}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Margin="0,0,20,0"/><TextBlock Text="{Binding TopologyStatus}" Foreground="#6B7280"/><TextBlock Text="{Binding Session}" Margin="20,0,0,0"/></WrapPanel>
    <TextBlock Text="{Binding ConfigurationState}" Foreground="#6B7280" FontSize="12" Margin="0,5,0,0"/>
    <TextBlock Text="{Binding Health}" Foreground="#6B7280" FontSize="12" Margin="0,3,0,0"/>
    <TextBlock Text="{Binding CapacityState}" Foreground="#6B7280" FontSize="12" Margin="0,3,0,0"/>
    <TextBlock Text="{Binding AuxiliaryState}" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,3,0,0"/>
    <WrapPanel Visibility="{Binding LoginVisibility}"><TextBox Text="{Binding OperatorSubject,UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="操作员账号"/><PasswordBox x:Name="LoginProof" Width="150" AutomationProperties.Name="操作员口令"/><Button Content="验证身份" Click="Login_Click" Style="{StaticResource StationButton}"/><Button Content="登出" Click="Logout_Click" Style="{StaticResource StationButton}"/></WrapPanel>
   </StackPanel></Expander>
  </Border></ScrollViewer>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{Binding StatusPresentation.Background}" BorderBrush="{Binding StatusPresentation.Border}" BorderThickness="1" CornerRadius="8"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="16,12,16,0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="8,4,8,0"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><ScrollViewer x:Name="StatusDiagnostics" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="96"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="20"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel><TextBlock Text="{Binding StatusPresentation.Text}" Foreground="{Binding StatusPresentation.Foreground}" FontWeight="Bold"/><TextBlock Text="{Binding BlockingReasons}"/><TextBlock Text="{Binding Message}" FontSize="13"/><TextBlock Text="{Binding ReadStatus}" FontSize="12" Foreground="#6B7280"/></StackPanel></ScrollViewer><WrapPanel><TextBlock Text="最后成功读取：" FontSize="12" Foreground="#6B7280"/><TextBlock x:Name="LastReadTime" Text="{Binding UpdatedAt}" FontSize="12" Foreground="#6B7280"/></WrapPanel></StackPanel></Border>
   <ContentControl x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding ViewportReady}"/>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="20,8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12,2"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding EnvironmentStatus}" FontSize="12" Foreground="#6B7280"/></Border>
  <Border x:Name="ViewportWarning" Grid.RowSpan="4" Background="#F0F2F5" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24" Visibility="{Binding ViewportWarningVisibility}">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding ViewportStatus}" FontSize="24" FontWeight="Bold"/>
    <TextBlock Text="有效客户区至少需要 800 × 420 DIP。当前窗口的新操作已禁用，已请求软件暂停；暂停结果以下方应用快照为准。" FontSize="16" Margin="0,16"/>
    <TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Message}"/><TextBlock Text="{Binding ReadStatus}" Margin="0,12"/>
    <TextBlock Text="在途作业与原请求保持。空间恢复不会自动恢复入场；应用暂停且快照有效后，先确认视图，再核对现场并显式恢复。软件暂停不是安全急停。"/>
    <WrapPanel Margin="0,16"><Button Content="最大化窗口" Click="Maximize_Click" Style="{StaticResource StationButton}"/><Button Content="重试软件暂停" Click="ViewportPause_Click" Style="{StaticResource StationButton}"/><Button Content="确认视图，保持暂停" Click="ViewportAcknowledge_Click" IsEnabled="{Binding CanAcknowledgeViewport}" Style="{StaticResource StationButton}"/></WrapPanel>
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
</Window>
