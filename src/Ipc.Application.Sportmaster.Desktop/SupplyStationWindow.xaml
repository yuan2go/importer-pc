<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:parameters="clr-namespace:Ipc.Application.ParcelFlow.Desktop;assembly=Ipc.Application.ParcelFlow.Desktop" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop" x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationWindow" Title="菜鸟供包台" Width="1600" Height="900" MinWidth="640" MinHeight="420" Background="{DynamicResource StationBackground}" UseLayoutRounding="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid x:Name="ClientArea" Background="{StaticResource StationBackground}">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Grid.Resources>
   <Style x:Key="StationIconNavigation" TargetType="Button" BasedOn="{StaticResource StationNavigation}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="ContentTemplate">
     <Setter.Value>
      <DataTemplate>
       <StackPanel Orientation="Horizontal">
        <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False"><Path.Style><Style TargetType="Path"><Setter Property="Margin" Value="2,0,10,0"/><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Margin" Value="2,0,0,0"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel>
      </DataTemplate>
     </Setter.Value>
    </Setter>
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border x:Name="TimeHeader" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,0,1" Padding="16,8" MinHeight="48">
   <Grid>
    <TextBlock x:Name="StationClock" FontSize="{x:Static type:UiTypography.Body}" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="本机时间"/>
    <Button x:Name="MinimizeFullScreen" Click="MinimizeFullScreen_Click" HorizontalAlignment="Right" MinWidth="44" MinHeight="44" ToolTip="最小化到任务栏" AutomationProperties.Name="最小化到任务栏">
     <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Path=(parameters:WindowOpeningPreference.IsFullScreen), RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
     <Path Data="M 3,10 L 17,10" Stroke="{DynamicResource Ink}" StrokeThickness="1.7" Width="20" Height="20"/>
    </Button>
   </Grid>
  </Border>
  <Border x:Name="DailyNavigation" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Surface}" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,1,0">
   <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="176"/><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Width" Value="64"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel Margin="8,12,8,8" LastChildFill="True">
    <Button x:Name="NavigationToggle" DockPanel.Dock="Top" Click="NavigationToggle_Click" Content="收起菜单" ToolTip="收起或展开菜单" AutomationProperties.Name="收起或展开菜单" Style="{StaticResource StationIconNavigation}" Tag="M 3,5 L 21,5 M 3,12 L 21,12 M 3,19 L 21,19" Margin="0,0,0,16"/>
    <StackPanel DockPanel.Dock="Bottom">
     <Button x:Name="OperatorAccess" Content="操作员" Click="OperatorLogin_Click" Visibility="{Binding LoginVisibility}" Style="{StaticResource StationIconNavigation}" Tag="M 8,6 A 4,4 0 1 0 16,6 A 4,4 0 1 0 8,6 M 3,22 L 3,19 C 3,12 21,12 21,19 L 21,22" ToolTip="操作员身份" AutomationProperties.Name="操作员身份"/>
     <Button x:Name="ManagementCenterEntry" Content="管理中心" Click="ManagementMode_Click" Style="{StaticResource StationIconNavigation}" Tag="M 10,2 L 14,2 14.6,5 16.4,6 19.3,5 21.3,8.5 19,10.5 19,13.5 21.3,15.5 19.3,19 16.4,18 14.6,19 14,22 10,22 9.4,19 7.6,18 4.7,19 2.7,15.5 5,13.5 5,10.5 2.7,8.5 4.7,5 7.6,6 9.4,5 Z M 16,12 A 4,4 0 1 1 8,12 A 4,4 0 1 1 16,12" ToolTip="管理中心（需要管理密码）" AutomationProperties.Name="管理中心，需要管理密码"/>
    </StackPanel>
    <StackPanel>
     <Button Tag="M 3,6 L 12,2 21,6 21,18 12,22 3,18 Z M 3,6 L 12,10 21,6 M 12,10 L 12,22 M 7.5,4 L 16.5,8 16.5,12" Content="作业" Click="Workstation_Click" Margin="0,0,0,8" ToolTip="作业" AutomationProperties.Name="作业">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="workstation"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
     <Button Tag="M 8,4 L 4,4 4,22 20,22 20,4 16,4 M 8,2 L 16,2 16,6 8,6 Z M 8,11 L 9,11 M 12,11 L 17,11 M 8,16 L 9,16 M 12,16 L 17,16" Content="记录" Click="History_Click" Margin="0,0,0,8" ToolTip="记录" AutomationProperties.Name="记录">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationIconNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="history"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBackground}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2" Grid.Column="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <StackPanel>
    <Border x:Name="PendingConfigurationBanner" Padding="16,6" Background="{StaticResource AccentBackground}">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasConfigurationActivationNotice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCompact}" Value="True"/><Condition Binding="{Binding SelectedPage}" Value="workstation"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel><Button x:Name="ActivationOutcomeAction" Content="{Binding ConfigurationActivationActionText}" Click="ProductRestart_Click" IsEnabled="{Binding CanOpenConfigurationActivation}" DockPanel.Dock="Right" MinHeight="44"/><TextBlock Text="{Binding ConfigurationActivationBannerText}" ToolTip="{Binding ConfigurationActivationOutcome}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    </Border>
    <Border Padding="8,4" Background="{DynamicResource AccentBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,4">
     <Border.Style>
      <Style TargetType="Border">
       <Style.Triggers>
        <DataTrigger Binding="{Binding HasGlobalOperationFeedback}" Value="False">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding GlobalReceiptCommitted}" Value="True"/>
          <Condition Binding="{Binding IsTight}" Value="True"/>
          <Condition Binding="{Binding SelectedPage}" Value="workstation"/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <DockPanel>
      <Button Content="关闭提示" Click="DismissGlobalFeedback_Click" DockPanel.Dock="Right" MinHeight="44" Padding="8,4" FontSize="{x:Static type:UiTypography.Body}" Margin="8,0,0,0"/>
      <TextBox x:Name="GlobalOperationFeedback" MinHeight="0" Padding="0" VerticalAlignment="Center" Text="{Binding GlobalOperationFeedback,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" MaxHeight="44" VerticalScrollBarVisibility="Auto" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="最近一次操作结果，可选择复制" AutomationProperties.LiveSetting="Assertive"/>
     </DockPanel>
    </Border>
    <Border x:Name="OperationalStatusBar" Background="{Binding WorkspaceStatusBackground}" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,0,1">
     <Border.Style>
      <Style TargetType="Border">
       <Setter Property="Padding" Value="16,8"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedPage}" Value="maintenance"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding SelectedPage}" Value="history">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SelectedPage}" Value="diagnostics">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SelectedPage}" Value="debug">
         <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsTight}" Value="True">
         <Setter Property="Padding" Value="16,0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
         <Setter Property="Padding" Value="20,6"/>
        </DataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding SelectedPage}" Value="maintenance"/>
          <Condition Binding="{Binding WorkFeedback}" Value=""/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding SelectedPage}" Value="logs"/>
          <Condition Binding="{Binding HasOperationalAttention}" Value="False"/>
          <Condition Binding="{Binding WorkFeedback}" Value=""/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <DockPanel LastChildFill="True">
      <Border x:Name="RcsConnection" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0" Background="{Binding RcsPresentation.Background}" BorderBrush="{Binding RcsPresentation.Border}" BorderThickness="1" Padding="10,6">
       <Border.Style>
        <Style TargetType="Border">
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
       <TextBlock Text="{Binding RcsPresentation.Text}" Foreground="{Binding RcsPresentation.Foreground}" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="RCS 连接状态" AutomationProperties.LiveSetting="Polite" ToolTip="RCS 在线只表示服务可连接；每件包裹以本件返回的格口为准。"/>
      </Border>
      <StackPanel>
       <DockPanel LastChildFill="True">
       <Button x:Name="CompactActivationAction" Content="{Binding ConfigurationActivationCompactText}" Click="ProductRestart_Click" IsEnabled="{Binding CanOpenConfigurationActivation}" DockPanel.Dock="Right" HorizontalAlignment="Right" MinHeight="32" Margin="8,0,0,0" ToolTip="{Binding ConfigurationActivationOutcome}">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasConfigurationActivationNotice}" Value="True"/><Condition Binding="{Binding IsCompact}" Value="True"/><Condition Binding="{Binding SelectedPage}" Value="workstation"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
       </Button>
       <Border x:Name="PaceSummary" Visibility="{Binding PaceVisibility}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0" Focusable="False"><TextBlock x:Name="PaceBadge" AutomationProperties.Name="{Binding PaceText}" Visibility="{Binding PaceVisibility}" FontSize="{x:Static type:UiTypography.Label}" VerticalAlignment="Center" ToolTip="按原请求准备时间统计取得格口次数；读取持久事实，不代表实物落格件数。管理模式可右键隐藏。"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding PaceText}"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Text" Value="{Binding PaceCompact}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
       </DockPanel>
       <ScrollViewer x:Name="StatusDiagnostics" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Style>
         <Style TargetType="ScrollViewer">
          <Setter Property="MaxHeight" Value="64"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsTight}" Value="True">
            <Setter Property="MaxHeight" Value="48"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
            <Setter Property="MaxHeight" Value="48"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding SelectedPage}" Value="maintenance">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding IsTight}" Value="True"/>
             <Condition Binding="{Binding SelectedPage}" Value="workstation"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Collapsed"/>
           </MultiDataTrigger>
           <DataTrigger Binding="{Binding ShowSupplyControlNotice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
          </Style.Triggers>
         </Style>
        </ScrollViewer.Style>
        <DockPanel LastChildFill="True">
         <TextBlock x:Name="WorkStatus" Text="{Binding OperatorStatus}" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{Binding WorkspaceStatusForeground}">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
              <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
              <Setter Property="DockPanel.Dock" Value="Left"/>
              <Setter Property="Margin" Value="0,0,16,0"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <TextBlock x:Name="SettingsRunMode" DockPanel.Dock="Left" Text="{Binding SettingsRunMode}" FontSize="{x:Static type:UiTypography.Label}" Margin="0,0,16,0" Foreground="{StaticResource StationMuted}">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <TextBlock x:Name="ActiveBlockingReasons" Text="{Binding OperatorNotice}" Foreground="{Binding WorkspaceStatusForeground}" AutomationProperties.Name="暂不能供包的原因">
          <TextBlock.Style>
           <Style TargetType="TextBlock" BasedOn="{StaticResource StationNotice}">
            <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
              <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </DockPanel>
       </ScrollViewer>
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style>
         <Style TargetType="ScrollViewer">
          <Setter Property="MaxHeight" Value="40"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding WorkFeedback}" Value="">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding IsTight}" Value="True">
            <Setter Property="MaxHeight" Value="24"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </ScrollViewer.Style>
        <TextBlock x:Name="OperationFeedback" Text="{Binding WorkFeedback}" ToolTip="{Binding Feedback}" AutomationProperties.LiveSetting="Polite">
         <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource StationNotice}">
           <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
             <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </ScrollViewer>
      </StackPanel>
     </DockPanel>
    </Border>
   </StackPanel>
   <ContentControl x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding ViewportReady}">
    <ContentControl.Style>
     <Style TargetType="ContentControl">
      <Setter Property="Margin" Value="8"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsCompact}" Value="True">
        <Setter Property="Margin" Value="4"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
        <Setter Property="Margin" Value="0"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </ContentControl.Style>
   </ContentControl>
  </Grid>
  <Border x:Name="WorkstationFooter" Grid.Row="3" Grid.ColumnSpan="2" Padding="16,4" Background="White">
   <Border.Style>
    <Style TargetType="Border">
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsTight}" Value="True">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Border.Style>
   <TextBlock Text="{Binding EnvironmentStatus}" Foreground="{StaticResource StationMuted}" FontSize="{x:Static type:UiTypography.Label}" TextTrimming="CharacterEllipsis"/>
  </Border>
  <Border x:Name="ViewportWarning" Grid.RowSpan="4" Grid.ColumnSpan="2" Background="{StaticResource StationBackground}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24" Visibility="{Binding ViewportWarningVisibility}">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="{Binding ViewportStatus}" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/>
     <TextBlock Text="窗口太小，无法完整显示作业信息（至少需要 800 × 420）。请最大化窗口；相机和当前任务不受影响。" FontSize="{x:Static type:UiTypography.Body}" Margin="0,16"/>
     <TextBlock Text="{Binding Status}"/>
     <TextBlock Text="{Binding Message}"/>
     <TextBlock Text="{Binding ReadStatus}" Margin="0,12"/>
     <WrapPanel Margin="0,16">
      <Button Content="最大化窗口" Click="Maximize_Click" Style="{StaticResource StationButton}"/>
     </WrapPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</Window>
