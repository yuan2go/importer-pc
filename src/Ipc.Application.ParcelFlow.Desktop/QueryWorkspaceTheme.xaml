<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/ParameterSettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
 <DataTemplate x:Key="QueryDisclosureHeader"><Grid MinHeight="32"><TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/></Grid></DataTemplate>
 <Style x:Key="QueryHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#202833"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 <Style x:Key="QueryHint" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#657184"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="QueryResultsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
  <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="RowHeight" Value="44"/><Setter Property="MinHeight" Value="32"/><Setter Property="BorderBrush" Value="#E1E5EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E9EDF2"/><Setter Property="ColumnHeaderHeight" Value="36"/>
  <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F5F7FA"/><Setter Property="Foreground" Value="#586578"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E1E5EB"/></Style></Setter.Value></Setter>
  <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="Foreground" Value="#202833"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#0B63F6"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
 </Style>
 <Style x:Key="QueryCellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
</ResourceDictionary>
