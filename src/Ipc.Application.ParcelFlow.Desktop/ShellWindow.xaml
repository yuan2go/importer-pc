<Window x:Class="Ipc.Application.ParcelFlow.Desktop.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:parameters="clr-namespace:Ipc.Application.ParcelFlow.Desktop" Title="{Binding Title}" Width="1440" Height="900" MinWidth="640" MinHeight="420" UseLayoutRounding="True" Background="White" FontSize="{x:Static type:UiTypography.Body}" FontWeight="Normal">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/ParameterSettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="ShellAction" TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="ShellTab" TargetType="Button" BasedOn="{StaticResource ShellAction}"><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <DataTemplate x:Key="ShellDisclosure"><Grid MinHeight="22"><TextBlock Text="{Binding}" FontSize="{x:Static type:UiTypography.Label}"/></Grid></DataTemplate>
  <parameters:ParameterMessageTextConverter x:Key="ParameterFeedbackText"/>
 </ResourceDictionary></Window.Resources>
 <Grid x:Name="ClientArea"><Grid.Resources><Style x:Key="Navigation" TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style><Style x:Key="CompactNavigation" TargetType="Menu"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="#E1E5EB" BorderThickness="0,0,0,1" Background="White"><StackPanel Margin="16,4,16,4">
   <Grid x:Name="IdentityHeader" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="{Binding Title}" MaxWidth="260" Margin="0,0,12,0" FontSize="{x:Static type:UiTypography.Body}" FontWeight="{x:Static type:UiTypography.Emphasis}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding StationDisplaySummary}" MaxWidth="160" VerticalAlignment="Center" FontSize="{x:Static type:UiTypography.Diagnostic}" Foreground="#5A6878" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding StationDisplaySummary}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="OperatorIdentity" Text="{Binding AccountDisplay}" Focusable="True" ToolTip="{Binding AccountDisplay}" AutomationProperties.Name="{Binding AccountDisplay}" AutomationProperties.AutomationId="OperatorIdentity" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="MaxWidth" Value="260"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxWidth" Value="180"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <parameters:ManagementModeMenu Status="{Binding ManagementStatus}" ModeActionRequested="ManagementMode_Click" MinHeight="44" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <DockPanel x:Name="WorkspaceNavigation" LastChildFill="False">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="暂停新入场" Click="Pause_Click" Visibility="{Binding PauseVisibility}" Style="{StaticResource ShellAction}"/><Button Content="恢复新入场" Click="Resume_Click" Visibility="{Binding ResumeVisibility}" IsEnabled="{Binding CanResumeInViewport}" Style="{StaticResource ShellAction}"/></StackPanel>
    <Menu Style="{StaticResource CompactNavigation}" Background="Transparent" VerticalAlignment="Center"><MenuItem Header="页面与窗口" MinHeight="38"><MenuItem Header="工作台" Click="Workstation_Click"/><MenuItem Header="作业记录" Click="History_Click"/><MenuItem Visibility="{Binding ManagementModeVisibility}" Header="参数设置" Click="Maintenance_Click"/><MenuItem Visibility="{Binding ManagementModeVisibility}" Header="日志查询" Click="Logs_Click"/><Separator/><MenuItem Visibility="{Binding ManagementModeVisibility}" Header="切换紧凑布局" Click="Layout_Click"/></MenuItem></Menu>
    <WrapPanel Style="{StaticResource Navigation}"><Button Content="工作台" Click="Workstation_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ShellTab}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="work"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#B8CFF3"/><Setter Property="Foreground" Value="#185FBC"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="作业记录" Click="History_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ShellTab}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="history"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#B8CFF3"/><Setter Property="Foreground" Value="#185FBC"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="参数设置" Click="Maintenance_Click" Visibility="{Binding ManagementModeVisibility}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ShellTab}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="maintenance"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#B8CFF3"/><Setter Property="Foreground" Value="#185FBC"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="日志查询" Click="Logs_Click" Visibility="{Binding ManagementModeVisibility}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ShellTab}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="logs"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#B8CFF3"/><Setter Property="Foreground" Value="#185FBC"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Visibility="{Binding ManagementModeVisibility}" Content="紧凑布局" Click="Layout_Click" Style="{StaticResource ShellAction}"/></WrapPanel>
   </DockPanel>
  </StackPanel></Border>
  <StackPanel Grid.Row="1" Margin="12,4,12,0">
<Border Background="#FFF6E3" BorderBrush="#D8B35B" BorderThickness="1" Padding="8,4" Margin="0,0,0,4"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasManagementNotice}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBox Text="{Binding ManagementNotice,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Label}" MinHeight="0" Padding="0" MaxHeight="54" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="管理授权变化说明" AutomationProperties.LiveSetting="Assertive"/></Border>
<Border Padding="8,4" Background="#EEF4FF" BorderBrush="#BDD2F3" BorderThickness="1" Margin="0,0,0,4"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasGlobalOperationFeedback}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button Content="收起回执" Click="DismissGlobalFeedback_Click" DockPanel.Dock="Right" MinHeight="44" Padding="8,4" FontSize="{x:Static type:UiTypography.Body}" Margin="8,0,0,0"/><TextBox x:Name="GlobalOperationFeedback" MinHeight="0" Padding="0" VerticalAlignment="Center" Text="{Binding GlobalOperationFeedback,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#25384B" TextWrapping="Wrap" MaxHeight="44" VerticalScrollBarVisibility="Auto" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="当前全局操作回执，可选择复制" AutomationProperties.LiveSetting="Assertive"/></DockPanel></Border>
   <Border x:Name="OperationalAttention" BorderBrush="{Binding StatusPresentation.Border}" BorderThickness="0,0,0,1" Background="{Binding StatusPresentation.Background}" Padding="8,4">
    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasOperationalAttention}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <ScrollViewer x:Name="OperationalStatusScroll" MaxHeight="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel><TextBlock Text="{Binding NextAction}" FontSize="{x:Static type:UiTypography.Label}" TextWrapping="Wrap" AutomationProperties.Name="当前影响与下一动作"/><TextBlock x:Name="ActiveBlockingReasons" Text="{Binding BlockingReasons}" TextWrapping="Wrap" FontSize="{x:Static type:UiTypography.Label}" Foreground="{StaticResource Warning}" AutomationProperties.Name="当前作业阻断原因" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    </ScrollViewer>
   </Border>
   <ScrollViewer MaxHeight="36" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding ShowWorkspaceFeedback,RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding TaskFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
    <TextBlock x:Name="OperationFeedback" FontSize="{x:Static type:UiTypography.Label}" TextWrapping="Wrap" ToolTip="{Binding Feedback}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding TaskFeedback}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="maintenance"><Setter Property="Text" Value="{Binding TaskFeedback,Converter={StaticResource ParameterFeedbackText}}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </ScrollViewer>
  </StackPanel>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,0"><Expander HeaderTemplate="{StaticResource ShellDisclosure}" Header="操作员登录" FontSize="{x:Static type:UiTypography.Label}"><Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="IsExpanded" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="work"><Setter Property="Visibility" Value="{Binding LoginVisibility}"/></DataTrigger><DataTrigger Binding="{Binding Snapshot.CurrentOperator}" Value="{x:Null}"><Setter Property="IsExpanded" Value="True"/></DataTrigger><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="maintenance"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="logs"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style><WrapPanel x:Name="OperationalLogin" Visibility="{Binding LoginVisibility}"><TextBlock Text="操作员账号" VerticalAlignment="Center"/><TextBox Text="{Binding OperatorSubject,UpdateSourceTrigger=PropertyChanged}" Width="140"/><PasswordBox x:Name="LoginProof" Width="160" AutomationProperties.Name="操作员口令"/><Button Content="验证身份" Click="Login_Click" IsEnabled="{Binding CanStartFreshOperation}"/><Button Content="登出" Click="Logout_Click" IsEnabled="{Binding CanStartFreshOperation}"/></WrapPanel></Expander></ScrollViewer>
   <ContentControl x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding ViewportReady}" Margin="6,4"/>
  </Grid>
  <StackPanel Grid.Row="3" Margin="12,2"><Expander HeaderTemplate="{StaticResource ShellDisclosure}" x:Name="StationDiagnostics" Visibility="{Binding ManagementModeVisibility}"  Header="站位、会话与设备诊断" Margin="0,2,0,0" FontSize="{x:Static type:UiTypography.Diagnostic}"><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><ScrollViewer x:Name="StationDiagnosticsScroll" MaxHeight="80" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding ReadStatus}"/><TextBlock Text="{Binding BlockingReasons}" TextWrapping="Wrap"/><TextBox Text="{Binding Feedback,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/><TextBlock Text="{Binding Flow}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Health}" TextWrapping="Wrap"/><TextBlock Text="{Binding CapacityState}"/><TextBlock Text="{Binding AuxiliaryState}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/><TextBlock Text="{Binding ConfigurationState}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Session}"/><TextBlock Text="{Binding OperationOperator}"/><TextBlock Text="{Binding CurrentImage}"/><TextBlock Text="{Binding CaptureState}" TextWrapping="Wrap"/><TextBlock Text="{Binding UploadState}"/><Expander Header="原实体检查说明"><StackPanel><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="重启原实体检查说明；不替代现场安全许可"/></StackPanel></Expander></StackPanel></ScrollViewer></Expander><DockPanel><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding HasCurrentOperation}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="history"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="maintenance"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="logs"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style><WrapPanel DockPanel.Dock="Right" IsEnabled="{Binding CanStartOperation}" ToolTip="{Binding OperationStatus}" ToolTipService.ShowOnDisabled="True"><ComboBox ItemsSource="{Binding PositionIds}" SelectedItem="{Binding SelectedPositionId}" Width="90" AutomationProperties.Name="原作业命令投递位"/><Button Content="核对原请求" Click="Reconcile_Click" IsEnabled="{Binding CanQueryCurrent}"/><Button Content="继续未尝试原阶段" Click="Continue_Click" IsEnabled="{Binding CanContinue}"/></WrapPanel><TextBlock Text="{Binding CurrentCommandTarget}" ToolTip="{Binding CurrentCommandTarget}" FontSize="{x:Static type:UiTypography.Diagnostic}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding StatusPresentation.Text}" Foreground="{Binding StatusPresentation.Foreground}" FontSize="{x:Static type:UiTypography.Diagnostic}" Margin="12,0,0,0"/><TextBlock Text="{Binding EnvironmentStatus}" FontSize="{x:Static type:UiTypography.Diagnostic}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EnvironmentStatus}"/></DockPanel></StackPanel>
  <Border Grid.RowSpan="4" Visibility="{Binding ViewportWarningVisibility}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding ViewportStatus}" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/><TextBlock Text="有效客户区至少800 × 420 逻辑像素。新操作已禁用，软件暂停以应用回执为准；在途请求继续保留。空间恢复后须人工确认，业务保持暂停。" TextWrapping="Wrap" Margin="0,16"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding ReadStatus}" TextWrapping="Wrap"/><WrapPanel><Button Content="最大化窗口" Click="Maximize_Click"/><Button Content="重试软件暂停" Click="ViewportPause_Click"/><Button Content="确认视图，保持暂停" Click="ViewportAcknowledge_Click" IsEnabled="{Binding CanAcknowledgeViewport}"/></WrapPanel></StackPanel></ScrollViewer></Border>
 </Grid>
</Window>
