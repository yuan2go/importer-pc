<Window x:Class="Ipc.Application.ParcelFlow.Desktop.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="1440" Height="900" MinWidth="900" MinHeight="620" UseLayoutRounding="True">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="工作台" Click="Workstation_Click"/><Button Content="作业记录" Click="History_Click"/><Button Content="设备与维护" Click="Maintenance_Click"/><Button Content="辅助窗口" Click="Window_Click"/><Button Content="紧凑布局" Click="Layout_Click"/></StackPanel><StackPanel><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Flow}" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="{StaticResource Surface}" Padding="12" Margin="0,12"><StackPanel><TextBlock Text="{Binding Health}"/><TextBlock Text="{Binding ConfigurationState}" Foreground="{StaticResource Muted}"/>
   <TextBlock Text="{Binding Session}"/><TextBlock Text="{Binding OperationOperator}"/><TextBlock Text="{Binding CurrentImage}"/><TextBlock Text="{Binding CaptureState}" TextWrapping="Wrap"/><TextBlock Text="{Binding UploadState}"/>
   <WrapPanel Visibility="{Binding LoginVisibility}"><TextBlock Text="模拟账号" VerticalAlignment="Center"/><TextBox Text="{Binding OperatorSubject,UpdateSourceTrigger=PropertyChanged}" Width="140"/><TextBlock Text="公开模拟口令 SIMULATION_ONLY" VerticalAlignment="Center"/><PasswordBox x:Name="LoginProof" Width="160"/><Button Content="验证身份" Click="Login_Click"/><Button Content="登出" Click="Logout_Click"/></WrapPanel></StackPanel></Border>
  <Border Grid.Row="2" BorderBrush="{StaticResource Warning}" BorderThickness="3,0,0,0" Background="{StaticResource WarningBackground}" Padding="12"><StackPanel><TextBlock Text="{Binding Status}" FontWeight="Bold"/><TextBlock Text="{Binding BlockingReasons}"/><TextBlock Text="{Binding Message}"/></StackPanel></Border>
  <ContentControl x:Name="PageHost" Grid.Row="3" Margin="0,12"/>
  <DockPanel Grid.Row="4"><TextBlock Text="{Binding EnvironmentStatus}" Foreground="{StaticResource Muted}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="暂停新入场" Click="Pause_Click"/><Button Content="恢复新入场" Click="Resume_Click" IsEnabled="{Binding CanResume}"/><Button Content="核对原请求" Click="Reconcile_Click"/><Button Content="继续未尝试原阶段" Click="Continue_Click" IsEnabled="{Binding CanContinue}"/></StackPanel></DockPanel>
 </Grid>
</Window>
