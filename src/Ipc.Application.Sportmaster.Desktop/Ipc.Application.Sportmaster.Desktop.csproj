<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting></PropertyGroup>
  <PropertyGroup>
    <DefaultWorkstationPage Condition="'$(DefaultWorkstationPage)' == ''">supply-station</DefaultWorkstationPage>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Ipc.DefaultWorkstationPage" Value="$(DefaultWorkstationPage)"/>
  </ItemGroup>
  <Target Name="CheckDefaultWorkstationPage" BeforeTargets="PrepareForBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefaultWorkstationPage)', '\A(supply-station|tote-station)\z'))" Text="DefaultWorkstationPage must be supply-station or tote-station for Sportmaster."/>
  </Target>
  <ItemGroup><ProjectReference Include="../Ipc.Application.ParcelFlow.Desktop/Ipc.Application.ParcelFlow.Desktop.csproj"/></ItemGroup>
  <ItemGroup><Using Include="Ipc.Presentation.Wpf"/></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/operator/quick-guide.md" LogicalName="Ipc.Sportmaster.Help.quick-guide.md"/>
    <EmbeddedResource Include="../../docs/operator/deployment-card.md" LogicalName="Ipc.Sportmaster.Help.deployment-card.md"/>
    <EmbeddedResource Include="../../docs/operator/implementation-guide.md" LogicalName="Ipc.Sportmaster.Help.implementation-guide.md"/>
    <EmbeddedResource Include="../../docs/operator/fault-codes.md" LogicalName="Ipc.Sportmaster.Help.fault-codes.md"/>
  </ItemGroup>
</Project>
