<UserControl x:Class="Ipc.Desktop.LaneControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="0" UseLayoutRounding="True">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="16,8"><TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding Health}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}"/></DockPanel>
   <Border Grid.Row="1" Background="{Binding StatusBackground}" BorderBrush="{StaticResource Line}" BorderThickness="0,1" Padding="16,8"><StackPanel><TextBlock x:Name="ResultTitle" Text="{Binding Status}" FontSize="29" FontWeight="Bold" Foreground="{Binding StatusBrush}"/><TextBlock Text="{Binding Reason}" FontSize="13" Foreground="{StaticResource Muted}"/><TextBox x:Name="WaveDifferenceReview" Text="{Binding WaveDifference}" Visibility="{Binding HasWaveDifference,Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource ReadonlyValue}" Foreground="{StaticResource Danger}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" AutomationProperties.Name="入场箱与Item波次差异"/></StackPanel></Border>
   <ScrollViewer x:Name="CriticalScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="CriticalScrollChanged">
    <StackPanel Margin="16,8"><StackPanel x:Name="CriticalReview">
     <DockPanel x:Name="BarcodeReview"><Button Content="复制" DockPanel.Dock="Right" Click="CopyBarcodeClick" ToolTip="复制完整Item条码"/><StackPanel><TextBlock Text="Item条码 · 只读观察" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BarcodeValue" Text="{Binding Barcode}" Style="{StaticResource ReadonlyValue}" FontSize="27" FontWeight="Bold" AutomationProperties.Name="本通道完整Item条码"/></StackPanel></DockPanel>
     <Grid x:Name="FactGrid" Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <UniformGrid x:Name="Metadata" Columns="3"><StackPanel><TextBlock Text="SKU" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Sku}" Style="{StaticResource ReadonlyValue}" FontSize="15" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="10,0"><TextBlock Text="分拨任务ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TaskId}" Style="{StaticResource ReadonlyValue}" FontSize="15" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="目标格口" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Destination}" Style="{StaticResource ReadonlyValue}" FontSize="23" Foreground="{StaticResource Accent}" FontWeight="Bold"/></StackPanel></UniformGrid>
      <Border x:Name="QuantityPanel" Grid.Row="1" Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Margin="0,6"><UniformGrid Columns="3"><StackPanel Margin="12,6"><TextBlock Text="包装内SKU数量" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PackageValue" Text="{Binding Package}" FontSize="31" FontFamily="Consolas" FontWeight="Bold"/></StackPanel><StackPanel Margin="12,6"><TextBlock Text="剩余需求数量" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="DemandValue" Text="{Binding Remaining}" FontSize="31" FontFamily="Consolas" FontWeight="Bold"/></StackPanel><Border Background="{StaticResource AccentBackground}" Padding="12,6"><StackPanel><TextBlock Text="本次供给 / 保留" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SupplyValue" Text="{Binding Supply}" FontSize="31" FontFamily="Consolas" Foreground="{StaticResource Accent}" FontWeight="Bold"/></StackPanel></Border></UniformGrid></Border>
     </Grid>
     <TextBlock x:Name="QuantityUnitLabel" Text="{Binding QuantityUnit}" Style="{StaticResource FieldLabel}"/>
     <TextBox Text="{Binding ItemWave}" Style="{StaticResource ReadonlyValue}" FontSize="12" Margin="0,4"/>
     <StackPanel x:Name="SplitReview" Visibility="{Binding SplitVisible,Converter={StaticResource VisibleWhenTrue}}" Margin="0,6"><DockPanel><TextBlock Text="{Binding SplitProgress}" FontWeight="SemiBold"/><TextBlock Text="{Binding Remove}" DockPanel.Dock="Right" Foreground="{StaticResource Warning}"/></DockPanel><ProgressBar Value="{Binding SplitCount}" Maximum="{Binding SplitTarget}" Height="8" Margin="0,5" Foreground="{StaticResource Accent}"/></StackPanel>
    </StackPanel>
    <Expander Header="来源与历史证实" Margin="0,6,0,0"><ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBox Text="{Binding ObservationSource}" Style="{StaticResource ReadonlyValue}" FontSize="12" Margin="0,4"/>
     <TextBox Text="{Binding Provenance}" Style="{StaticResource ReadonlyValue}" FontSize="12" Margin="0,4"/>
     <TextBlock Text="{Binding SplitPolicy}" Visibility="{Binding SplitVisible,Converter={StaticResource VisibleWhenTrue}}" FontSize="12" Foreground="{StaticResource Warning}" Margin="0,4"/>
     <TextBox Text="{Binding PreviousResult}" Style="{StaticResource ReadonlyValue}" FontSize="12" Margin="0,4"/>
    </StackPanel></ScrollViewer></Expander>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="3" Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
    <StackPanel>
     <DockPanel x:Name="ScanControls" Visibility="{Binding SplitVisible,Converter={StaticResource VisibleWhenTrue}}"><Button Content="清空重扫" Click="ClearClick" DockPanel.Dock="Right" IsEnabled="{Binding CanClear}"/><Button Content="计入保留件" Click="ScanClick" DockPanel.Dock="Right" IsEnabled="{Binding CanScan}"/><TextBox x:Name="RetainedInput" Text="{Binding RetainedDraft,UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="RetainedFocus" IsReadOnly="{Binding ScanReadOnly}" MaxLength="128" PreviewTextInput="RetainedTextInput" DataObject.Pasting="RetainedPaste" AutomationProperties.Name="本通道保留件独立身份" ToolTip="仅Simulation保留件独立身份，不以回调次数计件" KeyDown="RetainedKeyDown"/></DockPanel>
     <TextBlock Text="{Binding ScanFeedback}" Visibility="{Binding SplitVisible,Converter={StaticResource VisibleWhenTrue}}" FontSize="13" Foreground="{StaticResource Warning}"/><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PrimaryAction" Content="{Binding ActionLabel}" Click="PrimaryClick" DockPanel.Dock="Right" Style="{StaticResource LaneAction}" IsEnabled="{Binding CanPrimary}" MinWidth="150" ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"/><WrapPanel x:Name="SecondaryActions" Visibility="{Binding ShowDisposition,Converter={StaticResource VisibleWhenTrue}}"><Button Content="处置" Click="CancelClick" IsEnabled="{Binding CanCancel}" ToolTip="核对并处置本通道未提交草稿；保留原请求与实体责任"/></WrapPanel></StackPanel><StackPanel><TextBlock Text="{Binding ActionSummary}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding DisabledReason}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Occupancy}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Border>
</UserControl>
