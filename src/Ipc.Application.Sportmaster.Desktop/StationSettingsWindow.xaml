<Window x:Class="Ipc.Application.Sportmaster.Desktop.StationSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf"
 Title="{DynamicResource Settings.StationTitle}" Width="1220" Height="800" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Background}">
 <Window.Resources>
  <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource WorkstationCard}">
   <Setter Property="Padding" Value="16,12"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="SettingsCardHeading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Position}"/>
   <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <DataTemplate x:Key="ReadOnlySettingsField">
   <StackPanel Margin="0,0,12,8">
    <TextBlock x:Name="Label" Text="{Binding Label}" Style="{DynamicResource FieldLabel}" Margin="0,0,0,3"/>
    <TextBox Style="{DynamicResource ReadonlyValue}" Text="{Binding Value,Mode=OneWay}" IsTabStop="True"
             AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.LabeledBy="{Binding ElementName=Label}"/>
   </StackPanel>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="SettingsThreeColumns"><UniformGrid Columns="3"/></ItemsPanelTemplate>
 </Window.Resources>
 <Grid Background="{DynamicResource Background}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
   <DockPanel>
    <Button x:Name="EditSettings" DockPanel.Dock="Right" Content="{DynamicResource Settings.UnlockEdit}" Click="Edit_Click" Style="{DynamicResource Primary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings.StationTitle}" FontSize="{x:Static type:UiTypography.PageTitle}"
               FontWeight="{x:Static type:UiTypography.Emphasis}" VerticalAlignment="Center"/>
    <Border Style="{DynamicResource OperatorStatusBadge}" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}"
            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
     <TextBlock x:Name="AuthorizationText" Text="{DynamicResource Settings.ReadOnly}" FontSize="{x:Static type:UiTypography.Label}"
                Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/>
    </Border>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <ScrollViewer x:Name="ReadOnlyBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
     <TextBox x:Name="ReadOnlySettings" Style="{DynamicResource ReadonlyValue}" IsTabStop="True" Margin="0,0,0,12" AutomationProperties.Name="{DynamicResource Settings.VersionStatus}"/>
     <StackPanel x:Name="EffectiveSettingsCards">
      <Border Style="{StaticResource SettingsCard}">
       <StackPanel>
        <TextBlock Text="{DynamicResource Common.StationRcs}" Style="{StaticResource SettingsCardHeading}"/>
        <ItemsControl x:Name="StationFields" ItemsPanel="{StaticResource SettingsThreeColumns}" ItemTemplate="{StaticResource ReadOnlySettingsField}"/>
       </StackPanel>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
         <DockPanel Margin="0,0,0,8">
          <Border DockPanel.Dock="Right" Style="{StaticResource OperatorStatusBadge}" Background="{Binding Left.DevicePresentation.Background}"
                  BorderBrush="{Binding Left.DevicePresentation.Border}">
           <TextBlock Text="{Binding Left.DevicePresentation.Text}" type:PaletteBrush.ForegroundKey="{Binding Left.DeviceForegroundKey}" FontSize="{x:Static type:UiTypography.Label}"/>
          </Border>
          <TextBlock Text="{DynamicResource Common.CamerasLeft}" Style="{StaticResource SettingsCardHeading}" Margin="0"/>
         </DockPanel>
         <ItemsControl x:Name="LeftCameraFields" ItemTemplate="{StaticResource ReadOnlySettingsField}"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Style="{StaticResource SettingsCard}">
        <StackPanel>
         <DockPanel Margin="0,0,0,8">
          <Border DockPanel.Dock="Right" Style="{StaticResource OperatorStatusBadge}" Background="{Binding Right.DevicePresentation.Background}"
                  BorderBrush="{Binding Right.DevicePresentation.Border}">
           <TextBlock Text="{Binding Right.DevicePresentation.Text}" type:PaletteBrush.ForegroundKey="{Binding Right.DeviceForegroundKey}" FontSize="{x:Static type:UiTypography.Label}"/>
          </Border>
          <TextBlock Text="{DynamicResource Common.CamerasRight}" Style="{StaticResource SettingsCardHeading}" Margin="0"/>
         </DockPanel>
         <ItemsControl x:Name="RightCameraFields" ItemTemplate="{StaticResource ReadOnlySettingsField}"/>
        </StackPanel>
       </Border>
      </Grid>
     </StackPanel>
     <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
       <TextBlock Text="{DynamicResource Common.SetupDisplay}" Style="{StaticResource SettingsCardHeading}"/>
       <ItemsControl x:Name="PreferenceFields" ItemsPanel="{StaticResource SettingsThreeColumns}" ItemTemplate="{StaticResource ReadOnlySettingsField}"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <ContentControl x:Name="EditorHost" Visibility="Collapsed"/>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource OperatorActionFooter}" Padding="20,0" Height="64">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="ReturnToWorkstation" Content="{DynamicResource Settings.ReturnWork}" Click="Return_Click" Margin="0,0,8,0"
             ToolTip="{DynamicResource Settings.HideHelp}"/>
     <Button x:Name="CloseSettings" Content="{DynamicResource Common.Close}" Click="Close_Click" Margin="0,0,8,0"
             ToolTip="{DynamicResource Settings.CloseHelp}"/>
     <StackPanel x:Name="EditActions" Orientation="Horizontal" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
     <TextBlock x:Name="SettingsDraft" Text="{Binding ConfigurationDraftStatusText}" Visibility="Collapsed" ToolTip="{Binding ConfigurationDraftStatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="SettingsFeedback" Text="{Binding WorkFeedback}" FontSize="{x:Static type:UiTypography.Label}"
                Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                ToolTip="{Binding WorkFeedback}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</Window>
