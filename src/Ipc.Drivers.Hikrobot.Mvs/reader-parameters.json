    "AppliesWhenKey": "reader.engine",
    "AppliesWhenEquals": "zxing-cpp",
    "ApplyLevel": "GuardedLive"
  },
  {
    "Key": "motion.still-ms",
    "Group": "识别 / 静止判定",
    "Label": "放稳后再识别",
    "Type": "integer",
    "Default": "200",
    "Minimum": 0,
    "Maximum": 2000,
    "MaximumLength": 4,
    "Unit": "毫秒",
    "Description": "放稳后接收识别结果，默认200毫秒。软件识别在放稳后执行；海康原生识码已随采图完成，放置过程中的结果不进入供包业务。0表示每帧接收。",
    "ApplyLevel": "GuardedLive"
  }
