<Window x:Class="Ipc.Operations.Desktop.OperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf"
        Title="供包运维工具" Width="1280" Height="760" MinWidth="880" MinHeight="560"
        Background="{DynamicResource Background}" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="OperationsCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="OperationsSection" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Group}"/>
   <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  </Style>
  <Style x:Key="OperationsHint" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="OperationsToggle" TargetType="ToggleButton">
   <Setter Property="MinHeight" Value="44"/>
   <Setter Property="Padding" Value="12,4"/>
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="{DynamicResource Soft}"/>
    </Trigger>
    <Trigger Property="IsChecked" Value="True">
     <Setter Property="Background" Value="{DynamicResource AccentBackground}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
     <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
     <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OperationsTab" TargetType="TabItem">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2"
              BorderBrush="Transparent" Padding="4,0" MinHeight="48" Margin="0,0,24,0">
       <ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextElement.Foreground="{DynamicResource Muted}" TextElement.FontWeight="{x:Static type:UiTypography.Regular}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource Accent}"/>
        <Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="{DynamicResource Soft}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OperationsSummaryValue" TargetType="TextBlock" BasedOn="{StaticResource OperationsSection}">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Position}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>
  <Style x:Key="OperationsDebugAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Warning}"/>
   <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
  </Style>
  <Style x:Key="LogFilterField" TargetType="StackPanel">
   <Setter Property="Margin" Value="0,0,8,6"/>
  </Style>
  <DataTemplate x:Key="PositionOverviewCard">
   <Border Style="{StaticResource OperationsCard}" Margin="4,0,4,8">
    <StackPanel>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
      <DockPanel>
       <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,4" Margin="8,0,0,0">
        <Border.Style>
         <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource Soft}"/>
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding AllowsSupply}" Value="True">
            <Setter Property="Background" Value="{DynamicResource SuccessBackground}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Border.Style>
        <TextBlock Text="{Binding Status}" FontSize="{x:Static type:UiTypography.Label}"/>
       </Border>
       <TextBlock Text="{Binding Title}" Style="{StaticResource OperationsSection}" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="小车状态" Style="{StaticResource OperationsHint}"/>
      <TextBox Grid.Column="1" Text="{Binding Vehicle, Mode=OneWay}" Style="{DynamicResource ReadonlyValue}"/>
      <TextBlock Grid.Row="1" Text="当前轮次" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Round, Mode=OneWay}" Style="{DynamicResource ReadonlyValue}" Margin="0,4,0,0"/>
      <TextBlock Grid.Row="2" Text="当前任务" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Operation, Mode=OneWay}" Style="{DynamicResource ReadonlyValue}" Margin="0,4,0,0"/>
      <TextBlock Grid.Row="3" Text="人工输入" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Manual}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Grid.Row="4" Text="供包提示" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      <TextBox Grid.Row="4" Grid.Column="1" Style="{DynamicResource ReadonlyValue}" Text="{Binding Notice,Mode=OneWay}" IsTabStop="True" Margin="0,4,0,0" AutomationProperties.Name="本位供包提示，可复制"/>
     </Grid>
    </StackPanel>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="DeviceOverviewCard">
   <Border Style="{StaticResource OperationsCard}" Background="{DynamicResource Soft}" Padding="12" Margin="4">
    <StackPanel>
     <TextBlock Text="{Binding Title}" Style="{StaticResource OperationsHint}"/>
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Confirmed}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Success}"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <TextBlock Text="{Binding Detail}" Style="{StaticResource OperationsHint}"/>
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <Border x:Name="HeaderBar" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
           BorderThickness="0,0,0,1" Padding="24,0" MinHeight="64">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid VerticalAlignment="Center" Margin="0,0,8,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition MaxWidth="160"/></Grid.ColumnDefinitions>
      <TextBlock Text="供包运维工具" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"
                 Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
      <Border Grid.Column="1" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="6" Padding="8,3" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
       <TextBlock x:Name="StationText" Text="站点待核验" TextTrimming="CharacterEllipsis"
                  Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}"/>
      </Border>
     </Grid>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
      <Border x:Name="ConnectionPill" Padding="9,4" Background="{DynamicResource Soft}" CornerRadius="{DynamicResource RadiusBadge}" VerticalAlignment="Center">
       <TextBlock x:Name="ConnectionText" Text="核验连接中" FontSize="{x:Static type:UiTypography.Label}"
                  AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource Muted}"/>
      </Border>
      <ContentControl x:Name="AuthorizationStatusHost" Margin="6,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <ContentControl x:Name="AuthorizationActionHost" VerticalAlignment="Center"/>
      <ToggleButton x:Name="EnvironmentToggle" Content="环境信息" Style="{StaticResource OperationsToggle}" Margin="6,0,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border x:Name="EnvironmentInfo" Margin="24,4,24,4" Padding="12,4">
    <Border.Style>
     <Style TargetType="Border" BasedOn="{StaticResource OperationsCard}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsChecked, ElementName=EnvironmentToggle}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
       <TextBox x:Name="InstallationText" Style="{DynamicResource ReadonlyValue}" IsTabStop="True" AutomationProperties.Name="版本、完整来源和本机路径"/>
       <TextBlock x:Name="ConnectionDetails" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      </StackPanel>
      <ContentControl x:Name="AuthorizationDetailsHost" Grid.Column="1"/>
     </Grid>
    </ScrollViewer>
   </Border>
   <ContentControl x:Name="WorkspaceNoticeHost" Margin="24,0"/>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
          BorderThickness="0,1,0,0" MinHeight="32" Padding="24,0">
   <DockPanel VerticalAlignment="Center">
    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource OperationsHint}" Margin="12,0,0,0"/>
    <TextBlock Text="查看不会暂停供包。软件暂停不是安全急停。" Style="{StaticResource OperationsHint}"/>
   </DockPanel>
  </Border>
  <TabControl x:Name="Pages" ItemContainerStyle="{StaticResource OperationsTab}" Padding="0" SelectionChanged="PageChanged">
   <TabControl.Template>
    <ControlTemplate TargetType="TabControl">
     <DockPanel KeyboardNavigation.TabNavigation="Local">
      <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
       <TabPanel IsItemsHost="True" Margin="24,0" KeyboardNavigation.TabIndex="1"/>
      </Border>
      <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
     </DockPanel>
    </ControlTemplate>
   </TabControl.Template>
   <TabItem Header="运行总览">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="20,16,20,14">
      <UniformGrid x:Name="OverviewMetrics" Columns="4" Margin="0,0,0,8">
       <Border Style="{StaticResource OperationsCard}" Margin="4">
        <StackPanel>
         <TextBlock Text="工作站状态" Style="{StaticResource OperationsHint}"/>
         <TextBlock x:Name="OverviewStatus" Text="待确认" Style="{StaticResource OperationsSummaryValue}"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource OperationsCard}" Margin="4">
        <StackPanel>
         <TextBlock Text="当前可见作业" Style="{StaticResource OperationsHint}"/>
         <TextBlock x:Name="VisibleOperationsText" Text="待确认" Style="{StaticResource OperationsSummaryValue}"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource OperationsCard}" Margin="4">
        <StackPanel>
         <TextBlock Text="当前未确认 / 历史保管" Style="{StaticResource OperationsHint}"/>
         <TextBlock x:Name="UnconfirmedOperationsText" Text="待确认" Style="{StaticResource OperationsSummaryValue}"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource OperationsCard}" Margin="4">
        <StackPanel>
         <TextBlock Text="待生效设置" Style="{StaticResource OperationsHint}"/>
         <TextBlock x:Name="PendingOverviewText" Text="待确认" Style="{StaticResource OperationsSummaryValue}"/>
        </StackPanel>
       </Border>
      </UniformGrid>
      <TextBlock x:Name="OverviewSummary" Style="{StaticResource OperationsHint}" Margin="4,0,4,10"/>
      <ItemsControl x:Name="PositionCards" ItemTemplate="{StaticResource PositionOverviewCard}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
      <Border Style="{StaticResource OperationsCard}" Margin="4,4,4,8">
       <StackPanel>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="4,0,4,4">
         <TextBlock Text="关键设备与存储确认" Style="{StaticResource OperationsSection}"/>
        </Border>
        <ItemsControl x:Name="DeviceRows" ItemTemplate="{StaticResource DeviceOverviewCard}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
       </StackPanel>
      </Border>
      <Expander Header="技术详情与阻断原因" Margin="0,2,8,0">
       <TextBox x:Name="TechnicalText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                VerticalScrollBarVisibility="Auto" MaxHeight="220"/>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="日志中心">
    <DockPanel Margin="24,16,24,12" Background="{DynamicResource Surface}">
     <Border DockPanel.Dock="Top" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}"
             BorderThickness="0,0,0,1" Padding="12,8">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" AutomationProperties.Name="日志来源">
       <RadioButton x:Name="OfflineLogMode" Content="离线运行日志 · 只读" GroupName="OperationsLogMode" IsChecked="True"
                    Style="{StaticResource OperationsToggle}" AutomationProperties.AutomationId="Operations.LogMode.Offline"
                    ToolTip="只读取已落盘运行日志"/>
       <RadioButton x:Name="OnlineLogMode" Content="完整在线日志 · 需授权" GroupName="OperationsLogMode" Margin="4,0,0,0"
                    Style="{StaticResource OperationsToggle}" AutomationProperties.AutomationId="Operations.LogMode.Online"
                    ToolTip="使用工作站的已授权连接查询完整在线日志"/>
      </StackPanel>
     </Border>
     <Grid>
      <ContentControl x:Name="OnlineLogs" Visibility="Collapsed"/>
      <Grid x:Name="OfflineLogs" Margin="12,8">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <WrapPanel x:Name="Filters" Margin="0,0,0,4">
        <WrapPanel.Resources>
         <ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/ParameterSettingsTheme.xaml"/>
        </WrapPanel.Resources>
        <StackPanel Style="{StaticResource LogFilterField}" Width="228">
         <TextBlock Text="日志范围" Style="{StaticResource OperationsHint}"/>
         <ComboBox x:Name="LogAreas" Margin="0" Height="44" TextSearch.TextPath="Label" AutomationProperties.Name="日志范围">
          <ComboBox.ItemTemplate>
           <DataTemplate>
            <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" MaxWidth="184"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           </DataTemplate>
          </ComboBox.ItemTemplate>
         </ComboBox>
        </StackPanel>
        <StackPanel Style="{StaticResource LogFilterField}" Width="148">
         <TextBlock Text="时间" Style="{StaticResource OperationsHint}"/>
         <ComboBox x:Name="TimeRange" Margin="0" SelectedIndex="0" Height="44" AutomationProperties.Name="日志时间范围">
          <ComboBoxItem Content="最近1小时"/><ComboBoxItem Content="今天"/><ComboBoxItem Content="最近24小时"/>
         </ComboBox>
        </StackPanel>
        <StackPanel Style="{StaticResource LogFilterField}" Width="88">
         <TextBlock Text="级别" Style="{StaticResource OperationsHint}"/>
         <ComboBox x:Name="Level" Margin="0" SelectedIndex="0" Height="44" AutomationProperties.Name="日志级别">
          <ComboBoxItem Content="全部"/><ComboBoxItem Content="错误"/><ComboBoxItem Content="警告"/><ComboBoxItem Content="信息"/>
         </ComboBox>
        </StackPanel>
        <StackPanel Style="{StaticResource LogFilterField}" Width="88">
         <TextBlock Text="来源" Style="{StaticResource OperationsHint}"/>
         <TextBox x:Name="SourceFilter" Height="44" Margin="0" AutomationProperties.Name="日志来源"/>
        </StackPanel>
        <StackPanel Style="{StaticResource LogFilterField}" Width="126">
         <TextBlock Text="关键词" Style="{StaticResource OperationsHint}"/>
         <TextBox x:Name="Keyword" Height="44" Margin="0" AutomationProperties.Name="日志关键词"/>
        </StackPanel>
        <CheckBox x:Name="KeyEvents" Content="关键事件" IsChecked="True" VerticalAlignment="Bottom" MinHeight="44" Margin="0,0,0,6"/>
       </WrapPanel>
       <DockPanel Grid.Row="1" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
         <Button x:Name="QueryButton" Content="查询" Click="QueryClick" Style="{DynamicResource Primary}"/>
         <Button x:Name="CancelQuery" Content="取消查询" Click="CancelClick" IsEnabled="False" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="LogStatus" Text="只读取已落盘运行日志。" Style="{StaticResource OperationsHint}"
                   VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.LiveSetting="Polite"/>
       </DockPanel>
       <DataGrid x:Name="LogGrid" Grid.Row="2" RowHeight="44" FontSize="{x:Static type:UiTypography.Log}" SelectionMode="Extended"
                 SelectionUnit="FullRow" SelectionChanged="LogSelectionChanged" ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="查询日志">
        <DataGrid.Columns>
         <DataGridTextColumn Header="时间（本机）" Binding="{Binding At, StringFormat={}{0:MM-dd HH:mm:ss.fff}}" Width="180"/>
         <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="75"/>
         <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="110"/>
         <DataGridTextColumn Header="事件" Binding="{Binding EventCode}" Width="210"/>
         <DataGridTextColumn Header="原文" Binding="{Binding Text}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBox x:Name="LogDetail" Grid.Row="3" Visibility="Collapsed" Height="100" IsReadOnly="True" TextWrapping="NoWrap"
                AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="所选日志原文"/>
       <DockPanel Grid.Row="4" Margin="0,6,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button Content="复制所选原文" Click="CopyClick"/>
         <Button x:Name="PreviousButton" Content="上一页" Click="PreviousClick" IsEnabled="False" Margin="6,0,0,0"/>
         <Button x:Name="NextButton" Content="下一页" Click="NextClick" IsEnabled="False" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="PageText" Style="{StaticResource OperationsHint}" VerticalAlignment="Center"/>
       </DockPanel>
       <Expander Grid.Row="5" Header="查询范围与完整性说明">
        <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto">
         <StackPanel>
          <TextBlock Text="离线查询只读取运行日志，不读取业务数据库或认证日志。" Style="{StaticResource OperationsHint}"/>
          <TextBox x:Name="LogNotices" Style="{DynamicResource ReadonlyValue}"/>
         </StackPanel>
        </ScrollViewer>
       </Expander>
      </Grid>
     </Grid>
    </DockPanel>
   </TabItem>
   <TabItem Header="设备调试" Tag="debug"><ContentControl x:Name="DeviceDebugPage" Margin="24,16,24,12"/></TabItem>
   <TabItem Header="专业参数" Tag="parameters">
    <Border Style="{StaticResource OperationsCard}" Margin="24,16,24,12" Padding="0" ClipToBounds="True">
     <ContentControl x:Name="ProfessionalPage"/>
    </Border>
   </TabItem>
   <TabItem Header="维护中心" Tag="maintenance"><ContentControl x:Name="MaintenancePage"/></TabItem>
  </TabControl>
 </DockPanel>
</Window>
