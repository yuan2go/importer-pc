<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
  <WrapPanel Grid.ColumnSpan="2"><Button Content="读取最新50条" Click="Refresh_Click"/><Button Content="下一页" Click="Next_Click" IsEnabled="{Binding HasNextHistory}"/><TextBlock Text="{Binding CapacityState}" VerticalAlignment="Center"/></WrapPanel>
  <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" RowHeight="44"><DataGrid.Columns><DataGridTextColumn Header="投递位" Binding="{Binding Operation.PositionId}"/><DataGridTextColumn Header="包裹号" Binding="{Binding Operation.ParcelCode}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Operation.State}" Width="*"/><DataGridTextColumn Header="格口" Binding="{Binding Operation.Slot}" Width="90"/><DataGridCheckBoxColumn Header="归档原件" Binding="{Binding Archived}"/></DataGrid.Columns></DataGrid>
  <DockPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding HistoryCommandTarget}" TextWrapping="Wrap"/><WrapPanel><Button Content="核对所选原请求" Click="Query_Click" IsEnabled="{Binding CanHistoryQuery}"/><Button Content="继续所选未尝试阶段" Click="Continue_Click" IsEnabled="{Binding CanHistoryContinue}"/></WrapPanel><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="重启后的原实体检查说明；不替代现场安全许可"/></StackPanel><TextBox Text="{Binding Details}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel>
 </Grid>
</UserControl>
