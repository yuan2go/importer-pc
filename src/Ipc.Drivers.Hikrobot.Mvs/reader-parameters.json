    "MaximumLength": 32,
    "MaximumItems": 64,
    "Description": "默认全部码制。可多选现场实际码制；全部与具体码制互斥。减少码制可能漏读未勾选标签，保存并受控启用后生效。"
  },
  {
    "Key": "code.try-invert",
    "Group": "识别 / 图像",
    "Label": "识别反色条码",
    "Type": "boolean",
    "Default": "true",
    "Description": "仅用于软件识别。海康原生识码使用厂商算法的图像处理。"
  },
  {
    "Key": "motion.still-ms",
    "Group": "识别 / 静止判定",
    "Label": "放稳后再识别",
    "Type": "integer",
    "Default": "200",
    "Minimum": 0,
    "Maximum": 2000,
    "MaximumLength": 4,
    "Unit": "毫秒",
    "Description": "放稳后接收识别结果，默认200毫秒。软件识别在放稳后执行；海康原生识码已随采图完成，放置过程中的结果不进入供包业务。0表示每帧接收。"
  }
