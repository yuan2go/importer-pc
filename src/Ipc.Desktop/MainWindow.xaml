<Window x:Class="Ipc.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ipc.Desktop" Title="供包工作站" Width="1440" Height="900" MinWidth="640" MinHeight="420" Closing="WindowClosing" SizeChanged="WindowSizeChanged">
 <Grid x:Name="ClientArea" Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="4,0,4,8"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><TextBlock Text="供包工作站" FontSize="24" FontWeight="SemiBold"/><Border Background="#205FCE" CornerRadius="4" Padding="10,4" Margin="12,0"><TextBlock x:Name="ModeBadge" Text="SIMULATION" Foreground="White" FontWeight="Bold"/></Border></StackPanel><WrapPanel HorizontalAlignment="Right"><TextBlock Text="{Binding Identity}" Margin="8,0"/><Button Content="第二窗口" Click="SecondViewClick"/><Button x:Name="LayoutButton" Content="标准 / 紧凑" Click="LayoutClick"/><Button Tag="Logout" Content="登出" Click="LogoutClick"/></WrapPanel></DockPanel>
  <Border x:Name="StatusBanner" Grid.Row="1" Background="#EEF4FF" BorderBrush="#D8E0E7" BorderThickness="1" Padding="10" Margin="0,0,0,8" MaxHeight="100"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding GlobalStatus}" AutomationProperties.LiveSetting="Assertive"/><TextBlock Text="{Binding Projection}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></ScrollViewer></Border>
  <TabControl x:Name="Pages" Grid.Row="2" SelectionChanged="TabChanged">
   <TabItem x:Name="WorkstationPage" Header="工作台"><Grid x:Name="WorkstationBody"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="WorkScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前箱 / 箱波次" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Context}" FontSize="22" FontWeight="SemiBold" Margin="0,6"/><TextBlock Text="{Binding ContextSource}" FontSize="12" Foreground="{StaticResource Muted}"/><WrapPanel Margin="0,6"><TextBox Text="{Binding BoxDraft,UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="箱码草稿" KeyDown="BoxKeyDown"/><Button Tag="OpenContext" Content="校验新箱" Click="OpenClick"/></WrapPanel></StackPanel><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="本箱唯一接受量" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Accepted}" FontSize="32" Foreground="#147450" FontWeight="SemiBold"/><TextBlock Text="按唯一接受账累计" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Grid></Border>
     <Grid x:Name="LaneGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><local:LaneControl x:Name="LeftLane"/><local:LaneControl x:Name="RightLane" Grid.Column="1"/></Grid>
     <TextBlock Text="最近作业 · 点击查看原请求与接受事实" FontWeight="SemiBold" Margin="12,14,0,6"/><DataGrid x:Name="RecentGrid" Height="174" Margin="6" SelectionChanged="HistorySelected"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130"/><DataGridTextColumn Header="通道" Binding="{Binding Lane}" Width="55"/><DataGridTextColumn Header="Item 条码" Binding="{Binding Barcode}" Width="*"/><DataGridTextColumn Header="数量 / 单位" Binding="{Binding Quantity}" Width="140"/><DataGridTextColumn Header="作业状态" Binding="{Binding Status}" Width="210"/></DataGrid.Columns></DataGrid>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="6"><WrapPanel><Button x:Name="SubmitLeft" Style="{StaticResource Primary}" Content="左通道 · 确认供包" Click="SubmitLeftClick"/><Button x:Name="SubmitRight" Style="{StaticResource Primary}" Content="右通道 · 确认供包" Click="SubmitRightClick"/><Button Tag="Pause" Content="暂停入场" Click="PauseClick"/><Button Tag="Resume" Content="恢复入场" Click="ResumeClick"/><Button Tag="CheckClose" Content="结束检查" Click="CheckClick"/><TextBlock Text="软件暂停不是安全急停" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0"/></WrapPanel></Border>
   </Grid></TabItem>
   <TabItem x:Name="HistoryPage" Header="记录与请求"><Grid x:Name="HistoryBody" Margin="8"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions><Grid x:Name="HistoryList"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBox x:Name="FilterBox" MinWidth="150" AutomationProperties.Name="历史筛选"/><Button Content="查询" Click="HistoryClick"/></DockPanel><DataGrid x:Name="HistoryGrid" Grid.Row="1" SelectionChanged="HistorySelected"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130"/><DataGridTextColumn Header="箱码" Binding="{Binding Box}" Width="130"/><DataGridTextColumn Header="箱波次" Binding="{Binding BoxWave}" Width="120"/><DataGridTextColumn Header="Item 条码" Binding="{Binding Barcode}" Width="160"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130"/><DataGridTextColumn Header="目标格口" Binding="{Binding Destination}" Width="130"/><DataGridTextColumn Header="Item 波次" Binding="{Binding ItemWave}" Width="130"/><DataGridTextColumn Header="任务 ID" Binding="{Binding Task}" Width="150"/><DataGridTextColumn Header="数量 / 单位" Binding="{Binding Quantity}" Width="130"/><DataGridTextColumn Header="状态" Binding="{Binding Status,Converter={StaticResource OperatorLabel}}" Width="190"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="上一页" Click="PreviousClick"/><Button Content="下一页" Click="NextClick"/></StackPanel></Grid><Grid x:Name="HistoryDetail" Grid.Column="1" Margin="10,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Operation → Request → Attempt → Response / Audit" FontWeight="SemiBold" Margin="4,8"/><TreeView x:Name="DetailTree" Grid.Row="1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Grid></TabItem>
   <TabItem x:Name="RecoveryPage" Header="报警与恢复"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="650" Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding AlarmSummary}"/><TextBlock Text="已读不代表恢复。历史分页不影响活动报警。"/></StackPanel>
    <TabControl Grid.Row="1">
     <TabItem Header="活动报警"><DataGrid x:Name="AlarmGrid" SelectionChanged="AlarmSelected"><DataGrid.Columns>
      <DataGridTextColumn Header="发生 UTC" Binding="{Binding RaisedAt}" Width="180"/><DataGridTextColumn Header="范围" Binding="{Binding Scope}"/><DataGridTextColumn Header="原因" Binding="{Binding Code,Converter={StaticResource OperatorLabel}}" Width="*"/><DataGridTextColumn Header="对象" Binding="{Binding OwnerId}" Width="240"/><DataGridTextColumn Header="已读" Binding="{Binding AckedBy}"/>
     </DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="已恢复历史"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="刷新历史" Click="AlarmHistoryClick"/><Button Content="上一页" Click="AlarmPreviousClick"/><Button Content="下一页" Click="AlarmNextClick"/></WrapPanel><DataGrid x:Name="AlarmHistoryGrid" SelectionChanged="AlarmSelected"><DataGrid.Columns>
      <DataGridTextColumn Header="发生 UTC" Binding="{Binding RaisedAt}" Width="180"/><DataGridTextColumn Header="原因" Binding="{Binding Code,Converter={StaticResource OperatorLabel}}" Width="*"/><DataGridTextColumn Header="对象" Binding="{Binding OwnerId}" Width="240"/><DataGridTextColumn Header="恢复 UTC" Binding="{Binding ClearedAt}" Width="180"/><DataGridTextColumn Header="已读" Binding="{Binding AckedBy}"/>
     </DataGrid.Columns></DataGrid></DockPanel></TabItem>
    </TabControl>
    <DataGrid x:Name="RecoveryGrid" Grid.Row="2" SelectionChanged="RecoverySelected"><DataGrid.Columns>
     <DataGridTextColumn Header="原请求" Binding="{Binding Id}" Width="240"/><DataGridTextColumn Header="状态" Binding="{Binding Status,Converter={StaticResource OperatorLabel}}" Width="120"/><DataGridTextColumn Header="阻断 / 本地终结禁止原因" Binding="{Binding Reasons}" Width="*"/><DataGridTextColumn Header="下一步" Binding="{Binding NextStep}" Width="280"/>
    </DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="3"><TextBox x:Name="RequestIdBox" MinWidth="260" AutomationProperties.Name="原请求身份"/><Button Tag="Reconcile" Content="查询原请求结果" Click="ReconcileClick"/><Button Tag="CancelPrepared" x:Name="CancelPreparedButton" Content="终结选中未交付请求" Click="CancelPreparedClick" IsEnabled="False"/><Button Tag="AckAlarm" Content="已读选中报警" Click="AckClick"/><Button Content="查看关联详情" Click="AlarmDetailClick"/><Button Content="当前关闭详情" Click="CloseDetailClick"/></WrapPanel>
    <StackPanel Grid.Row="4"><TextBlock Text="本地终结保留原记录；此前预留与实体仍须另行处置。"/><WrapPanel><TextBox x:Name="EvidenceBox" MinWidth="350" AutomationProperties.Name="人工核对证据"/><Button Tag="RecordReconciliation" Content="记录核对依据" Click="RecordEvidenceClick"/><Button Tag="CancelClose" Content="取消少货关闭" Click="CancelCloseClick"/><Button Tag="ConfirmClose" Content="确认当前检查并关闭" Click="ConfirmCloseClick"/></WrapPanel></StackPanel>
   </Grid></ScrollViewer></TabItem>

   <TabItem x:Name="MaintenancePage" Header="维护配置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="站点配置草稿" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="编辑 → 验证并保存 → 待激活 → 受控重启。激活失败保留上一有效配置。活动箱或未决请求阻止激活。" Margin="0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="站点 ID / 配置版本"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="StationIdField" Width="180" IsReadOnly="True" ToolTip="当前数据根与资源租约绑定此站点；本包不支持重命名"/><TextBox x:Name="VersionField" Width="180"/></StackPanel><TextBlock Grid.Row="1" Text="接收端点"/><TextBox x:Name="EndpointField" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="接收端点"/><TextBlock Grid.Row="2" Text="目标版本 / 合同"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="BindingVersionField" Width="180"/><TextBox x:Name="ContractField" Width="220" IsReadOnly="True"/></StackPanel><TextBlock Grid.Row="3" Text="超时 / 队列容量"/><WrapPanel Grid.Row="3" Grid.Column="1"><TextBox x:Name="TimeoutField" Width="90" ToolTip="请求超时毫秒"/><TextBox x:Name="EventCapacityField" Width="90" ToolTip="观察队列容量"/><TextBox x:Name="CommandCapacityField" Width="90" ToolTip="命令队列容量"/><TextBox x:Name="OutboxCapacityField" Width="90" ToolTip="待决请求容量"/></WrapPanel><TextBlock Grid.Row="4" Text="磁盘低水位 MB"/><TextBox x:Name="MinimumFreeField" Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left"/><TextBlock Grid.Row="5" Text="合成需求 / 包装上限"/><WrapPanel Grid.Row="5" Grid.Column="1"><TextBox x:Name="FixtureDemandField" Width="100" ToolTip="仅 SIMULATION 合成初始需求"/><TextBox x:Name="MaximumPackageField" Width="100" ToolTip="仅 SIMULATION 包装上限"/><TextBox x:Name="PolicyField" Width="240" IsReadOnly="True" ToolTip="数量策略不可由界面另造生产规则"/></WrapPanel></Grid>
    <TextBlock Text="已安装驱动绑定 · 仅列出产品允许的驱动" FontWeight="SemiBold" Margin="0,12,0,8"/><DataGrid x:Name="DeviceConfigGrid" IsReadOnly="False" CanUserAddRows="False" Height="140"><DataGrid.Columns><DataGridTextColumn Header="逻辑角色" Binding="{Binding Role}" IsReadOnly="True" Width="100"/><DataGridComboBoxColumn x:Name="DriverColumn" Header="已安装驱动" SelectedItemBinding="{Binding Driver,UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="绑定版本" Binding="{Binding Revision,UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="回放文件（仅 replay）" Binding="{Binding ReplayFile,UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid>
    <WrapPanel><Button Content="预览差异与校验" Click="PreviewConfigClick"/><Button Tag="SaveConfig" Content="验证并保存草稿" Click="SaveConfigClick"/><Button Content="刷新修订记录" Click="ConfigsClick"/><Button Tag="ActivateConfig" Content="激活选中修订 · 待重启" Click="ActivateClick"/></WrapPanel><TextBlock x:Name="ConfigFeedback" Text="更改仅写入草稿；全部字段在后台再次校验。" Margin="4,8"/><ListBox x:Name="ConfigDiff" MinHeight="70" MaxHeight="180"/><DataGrid x:Name="ConfigsList" Height="150"><DataGrid.Columns><DataGridTextColumn Header="修订 ID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status,Converter={StaticResource OperatorLabel}}" Width="150"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="时间" Binding="{Binding At}" Width="200"/></DataGrid.Columns></DataGrid>
    <Expander Header="高级诊断 · JSON 草稿（不会自动覆盖表单）" Margin="0,12"><StackPanel><TextBox x:Name="ConfigDraft" Height="220" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"/><Button Content="将 JSON 导入表单并校验" Click="ImportConfigClick"/></StackPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="DiagnosticsPage" Header="设备与诊断"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="设备状态与恢复诊断" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeIdentity" FontFamily="Consolas" FontSize="13" Margin="0,8"/><TextBlock Text="{Binding Devices}" Margin="0,8"/><TextBlock Text="查看设备连接与来源代次；更改绑定请使用维护配置。来源核对和过载恢复需要有效维护身份及检查依据。" Margin="0,8"/>
    <WrapPanel><Button Content="导出脱敏诊断" Click="ExportClick"/><Button Tag="Backup" Content="一致性备份" Click="BackupClick"/></WrapPanel><TextBox x:Name="ReviewEvidence" AutomationProperties.Name="来源或恢复检查依据"/><WrapPanel><Button Tag="ReviewObservations" Content="来源观察核对完成" Click="ReviewClick"/><Button Tag="ClearOverload" x:Name="OverloadButton" Content="确认过载检查依据" Click="OverloadClick"/><Button Tag="ClearQuarantine" Content="解除恢复隔离（有依据）" Click="QuarantineClick"/></WrapPanel><TextBlock Text="{Binding RecoveryHint}"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="EngineeringPage" Header="工程控制 · SIMULATION"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="SIMULATION · 独立工程控制" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="以下仅生成合成观察和故障；设备事件需要有效身份，维护动作需要维护角色。真实 SDK、WCS 和现场权限均未取得。" Margin="0,8"/><WrapPanel><Button Tag="Login" Content="模拟操作员" Click="OperatorClick"/><Button Tag="Login" Content="模拟维护员" Click="MaintenanceClick"/></WrapPanel><StackPanel x:Name="EngineeringControls"><TextBlock Text="{Binding Devices}" Margin="0,8"/><WrapPanel><ComboBox x:Name="EngineeringLane" Width="140" SelectedIndex="0"><ComboBoxItem Content="left"/><ComboBoxItem Content="right"/></ComboBox><TextBox x:Name="EngineeringBarcode" Width="220" Text="000123" AutomationProperties.Name="模拟 Item 条码" KeyDown="EngineeringKeyDown"/><TextBox x:Name="EngineeringQuantity" Width="90" Text="1" AutomationProperties.Name="模拟包装量"/></WrapPanel><WrapPanel><Button Tag="Enter" Content="实体入场" Click="EventClick"/><Button Tag="Read" Content="读码" Click="EventClick"/><Button Tag="NoCode" Content="无码" Click="EventClick"/><Button Tag="MultiCode" Content="多码" Click="EventClick"/><Button Tag="Depart" Content="实体离场" Click="EventClick"/><Button Tag="Revalidate" Content="核对实体许可" Click="EventClick"/><Button Tag="Reset" Content="实体复位" Click="EventClick"/><Button Tag="Replay" Content="推进回放" Click="ReplayClick"/></WrapPanel><WrapPanel><ComboBox x:Name="FaultBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="None"/><ComboBoxItem Content="Drop"/><ComboBoxItem Content="Delay"/><ComboBoxItem Content="Reject"/><ComboBoxItem Content="QueryMissing"/><ComboBoxItem Content="QueryUnsupported"/></ComboBox><Button Tag="SetFixtureFault" Content="下个请求故障" Click="FaultClick"/><ComboBox x:Name="BlockBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="EntityPermit"/><ComboBoxItem Content="WcsUnavailable"/><ComboBoxItem Content="License"/><ComboBoxItem Content="DeviceFault"/></ComboBox><Button Tag="SetSyntheticBlock" Content="设置模拟阻断" Click="BlockClick"/><Button Tag="ClearSyntheticBlock" Content="解除模拟阻断" Click="UnblockClick"/></WrapPanel></StackPanel><TextBlock Text="策略 SYNTHETIC-KEEP-v1：扫描保留件，业务接受与实体离场分开。Production 缺必需能力继续 NotReady。" Margin="0,16"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <ScrollViewer Grid.Row="3" MaxHeight="60" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding LastResult}" Margin="4,8,4,0" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/></ScrollViewer>
  <Border x:Name="SmallAreaWarning" Grid.Row="2" Background="#FDF0F0" BorderBrush="#B52F38" BorderThickness="2" Padding="24" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><TextBlock Text="有效显示区域不足 · 已阻断业务输入" FontSize="24" Foreground="#B52F38"/><TextBlock Text="请扩大窗口，或调整显示缩放，使客户区至少达到 800 × 420 DIP。设备与后台状态继续保留；扩大后重新取得新鲜投影才恢复操作。" Margin="0,14"/></StackPanel></Border>
 </Grid>
</Window>
