<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><ApplicationManifest>app.manifest</ApplicationManifest><EnableWindowsTargeting>true</EnableWindowsTargeting><BusinessModule Condition="'$(BusinessModule)' == ''">Supply</BusinessModule><NuGetLockFilePath Condition="'$(NuGetLockFilePath)' == ''">packages.$([System.String]::Copy('$(BusinessModule)').ToLowerInvariant()).lock.json</NuGetLockFilePath><EnableDefaultCompileItems>false</EnableDefaultCompileItems><EnableDefaultPageItems>false</EnableDefaultPageItems><EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition></PropertyGroup>
 <ItemGroup><Page Include="Themes/Workstation.xaml"/></ItemGroup>
 <ItemGroup Condition="'$(BusinessModule)' == 'Supply'"><Compile Include="App.xaml.cs"/><Compile Include="../Ipc.Application.Supply.Desktop/*.cs" Link="Supply/%(Filename)%(Extension)"/><Page Include="../Ipc.Application.Supply.Desktop/*.xaml" Link="Supply/%(Filename)%(Extension)"/><ApplicationDefinition Include="App.xaml"/><ProjectReference Include="../Ipc.Product/Ipc.Product.csproj"/></ItemGroup>
 <PropertyGroup Condition="'$(BusinessModule)' == 'Sportmaster'"><DefineConstants>$(DefineConstants);SPORTMASTER</DefineConstants></PropertyGroup>
 <PropertyGroup Condition="'$(BusinessModule)' == 'DirectPlc'"><DefineConstants>$(DefineConstants);DIRECTPLC</DefineConstants></PropertyGroup>
 <PropertyGroup Condition="'$(BusinessModule)' == 'WcsToPlc'"><DefineConstants>$(DefineConstants);WCSTOPLC</DefineConstants></PropertyGroup>
 <ItemGroup Condition="'$(BusinessModule)' == 'Sportmaster' Or '$(BusinessModule)' == 'DirectPlc' Or '$(BusinessModule)' == 'WcsToPlc'"><Compile Include="ParcelApp.xaml.cs"/><Compile Include="DesktopLaunchOptions.cs"/><Compile Include="StartupWorkflows.cs"/><ApplicationDefinition Include="ParcelApp.xaml"/><ProjectReference Include="../Ipc.Assembly/Ipc.Assembly.csproj"/><ProjectReference Include="../Ipc.Application.$(BusinessModule).Desktop/Ipc.Application.$(BusinessModule).Desktop.csproj"/></ItemGroup>
 <Target Name="CheckDesktopSelection" BeforeTargets="PrepareForBuild" Condition="'$(BusinessModule)' != 'Supply' And '$(BusinessModule)' != 'Sportmaster' And '$(BusinessModule)' != 'DirectPlc' And '$(BusinessModule)' != 'WcsToPlc'"><Error Text="This desktop supports Supply, Sportmaster, DirectPlc or WcsToPlc"/></Target>
</Project>
