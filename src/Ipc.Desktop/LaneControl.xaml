<UserControl x:Class="Ipc.Desktop.LaneControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="330">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="6" Padding="16">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><TextBlock Text="{Binding Label}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Health}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel>
   <StackPanel Grid.Row="1" Margin="0,16,0,8"><TextBlock Text="{Binding Status}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBox Text="{Binding Barcode}" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas" FontSize="23" Margin="0" AutomationProperties.Name="完整条码"/><TextBlock Text="{Binding Reason}" Foreground="#B52F38" MaxHeight="70" TextTrimming="None"/></StackPanel>
   <UniformGrid Grid.Row="2" Columns="3" Margin="0,8"><StackPanel><TextBlock Text="包装" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Package}" FontSize="27"/></StackPanel><StackPanel><TextBlock Text="需求快照" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Remaining}" FontSize="27"/></StackPanel><StackPanel><TextBlock Text="供给 / 保留" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Supply}" FontSize="27" FontWeight="Bold"/></StackPanel></UniformGrid>
   <StackPanel Grid.Row="3"><TextBlock Text="{Binding SplitProgress}" FontSize="19" FontWeight="SemiBold"/><DockPanel><TextBox Text="{Binding RetainedDraft,UpdateSourceTrigger=PropertyChanged}" Width="165" AutomationProperties.Name="保留件模拟身份"/><Button Content="计入保留件" Click="ScanClick"/><Button Content="清空计数" Click="ClearClick"/></DockPanel></StackPanel>
   <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,8"><StackPanel><TextBlock Text="{Binding Occupancy}"/><Expander Header="模拟设备事件" IsExpanded="True"><StackPanel><TextBlock Text="SIMULATION · 显式入场、读码、离场和复位" Foreground="#895509"/>
    <DockPanel><TextBox Text="{Binding BarcodeDraft,UpdateSourceTrigger=PropertyChanged}" MinWidth="150" AutomationProperties.Name="模拟条码草稿"/><TextBox Text="{Binding QuantityDraft,UpdateSourceTrigger=PropertyChanged}" Width="65" AutomationProperties.Name="模拟包装数量"/></DockPanel>
    <WrapPanel><Button Content="实体入场" Tag="Enter" Click="EventClick"/><Button Content="读码" Tag="Read" Click="EventClick"/><Button Content="无码" Tag="NoCode" Click="EventClick"/><Button Content="多码" Tag="MultiCode" Click="EventClick"/><Button Content="实体离场" Tag="Depart" Click="EventClick"/><Button Content="核对实体许可" Tag="Revalidate" Click="EventClick"/><Button Content="实体复位" Tag="Reset" Click="EventClick"/><Button Content="推进回放" Click="ReplayClick"/></WrapPanel>
   </StackPanel></Expander></StackPanel></ScrollViewer>
   <WrapPanel Grid.Row="5"><Button Style="{StaticResource Primary}" Content="确认供包" Click="SubmitClick" IsEnabled="{Binding CanSubmit}"/><Button Content="处置未提交草稿" Click="CancelClick"/><Button Content="作业详情" Click="DetailClick"/></WrapPanel>
  </Grid>
 </Border>
</UserControl>
