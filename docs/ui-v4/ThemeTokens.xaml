<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:type="clr-namespace:Ipc.Presentation.Wpf">

    <!--
    ====================================================================================
    importer-pc Commercial Industrial WPF Design System (UI-v4)
    Target Placement: docs/ui-v4/ThemeTokens.xaml -> Merge into src/Ipc.Presentation.Wpf/Themes/Workstation.xaml
    ====================================================================================
    NON-NEGOTIABLE CONSTRAINTS:
    1. TYPOGRAPHY-01: Uses ONLY bundled Noto Sans CJK SC (Regular 400 / Medium 500) via
       UiTypography.Interface / UiTypography.Code / UiTypography.Regular / UiTypography.Emphasis.
       NEVER introduce Bold (700), system fonts, or monospace fonts.
    2. BACKWARDS COMPATIBILITY: Preserves 100% of existing Workstation.xaml resource keys
       (Background, Surface, Soft, Ink, Muted, Line, Accent*, Success*, Warning*, Danger*,
       Primary, DangerButton, LaneAction, ReadonlyValue, CodeValue, FieldLabel,
       OperatorActionFooter, OperatorStatusBadge, OperatorCopyableNotice, ContentOnlyTabs,
       ContentOnlyTab, FocusRing) so existing XAML & Ipc.Desktop.UiVerification assertions pass.
    3. ZERO DASHED FOCUS FRAMES: All container & interactive controls suppress Win32/WPF
       dotted focus rectangles and render crisp solid 2px Accent keyboard focus rings.
    4. TOUCH & ERGONOMICS: Interactive controls enforce >= 44 DIP minimum target height.
    ====================================================================================
    -->

    <!-- =============================================================================== -->
    <!-- 1. DESIGN TOKENS: COLORS, BRUSHES, RADII, SHADOWS                               -->
    <!-- =============================================================================== -->

    <!-- Base Colors -->
    <Color x:Key="ColorBackground">#F1F4F7</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSoft">#F6F8FA</Color>
    <Color x:Key="ColorSurfaceHover">#F8FAFC</Color>
    <Color x:Key="ColorSurfacePressed">#E9EEF4</Color>
    <Color x:Key="ColorSurfaceDisabled">#F1F4F7</Color>

    <Color x:Key="ColorInk">#192736</Color>
    <Color x:Key="ColorMuted">#536577</Color>
    <Color x:Key="ColorSubtle">#7A8B9C</Color>
    <Color x:Key="ColorDisabledText">#8C9AA8</Color>

    <Color x:Key="ColorLine">#D8E0E7</Color>
    <Color x:Key="ColorLineStrong">#B8C5D2</Color>
    <Color x:Key="ColorLineSubtle">#E6ECF2</Color>

    <Color x:Key="ColorAccent">#205FCE</Color>
    <Color x:Key="ColorAccentHover">#184FAA</Color>
    <Color x:Key="ColorAccentPressed">#123D8B</Color>
    <Color x:Key="ColorAccentBackground">#EEF4FF</Color>
    <Color x:Key="ColorAccentBorder">#BDD3FA</Color>

    <Color x:Key="ColorSuccess">#147450</Color>
    <Color x:Key="ColorSuccessHover">#0F5E40</Color>
    <Color x:Key="ColorSuccessBackground">#EDF7F1</Color>
    <Color x:Key="ColorSuccessBorder">#B7E2CC</Color>

    <Color x:Key="ColorWarning">#895509</Color>
    <Color x:Key="ColorWarningBackground">#FFF5DF</Color>
    <Color x:Key="ColorWarningBorder">#F5D799</Color>

    <Color x:Key="ColorDanger">#B52F38</Color>
    <Color x:Key="ColorDangerHover">#95242C</Color>
    <Color x:Key="ColorDangerPressed">#781B22</Color>
    <Color x:Key="ColorDangerBackground">#FDF0F0</Color>
    <Color x:Key="ColorDangerBorder">#F0BFC3</Color>

    <!-- Core Semantic Brushes (100% compatible with existing Workstation.xaml keys) -->
    <SolidColorBrush x:Key="Background" Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="Soft" Color="{StaticResource ColorSoft}"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource ColorSurfaceHover}"/>
    <SolidColorBrush x:Key="SurfacePressed" Color="{StaticResource ColorSurfacePressed}"/>
    <SolidColorBrush x:Key="SurfaceDisabled" Color="{StaticResource ColorSurfaceDisabled}"/>

    <SolidColorBrush x:Key="Ink" Color="{StaticResource ColorInk}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource ColorMuted}"/>
    <SolidColorBrush x:Key="Subtle" Color="{StaticResource ColorSubtle}"/>
    <SolidColorBrush x:Key="DisabledText" Color="{StaticResource ColorDisabledText}"/>

    <SolidColorBrush x:Key="Line" Color="{StaticResource ColorLine}"/>
    <SolidColorBrush x:Key="LineStrong" Color="{StaticResource ColorLineStrong}"/>
    <SolidColorBrush x:Key="LineSubtle" Color="{StaticResource ColorLineSubtle}"/>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource ColorAccentPressed}"/>
    <SolidColorBrush x:Key="AccentBackground" Color="{StaticResource ColorAccentBackground}"/>
    <SolidColorBrush x:Key="AccentBorder" Color="{StaticResource ColorAccentBorder}"/>

    <SolidColorBrush x:Key="Success" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="SuccessHover" Color="{StaticResource ColorSuccessHover}"/>
    <SolidColorBrush x:Key="SuccessBackground" Color="{StaticResource ColorSuccessBackground}"/>
    <SolidColorBrush x:Key="SuccessBorder" Color="{StaticResource ColorSuccessBorder}"/>

    <SolidColorBrush x:Key="Warning" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="WarningBackground" Color="{StaticResource ColorWarningBackground}"/>
    <SolidColorBrush x:Key="WarningBorder" Color="{StaticResource ColorWarningBorder}"/>

    <SolidColorBrush x:Key="Danger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="DangerHover" Color="{StaticResource ColorDangerHover}"/>
    <SolidColorBrush x:Key="DangerPressed" Color="{StaticResource ColorDangerPressed}"/>
    <SolidColorBrush x:Key="DangerBackground" Color="{StaticResource ColorDangerBackground}"/>
    <SolidColorBrush x:Key="DangerBorder" Color="{StaticResource ColorDangerBorder}"/>

    <!-- Radii & Spacing Tokens -->
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">10</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">12</CornerRadius>

    <Thickness x:Key="PaddingCard">16</Thickness>
    <Thickness x:Key="PaddingCardCompact">12,10</Thickness>
    <Thickness x:Key="PaddingHeader">20,12</Thickness>
    <Thickness x:Key="PaddingFooter">20,12</Thickness>

    <!-- Subtle Industrial Elevation Shadows (GPU-lightweight, restrained opacity) -->
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="8" ShadowDepth="1" Direction="270" Color="#192736" Opacity="0.05"/>
    <DropShadowEffect x:Key="ShadowPopup" BlurRadius="16" ShadowDepth="4" Direction="270" Color="#192736" Opacity="0.14"/>
    <DropShadowEffect x:Key="ShadowDialog" BlurRadius="24" ShadowDepth="6" Direction="270" Color="#192736" Opacity="0.18"/>

    <!-- =============================================================================== -->
    <!-- 2. FOCUS VISUALS (ZERO DASHED FOCUS RECTANGLES)                                 -->
    <!-- =============================================================================== -->

    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Accent}"
                            BorderThickness="2"
                            CornerRadius="7"
                            Margin="-2"
                            SnapsToDevicePixels="True"
                            IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================================== -->
    <!-- 3. WINDOW & TYPOGRAPHY ROLES                                                    -->
    <!-- =============================================================================== -->

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Background}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.PageTitle}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Group}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
    </Style>

    <Style x:Key="DiagnosticText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Diagnostic}"/>
    </Style>

    <!-- =============================================================================== -->
    <!-- 4. SURFACES, CARDS, BARS & STATUS BADGES                                        -->
    <!-- =============================================================================== -->

    <Style x:Key="CommercialCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingCard}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ElevatedCard" TargetType="Border" BasedOn="{StaticResource CommercialCard}">
        <Setter Property="Effect" Value="{StaticResource ShadowCard}"/>
    </Style>

    <Style x:Key="SoftPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Soft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="DangerZoneCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="GlobalHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="{StaticResource PaddingHeader}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="OperatorActionFooter" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Status Badges / Pills -->
    <Style x:Key="OperatorStatusBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBadge}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="StatusBadgeNeutral" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
        <Setter Property="Background" Value="{DynamicResource Soft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    </Style>

    <Style x:Key="StatusBadgeSuccess" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
        <Setter Property="Background" Value="{DynamicResource SuccessBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}"/>
    </Style>

    <Style x:Key="StatusBadgeWarning" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
        <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}"/>
    </Style>

    <Style x:Key="StatusBadgeDanger" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
        <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
    </Style>

    <Style x:Key="StatusBadgeAccent" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
        <Setter Property="Background" Value="{DynamicResource AccentBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
    </Style>

    <!-- =============================================================================== -->
    <!-- 5. BUTTONS (DEFAULT, PRIMARY, QUIET, DANGER, SEGMENTED, CARD ACTION)            -->
    <!-- =============================================================================== -->

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsDefault" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                CornerRadius="{StaticResource RadiusControl}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="KeyboardFocusBorder"
                                CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfacePressed}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceDisabled}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineSubtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Accent Action -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Surface}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                CornerRadius="{StaticResource RadiusControl}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="KeyboardFocusBorder"
                                CornerRadius="8"
                                Margin="-2"
                                BorderBrush="{DynamicResource Ink}"
                                BorderThickness="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentPressed}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceDisabled}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineSubtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preserved LaneAction key -->
    <Style x:Key="LaneAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="48"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PrimaryIsCommand}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Surface}"/>
                <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Solid Danger Action -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
        <Setter Property="Foreground" Value="{DynamicResource Surface}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                CornerRadius="{StaticResource RadiusControl}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="KeyboardFocusBorder" CornerRadius="8" Margin="-2" BorderBrush="{DynamicResource Ink}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerHover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerPressed}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DangerPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceDisabled}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineSubtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Outline Action (for Maintenance Center Danger Zone cards) -->
    <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            CornerRadius="{StaticResource RadiusControl}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerBackground}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceDisabled}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineSubtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet / Ghost Action -->
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <!-- Maintenance Action Card Button (Replaces 100%-width stacked flat bars) -->
    <Style x:Key="ActionCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    </Style>

    <!-- =============================================================================== -->
    <!-- 6. TEXT INPUTS (TEXTBOX, READONLY, COPYABLE NOTICE, BARCODE, PASSWORDBOX)       -->
    <!-- =============================================================================== -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.22"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Margin="0"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Soft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceDisabled}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineSubtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preserved ReadonlyValue: Transparent, selectable, zero chrome, zero focus dashed box -->
    <Style x:Key="ReadonlyValue" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Background="{TemplateBinding Background}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        <Border x:Name="KeyboardFocusBorder"
                                CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preserved CodeValue: Strictly shares UiTypography.Code (Noto Sans CJK SC) -->
    <Style x:Key="CodeValue" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Code}"/>
    </Style>

    <!-- Preserved OperatorCopyableNotice -->
    <Style x:Key="OperatorCopyableNotice" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{DynamicResource AccentBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- Barcode Input Field (24 DIP compact, crisp focus highlight) -->
    <Style x:Key="BarcodeInputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Code}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.BarcodeCompact}"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================================== -->
    <!-- 7. COMBOBOX & COMBOBOXITEM (REPLACES WIN7 GREY GRADIENT CHROME GLOBALLY)        -->
    <!-- =============================================================================== -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            Margin="2,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Soft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,6,36,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleBtn"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource RadiusControl}"
                                            SnapsToDevicePixels="True">
                                        <Path x:Name="Chevron"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0"
                                              Data="M 0,0 L 5,5 L 10,0"
                                              Stroke="{DynamicResource Muted}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              RenderTransformOrigin="0.5,0.5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Left"/>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Margin="0,4,10,12"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}"
                                    Padding="4"
                                    Effect="{StaticResource ShadowPopup}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource SurfaceDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource LineSubtle}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================================== -->
    <!-- 8. TABCONTROL & TABITEM (MODERN UNDERLINE NAVIGATION BAR, ZERO DASHED FRAME)    -->
    <!-- =============================================================================== -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Tab Strip Bar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="16,0">
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Panel.ZIndex="1"
                                      KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <!-- Tab Content Surface (NO dashed border!) -->
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <!-- Active Bottom Indicator -->
                        <Border x:Name="Indicator"
                                Height="3"
                                VerticalAlignment="Bottom"
                                CornerRadius="2,2,0,0"
                                Background="{DynamicResource Accent}"
                                Visibility="Collapsed"/>
                        <!-- Keyboard Focus Indicator -->
                        <Border x:Name="FocusBar"
                                Margin="2,4"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Soft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preserved ContentOnlyTabs / ContentOnlyTab -->
    <Style x:Key="ContentOnlyTabs" TargetType="TabControl">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ContentOnlyTab" TargetType="TabItem">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- =============================================================================== -->
    <!-- 9. DATAGRID (COMMERCIAL ENTERPRISE TABLE, CLEAN HOVER/SELECTED, ZERO CLIPPING)  -->
    <!-- =============================================================================== -->

    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="RowHeight" Value="44"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineSubtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
        <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
        <Setter Property="Background" Value="{DynamicResource Soft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Soft}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="CellBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CellBorder" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="CellBorder" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================================== -->
    <!-- 10. CHECKBOX, RADIOBUTTON, EXPANDER, SLIDER, SCROLLBAR, MENU, TOOLTIP           -->
    <!-- =============================================================================== -->

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <Border x:Name="Box"
                                Width="20" Height="20"
                                CornerRadius="4"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource LineStrong}"
                                BorderThickness="1.5"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Path x:Name="CheckMark"
                                  Data="M 3,8 L 7,12 L 14,4"
                                  Stroke="{DynamicResource Surface}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceDisabled}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Line}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="{x:Static type:UiTypography.Emphasis}" VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          MinHeight="48"
                                          Cursor="Hand"
                                          FocusVisualStyle="{x:Null}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="Transparent" Padding="16,10" CornerRadius="7">
                                            <DockPanel>
                                                <Path x:Name="Chevron"
                                                      DockPanel.Dock="Right"
                                                      Width="10" Height="6" Stretch="Fill"
                                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Data="M 0,0 L 5,5 L 10,0"
                                                      Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      RenderTransformOrigin="0.5,0.5"/>
                                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Soft}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="ExpandSiteBorder"
                                    BorderBrush="{DynamicResource LineSubtle}"
                                    BorderThickness="0,1,0,0"
                                    Padding="16,12"
                                    Visibility="Collapsed">
                                <ContentPresenter x:Name="ExpandSite" Focusable="False"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSiteBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin Modern ScrollBars -->
    <Style x:Key="ThemeScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource LineStrong}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Muted}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ink}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ThemeScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource ThemeScrollThumb}"/></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ThemeScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ThemeScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ThemeScrollThumb}"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ThemeScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Menu, MenuItem & ToolTip -->
    <Style TargetType="Menu">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/>
        <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource ShadowPopup}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
