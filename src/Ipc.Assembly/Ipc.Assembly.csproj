<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><BusinessModule Condition="'$(BusinessModule)' == ''">Supply</BusinessModule><NuGetLockFilePath Condition="'$(NuGetLockFilePath)' == ''">packages.$([System.String]::Copy('$(BusinessModule)').ToLowerInvariant()).lock.json</NuGetLockFilePath><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
 <ItemGroup><Compile Include="Program.cs"/><ProjectReference Include="../Ipc.Platform/Ipc.Platform.csproj"/></ItemGroup>
 <ItemGroup Condition="'$(BusinessModule)' == 'Supply'"><Compile Include="SupplyAssembly.cs"/><ProjectReference Include="../Ipc.Product/Ipc.Product.csproj"/></ItemGroup>
 <ItemGroup Condition="'$(BusinessModule)' == 'Inspection'"><Compile Include="InspectionAssembly.cs"/><ProjectReference Include="../Ipc.Application.Inspection/Ipc.Application.Inspection.csproj"/></ItemGroup>
 <PropertyGroup Condition="'$(BusinessModule)' == 'Sportmaster' Or '$(BusinessModule)' == 'DirectPlc' Or '$(BusinessModule)' == 'WcsToPlc'"><DefineConstants>$(DefineConstants);PARCEL</DefineConstants></PropertyGroup>
 <PropertyGroup Condition="'$(BusinessModule)' == 'Sportmaster'"><DefineConstants>$(DefineConstants);SPORTMASTER</DefineConstants></PropertyGroup>
 <PropertyGroup Condition="'$(BusinessModule)' == 'DirectPlc'"><DefineConstants>$(DefineConstants);DIRECTPLC</DefineConstants></PropertyGroup>
 <PropertyGroup Condition="'$(BusinessModule)' == 'WcsToPlc'"><DefineConstants>$(DefineConstants);WCSTOPLC</DefineConstants></PropertyGroup>
 <ItemGroup Condition="'$(BusinessModule)' == 'Sportmaster' Or '$(BusinessModule)' == 'DirectPlc' Or '$(BusinessModule)' == 'WcsToPlc'">
  <Compile Include="ExtensionConsumerReaders.cs"/><ProjectReference Include="../Ipc.Application.Supply/Ipc.Application.Supply.csproj"/>
  <Compile Include="ParcelAssembly.cs"/><Compile Include="ParcelRuntimeSetup.cs"/><Compile Include="ParcelCapabilityFactory.cs"/><Compile Include="OriginalParcelQuery.cs" /><Compile Include="ParcelCli.cs"/>
  <Compile Include="../Ipc.Product/ExtensionBuildCheck.cs" Link="ExtensionBuildCheck.cs"/>
  <ProjectReference Include="../Ipc.Application.$(BusinessModule)/Ipc.Application.$(BusinessModule).csproj"/>
  <ProjectReference Include="../Ipc.Components/Ipc.Components.csproj"/><ProjectReference Include="../Ipc.Drivers/Ipc.Drivers.csproj"/><ProjectReference Include="../Ipc.Integrations/Ipc.Integrations.csproj" Condition="'$(BusinessModule)' != 'DirectPlc'"/>
 </ItemGroup>
 <Target Name="CheckBusinessSelection" BeforeTargets="PrepareForBuild" Condition="'$(BusinessModule)' != 'Supply' And '$(BusinessModule)' != 'Inspection' And '$(BusinessModule)' != 'Sportmaster' And '$(BusinessModule)' != 'DirectPlc' And '$(BusinessModule)' != 'WcsToPlc'"><Error Text="Choose Supply, Inspection, Sportmaster, DirectPlc or WcsToPlc"/></Target>
</Project>
