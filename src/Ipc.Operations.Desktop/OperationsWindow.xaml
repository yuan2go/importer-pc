<Window x:Class="Ipc.Operations.Desktop.OperationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf"
 Title="供包运维工具" Width="1180" Height="760" MinWidth="880" MinHeight="560" Background="{DynamicResource Background}" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <DockPanel><TextBlock Text="供包运维工具" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/><TextBlock Text="只读查看" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></DockPanel>
   <TextBox x:Name="InstallationText" Style="{DynamicResource ReadonlyValue}" Margin="0,8,0,4"/>
   <TextBlock x:Name="ConnectionText" Text="正在核验本机连接…" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="查看不会暂停供包。软件暂停不是安全急停。" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
  <TabControl x:Name="Pages">
   <TabItem Header="运行总览">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock x:Name="OverviewStatus" Text="尚未取得有效工作站状态" Margin="0,0,0,12" FontSize="{x:Static type:UiTypography.Position}"/>
      <TextBlock x:Name="OverviewSummary" Margin="0,0,0,12"/>
      <ItemsControl x:Name="PositionCards"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
        <StackPanel><TextBlock Text="{Binding Title}" FontWeight="{x:Static type:UiTypography.Emphasis}"/><TextBlock Text="{Binding Status}" Margin="0,8,0,0"/><TextBox Text="{Binding Detail}" Style="{DynamicResource ReadonlyValue}" Margin="0,8,0,0"/></StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="设备确认" FontWeight="{x:Static type:UiTypography.Emphasis}" Margin="0,0,0,8"/>
      <ItemsControl x:Name="DeviceRows"/>
      <TextBlock x:Name="StorageText" Margin="0,12,0,0"/>
      <Expander Header="技术详情与阻断原因" Margin="0,12,0,0"><TextBox x:Name="TechnicalText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxHeight="220"/></Expander>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="日志只读查询">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="日志范围" Margin="0,0,8,0"/><ComboBox x:Name="LogAreas" MinWidth="340" HorizontalAlignment="Left" AutomationProperties.Name="日志范围"/></DockPanel>
     <WrapPanel x:Name="Filters" Grid.Row="1" Margin="0,4,0,4">
      <TextBlock Text="时间"/><ComboBox x:Name="TimeRange" SelectedIndex="0" Width="150" AutomationProperties.Name="日志时间范围"><ComboBoxItem Content="最近1小时"/><ComboBoxItem Content="今天"/><ComboBoxItem Content="最近24小时"/></ComboBox>
      <TextBlock Text="级别"/><ComboBox x:Name="Level" SelectedIndex="0" Width="110" AutomationProperties.Name="日志级别"><ComboBoxItem Content="全部"/><ComboBoxItem Content="错误"/><ComboBoxItem Content="警告"/><ComboBoxItem Content="信息"/></ComboBox>
      <TextBlock Text="来源"/><TextBox x:Name="SourceFilter" Width="130" AutomationProperties.Name="日志来源"/>
      <TextBlock Text="关键词"/><TextBox x:Name="Keyword" Width="180" AutomationProperties.Name="日志关键词"/>
      <CheckBox x:Name="KeyEvents" Content="关键事件" IsChecked="True" VerticalAlignment="Center" Margin="8"/>
     </WrapPanel>
     <DockPanel Grid.Row="2" Margin="0,0,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="QueryButton" Content="查询" Click="QueryClick"/><Button x:Name="CancelQuery" Content="取消查询" Click="CancelClick" IsEnabled="False"/></StackPanel><TextBlock x:Name="LogStatus" Text="只读取已落盘运行日志，不读取业务数据库或认证日志。" MaxHeight="52" AutomationProperties.LiveSetting="Polite"/></DockPanel>
     <DataGrid x:Name="LogGrid" Grid.Row="3" RowHeight="36" FontSize="{x:Static type:UiTypography.Log}" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="LogSelectionChanged" ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="查询日志">
      <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding At, StringFormat={}{0:MM-dd HH:mm:ss.fff}}" Width="180"/><DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="75"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="110"/><DataGridTextColumn Header="事件" Binding="{Binding EventCode}" Width="210"/><DataGridTextColumn Header="原文" Binding="{Binding Text}" Width="*"/></DataGrid.Columns>
     </DataGrid>
     <TextBox x:Name="LogDetail" Grid.Row="4" Visibility="Collapsed" Height="120" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="所选日志原文"/>
     <DockPanel Grid.Row="5"><TextBlock x:Name="PageText"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制所选原文" Click="CopyClick"/><Button x:Name="PreviousButton" Content="上一页" Click="PreviousClick" IsEnabled="False"/><Button x:Name="NextButton" Content="下一页" Click="NextClick" IsEnabled="False"/></StackPanel></DockPanel>
     <Expander Grid.Row="6" Header="查询范围与完整性说明"><ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><TextBox x:Name="LogNotices" Style="{DynamicResource ReadonlyValue}"/></ScrollViewer></Expander>
    </Grid>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
