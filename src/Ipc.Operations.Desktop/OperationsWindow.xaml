<Window x:Class="Ipc.Operations.Desktop.OperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf"
        Title="{DynamicResource Ops.Title}" Width="1280" Height="760" MinWidth="880" MinHeight="560"
        Background="{DynamicResource Background}" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="OperationsCard" TargetType="Border" BasedOn="{StaticResource WorkstationCard}"/>
  <Style x:Key="OperationsSection" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Group}"/>
   <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  </Style>
  <Style x:Key="OperationsHint" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="OperationsToggle" TargetType="ToggleButton">
   <Setter Property="MinHeight" Value="44"/>
   <Setter Property="Padding" Value="12,4"/>
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="{DynamicResource Soft}"/>
    </Trigger>
    <Trigger Property="IsChecked" Value="True">
     <Setter Property="Background" Value="{DynamicResource AccentBackground}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
     <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
     <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OperationsTab" TargetType="TabItem">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2"
              BorderBrush="Transparent" Padding="4,0" MinHeight="48" Margin="0,0,24,0">
       <ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextElement.Foreground="{DynamicResource Muted}" TextElement.FontWeight="{x:Static type:UiTypography.Regular}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource Accent}"/>
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource Accent}"/>
        <Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="OperationsSummaryValue" TargetType="TextBlock" BasedOn="{StaticResource OperationsSection}">
   <Setter Property="FontSize" Value="{x:Static type:UiTypography.Position}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>
  <Style x:Key="OperationsDebugAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Warning}"/>
   <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
  </Style>
  <Style x:Key="LogFilterField" TargetType="StackPanel">
   <Setter Property="Margin" Value="0,0,8,6"/>
  </Style>
  <DataTemplate x:Key="PositionOverviewCard">
   <Border Style="{StaticResource OperationsCard}" Margin="4,0,4,8">
    <StackPanel>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
      <DockPanel>
       <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,4" Margin="8,0,0,0">
        <Border.Style>
         <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource Soft}"/>
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding AllowsSupply}" Value="True">
            <Setter Property="Background" Value="{DynamicResource SuccessBackground}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Border.Style>
        <TextBlock Text="{Binding Status}" FontSize="{x:Static type:UiTypography.Label}"/>
       </Border>
       <TextBlock Text="{Binding Title}" Style="{StaticResource OperationsSection}" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource Ops.Vehicle}" Style="{StaticResource OperationsHint}"/>
      <TextBox Grid.Column="1" Text="{Binding Vehicle, Mode=OneWay}" Style="{DynamicResource ReadonlyValue}"/>
      <TextBlock Grid.Row="1" Text="{DynamicResource Ops.Round}" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Round, Mode=OneWay}" Style="{DynamicResource ReadonlyValue}" Margin="0,4,0,0"/>
      <TextBlock Grid.Row="2" Text="{DynamicResource Ops.Task}" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Operation, Mode=OneWay}" Style="{DynamicResource ReadonlyValue}" Margin="0,4,0,0"/>
      <TextBlock Grid.Row="3" Text="{DynamicResource Ops.Manual}" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Manual}" TextWrapping="Wrap" Margin="6,4,0,0"/>
      <TextBlock Grid.Row="4" Text="{DynamicResource Ops.SupplyNotice}" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      <TextBox Grid.Row="4" Grid.Column="1" Style="{DynamicResource ReadonlyValue}" Text="{Binding Notice,Mode=OneWay}" IsTabStop="True" Margin="0,4,0,0" AutomationProperties.Name="{DynamicResource Ops.SupplyNoticeCopy}"/>
     </Grid>
    </StackPanel>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="DeviceOverviewCard">
   <Border Style="{StaticResource OperationsCard}" Background="{DynamicResource Soft}" Padding="12" Margin="4">
    <StackPanel>
     <TextBlock Text="{Binding Title}" Style="{StaticResource OperationsHint}"/>
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Confirmed}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Success}"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <TextBlock Text="{Binding Detail}" Style="{StaticResource OperationsHint}"/>
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <DockPanel Background="{DynamicResource Background}">
  <StackPanel DockPanel.Dock="Top">
   <Border x:Name="HeaderBar" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
           BorderThickness="0,0,0,1" Padding="24,0" Height="64">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid VerticalAlignment="Center" Margin="0,0,8,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition MaxWidth="160"/></Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource Ops.Title}" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"
                 Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
      <Border Grid.Column="1" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="{DynamicResource RadiusBadge}" Padding="8,3" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
       <TextBlock x:Name="StationText" Text="{DynamicResource Ops.VerifyStation}" TextTrimming="CharacterEllipsis"
                  Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}"/>
      </Border>
     </Grid>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
      <Border x:Name="ConnectionPill" Style="{StaticResource OperatorStatusBadge}" BorderBrush="{DynamicResource Line}" Padding="9,4" Background="{DynamicResource Soft}" CornerRadius="{DynamicResource RadiusBadge}" VerticalAlignment="Center">
       <TextBlock x:Name="ConnectionText" Text="{DynamicResource Ops.CheckConnection}" FontSize="{x:Static type:UiTypography.Label}"
                  AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource Muted}"/>
      </Border>
      <ContentControl x:Name="AuthorizationStatusHost" Margin="6,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <ContentControl x:Name="AuthorizationActionHost" VerticalAlignment="Center"/>
      <ToggleButton x:Name="EnvironmentToggle" Content="{DynamicResource Ops.Environment}" Style="{StaticResource OperationsToggle}" Margin="6,0,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Popup x:Name="AuthorizationOptions" PlacementTarget="{Binding ElementName=AuthorizationActionHost}"
          Placement="Bottom" HorizontalOffset="-180" AllowsTransparency="True" StaysOpen="False">
    <Border Style="{StaticResource OperationsCard}" Width="330" Margin="8" Effect="{DynamicResource ShadowPopup}">
     <ContentControl x:Name="AuthorizationDetailsHost"/>
    </Border>
   </Popup>
   <Popup IsOpen="{Binding IsChecked,ElementName=EnvironmentToggle,Mode=TwoWay}" PlacementTarget="{Binding ElementName=EnvironmentToggle}"
          Placement="Bottom" HorizontalOffset="-360" AllowsTransparency="True" StaysOpen="False">
    <Border x:Name="EnvironmentInfo" Style="{StaticResource OperationsCard}" Width="460" Margin="8" Effect="{DynamicResource ShadowPopup}">
    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,12,0">
       <TextBox x:Name="InstallationText" Style="{DynamicResource ReadonlyValue}" IsTabStop="True" AutomationProperties.Name="{DynamicResource Ops.EnvironmentAccessible}"/>
       <TextBlock x:Name="ConnectionDetails" Style="{StaticResource OperationsHint}" Margin="0,4,0,0"/>
      </StackPanel>
      <ContentControl x:Name="TechnicalFailureHost" Grid.Row="1" Margin="0,12,0,0"/>
     </Grid>
    </ScrollViewer>
    </Border>
   </Popup>
   <ContentControl x:Name="WorkspaceNoticeHost" Margin="24,0"/>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
          BorderThickness="0,1,0,0" MinHeight="32" Padding="24,0">
   <DockPanel VerticalAlignment="Center">
    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource OperationsHint}" Margin="12,0,0,0"/>
    <TextBlock Text="{DynamicResource Ops.ReadOnlySafety}" Style="{StaticResource OperationsHint}"/>
   </DockPanel>
  </Border>
  <TabControl x:Name="Pages" ItemContainerStyle="{StaticResource OperationsTab}" Padding="0" SelectionChanged="PageChanged">
   <TabControl.Template>
    <ControlTemplate TargetType="TabControl">
     <DockPanel KeyboardNavigation.TabNavigation="Local">
      <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
       <TabPanel IsItemsHost="True" Margin="24,0" KeyboardNavigation.TabIndex="1"/>
      </Border>
      <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
     </DockPanel>
    </ControlTemplate>
   </TabControl.Template>
   <TabItem Header="{DynamicResource Ops.Overview}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="20,16,20,14">
      <UniformGrid x:Name="OverviewMetrics" Columns="4" Margin="0,0,0,8">
       <Border Style="{StaticResource OperationsCard}" Margin="4">
        <StackPanel>
         <TextBlock Text="{DynamicResource Ops.WorkstationStatus}" Style="{StaticResource OperationsHint}"/>
         <TextBlock x:Name="OverviewStatus" Text="{DynamicResource Common.Pending}" Style="{StaticResource OperationsSummaryValue}"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource OperationsCard}" Margin="4">
        <StackPanel>
         <TextBlock Text="{DynamicResource Ops.VisibleTasks}" Style="{StaticResource OperationsHint}"/>
         <TextBlock x:Name="VisibleOperationsText" Text="{DynamicResource Common.Pending}" Style="{StaticResource OperationsSummaryValue}"/>
         <TextBlock x:Name="ExecutingRequestsText" Style="{StaticResource OperationsHint}"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource OperationsCard}" Margin="4">
        <StackPanel>
         <TextBlock Text="{DynamicResource Ops.Custody}" Style="{StaticResource OperationsHint}"/>
         <TextBlock x:Name="UnconfirmedOperationsText" Text="{DynamicResource Common.Pending}" Style="{StaticResource OperationsSummaryValue}"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource OperationsCard}" Margin="4">
        <StackPanel>
         <TextBlock Text="{DynamicResource Ops.PendingSettings}" Style="{StaticResource OperationsHint}"/>
         <TextBlock x:Name="PendingOverviewText" Text="{DynamicResource Common.Pending}" Style="{StaticResource OperationsSummaryValue}"/>
        </StackPanel>
       </Border>
      </UniformGrid>
      <ItemsControl x:Name="PositionCards" ItemTemplate="{StaticResource PositionOverviewCard}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
      <Border Style="{StaticResource OperationsCard}" Margin="4,4,4,8">
       <StackPanel>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="4,0,4,4">
         <TextBlock Text="{DynamicResource Ops.DevicesStorage}" Style="{StaticResource OperationsSection}"/>
        </Border>
        <ItemsControl x:Name="DeviceRows" ItemTemplate="{StaticResource DeviceOverviewCard}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
       </StackPanel>
      </Border>
      <Expander Header="{DynamicResource Ops.Technical}" Margin="0,2,8,0">
       <TextBox x:Name="TechnicalText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                VerticalScrollBarVisibility="Auto" MaxHeight="220"/>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource Ops.LogCenter}">
    <DockPanel Margin="24,16,24,12" Background="{DynamicResource Surface}">
     <Border DockPanel.Dock="Top" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}"
             BorderThickness="0,0,0,1" Padding="12,8">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Ops.LogSource}">
       <RadioButton x:Name="OfflineLogMode" Content="{DynamicResource Ops.OfflineLog}" GroupName="OperationsLogMode" IsChecked="True"
                    Style="{StaticResource OperationsToggle}" AutomationProperties.AutomationId="Operations.LogMode.Offline"
                    ToolTip="{DynamicResource Ops.OfflineLogHelp}"/>
       <RadioButton x:Name="OnlineLogMode" Content="{DynamicResource Ops.CompleteLog}" GroupName="OperationsLogMode" Margin="4,0,0,0"
                    Style="{StaticResource OperationsToggle}" AutomationProperties.AutomationId="Operations.LogMode.Online"
                    ToolTip="{DynamicResource Ops.CompleteLogHelp}"/>
      </StackPanel>
     </Border>
     <Grid>
      <ContentControl x:Name="OnlineLogs" Visibility="Collapsed"/>
      <Grid x:Name="OfflineLogs" Margin="12,8">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <WrapPanel x:Name="Filters" Margin="0,0,0,4">
        <WrapPanel.Resources>
         <ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/ParameterSettingsTheme.xaml"/>
        </WrapPanel.Resources>
        <StackPanel Style="{StaticResource LogFilterField}" MinWidth="268">
         <TextBlock Text="{DynamicResource Ops.LogArea}" Style="{StaticResource OperationsHint}"/>
         <ComboBox x:Name="LogAreas" Margin="0" Height="44" TextSearch.TextPath="Label" AutomationProperties.Name="{DynamicResource Ops.LogArea}">
          <ComboBox.ItemTemplate>
           <DataTemplate>
            <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" MaxWidth="244"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           </DataTemplate>
          </ComboBox.ItemTemplate>
         </ComboBox>
        </StackPanel>
        <StackPanel Style="{StaticResource LogFilterField}" Width="148">
         <TextBlock Text="{DynamicResource Common.Time}" Style="{StaticResource OperationsHint}"/>
         <ComboBox x:Name="TimeRange" Margin="0" SelectedIndex="0" Height="44" AutomationProperties.Name="{DynamicResource Ops.TimeAccessible}">
          <ComboBoxItem Content="{DynamicResource Ops.LastHour}"/><ComboBoxItem Content="{DynamicResource Common.DateToday}"/><ComboBoxItem Content="{DynamicResource Common.LastDay}"/>
         </ComboBox>
        </StackPanel>
        <StackPanel Style="{StaticResource LogFilterField}" Width="88">
         <TextBlock Text="{DynamicResource Common.Level}" Style="{StaticResource OperationsHint}"/>
         <ComboBox x:Name="Level" Margin="0" SelectedIndex="0" Height="44" AutomationProperties.Name="{DynamicResource Ops.LevelAccessible}">
          <ComboBoxItem Content="{DynamicResource Common.All}"/><ComboBoxItem Content="{DynamicResource Common.Error}"/><ComboBoxItem Content="{DynamicResource Common.Warning}"/><ComboBoxItem Content="{DynamicResource Common.Info}"/>
         </ComboBox>
        </StackPanel>
        <StackPanel Style="{StaticResource LogFilterField}" Width="88">
         <TextBlock Text="{DynamicResource Common.Source}" Style="{StaticResource OperationsHint}"/>
         <TextBox x:Name="SourceFilter" Height="44" Margin="0" AutomationProperties.Name="{DynamicResource Ops.LogSource}"/>
        </StackPanel>
        <StackPanel Style="{StaticResource LogFilterField}" Width="126">
         <TextBlock Text="{DynamicResource Ops.Keyword}" Style="{StaticResource OperationsHint}"/>
         <TextBox x:Name="Keyword" Height="44" Margin="0" AutomationProperties.Name="{DynamicResource Ops.KeywordAccessible}"/>
        </StackPanel>
        <CheckBox x:Name="KeyEvents" Content="{DynamicResource Ops.KeyEvents}" IsChecked="True" VerticalAlignment="Bottom" MinHeight="44" Margin="0,0,0,6"/>
       </WrapPanel>
       <DockPanel Grid.Row="1" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
         <Button x:Name="QueryButton" Content="{DynamicResource Common.Query}" Click="QueryClick" Style="{DynamicResource Primary}"/>
         <Button x:Name="CancelQuery" Content="{DynamicResource Common.CancelQuery}" Click="CancelClick" IsEnabled="False" Margin="6,0,0,0">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
           <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
          </Style></Button.Style>
         </Button>
        </StackPanel>
        <TextBlock x:Name="LogStatus" Text="{DynamicResource Ops.PickScope}" Style="{StaticResource OperationsHint}"
                   VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.LiveSetting="Polite"/>
       </DockPanel>
       <DataGrid x:Name="LogGrid" Grid.Row="2" RowHeight="44" FontSize="{x:Static type:UiTypography.Log}" SelectionMode="Extended"
                 SelectionUnit="FullRow" SelectionChanged="LogSelectionChanged" ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="{DynamicResource Ops.QueryLog}">
        <DataGrid.Columns>
         <DataGridTextColumn Header="{Binding [Ops.TimeLocal], Source={x:Static type:UiText.Current}}" Binding="{Binding At, StringFormat={}{0:MM-dd HH:mm:ss.fff}}" Width="180"/>
         <DataGridTextColumn Header="{Binding [Common.Level], Source={x:Static type:UiText.Current}}" Binding="{Binding Level}" Width="75"/>
         <DataGridTextColumn Header="{Binding [Common.Source], Source={x:Static type:UiText.Current}}" Binding="{Binding Source}" Width="110"/>
         <DataGridTextColumn Header="{Binding [Ops.Event], Source={x:Static type:UiText.Current}}" Binding="{Binding EventCode}" Width="210"/>
         <DataGridTextColumn Header="{Binding [Common.Original], Source={x:Static type:UiText.Current}}" Binding="{Binding Text}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBox x:Name="LogDetail" Grid.Row="3" Visibility="Collapsed" Height="100" IsReadOnly="True" TextWrapping="NoWrap"
                AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Ops.RawLog}"/>
       <DockPanel Grid.Row="4" Margin="0,6,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button Content="{DynamicResource Ops.CopyLog}" Click="CopyClick"/>
         <Button x:Name="PreviousButton" Content="{DynamicResource Common.Previous}" Click="PreviousClick" IsEnabled="False" Margin="6,0,0,0"/>
         <Button x:Name="NextButton" Content="{DynamicResource Common.NextPage}" Click="NextClick" IsEnabled="False" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="PageText" Style="{StaticResource OperationsHint}" VerticalAlignment="Center"/>
       </DockPanel>
       <Expander Grid.Row="5" Header="{DynamicResource Ops.LogScopeHelp}">
        <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto">
         <StackPanel>
          <TextBlock Text="{DynamicResource Ops.OfflineBoundary}" Style="{StaticResource OperationsHint}"/>
          <TextBox x:Name="LogNotices" Style="{DynamicResource ReadonlyValue}"/>
         </StackPanel>
        </ScrollViewer>
       </Expander>
      </Grid>
     </Grid>
    </DockPanel>
   </TabItem>
   <TabItem Header="{DynamicResource Ops.Debug}" Tag="debug"><ContentControl x:Name="DeviceDebugPage" Margin="24,16,24,12"/></TabItem>
   <TabItem Header="{DynamicResource Ops.Parameters}" Tag="parameters">
    <ContentControl x:Name="ProfessionalPage" Margin="24,16,24,12"/>
   </TabItem>
   <TabItem Header="{DynamicResource Ops.Maintenance}" Tag="maintenance"><ContentControl x:Name="MaintenancePage"/></TabItem>
  </TabControl>
 </DockPanel>
</Window>
