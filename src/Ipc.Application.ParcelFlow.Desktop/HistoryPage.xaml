<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Height" Value="*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
  <StackPanel Grid.ColumnSpan="2">
   <Expander x:Name="HistoryFilters" Header="筛选条件 · 条码 / 位 / 状态 / 请求 / 明确时区"><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel>
   <WrapPanel><StackPanel><TextBlock Text="完整条码（保留前导零）"/><TextBox Text="{Binding HistoryBarcode,UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="历史完整条码"/></StackPanel><StackPanel><TextBlock Text="投递位（留空表示全部）"/><TextBox Text="{Binding HistoryPosition,UpdateSourceTrigger=PropertyChanged}" Width="130" AutomationProperties.Name="历史投递位"/></StackPanel><StackPanel><TextBlock Text="业务状态"/><ComboBox ItemsSource="{Binding HistoryStates}" SelectedItem="{Binding HistoryState}" Width="160" MinHeight="44" AutomationProperties.Name="历史业务状态"/></StackPanel><StackPanel><TextBlock Text="原请求ID"/><TextBox Text="{Binding HistoryRequest,UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="历史原请求ID"/></StackPanel></WrapPanel>
   <WrapPanel><StackPanel><TextBlock Text="开始（含，留空不限）· 时间须含 +08:00 / Z"/><TextBox Text="{Binding HistoryFrom,UpdateSourceTrigger=PropertyChanged}" Width="285" AutomationProperties.Name="历史开始含时区"/></StackPanel><StackPanel><TextBlock Text="结束（不含，留空不限）"/><TextBox Text="{Binding HistoryToExclusive,UpdateSourceTrigger=PropertyChanged}" Width="285" AutomationProperties.Name="历史结束不含含时区"/></StackPanel></WrapPanel>
   </StackPanel></Expander>
   <WrapPanel><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="查询并固定范围" Click="Refresh_Click"/><Button Content="下一页" Click="Next_Click" IsEnabled="{Binding HasNextHistory}"/><Button Content="导出当前筛选CSV…" Click="Export_Click"/></WrapPanel><Button Content="取消导出" Click="CancelExport_Click" IsEnabled="{Binding HistoryExportRunning}"/></WrapPanel>
   <TextBlock Text="{Binding HistoryMetricsSummary}" TextWrapping="Wrap" FontSize="12"/>
  </StackPanel>
  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding HistoryStatus}" TextWrapping="Wrap" Margin="4,4,4,8" AutomationProperties.LiveSetting="Polite"/>
  <DataGrid x:Name="HistoryRows" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" RowHeight="44"><DataGrid.Style><Style TargetType="DataGrid"><Setter Property="Grid.Row" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns><DataGridTextColumn Header="观察时间（原时区）" Binding="{Binding Operation.ObservedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" Width="190"/><DataGridTextColumn Header="位" Binding="{Binding Operation.PositionId,Mode=OneWay}" Width="50"/><DataGridTextColumn Header="包裹号" Binding="{Binding Operation.ParcelCode,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Operation.State,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="格口" Binding="{Binding Operation.Slot,Mode=OneWay}" Width="70"/><DataGridCheckBoxColumn Header="归档" Binding="{Binding Archived}"/></DataGrid.Columns></DataGrid>
  <DockPanel><DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Grid.Row" Value="2"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="12,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.Row" Value="3"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,8,0,0"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
   <ScrollViewer DockPanel.Dock="Top" MaxHeight="96" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding HistoryCommandTarget}" TextWrapping="Wrap"/><TextBlock Text="{Binding HistorySelectionState}" FontSize="12"/><WrapPanel IsEnabled="{Binding CanStartOperation}" ToolTip="{Binding OperationStatus}" ToolTipService.ShowOnDisabled="True"><Button Content="核对所选原请求" Click="Query_Click" IsEnabled="{Binding CanHistoryQuery}"/><Button Content="继续所选未尝试阶段" Click="Continue_Click" IsEnabled="{Binding CanHistoryContinue}"/><Button Content="复制完整原件JSON" Click="Copy_Click"/></WrapPanel><Expander Header="原实体检查说明 · 继续原阶段时填写"><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="不替代现场安全许可"/></Expander></StackPanel></ScrollViewer>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBox Text="{Binding StructuredDetails,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" FontSize="14"/><Expander Header="高级详情 · 完整原作业 / 请求 / 回执 JSON"><TextBox Text="{Binding Details,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/></Expander></StackPanel></ScrollViewer>
  </DockPanel>
 </Grid>
</UserControl>
