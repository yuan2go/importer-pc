<Window x:Class="Ipc.Installer.InstallerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="菜鸟供包台安装程序" Icon="Assets/importer-pc.ico" Width="760" Height="480" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterScreen" Background="White" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F0F6FF" Padding="24,32"><StackPanel><Image Source="Assets/cainiao.png" Width="80" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="菜鸟供包台" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,0" TextAlignment="Center"/><TextBlock Text="安装程序" FontSize="14" Foreground="#536577" Margin="0,6,0,0" TextAlignment="Center"/></StackPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,30,28,20"><StackPanel>
   <TextBlock x:Name="Heading" Text="欢迎安装菜鸟供包台" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock x:Name="Version" FontSize="14" Foreground="#536577" Margin="0,10,0,20"/>
   <TextBlock x:Name="Description" Text="此程序将准备安装文件，并打开安装向导。你可以在向导中选择程序和数据目录，核对后授权安装。" FontSize="16" TextWrapping="Wrap" LineHeight="26"/>
   <TextBlock x:Name="Stage" FontSize="16" Margin="0,24,0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="20" Visibility="Collapsed" AutomationProperties.Name="安装文件准备进度"/>
   <TextBlock x:Name="FileName" FontSize="13" Foreground="#536577" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
   <TextBox x:Name="Diagnostic" IsReadOnly="True" TextWrapping="Wrap" FontSize="14" MaxHeight="150" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,12,0,0" AutomationProperties.Name="安装准备诊断，可选择复制"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F6F8FA" BorderBrush="#D8E0E7" BorderThickness="0,1,0,0" Padding="20,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Next" Content="下一步(_N)" IsDefault="True" Click="Next_Click"/><Button x:Name="Cancel" Content="取消" IsCancel="True" Click="Cancel_Click"/></StackPanel></Border>
 </Grid>
</Window>
