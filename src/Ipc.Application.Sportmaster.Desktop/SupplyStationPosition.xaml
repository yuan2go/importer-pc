<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop" x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationPosition" Foreground="{DynamicResource PlainText}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <UserControl.Style>
  <Style TargetType="UserControl">
   <Setter Property="Margin" Value="0,0,6,0"/>
   <Style.Triggers><DataTrigger Binding="{Binding PositionId}" Value="right"><Setter Property="Margin" Value="6,0,0,0"/></DataTrigger></Style.Triggers>
  </Style>
 </UserControl.Style>
 <Border x:Name="InputTargetOutline" BorderThickness="2" Margin="2" CornerRadius="{DynamicResource RadiusCard}">
  <Border.Style>
   <Style TargetType="Border">
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Style.Triggers><DataTrigger Binding="{Binding InputTargetActive}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
   </Style>
  </Border.Style>
  <Grid>
   <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource RadiusCard}"
           Effect="{DynamicResource ShadowCard}" IsHitTestVisible="False"/>
   <Border x:Name="PositionOutline" Style="{StaticResource StationPositionCard}">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" SharedSizeGroup="PositionHeading"/>
     <RowDefinition Height="Auto" SharedSizeGroup="PositionScan"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto" SharedSizeGroup="PositionTaskFields"/>
     <RowDefinition Height="Auto" SharedSizeGroup="PositionActions"/>
    </Grid.RowDefinitions>
    <DockPanel Style="{StaticResource StationPositionSection}">
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Border.Style>
       <Style TargetType="Border">
        <Setter Property="Padding" Value="0,0,0,8"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="0,0,0,2"/></DataTrigger></Style.Triggers>
       </Style>
      </Border.Style>
     <Grid>
      <Grid.Resources>
       <Style x:Key="SupplySwitch" TargetType="Button" BasedOn="{StaticResource StationButton}">
        <Setter Property="MinWidth" Value="56"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MinWidth" Value="52"/></DataTrigger></Style.Triggers>
       </Style>
      </Grid.Resources>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="{Binding Heading}" VerticalAlignment="Center" FontSize="{x:Static type:UiTypography.Position}" FontWeight="{x:Static type:UiTypography.Emphasis}" AutomationProperties.Name="投递位"/>
       <Border Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Margin="10,0,0,0">
        <Border.Style><Style TargetType="Border"><Style.Triggers>
         <DataTrigger Binding="{Binding SupplyConfigured}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style></Border.Style>
        <StackPanel Orientation="Horizontal">
         <Button x:Name="EnableSupply" Content="启用" Click="EnableSupply_Click" IsEnabled="{Binding CanChangeSupply}" Style="{StaticResource SupplySwitch}" Margin="0" type:PaletteBrush.BackgroundKey="{Binding EnableBackgroundKey}" type:PaletteBrush.ForegroundKey="{Binding EnableForegroundKey}" AutomationProperties.Name="启用本投递位" AutomationProperties.HelpText="{Binding SupplyStateText}"/>
         <Button x:Name="DisableSupply" Content="{Binding DisableLabel}" Click="DisableSupply_Click" IsEnabled="{Binding CanChangeSupply}" Style="{StaticResource SupplySwitch}" Margin="0" type:PaletteBrush.BackgroundKey="{Binding DisableBackgroundKey}" type:PaletteBrush.ForegroundKey="{Binding DisableForegroundKey}" AutomationProperties.Name="停用本投递位" AutomationProperties.HelpText="{Binding SupplyStateText}"/>
        </StackPanel>
       </Border>
      </StackPanel>
      <Border Grid.Column="1" Margin="6,0,0,0" Padding="8,4" Background="{DynamicResource Soft}" CornerRadius="{DynamicResource RadiusBadge}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Grid x:Name="VehicleState" VerticalAlignment="Center" ToolTip="{Binding VehicleStatusText}">
       <Grid.Resources>
        <Style TargetType="TextBlock">
         <Setter Property="type:PaletteBrush.ForegroundKey" Value="{Binding VehicleStatusForegroundKey}"/>
         <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
         <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/>
         <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
       </Grid.Resources>
       <TextBlock Text="{Binding VehicleStatusText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding VehicleStatusText}">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="{Binding VehicleNumberText}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding VehicleNumberText}"/>
        <TextBlock Text="{Binding CompactVehicleStatusText}" AutomationProperties.Name="{Binding VehicleStatusText}"/>
       </StackPanel>
      </Grid>
      </Border>
     </Grid>
     </Border>
    </DockPanel>
    <Grid Grid.Row="1" x:Name="ScanInformation" Height="48" Style="{StaticResource StationPositionSection}">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBox x:Name="BarcodeEntry" MinHeight="48" Padding="10,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0" VerticalContentAlignment="Center" FontSize="{x:Static type:UiTypography.BarcodeCompact}" FontFamily="{x:Static type:UiTypography.Code}" MaxLength="4096" AcceptsReturn="False" AcceptsTab="False" TextChanged="InputChanged" GotKeyboardFocus="Entry_GotKeyboardFocus" PreviewKeyDown="BarcodeEntry_KeyDown" PreviewTextInput="Entry_PreviewTextInput" AutomationProperties.Name="本次条码，可输入，回车提交" ToolTip="点击本位后输入；保留前导零。直接输入将替换已显示的整条旧码。完整条码输入后按回车或点击提交。">
      <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
       <Setter Property="MaxHeight" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="48"/></DataTrigger></Style.Triggers>
      </Style></TextBox.Style>
      <TextBox.ContextMenu>
       <ContextMenu>
        <MenuItem Header="剪切" Command="ApplicationCommands.Cut"/>
        <MenuItem Header="复制" Command="ApplicationCommands.Copy"/>
        <MenuItem Header="粘贴" Command="ApplicationCommands.Paste"/>
        <MenuItem Header="全选" Command="ApplicationCommands.SelectAll"/>
        <Separator/>
        <MenuItem Header="清空输入" Click="ClearInput_Click"/>
       </ContextMenu>
      </TextBox.ContextMenu>
     </TextBox>
     <TextBlock x:Name="BarcodePlaceholder" Text="{Binding BarcodePlaceholder}" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Body}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BarcodePlaceholder}">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Text.Length,ElementName=BarcodeEntry}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <Button x:Name="CurrentBarcode" Grid.Column="1" Content="图片" Click="Picture_Click" IsEnabled="{Binding CanViewCurrentPicture}" Margin="8,0,0,0" AutomationProperties.Name="查看当前包裹图片">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource StationButton}">
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="Background" Value="{DynamicResource Soft}"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MinWidth" Value="60"/></DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
      <Button.ContentTemplate>
       <DataTemplate>
        <StackPanel Orientation="Horizontal">
         <Path Data="M 2,2 L 16,2 16,14 2,14 Z M 2,12 L 7,7 11,11 13,9 16,12" Width="18" Height="16" Stretch="Uniform"
               Margin="0,0,5,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
               StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
         <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
       </DataTemplate>
      </Button.ContentTemplate>
     </Button>
    </Grid>
    <!-- The result owns the remaining height. Auxiliary metadata never scrolls it away. -->
    <Grid Grid.Row="2">
     <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="PositionSupplyNotice"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="DisablingNotice" Text="{Binding SupplyNotice}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SupplyDisabling}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    <Border x:Name="ResultPanel" Grid.Row="1" Style="{StaticResource StationResultPanel}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel x:Name="DetailedStatus" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,2,0,4">
       <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding ShowCenteredState}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
       <TextBlock Text="{Binding DisplayPresentation.Icon}" Style="{StaticResource StationResultHeading}" FontSize="{x:Static type:UiTypography.Exception}" Margin="0,0,8,0" AutomationProperties.Name="本位状态符号"/>
       <TextBlock Text="{Binding DisplayStatus}" Style="{StaticResource StationResultHeading}" FontSize="{x:Static type:UiTypography.Status}" FontWeight="{x:Static type:UiTypography.Emphasis}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
      <Grid Grid.Row="1" x:Name="SlotViewport">
       <Grid.Style>
        <Style TargetType="Grid">
         <Setter Property="Margin" Value="0,4"/>
         <Setter Property="Grid.ColumnSpan" Value="2"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding ShowConfirmedTask}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Grid.ColumnSpan" Value="1"/></MultiDataTrigger>
         </Style.Triggers>
        </Style>
       </Grid.Style>
       <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
       <TextBox x:Name="CurrentSlot" Text="{Binding DisplaySlot,Mode=OneWay}" FontSize="{Binding DisplaySlotFontSize}" MaxWidth="{Binding ActualWidth,ElementName=SlotViewport}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Ink}" Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True" FontFamily="{x:Static type:UiTypography.Interface}" FontWeight="{x:Static type:UiTypography.Emphasis}" AutomationProperties.Name="{Binding DisplaySlotLabel}">
        <TextBox.Style>
         <Style TargetType="TextBox" BasedOn="{StaticResource WorkstationTextBox}"><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding DisplaySlotVisible}" Value="False">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBox.Style>
       </TextBox>
      </Viewbox>
      </Grid>
      <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" x:Name="PositionBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
         <Style.Triggers>
          <DataTrigger Binding="{Binding DisplaySlotVisible}" Value="True">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ShowCenteredState}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers>
        </Style>
       </ScrollViewer.Style>
       <StackPanel>
        <TextBox x:Name="AttentionReason" Text="{Binding DisplayAttentionReason,Mode=OneWay}" Foreground="{DynamicResource Ink}" Style="{StaticResource StationValue}" Margin="0" AutomationProperties.Name="本位原因，可选择复制"/>
       </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="NextStep" Text="{Binding DisplayNextStep}" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StationInstruction}">
        <Setter Property="FontSize" Value="{x:Static type:OperatorTokens.InstructionSize}"/>
        <Setter Property="Grid.Row" Value="2"/><Setter Property="Grid.ColumnSpan" Value="2"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/></DataTrigger>
         <DataTrigger Binding="{Binding DisplayNextStep}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         <DataTrigger Binding="{Binding ShowCenteredState}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding ShowConfirmedTask}" Value="True"/></MultiDataTrigger.Conditions>
         <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
         <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0,0,0"/>
        </MultiDataTrigger></Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
      <TextBox x:Name="RecentChuteBarcode" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0" MaxHeight="48"
               Text="{Binding RecentChuteBarcode,Mode=OneWay}" Foreground="{DynamicResource Ink}"
               Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True"
               FontSize="{x:Static type:UiTypography.Body}"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center"
               AutomationProperties.Name="上一件条码，仅供查看">
       <TextBox.Style><Style TargetType="TextBox"><Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/><Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding ShowRecentChute}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
       </Style></TextBox.Style>
      </TextBox>
      <ScrollViewer x:Name="RcsGuidancePanel" Grid.Row="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    AutomationProperties.Name="取格口结果待核对">
       <ScrollViewer.Style><Style TargetType="ScrollViewer">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding ShowRcsGuidance}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
       </Style></ScrollViewer.Style>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding RcsGuidanceTitle}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                   FontSize="{x:Static type:UiTypography.Exception}" FontWeight="{x:Static type:UiTypography.Emphasis}" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{Binding RcsGuidanceSummary}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                   FontSize="{x:Static type:UiTypography.Label}" Margin="0,3,0,8"/>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusControl}" Padding="10,5" Margin="0,0,0,6">
         <Border.Style><Style TargetType="Border">
          <Style.Triggers><DataTrigger Binding="{Binding RcsGuidanceBarcode}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
         </Style></Border.Style>
         <StackPanel>
          <TextBlock Text="当前条码" FontSize="{x:Static type:UiTypography.Label}" Foreground="{DynamicResource Muted}"/>
          <TextBox Text="{Binding RcsGuidanceBarcode,Mode=OneWay}" Style="{DynamicResource ReadonlyValue}"
                   IsTabStop="True" AutomationProperties.Name="当前条码，可选择复制"/>
          <TextBlock Text="{Binding RcsGuidanceBarcodeSuffix}" FontSize="{x:Static type:UiTypography.Body}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Warning}" FontWeight="{x:Static type:UiTypography.Emphasis}"/>
         </StackPanel>
        </Border>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusControl}" Padding="10,5">
         <StackPanel TextBlock.FontSize="{x:Static type:UiTypography.Body}">
          <TextBlock Text="1. 取下包裹，放到异常暂存篮" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding RcsGuidanceSecondStep}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="3. 呼叫班长或运维核对，请勿再次上件" TextWrapping="Wrap"/>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
      <Border x:Name="CenteredSupplyPanel" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="Transparent">
       <Border.Style>
        <Style TargetType="Border">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Setter Property="Padding" Value="8"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding ShowCenteredState}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
          <DataTrigger Binding="{Binding ShowRcsGuidance}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="8,2"/></DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
       <Grid x:Name="CenteredSupplyContent" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
         <Path Width="28" Height="25" Margin="0,0,0,8" Stretch="Uniform" HorizontalAlignment="Center"
               Stroke="{DynamicResource Success}" StrokeThickness="1.7" StrokeLineJoin="Round"
               Data="M 2,8 L 14,2 26,8 26,22 14,28 2,22 Z M 2,8 L 14,14 26,8 M 14,14 L 14,28">
          <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
           <MultiDataTrigger><MultiDataTrigger.Conditions>
            <Condition Binding="{Binding CenteredStateTitle}" Value="等待投包"/>
            <Condition Binding="{Binding IsTight}" Value="False"/>
           </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
          </Style.Triggers></Style></Path.Style>
         </Path>
        <TextBlock x:Name="CenteredStateTitle" Text="{Binding CenteredStateTitle}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="{x:Static type:UiTypography.Emphasis}" type:PaletteBrush.ForegroundKey="{Binding CenteredStateForegroundKey}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Exception}"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.PageTitle}"/></DataTrigger><DataTrigger Binding="{Binding CenteredRcsRejection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        </StackPanel>
        <local:RejectionMessageBox x:Name="CenteredRcsMessage" Text="{Binding CenteredStateTitle,Mode=OneWay}" type:PaletteBrush.ForegroundKey="{Binding CenteredStateForegroundKey}"
                 TextAlignment="Center" TextWrapping="Wrap" VerticalContentAlignment="Stretch" FontWeight="{x:Static type:UiTypography.Emphasis}" IsTabStop="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="RCS 返回消息，可选择复制" AutomationProperties.LiveSetting="Polite">
         <TextBox.Style>
          <Style TargetType="TextBox" BasedOn="{StaticResource OperatorCopyableNotice}">
           <!-- Keep the RCS original selectable without changing its centered result appearance. -->
           <Setter Property="Background" Value="Transparent"/>
           <Setter Property="Padding" Value="8,0"/>
           <Setter Property="FontSize" Value="{x:Static type:UiTypography.Exception}"/>
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding CenteredRcsRejection}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.PageTitle}"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBox.Style>
        </local:RejectionMessageBox>
        <TextBlock x:Name="CenteredStateReason" Grid.Row="1" Text="{Binding CenteredStateReason}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.TaskValue}"/><Setter Property="Margin" Value="0,12,0,0"/><Style.Triggers><DataTrigger Binding="{Binding SupplyDisabled}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/></DataTrigger><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="Margin" Value="0"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding CenteredAttention}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,4,0,0"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding SupplyDisabled}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Row="2">
         <Border x:Name="CenteredRcsDivider" Height="1" MaxWidth="280" Background="{DynamicResource Line}">
          <Border.Style>
           <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,10,0,8"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding CenteredAttention}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
             <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0,4,0,3"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </Border.Style>
         </Border>
         <TextBlock x:Name="CenteredInstruction" Text="{Binding CenteredStateInstruction}" ToolTip="{Binding CenteredStateFullInstruction}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static type:UiTypography.TaskValue}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/></DataTrigger>
             <DataTrigger Binding="{Binding CenteredAttention}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="Margin" Value="0"/></DataTrigger>
             <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTight}" Value="True"/><Condition Binding="{Binding CenteredAttention}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/></MultiDataTrigger>
             <DataTrigger Binding="{Binding CenteredStateInstruction}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
        <Button x:Name="CenteredEnableSupply" HorizontalAlignment="Center" Grid.Row="3" Content="{Binding EnableLabel}" Click="EnableSupply_Click" IsEnabled="{Binding CanChangeSupply}" MinHeight="44">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}">
          <Setter Property="Background" Value="{DynamicResource Success}"/><Setter Property="Foreground" Value="{DynamicResource Surface}"/>
          <Setter Property="Margin" Value="0,12,0,0"/><Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding SupplyDisabled}" Value="True"/>
             <Condition Binding="{Binding SupplyConfigured}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible"/>
           </MultiDataTrigger>
           <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0,4,0,0"/></DataTrigger>
           <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Trigger>
          </Style.Triggers>
         </Style></Button.Style>
        </Button>
        <Button x:Name="ConfirmPlacementRemoval" Grid.Row="3" Content="已取下包裹" Click="ConfirmPlacementRemoval_Click" MinHeight="44">
         <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource StationButton}">
           <Setter Property="Margin" Value="0,8,0,0"/>
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers>
            <MultiDataTrigger>
             <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding CanConfirmPlacementRemoval}" Value="True"/>
              <Condition Binding="{Binding ShowConfirmedPlacementRemoval}" Value="False"/>
             </MultiDataTrigger.Conditions>
             <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
           </Style.Triggers>
          </Style>
         </Button.Style>
        </Button>
       </Grid>
      </Border>
     </Grid>
    </Border>
    </Grid>
    <!-- The two positions share the task row height so that their cards stay aligned. -->
    <Grid Grid.Row="3" x:Name="TaskFields">
     <Grid.Resources>
      <Style x:Key="LaneTaskLabel" TargetType="TextBlock" BasedOn="{StaticResource StationTaskLabel}">
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompact}" Value="False">
         <Setter Property="DockPanel.Dock" Value="Top"/>
         <Setter Property="Margin" Value="0"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Grid.Resources>
     <Grid.Style>
      <Style TargetType="Grid">
       <Setter Property="Height" Value="104"/>
       <Setter Property="Margin" Value="0,8,0,0"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsTight}" Value="True">
         <Setter Property="Height" Value="72"/>
         <Setter Property="Margin" Value="0,2,0,0"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Grid.Style>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}"
             BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" IsHitTestVisible="False"/>
     <DockPanel Grid.Row="0" Grid.Column="0" Margin="8,2,6,0">
      <TextBlock Text="波次号" Style="{StaticResource LaneTaskLabel}"/>
      <TextBox x:Name="WaveValue" Tag="{Binding WaveNo}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource StationTaskValue}" AutomationProperties.Name="本次任务波次号"/>
     </DockPanel>
     <DockPanel Grid.Row="0" Grid.Column="1" Margin="8,2,6,0">
      <TextBlock Text="任务号" Style="{StaticResource LaneTaskLabel}"/>
      <TextBox x:Name="TaskValue" Tag="{Binding TaskId}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource StationTaskValue}" AutomationProperties.Name="本次调度任务号"/>
     </DockPanel>
     <DockPanel Grid.Row="1" Grid.Column="0" Margin="8,0,6,2">
      <TextBlock Text="商品编码" Style="{StaticResource LaneTaskLabel}"/>
      <TextBox x:Name="SkuValue" Tag="{Binding SkuId}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource StationTaskValue}" AutomationProperties.Name="本次任务商品编码"/>
     </DockPanel>
     <DockPanel Grid.Row="1" Grid.Column="1" Margin="8,0,6,2">
      <TextBlock Text="返回数量" Style="{StaticResource LaneTaskLabel}"/>
      <TextBox x:Name="QuantityValue" Tag="{Binding ResponseQuantity}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource StationTaskValue}" FontFamily="{x:Static type:UiTypography.Interface}" AutomationProperties.Name="本次调度返回数量"/>
     </DockPanel>
    </Grid>
    <StackPanel Grid.Row="4" x:Name="FixedActions" Style="{StaticResource StationPositionActions}">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto" SharedSizeGroup="PositionInputFeedback"/>
       <RowDefinition Height="Auto" SharedSizeGroup="PositionActionButtons"/>
       <RowDefinition Height="Auto" SharedSizeGroup="PositionDeviceInformation"/>
      </Grid.RowDefinitions>
     <TextBlock x:Name="InputFeedback" TextWrapping="Wrap" MaxHeight="52" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource StationNotice}" AutomationProperties.LiveSetting="Polite"/>
     <Grid Grid.Row="1" x:Name="PositionActionButtons">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="8"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="SubmitBarcode" Height="44" Content="提交" Click="SubmitBarcode_Click" MinWidth="80" Margin="0">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource Primary}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding Visibility,ElementName=RebaseInput}" Value="Visible">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
      <Button x:Name="RebaseInput" Height="44" MinHeight="44" Content="确认本位包裹" Click="RebaseInput_Click" Visibility="Collapsed" Style="{StaticResource StationTouch}"
              ToolTip="本位状态已变化。请确认手上的包裹属于本位后再提交。"/>
      <Button x:Name="ConfirmManualPlacementRemoval" Height="44" MinHeight="44" Grid.Column="2" Content="已取下包裹" Click="ConfirmPlacementRemoval_Click">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource StationTouch}">
         <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
         <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
         <Setter Property="BorderBrush" Value="{DynamicResource Warning}"/>
         <Setter Property="Margin" Value="0,0,8,0"/>
         <Setter Property="Visibility" Value="Collapsed"/>
         <Setter Property="ToolTip" Value="取下本件后确认，准备接收下一件"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding ShowRcsGuidance}" Value="True">
           <Setter Property="ToolTip" Value="确认包裹已取下。原请求仍需核对，本位暂不能再次上件。"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ShowConfirmedPlacementRemoval}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
      <Button x:Name="WorkDetails" Height="44" MinHeight="44" Grid.Column="4" Content="查看详情" Click="Details_Click" IsEnabled="{Binding CanViewWorkDetails}" Style="{StaticResource StationTouch}"/>
     </Grid>
     <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Margin="0,3,0,0" IsHitTestVisible="False">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     </Border>
     <Grid Grid.Row="2" x:Name="PositionDeviceFooter">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,7,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CameraConnection" VerticalAlignment="Center" Text="{Binding CameraFooterText}" ToolTip="{Binding CameraFooterHint}" TextWrapping="Wrap" type:PaletteBrush.ForegroundKey="{Binding CameraFooterForegroundKey}" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="相机连接状态" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Grid.Column="1" FontSize="{x:Static type:UiTypography.Label}" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="{Binding DataContext.PaceVisibility,RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="Text" Value="{Binding DataContext.LeftPaceText,RelativeSource={RelativeSource AncestorType=Window}}"/><Style.Triggers><DataTrigger Binding="{Binding PositionId}" Value="right"><Setter Property="Text" Value="{Binding DataContext.RightPaceText,RelativeSource={RelativeSource AncestorType=Window}}"/></DataTrigger><DataTrigger Binding="{Binding DataContext.IsCompact,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     </Grid>
    </StackPanel>
   </Grid>
   </Border>
  </Grid>
 </Border>
</UserControl>
