<Window x:Class="Ipc.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ipc.Desktop" Title="供包参考工位 · SIMULATION" Width="1440" Height="900" MinWidth="980" MinHeight="700" Closing="WindowClosing" SizeChanged="WindowSizeChanged" PreviewKeyDown="WindowKeyDown">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,12"><TextBlock Text="供包参考工位" FontSize="26" FontWeight="SemiBold"/><WrapPanel><TextBlock Text="{Binding Identity}" Margin="12,0"/><Button Content="模拟操作员" Click="OperatorClick"/><Button Content="模拟维护员" Click="MaintenanceClick"/><Button Content="登出" Click="LogoutClick"/><Button Content="第二视图" Click="SecondViewClick"/><Button Content="标准 / 紧凑" Click="LayoutClick"/></WrapPanel></WrapPanel>
  <Border Grid.Row="1" Background="#FFF5DF" BorderBrush="#D8B871" BorderThickness="1" Padding="12" Margin="0,0,0,10"><TextBlock Text="{Binding GlobalStatus}" Foreground="#895509" AutomationProperties.LiveSetting="Assertive"/></Border>
  <WrapPanel Grid.Row="2" Margin="0,0,0,10"><TextBlock Text="{Binding Context}" MinWidth="230" FontSize="18"/><TextBox Text="{Binding BoxDraft,UpdateSourceTrigger=PropertyChanged}" Width="210" AutomationProperties.Name="箱码草稿"/><Button Content="校验新箱" Click="OpenClick"/><Button Content="暂停入场" Click="PauseClick"/><Button Content="恢复入场" Click="ResumeClick"/><Button Content="结束检查" Click="CheckClick"/><TextBlock Text="软件暂停非安全急停" Foreground="{StaticResource Muted}" Margin="12,0"/></WrapPanel>
  <TabControl x:Name="Pages" Grid.Row="3" SelectionChanged="TabChanged">
   <TabItem Header="工作台"><Grid x:Name="LaneGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><local:LaneControl x:Name="LeftLane"/><local:LaneControl x:Name="RightLane" Grid.Column="1"/></Grid></TabItem>
   <TabItem Header="记录与请求"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBox x:Name="FilterBox" MinWidth="180" AutomationProperties.Name="历史筛选"/><Button Content="查询" Click="HistoryClick"/></DockPanel><DataGrid x:Name="HistoryGrid" Grid.Row="1" SelectionChanged="HistorySelected"><DataGrid.Columns><DataGridTextColumn Header="时间 UTC" Binding="{Binding CreatedAt}" Width="180"/><DataGridTextColumn Header="通道" Binding="{Binding Lane}"/><DataGridTextColumn Header="条码" Binding="{Binding Barcode}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="160"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="上一页" Click="PreviousClick"/><Button Content="下一页" Click="NextClick"/></StackPanel></Grid><TextBox x:Name="DetailText" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/></Grid></TabItem>
   <TabItem Header="报警与关闭核对"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="已读不代表恢复。选择报警可定位原作业、设备或关闭请求。"/><DataGrid x:Name="AlarmGrid" Grid.Row="1" SelectionChanged="AlarmSelected"><DataGrid.Columns><DataGridTextColumn Header="发生 UTC" Binding="{Binding RaisedAt}" Width="180"/><DataGridTextColumn Header="范围" Binding="{Binding Scope}" Width="100"/><DataGridTextColumn Header="原因" Binding="{Binding Code}" Width="*"/><DataGridTextColumn Header="对象" Binding="{Binding OwnerId}" Width="240"/><DataGridTextColumn Header="已读" Binding="{Binding AckedBy}"/><DataGridTextColumn Header="恢复时间" Binding="{Binding ClearedAt}" Width="180"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="2"><TextBox x:Name="RequestIdBox" MinWidth="300" AutomationProperties.Name="原请求身份"/><Button Content="查询原请求结果" Click="ReconcileClick"/><Button Content="已读选中报警" Click="AckClick"/><Button Content="查看报警关联详情" Click="AlarmDetailClick"/><Button Content="当前关闭详情" Click="CloseDetailClick"/></DockPanel><DockPanel Grid.Row="3"><TextBox x:Name="EvidenceBox" MinWidth="350" AutomationProperties.Name="人工核对证据"/><Button Content="记录核对依据" Click="RecordEvidenceClick"/><Button Content="取消少货关闭" Click="CancelCloseClick"/><Button Content="确认当前检查并关闭" Click="ConfirmCloseClick"/></DockPanel></Grid></TabItem>
   <TabItem Header="设备、配置与诊断"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="SIMULATION · 工程夹具控制" FontSize="20"/><TextBlock Text="{Binding Devices}" Margin="0,8"/>
    <WrapPanel><ComboBox x:Name="FaultBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="None"/><ComboBoxItem Content="Drop"/><ComboBoxItem Content="Delay"/><ComboBoxItem Content="Reject"/><ComboBoxItem Content="QueryMissing"/><ComboBoxItem Content="QueryUnsupported"/></ComboBox><Button Content="下个请求故障" Click="FaultClick"/>
    <ComboBox x:Name="BlockBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="EntityPermit"/><ComboBoxItem Content="WcsUnavailable"/><ComboBoxItem Content="License"/><ComboBoxItem Content="DeviceFault"/></ComboBox><Button Content="设置模拟阻断" Click="BlockClick"/><Button Content="解除对应模拟阻断" Click="UnblockClick"/></WrapPanel>
    <TextBlock Text="站点配置草稿（维护角色；验证后待受控重启生效）" Margin="0,18,0,4"/><TextBox x:Name="ConfigDraft" Height="220" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"/>
    <WrapPanel><Button Content="验证并保存草稿" Click="SaveConfigClick"/><Button Content="刷新修订记录" Click="ConfigsClick"/><Button Content="激活选中修订并待重启" Click="ActivateClick"/><Button Content="导出脱敏诊断" Click="ExportClick"/><Button Content="一致性备份" Click="BackupClick"/></WrapPanel>
    <ListBox x:Name="ConfigsList" DisplayMemberPath="Status" Height="100"/><TextBox x:Name="ReviewEvidence" AutomationProperties.Name="来源或恢复检查依据"/><WrapPanel><Button Content="来源观察核对完成" Click="ReviewClick"/><Button Content="清除过载（有依据）" Click="OverloadClick"/><Button Content="解除恢复隔离（有依据）" Click="QuarantineClick"/></WrapPanel>
    <TextBlock Text="策略 SYNTHETIC-KEEP-v1：扫描保留件；共享箱双逻辑通道；业务接受与实体离场分开。真实 SDK、WCS、实体与数量规则、认证均未批准。Production 拒绝业务。" Foreground="#895509" Margin="0,18"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <TextBlock Grid.Row="4" Text="{Binding LastResult}" Margin="4,10,4,0" Foreground="{StaticResource Muted}"/>
 </Grid>
</Window>
