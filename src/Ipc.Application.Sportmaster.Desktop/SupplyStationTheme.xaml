<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Native UI derived under explicit user authorization. No HTML, CDN or font binaries. -->
 <SolidColorBrush x:Key="StationBackground" Color="#F0F2F5"/>
 <SolidColorBrush x:Key="StationInk" Color="#111827"/>
 <SolidColorBrush x:Key="StationMuted" Color="#6B7280"/>
 <SolidColorBrush x:Key="StationLine" Color="#E5E7EB"/>
 <Style x:Key="StationCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource StationLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
 <Style x:Key="StationLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource StationMuted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 <Style x:Key="StationValue" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}"><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="IsTabStop" Value="True"/><Setter Property="AutomationProperties.Name" Value="只读作业标识，可选择复制"/></Style>
 <Style x:Key="StationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="BorderBrush" Value="#D1D5DB"/><Setter Property="Foreground" Value="#374151"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="13"/></Style>
</ResourceDictionary>
