<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationPosition">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border x:Name="InputTargetOutline" BorderBrush="{Binding InputTargetBrush}" BorderThickness="3" Margin="2" CornerRadius="4">
  <Border x:Name="PositionOutline" Style="{StaticResource StationCard}" Padding="8">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
     <ComboBox x:Name="VisibleInputSource" DockPanel.Dock="Right" MinHeight="44" MinWidth="96" Margin="8,0,0,0" SelectionChanged="InputSource_SelectionChanged" SelectedIndex="0" AutomationProperties.Name="本位条码输入来源" ToolTip="键盘和PDA键盘均输入到当前焦点；不代表硬件设备绑定。">
      <ComboBoxItem Content="键盘"/>
      <ComboBoxItem Content="PDA键盘"/>
     </ComboBox>
     <StackPanel>
      <TextBlock Text="{Binding Heading}" FontSize="{x:Static type:UiTypography.Position}" FontWeight="{x:Static type:UiTypography.Emphasis}" AutomationProperties.Name="投递位"/>
      <TextBlock x:Name="CameraConnection" Text="{Binding DevicePresentation.Text}" Foreground="{Binding DevicePresentation.Foreground}" FontSize="{x:Static type:UiTypography.Label}" AutomationProperties.Name="相机连接状态" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" x:Name="ScanInformation" Margin="0,0,0,8">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBox x:Name="BarcodeEntry" MinHeight="48" Margin="0" VerticalContentAlignment="Center" FontSize="{x:Static type:UiTypography.BarcodeCompact}" FontFamily="{x:Static type:UiTypography.Code}" MaxLength="4096" AcceptsReturn="False" AcceptsTab="False" TextChanged="InputChanged" GotKeyboardFocus="Entry_GotKeyboardFocus" LostKeyboardFocus="Entry_LostKeyboardFocus" PreviewKeyDown="BarcodeEntry_KeyDown" PreviewTextInput="Entry_PreviewTextInput" AutomationProperties.Name="本次条码，可输入，回车提交" ToolTip="点击本位后输入；保留前导零。直接输入将替换已显示的整条旧码。PDA设为键盘输入并以回车结束。">
      <TextBox.ContextMenu>
       <ContextMenu>
        <MenuItem Header="剪切" Command="ApplicationCommands.Cut"/>
        <MenuItem Header="复制" Command="ApplicationCommands.Copy"/>
        <MenuItem Header="粘贴" Command="ApplicationCommands.Paste"/>
        <MenuItem Header="全选" Command="ApplicationCommands.SelectAll"/>
        <Separator/>
        <MenuItem Header="手动键盘" x:Name="KeyboardSource" IsCheckable="True" IsChecked="True" Click="KeyboardSource_Click"/>
        <MenuItem Header="PDA键盘" x:Name="PdaSource" IsCheckable="True" Click="PdaSource_Click"/>
        <Separator/>
        <MenuItem Header="清空输入" Click="ClearInput_Click"/>
       </ContextMenu>
      </TextBox.ContextMenu>
     </TextBox>
     <Button x:Name="CurrentBarcode" Grid.Column="1" Content="图片" Click="Picture_Click" IsEnabled="{Binding HasCurrentInput}" Style="{StaticResource StationButton}" MinWidth="64" Margin="8,0,0,0" AutomationProperties.Name="查看当前包裹图片"/>
    </Grid>
    <!-- The result owns the remaining height. Auxiliary metadata never scrolls it away. -->
    <Border x:Name="ResultPanel" Grid.Row="2" Background="{Binding ResultBackground}" Padding="12,8" CornerRadius="4">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel>
       <TextBlock Text="{Binding DisplayPresentation.Icon}" Foreground="{Binding ResultForeground}" FontSize="{x:Static type:UiTypography.Exception}" Margin="0,0,8,0" AutomationProperties.Name="本位状态符号"/>
       <TextBlock Text="{Binding ReadCueLabel}" Foreground="{Binding ResultForeground}" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding ResultForeground}" FontSize="{x:Static type:UiTypography.Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
      <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4" HorizontalAlignment="Center">
       <TextBox x:Name="CurrentSlot" Text="{Binding DisplaySlot,Mode=OneWay}" FontSize="{Binding DisplaySlotFontSize}" Foreground="{Binding ResultForeground}" Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True" FontFamily="{x:Static type:UiTypography.Code}" FontWeight="{x:Static type:UiTypography.Emphasis}" AutomationProperties.Name="{Binding DisplaySlotLabel}">
        <TextBox.Style>
         <Style TargetType="TextBox">
          <Style.Triggers>
           <DataTrigger Binding="{Binding DisplaySlotVisible}" Value="False">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBox.Style>
       </TextBox>
      </Viewbox>
      <ScrollViewer Grid.Row="1" x:Name="PositionBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4">
       <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
         <Style.Triggers>
          <DataTrigger Binding="{Binding DisplaySlotVisible}" Value="True">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </ScrollViewer.Style>
       <StackPanel>
        <TextBox x:Name="AttentionReason" Text="{Binding DisplayAttentionReason,Mode=OneWay}" Foreground="{Binding ResultForeground}" Style="{StaticResource StationValue}" Margin="0" AutomationProperties.Name="本位原因，可选择复制"/>
        <TextBlock x:Name="RetainedResponsibility" Text="{Binding OriginalResultSummary}" Foreground="{Binding ResultForeground}" Style="{StaticResource StationNotice}"/>
       </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="NextStep" Grid.Row="2" Text="{Binding DisplayNextStep}" Foreground="{Binding ResultForeground}" FontSize="{x:Static type:OperatorTokens.InstructionSize}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Style="{StaticResource StationInstruction}"/>
     </Grid>
    </Border>
    <StackPanel Grid.Row="3" x:Name="FixedActions" Margin="0,8,0,0">
     <TextBlock x:Name="InputFeedback" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource StationNotice}" AutomationProperties.LiveSetting="Polite"/>
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="1" Width="{x:Static type:OperatorTokens.TouchGap}"/>
      <Button x:Name="SubmitBarcode" Content="提交" Click="SubmitBarcode_Click">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource StationPrimaryTouch}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding Visibility,ElementName=RebaseInput}" Value="Visible">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
      <Button x:Name="RebaseInput" Content="确认本位包裹" Click="RebaseInput_Click" Visibility="Collapsed" Style="{StaticResource StationTouch}" ToolTip="本位状态已变化。请确认手上的包裹属于本位后再提交。"/>
      <Button Grid.Column="2" Content="查看详情" Click="Details_Click" IsEnabled="{Binding CanReconcile}" Style="{StaticResource StationTouch}"/>
     </Grid>
    </StackPanel>
   </Grid>
  </Border>
 </Border>
</UserControl>
