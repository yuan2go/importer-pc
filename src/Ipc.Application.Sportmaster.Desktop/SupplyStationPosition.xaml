<UserControl x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationPosition" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource StationCard}"><Setter Property="Margin" Value="8,4"/><Setter Property="Padding" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="0"/></DataTrigger></Style.Triggers></Style></Border.Style>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Margin" Value="16,10"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="16,4"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
   <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceLabel}" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource StationMuted}" ToolTip="{Binding DeviceStatus}"/>
   <StackPanel><TextBlock Text="相机信息" FontSize="14" Foreground="{StaticResource StationMuted}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock x:Name="ReaderIdentity" Text="{Binding ReaderIdentity}" ToolTip="{Binding ReaderIdentity}" FontSize="13" Foreground="{StaticResource StationMuted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" AutomationProperties.Name="本位运行相机身份"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{Binding Presentation.Background}" BorderBrush="{Binding Presentation.Border}" BorderThickness="1" CornerRadius="0"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="12,8"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="12,4"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding Status}" Foreground="{Binding Presentation.Foreground}" FontWeight="SemiBold" FontSize="20" AutomationProperties.LiveSetting="Polite"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="40"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="20"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><TextBlock Text="{Binding OperatorInstruction}" Style="{StaticResource StationNotice}" Foreground="{Binding Presentation.Foreground}"/></ScrollViewer>
    <TextBlock x:Name="RetainedResponsibility" Text="{Binding OriginalResultSummary}" FontSize="16" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding OriginalResponsibility}" Foreground="{StaticResource Warning}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel>
  </Border>
  <ScrollViewer x:Name="PositionBody" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="16,4"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="16,0"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,4"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Width" Value="2*"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition></Grid.ColumnDefinitions>
   <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.ColumnSpan" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="扫描信息 · 本次条码" Style="{StaticResource StationLabel}"/><TextBox x:Name="CurrentBarcode" MinHeight="36" Text="{Binding Barcode,Mode=OneWay}" FontSize="30" FontWeight="SemiBold" Margin="0" AutomationProperties.Name="本次条码，可选择复制"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource StationValue}"><Setter Property="MaxHeight" Value="76"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="48"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
   <TextBlock x:Name="ScanSummary" Text="{Binding ScanSummary}" ToolTip="{Binding SelectionSummary}" FontSize="13" Foreground="{StaticResource StationMuted}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Border Padding="0,4,0,0"><Border.Style><Style TargetType="Border"><Setter Property="MaxHeight" Value="240"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Expander Header="本次扫描候选与筛选依据" Margin="0,8,0,0">
     <StackPanel><TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding ScanTime,StringFormat=读取时间：{0}}"/><TextBox Text="{Binding ObservationIdentity,Mode=OneWay}" Style="{StaticResource StationValue}"/><TextBlock Text="完整原始候选" Style="{StaticResource StationLabel}"/>
      <TextBox Text="{Binding RawCandidates,Mode=OneWay}" Style="{StaticResource StationValue}" MaxHeight="160" AutomationProperties.Name="完整原始条码候选"/>
      <TextBlock Text="业务选中码" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding SelectedCode,Mode=OneWay}" Style="{StaticResource StationValue}"/>
     </StackPanel>
    </Expander>
   </StackPanel></ScrollViewer></Border>
   </StackPanel>
   <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,16,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.RowSpan" Value="2"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Margin" Value="16,0,0,0"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="任务信息 · 目标格口"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StationLabel}"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="FontSize" Value="14"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBox x:Name="CurrentSlot" Grid.Row="1" MinHeight="48" MaxHeight="94" Text="{Binding Slot,Mode=OneWay}" Foreground="{Binding Presentation.Foreground}" FontWeight="SemiBold" VerticalContentAlignment="Center" Margin="0" AutomationProperties.Name="本次有效格口，可选择复制"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource StationValue}"><Setter Property="FontSize" Value="{Binding SlotFontSize}"/><Setter Property="Margin" Value="0"/></Style></TextBox.Style></TextBox>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="1" Margin="0,8,0,8">
   <Expander Header="本次扫描候选与筛选依据" Margin="0,0,0,8"><Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel>
    <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding ScanTime,StringFormat=读取时间：{0}}"/><TextBox Text="{Binding ObservationIdentity,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="完整原始候选" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding RawCandidates,Mode=OneWay}" Style="{StaticResource StationValue}" MaxHeight="160"/>
    <TextBlock Text="业务选中码" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding SelectedCode,Mode=OneWay}" Style="{StaticResource StationValue}"/>
   </StackPanel></Expander>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="波次" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding WaveNo,Mode=OneWay}" Style="{StaticResource StationValue}" AutomationProperties.Name="本次任务波次"/>
     <TextBlock Text="商品编码" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding SkuId,Mode=OneWay}" Style="{StaticResource StationValue}" AutomationProperties.Name="本次任务商品编码"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="任务号" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding TaskId,Mode=OneWay}" Style="{StaticResource StationValue}" AutomationProperties.Name="本次调度任务号"/>
     <TextBlock Text="返回数量" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding ResponseQuantity,Mode=OneWay}" Style="{StaticResource StationValue}" AutomationProperties.Name="本次调度返回数量"/></StackPanel>
   </Grid>

  </StackPanel>
  <Expander Grid.Row="2" Header="原作业与恢复详情" IsExpanded="False" Margin="0,2,0,4" FontSize="16">
   <ScrollViewer x:Name="PositionDetailsScroll" VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="200"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="120"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel>
    <TextBlock Text="{Binding ReaderId}" Foreground="{StaticResource StationMuted}"/><TextBlock Text="{Binding DeviceStatus}"/><TextBlock Text="{Binding BlockingReasons}"/><TextBlock Text="{Binding ResultReason}" Foreground="{Binding Presentation.Foreground}"/><TextBlock Text="{Binding OriginalResponsibility}" Foreground="{StaticResource Warning}"/><TextBlock Text="{Binding LatestInputSummary}" FontSize="16"/><TextBlock Text="{Binding ObservedAt}" FontSize="14" Foreground="{StaticResource StationMuted}"/>
    <TextBlock Text="实体准入身份 · 当前观察" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding Admission,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="原作业身份 · 命令目标" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding OperationId,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="原取格口请求" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding RequestId,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="格口取得只表示上游结果；不表示物理完成。" FontSize="16" Foreground="{StaticResource StationMuted}"/>
    <TextBlock Text="原实体检查说明 · 继续原阶段时使用" Style="{StaticResource StationLabel}" Margin="0,12,0,4"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="本位原实体检查说明" MinHeight="44"/>
    <Expander Header="本位最近作业"><DataGrid ItemsSource="{Binding Recent}" Height="180" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="包裹号" Binding="{Binding ParcelCode,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State,Converter={StaticResource ParcelStateText},Mode=OneWay}" Width="*"/><DataGridTextColumn Header="格口" Binding="{Binding Slot,Mode=OneWay}" Width="70"/></DataGrid.Columns></DataGrid></Expander>
    <Expander Header="显式参考输入 · 模拟模式" Visibility="{Binding DataContext.SimulationVisibility,RelativeSource={RelativeSource AncestorType=Window}}"><StackPanel><TextBlock Text="新实体须显式创建身份；同码不等于同一实体。" FontSize="16"/><TextBox Text="{Binding ParcelCode,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模拟包裹号"/><TextBox Text="{Binding AdmissionId,Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="模拟实体准入身份"/><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="新包裹身份" Click="New_Click" Style="{StaticResource StationButton}"/><Button Content="模拟本位读码" Click="Emit_Click" IsEnabled="{Binding CanAdmit}" Style="{StaticResource StationButton}"/></WrapPanel></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </Expander>
  </Grid></ScrollViewer>
  <Border IsEnabled="{Binding CanStartOperation}" x:Name="FixedActions" Grid.Row="4" BorderBrush="{StaticResource StationLine}" BorderThickness="0,1,0,0" Background="#FBFCFD" Padding="12,8">
   <DockPanel LastChildFill="True">
    <WrapPanel DockPanel.Dock="Right">
     <Button Content="查看详情" Click="Details_Click" IsEnabled="{Binding CanReconcile}" Style="{StaticResource StationButton}" ToolTip="当前位保留的原作业与原请求；未准入的新观察另见扫描依据"/>
     <Button x:Name="PositionDiagnostics" Content="本位诊断" Click="Diagnostics_Click" Style="{StaticResource StationButton}"/>
     <Button x:Name="ReconcileOriginal" Content="核对原请求" Click="Reconcile_Click" IsEnabled="{Binding CanQueryOriginal}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUncertainOriginal}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button x:Name="ContinueOriginal" Content="继续原阶段" Click="Continue_Click" IsEnabled="{Binding CanContinue}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasContinuation}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    </WrapPanel>
    <TextBlock x:Name="NextStep" Text="{Binding NextStep}" Foreground="{StaticResource StationMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,12,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </DockPanel>
  </Border>
 </Grid></Border>
</UserControl>
