<Window x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop" Title="菜鸟供包台" Width="1600" Height="900" MinWidth="640" MinHeight="420" Background="{DynamicResource StationBackground}" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid x:Name="ClientArea" Background="{StaticResource StationBackground}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.Resources>
   <Style x:Key="ExpandedNavigation" TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
   <Style x:Key="CompactNavigation" TargetType="Menu"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  </Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,0,1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="16,8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12,4"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"><Button x:Name="OperatorAccess" Content="操作员登录" Click="OperatorLogin_Click" Visibility="{Binding LoginVisibility}" Style="{StaticResource StationButton}"/>
     <Menu Background="White" VerticalAlignment="Center"><MenuItem Header="更多" MinHeight="44" Padding="10,6"><MenuItem Header="站位与设备诊断" Click="Diagnostics_Click"/><MenuItem Header="辅助窗口" Click="Window_Click"/><MenuItem Header="标准 / 紧凑布局" Click="Layout_Click"/></MenuItem></Menu>
     <Border BorderBrush="{StaticResource StationLine}" BorderThickness="1,0,0,0" Margin="8,4"/>
     <Button Content="暂停新入场" Click="Pause_Click" Style="{StaticResource StationButton}"/>
     <Button Content="恢复新入场" Click="Resume_Click" IsEnabled="{Binding CanResumeInViewport}" Style="{StaticResource StationButton}"/>
    </StackPanel>
    <Button x:Name="ReturnToWork" DockPanel.Dock="Left" Content="返回作业" Click="Workstation_Click" Margin="0,0,16,0" MinHeight="44" FontSize="14" FontWeight="Normal"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"><Image Source="pack://application:,,,/Ipc.Application.ParcelFlow.Desktop;component/Assets/cainiao.png" Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="菜鸟标志"/><StackPanel><TextBlock Text="菜鸟供包台" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="FontSize" Value="18"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Station}" FontSize="14" Foreground="{StaticResource StationMuted}"/></StackPanel></StackPanel>
    <Grid VerticalAlignment="Center">
     <Menu Style="{StaticResource CompactNavigation}" Background="White"><MenuItem Header="{Binding PageTitle,StringFormat={}{0} ▾}" MinHeight="44" Padding="12,6"><MenuItem Header="工作台" Click="Workstation_Click"/><MenuItem Header="作业记录" Click="History_Click"/><MenuItem Header="参数配置" Click="Maintenance_Click"/><MenuItem Header="诊断与恢复" Click="Diagnostics_Click"/><Separator/><MenuItem Header="帮助与支持" Click="Support_Click"/></MenuItem></Menu>
<TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </DockPanel>
  </Border>
  <Border x:Name="DailyNavigation" Grid.Row="1" Grid.RowSpan="2" Width="176" Background="White" BorderBrush="{StaticResource StationLine}" BorderThickness="0,0,1,0">
   <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <DockPanel Margin="12,20,12,12"><Button DockPanel.Dock="Bottom" Content="帮助与支持" Click="Support_Click" Style="{StaticResource StationNavigation}"/>
    <StackPanel><Button Content="作业" Click="Workstation_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="workstation"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="作业记录" Click="History_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="history"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="参数配置" Click="Maintenance_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="maintenance"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="诊断与恢复" Click="Diagnostics_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StationNavigation}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="diagnostics"><Setter Property="Background" Value="{StaticResource AccentBackground}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DockPanel></Border>
  <ScrollViewer x:Name="HeaderDiagnostics" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding LoginVisibility}">
   <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="64"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="22"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><TextBlock Text="{Binding Session}" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="20,4"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="20,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </ScrollViewer>
  <Grid Grid.Row="2" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{Binding WorkspaceStatusBackground}" BorderBrush="{Binding StatusPresentation.Border}" BorderThickness="0,0,0,1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="16,8"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="16,0"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Padding" Value="20,6"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <StackPanel>
     <ScrollViewer x:Name="StatusDiagnostics" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="28"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="MaxHeight" Value="48"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
      <DockPanel LastChildFill="True">
       <TextBlock x:Name="WorkStatus" Text="{Binding WorkStatus}" FontWeight="SemiBold" Foreground="{Binding WorkspaceStatusForeground}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="DockPanel.Dock" Value="Top"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="FontSize" Value="14"/><Setter Property="DockPanel.Dock" Value="Left"/><Setter Property="Margin" Value="0,0,16,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock x:Name="SettingsRunMode" DockPanel.Dock="Left" Text="{Binding SettingsRunMode}" FontSize="13" Margin="0,0,16,0" Foreground="{StaticResource StationMuted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock x:Name="ActiveBlockingReasons" Text="{Binding DisplayWorkNotice}" Foreground="{Binding WorkspaceStatusForeground}" AutomationProperties.Name="当前作业阻断原因" ToolTip="{Binding WorkNotice}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StationNotice}"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="FontSize" Value="13"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </DockPanel>
     </ScrollViewer>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="40"/><Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="20"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><TextBlock x:Name="OperationFeedback" Text="{Binding WorkFeedback}" ToolTip="{Binding Feedback}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StationNotice}"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="FontSize" Value="13"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></ScrollViewer>
    </StackPanel>
   </Border>
   <ContentControl x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding ViewportReady}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Margin" Value="8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="4"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
  </Grid>
  <Border x:Name="WorkstationFooter" Grid.Row="3" Grid.ColumnSpan="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="20,8"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12,1"/></DataTrigger><DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><Grid Margin="0,0,0,6"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="workstation"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Left.Barcode}"><Run Text="左相机  "/><Run Text="{Binding Left.Status,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Left.Barcode,Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding Left.Slot,Mode=OneWay}"/></TextBlock>
<TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding Right.Barcode}"><Run Text="右相机  "/><Run Text="{Binding Right.Status,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Right.Barcode,Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding Right.Slot,Mode=OneWay}"/></TextBlock></Grid><TextBlock Text="{Binding EnvironmentStatus}" FontSize="14" Foreground="{StaticResource StationMuted}" ToolTip="{Binding UpdatedAt,StringFormat=最后读取：{0}}"/></StackPanel></Border>
  <Border x:Name="ViewportWarning" Grid.RowSpan="4" Grid.ColumnSpan="2" Background="{StaticResource StationBackground}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24" Visibility="{Binding ViewportWarningVisibility}">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding ViewportStatus}" FontSize="24" FontWeight="Bold"/>
    <TextBlock Text="有效客户区至少需要 800 × 420 逻辑像素。当前窗口的新操作已禁用，已请求软件暂停；暂停结果以下方应用快照为准。" FontSize="16" Margin="0,16"/>
    <TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Message}"/><TextBlock Text="{Binding ReadStatus}" Margin="0,12"/>
    <TextBlock Text="在途作业与原请求保持。空间恢复不会自动恢复入场；应用暂停且快照有效后，先确认视图，再核对现场并显式恢复。软件暂停不是安全急停。"/>
    <WrapPanel Margin="0,16"><Button Content="最大化窗口" Click="Maximize_Click" Style="{StaticResource StationButton}"/><Button Content="重试软件暂停" Click="ViewportPause_Click" Style="{StaticResource StationButton}"/><Button Content="确认视图，保持暂停" Click="ViewportAcknowledge_Click" IsEnabled="{Binding CanAcknowledgeViewport}" Style="{StaticResource StationButton}"/></WrapPanel>
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
</Window>
