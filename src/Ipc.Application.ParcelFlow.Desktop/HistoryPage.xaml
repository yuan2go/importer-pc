<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Height" Value="*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
  <WrapPanel Grid.ColumnSpan="2"><Button Content="读取最新50条" Click="Refresh_Click"/><Button Content="下一页" Click="Next_Click" IsEnabled="{Binding HasNextHistory}"/><TextBlock Text="{Binding CapacityState}" VerticalAlignment="Center"/></WrapPanel>
  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding HistoryStatus}" TextWrapping="Wrap" Margin="4,4,4,8" AutomationProperties.LiveSetting="Polite"/>
  <DataGrid ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" RowHeight="44"><DataGrid.Style><Style TargetType="DataGrid"><Setter Property="Grid.Row" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns><DataGridTextColumn Header="观察时间（原时区）" Binding="{Binding Operation.ObservedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" Width="190"/><DataGridTextColumn Header="位" Binding="{Binding Operation.PositionId}" Width="50"/><DataGridTextColumn Header="包裹号" Binding="{Binding Operation.ParcelCode}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Operation.State}" Width="*"/><DataGridTextColumn Header="格口" Binding="{Binding Operation.Slot}" Width="70"/><DataGridCheckBoxColumn Header="归档" Binding="{Binding Archived}"/></DataGrid.Columns></DataGrid>
  <DockPanel><DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Grid.Row" Value="2"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="12,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Grid.Row" Value="3"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,8,0,0"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding HistoryCommandTarget}" TextWrapping="Wrap"/><WrapPanel><Button Content="核对所选原请求" Click="Query_Click" IsEnabled="{Binding CanHistoryQuery}"/><Button Content="继续所选未尝试阶段" Click="Continue_Click" IsEnabled="{Binding CanHistoryContinue}"/><Button Content="复制完整原件JSON" Click="Copy_Click"/></WrapPanel><Expander Header="原实体检查说明 · 继续原阶段时填写"><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="不替代现场安全许可"/></Expander></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBox Text="{Binding StructuredDetails,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" FontSize="14"/><Expander Header="高级详情 · 完整原作业 / 请求 / 回执 JSON"><TextBox Text="{Binding Details,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/></Expander></StackPanel></ScrollViewer>
  </DockPanel>
 </Grid>
</UserControl>
