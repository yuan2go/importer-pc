<UserControl x:Class="Ipc.Application.Sportmaster.Desktop.ToteSupplyStationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" Foreground="{DynamicResource Ink}">
 <Grid Background="{DynamicResource Background}" Margin="12,6">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Style="{DynamicResource WorkstationCard}" Padding="8,4" Margin="0,0,0,6">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,12,0">
     <Border Background="{DynamicResource AccentBackground}" CornerRadius="{DynamicResource RadiusControl}" Padding="8" Margin="0,0,8,0">
      <Path Width="21" Height="21" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="2"
       Data="M 2,7 L 12,2 22,7 22,17 12,22 2,17 Z M 2,7 L 12,12 22,7 M 12,12 L 12,22"/>
     </Border>
     <StackPanel VerticalAlignment="Center" MaxWidth="230">
      <TextBlock Text="{DynamicResource Tote.Title}" FontWeight="Medium" FontSize="16" TextWrapping="Wrap"/>
      <TextBlock Text="{DynamicResource Tote.Subtitle}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
     </StackPanel>
    </StackPanel>
    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,5,0">
       <Ellipse.Style><Style TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource Warning}"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding OperatorStatusTone}" Value="Ready">
          <Setter Property="Fill" Value="{DynamicResource Success}"/>
          <DataTrigger.EnterActions><BeginStoryboard Name="StationPulse"><Storyboard>
           <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
          </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
          <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="StationPulse"/></DataTrigger.ExitActions>
         </DataTrigger>
         <DataTrigger Binding="{Binding OperatorStatusTone}" Value="Blocked"><Setter Property="Fill" Value="{DynamicResource Danger}"/></DataTrigger>
        </Style.Triggers>
       </Style></Ellipse.Style>
      </Ellipse>
      <TextBlock Text="{Binding OperatorStatus}" MaxWidth="136" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </StackPanel>
     <Button Content="{Binding RcsButtonText}" IsEnabled="{Binding CanCheckRcs}" Click="CheckRcs_Click" MinHeight="44" Margin="3,0"/>
     <TextBlock Text="{Binding Snapshot.CurrentOperator.DisplayName}" TextWrapping="Wrap" MaxWidth="110" VerticalAlignment="Center" Margin="5,0"/>
     <Button x:Name="MuteButton" MinHeight="44" Click="Mute_Click" Margin="3,0"/>
     <Button Content="{DynamicResource Common.Settings}" Click="Settings_Click" MinHeight="44" Margin="3,0"/>
     <Button Content="{DynamicResource Work.NavRecords}" Click="History_Click" MinHeight="44" Margin="3,0"/>
     <Button Content="{DynamicResource Work.Exit}" Click="Exit_Click" MinHeight="44" Margin="3,0"/>
     <TextBlock x:Name="ClockText" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="5,0"/>
    </WrapPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Style="{DynamicResource WorkstationCard}" Padding="10,5" Margin="0,0,0,6">
   <WrapPanel VerticalAlignment="Center">
    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
     <TextBlock Text="{DynamicResource Tote.Current}" FontWeight="Medium"/>
     <TextBlock Text="{DynamicResource Tote.Local}" Foreground="{DynamicResource Muted}" FontSize="{x:Static ui:UiTypography.Label}"/>
    </StackPanel>
    <TextBox x:Name="ContainerInput" MinWidth="150" Width="180" MaxLength="128" MinHeight="44" Margin="0,0,10,0"
     AutomationProperties.AutomationId="Tote.ContainerInput" AutomationProperties.Name="{DynamicResource Tote.ContainerCode}"
     ToolTip="{DynamicResource Tote.ContainerCode}" KeyDown="ToteInput_KeyDown"/>
    <TextBlock Text="{DynamicResource Tote.Plan}" TextWrapping="Wrap" MaxWidth="140" Margin="0,0,5,0" VerticalAlignment="Center"/>
    <TextBox x:Name="PlanInput" MinHeight="44" Width="70" MaxLength="10" Margin="0,0,12,0"
     AutomationProperties.Name="{DynamicResource Tote.Plan}" KeyDown="ToteInput_KeyDown"/>
    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
     <TextBlock Text="{DynamicResource Tote.Count}" Foreground="{DynamicResource Muted}" Margin="0,0,5,0"/>
     <TextBlock x:Name="CountText" Foreground="{DynamicResource Accent}" FontWeight="Medium"/>
    </StackPanel>
    <Button Content="{DynamicResource Tote.End}" AutomationProperties.AutomationId="Tote.EndSupply"
     Click="EndSupply_Click" MinHeight="44"/>
   </WrapPanel>
  </Border>
  <Grid Grid.Row="2" x:Name="Lanes">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  </Grid>
  <Border Grid.Row="3" Margin="0,6,0,0" Padding="8,3" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource RadiusControl}">
   <DockPanel>
    <TextBlock x:Name="SessionFeedback" DockPanel.Dock="Right" MaxWidth="380" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
     <Run Text="{Binding SettingsRunMode,Mode=OneWay}"/>
     <Run Text=" · "/>
     <Run Text="{DynamicResource Tote.HelpSafety}"/>
    </TextBlock>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
