<UserControl x:Class="Ipc.Application.Sportmaster.Desktop.SupplyStationPosition" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="16,12"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="8,4"/></DataTrigger></Style.Triggers></Style></Grid.Style>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{Binding Accent}" BorderThickness="4,0,0,0" Background="White"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="8,4"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="6,2"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock FontSize="16" FontWeight="Bold" Foreground="{Binding Accent}"><Run Text="{Binding Heading}"/><Run Text=" · "/><Run Text="{Binding ReaderId}" FontSize="12"/></TextBlock><TextBlock Text="{Binding DeviceStatus}" FontSize="12" Foreground="{StaticResource StationMuted}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
  <Border Grid.Row="1" Background="{Binding Presentation.Background}" BorderBrush="{Binding Presentation.Border}" BorderThickness="1" CornerRadius="8"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,6,0,6"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="0,4,0,4"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
   <TextBlock Foreground="{Binding Presentation.Foreground}" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="FontSize" Value="15"/></DataTrigger></Style.Triggers></Style></TextBlock.Style><Run Text="{Binding Presentation.Icon}"/><Run Text=" "/><Run Text="{Binding Status}"/></TextBlock>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="90"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel><TextBlock Text="{Binding BlockingReasons}" FontSize="13"/><TextBlock Text="{Binding ResultReason}" FontSize="13" Foreground="{Binding Presentation.Foreground}"/><TextBlock Text="{Binding OriginalResponsibility}" FontSize="13" Foreground="{StaticResource Warning}"/></StackPanel></ScrollViewer>
   <TextBlock x:Name="RetainedResponsibility" Text="{Binding OriginalResultSummary}" FontSize="12" TextWrapping="Wrap" MaxHeight="36" ToolTip="{Binding OriginalResponsibility}" Foreground="{StaticResource Warning}"/>
  </StackPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource StationCard}" Padding="8,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="包裹号 · 本次原始观察" Style="{StaticResource StationLabel}" Margin="0,0,0,2"/><TextBox x:Name="CurrentBarcode" VerticalScrollBarVisibility="Auto" Text="{Binding Barcode,Mode=OneWay}" FontWeight="Bold" MaxHeight="64"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource StationValue}"><Setter Property="FontSize" Value="25"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="FontSize" Value="20"/><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></StackPanel>
   <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="目标格口 · 本次结果" Style="{StaticResource StationLabel}" Margin="0,0,0,2"/><TextBox x:Name="CurrentSlot" VerticalScrollBarVisibility="Auto" Text="{Binding Slot,Mode=OneWay}" Style="{StaticResource StationValue}" Margin="0" Foreground="{Binding Presentation.Foreground}" FontSize="28" FontWeight="Bold" MaxHeight="40"/></StackPanel>
  </Grid></Border>
  <Expander Grid.Row="3" Header="原作业、观察与诊断详情" Margin="0,6,0,0"><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="{Binding BlockingReasons}" TextWrapping="Wrap"/><TextBlock Text="{Binding ResultReason}" TextWrapping="Wrap" Foreground="{Binding Presentation.Foreground}"/><TextBlock Text="{Binding OriginalResponsibility}" TextWrapping="Wrap" Foreground="{StaticResource Warning}"/><TextBlock Text="{Binding DeviceStatus}" FontSize="12"/><TextBlock Text="{Binding LatestInputSummary}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding ObservedAt}" FontSize="12" Foreground="{StaticResource StationMuted}"/>
    <TextBlock Text="实体准入身份 · 当前观察" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding Admission,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="原作业身份 · 命令目标" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding OperationId,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="原 WCS 请求" Style="{StaticResource StationLabel}"/><TextBox Text="{Binding RequestId,Mode=OneWay}" Style="{StaticResource StationValue}"/>
    <TextBlock Text="{Binding ImageStatus}" FontSize="12" Foreground="{StaticResource StationMuted}"/><TextBlock Text="格口取得只表示 WCS 结果；不表示物理完成。" FontSize="12" Foreground="{StaticResource StationMuted}"/>
    <TextBlock Text="原实体检查说明 · 继续原阶段时使用" Style="{StaticResource StationLabel}" Margin="0,8,0,4"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="本位原实体检查说明" MinHeight="36"/>
    <Expander Header="本位最近作业 · 当前保留记录"><DataGrid ItemsSource="{Binding Recent}" Height="180" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="包裹号" Binding="{Binding ParcelCode}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="格口" Binding="{Binding Slot}" Width="70"/></DataGrid.Columns></DataGrid></Expander>
    <Expander Header="显式参考输入 · Simulation" Visibility="{Binding DataContext.SimulationVisibility,RelativeSource={RelativeSource AncestorType=Window}}"><StackPanel><TextBlock Text="新包裹身份需显式创建；同码不等于同一实体。" FontSize="12"/><TextBox Text="{Binding ParcelCode,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模拟包裹号"/><TextBox Text="{Binding AdmissionId,Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="模拟实体准入身份"/><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="新包裹身份" Click="New_Click" Style="{StaticResource StationButton}"/><Button Content="模拟本位读码" Click="Emit_Click" IsEnabled="{Binding CanAdmit}" Style="{StaticResource StationButton}"/></WrapPanel></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </Expander>
  <Border IsEnabled="{Binding CanStartOperation}" x:Name="FixedActions" Grid.Row="4" Background="White" BorderBrush="{StaticResource StationLine}" BorderThickness="0,1,0,0" Padding="0,0,0,0"><WrapPanel><Button Content="查看详情" Click="Details_Click" IsEnabled="{Binding CanReconcile}" Style="{StaticResource StationButton}"/><Button Content="核对原请求" Click="Reconcile_Click" IsEnabled="{Binding CanReconcile}" Style="{StaticResource StationButton}"/><Button Content="继续原阶段" Click="Continue_Click" IsEnabled="{Binding CanContinue}" Style="{StaticResource StationButton}"/></WrapPanel></Border>
 </Grid>
</UserControl>
