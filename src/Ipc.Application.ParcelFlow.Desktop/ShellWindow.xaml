<Window x:Class="Ipc.Application.ParcelFlow.Desktop.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:parameters="clr-namespace:Ipc.Application.ParcelFlow.Desktop" Title="{Binding Title}" Width="1440" Height="900" MinWidth="640" MinHeight="420" UseLayoutRounding="True" Background="White" FontSize="14" FontWeight="Normal">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/ParameterSettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="ShellAction" TargetType="Button" BasedOn="{StaticResource ParameterAction}"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="ShellTab" TargetType="Button" BasedOn="{StaticResource ShellAction}"><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <parameters:ParameterMessageTextConverter x:Key="ParameterFeedbackText"/>
 </ResourceDictionary></Window.Resources>
 <Grid x:Name="ClientArea"><Grid.Resources><Style x:Key="Navigation" TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style><Style x:Key="CompactNavigation" TargetType="Menu"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="#E1E5EB" BorderThickness="0,0,0,1" Background="White"><StackPanel Margin="16,8,16,8">
   <Grid x:Name="IdentityHeader" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding StationDisplaySummary}" FontSize="12" Foreground="#5A6878" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding StationDisplaySummary}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="OperatorIdentity" Text="{Binding AccountDisplay}" ToolTip="{Binding AccountDisplay}" AutomationProperties.Name="{Binding AccountDisplay}" AutomationProperties.AutomationId="OperatorIdentity" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="MaxWidth" Value="260"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxWidth" Value="180"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <parameters:ManagementModeMenu Status="{Binding ManagementStatus}" ModeActionRequested="ManagementMode_Click" MinHeight="38" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <DockPanel x:Name="WorkspaceNavigation" LastChildFill="False">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="暂停新入场" Click="Pause_Click" Visibility="{Binding PauseVisibility}" Style="{StaticResource ShellAction}"/><Button Content="恢复新入场" Click="Resume_Click" Visibility="{Binding ResumeVisibility}" IsEnabled="{Binding CanResumeInViewport}" Style="{StaticResource ShellAction}"/></StackPanel>
    <Menu Style="{StaticResource CompactNavigation}" Background="Transparent" VerticalAlignment="Center"><MenuItem Header="页面与窗口" MinHeight="38"><MenuItem Header="工作台" Click="Workstation_Click"/><MenuItem Header="作业记录" Click="History_Click"/><MenuItem Visibility="{Binding ManagementModeVisibility}" Header="参数设置" Click="Maintenance_Click"/><MenuItem Visibility="{Binding ManagementModeVisibility}" Header="日志查询" Click="Logs_Click"/><Separator/><MenuItem Visibility="{Binding ManagementModeVisibility}" Header="切换紧凑布局" Click="Layout_Click"/></MenuItem></Menu>
    <WrapPanel Style="{StaticResource Navigation}"><Button Content="工作台" Click="Workstation_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ShellTab}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="work"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#B8CFF3"/><Setter Property="Foreground" Value="#185FBC"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="作业记录" Click="History_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ShellTab}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="history"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#B8CFF3"/><Setter Property="Foreground" Value="#185FBC"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="参数设置" Click="Maintenance_Click" Visibility="{Binding ManagementModeVisibility}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ShellTab}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="maintenance"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#B8CFF3"/><Setter Property="Foreground" Value="#185FBC"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="日志查询" Click="Logs_Click" Visibility="{Binding ManagementModeVisibility}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ShellTab}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="logs"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#B8CFF3"/><Setter Property="Foreground" Value="#185FBC"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Visibility="{Binding ManagementModeVisibility}" Content="紧凑布局" Click="Layout_Click" Style="{StaticResource ShellAction}"/></WrapPanel>
   </DockPanel>
  </StackPanel></Border>
  <Expander x:Name="StationDiagnostics" Visibility="{Binding ManagementModeVisibility}" Grid.Row="1" Header="站位、会话与设备诊断" Margin="12,0"><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><ScrollViewer x:Name="StationDiagnosticsScroll" MaxHeight="128" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding BlockingReasons}" TextWrapping="Wrap"/><TextBox Text="{Binding Feedback,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/><TextBlock Text="{Binding Flow}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Health}" TextWrapping="Wrap"/><TextBlock Text="{Binding CapacityState}"/><TextBlock Text="{Binding AuxiliaryState}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/><TextBlock Text="{Binding ConfigurationState}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Session}"/><TextBlock Text="{Binding OperationOperator}"/><TextBlock Text="{Binding CurrentImage}"/><TextBlock Text="{Binding CaptureState}" TextWrapping="Wrap"/><TextBlock Text="{Binding UploadState}"/><Expander Header="原实体检查说明"><StackPanel><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="重启原实体检查说明；不替代现场安全许可"/></StackPanel></Expander></StackPanel></ScrollViewer></Expander>
  <Border Grid.Row="2" BorderBrush="{Binding StatusPresentation.Border}" BorderThickness="3,0,0,0" Background="{Binding StatusPresentation.Background}" Padding="8,4" Margin="12,4"><ScrollViewer x:Name="OperationalStatusScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="280"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="64"/></DataTrigger><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="maintenance"><Setter Property="MaxHeight" Value="60"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="48"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="20"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel><TextBlock Text="{Binding NextAction}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.Name="当前影响与下一动作"/><TextBlock Text="{Binding StatusPresentation.Text}" Foreground="{Binding StatusPresentation.Foreground}" FontWeight="Bold"/></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="48"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="MaxHeight" Value="20"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><TextBlock x:Name="OperationFeedback" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding Feedback}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding OperatorFeedback}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="maintenance"><Setter Property="Text" Value="{Binding OperatorFeedback,Converter={StaticResource ParameterFeedbackText}}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></ScrollViewer><ScrollViewer x:Name="ActiveBlockersScroll" MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ActiveBlockingReasons" Text="{Binding BlockingReasons}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" AutomationProperties.Name="当前作业阻断原因" AutomationProperties.LiveSetting="Polite"/></ScrollViewer><Expander Header="操作员登录"><Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="{Binding LoginVisibility}"/><Setter Property="IsExpanded" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.CurrentOperator}" Value="{x:Null}"><Setter Property="IsExpanded" Value="True"/></DataTrigger><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="maintenance"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="logs"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style><WrapPanel x:Name="OperationalLogin" Visibility="{Binding LoginVisibility}"><TextBlock Text="操作员账号" VerticalAlignment="Center"/><TextBox Text="{Binding OperatorSubject,UpdateSourceTrigger=PropertyChanged}" Width="140"/><PasswordBox x:Name="LoginProof" Width="160" AutomationProperties.Name="操作员口令"/><Button Content="验证身份" Click="Login_Click" IsEnabled="{Binding CanStartFreshOperation}"/><Button Content="登出" Click="Logout_Click" IsEnabled="{Binding CanStartFreshOperation}"/></WrapPanel></Expander><TextBlock Text="{Binding ReadStatus}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
  <ContentControl x:Name="PageHost" Grid.Row="3" IsEnabled="{Binding ViewportReady}" Margin="6,4"/>
  <StackPanel Grid.Row="4" Margin="12,2"><DockPanel><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="maintenance"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedWorkspace,RelativeSource={RelativeSource AncestorType=Window}}" Value="logs"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style><WrapPanel DockPanel.Dock="Right" IsEnabled="{Binding CanStartOperation}" ToolTip="{Binding OperationStatus}" ToolTipService.ShowOnDisabled="True"><ComboBox ItemsSource="{Binding PositionIds}" SelectedItem="{Binding SelectedPositionId}" Width="90" AutomationProperties.Name="原作业命令投递位"/><Button Content="核对原请求" Click="Reconcile_Click" IsEnabled="{Binding CanQueryCurrent}"/><Button Content="继续未尝试原阶段" Click="Continue_Click" IsEnabled="{Binding CanContinue}"/></WrapPanel><TextBlock Text="{Binding CurrentCommandTarget}" ToolTip="{Binding CurrentCommandTarget}" MaxHeight="20" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding EnvironmentStatus}" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
  <Border Grid.RowSpan="5" Visibility="{Binding ViewportWarningVisibility}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Danger}" BorderThickness="2" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding ViewportStatus}" FontSize="24" FontWeight="Bold"/><TextBlock Text="有效客户区至少800 × 420 逻辑像素。新操作已禁用，软件暂停以应用回执为准；在途请求继续保留。空间恢复后须人工确认，业务保持暂停。" TextWrapping="Wrap" Margin="0,16"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding ReadStatus}" TextWrapping="Wrap"/><WrapPanel><Button Content="最大化窗口" Click="Maximize_Click"/><Button Content="重试软件暂停" Click="ViewportPause_Click"/><Button Content="确认视图，保持暂停" Click="ViewportAcknowledge_Click" IsEnabled="{Binding CanAcknowledgeViewport}"/></WrapPanel></StackPanel></ScrollViewer></Border>
 </Grid>
</Window>
