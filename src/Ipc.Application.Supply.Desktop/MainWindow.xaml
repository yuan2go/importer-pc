   <TabItem Style="{StaticResource ContentOnlyTab}" x:Name="EngineeringPage" Header="工程控制 · SIMULATION"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="SIMULATION · 独立工程控制" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="以下仅生成合成观察和故障；设备事件需要有效身份，维护动作需要维护角色。真实 SDK、WCS 和现场权限均未取得。" Margin="0,8"/><Button Content="切换模拟身份入口" Click="OpenIdentityClick" HorizontalAlignment="Left"/><StackPanel x:Name="EngineeringControls"><TextBlock Text="{Binding Devices}" Margin="0,8"/><WrapPanel><ComboBox x:Name="EngineeringLane" Width="140" SelectedIndex="0"><ComboBoxItem Content="left"/><ComboBoxItem Content="right"/></ComboBox><TextBox x:Name="EngineeringBarcode" Width="220" Text="000123" AutomationProperties.Name="模拟 Item 条码" KeyDown="EngineeringKeyDown"/><TextBox x:Name="EngineeringQuantity" Width="90" Text="1" AutomationProperties.Name="模拟包装量"/></WrapPanel><WrapPanel><Button Tag="Enter" Content="实体入场" Click="EventClick"/><Button Tag="Read" Content="读码" Click="EventClick"/><Button Tag="NoCode" Content="无码" Click="EventClick"/><Button Tag="MultiCode" Content="多码" Click="EventClick"/><Button Tag="Depart" Content="实体离场" Click="EventClick"/><Button Tag="Revalidate" Content="核对实体许可" Click="EventClick"/><Button Tag="Reset" Content="实体复位" Click="EventClick"/><Button Tag="Replay" Content="推进回放" Click="ReplayClick"/><Button Tag="ReconnectSource" Content="重连模拟来源" Click="ReconnectSourceClick"/></WrapPanel><WrapPanel><ComboBox x:Name="FaultBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="None"/><ComboBoxItem Content="Drop"/><ComboBoxItem Content="Delay"/><ComboBoxItem Content="Reject"/><ComboBoxItem Content="QueryMissing"/><ComboBoxItem Content="QueryUnsupported"/></ComboBox><Button Tag="SetFixtureFault" Content="下个请求故障" Click="FaultClick"/><ComboBox x:Name="BlockBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="EntityPermit"/><ComboBoxItem Content="WcsUnavailable"/><ComboBoxItem Content="License"/><ComboBoxItem Content="DeviceFault"/></ComboBox><Button Tag="SetSyntheticBlock" Content="设置模拟阻断" Click="BlockClick"/><Button Tag="ClearSyntheticBlock" Content="解除模拟阻断" Click="UnblockClick"/></WrapPanel></StackPanel><TextBlock Text="策略 SYNTHETIC-KEEP-v1：扫描保留件，业务接受与实体离场分开。Production 缺必需能力继续 NotReady。" Margin="0,16"/></StackPanel></ScrollViewer></TabItem>
