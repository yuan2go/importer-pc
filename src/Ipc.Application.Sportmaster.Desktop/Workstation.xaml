<UserControl x:Class="Ipc.Application.Sportmaster.Desktop.Workstation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf">
 <UserControl.Resources><DataTemplate x:Key="CompactDisclosure"><Grid MinHeight="28"><TextBlock Text="{Binding}" FontSize="{x:Static type:UiTypography.Body}"/></Grid></DataTemplate></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ItemsControl x:Name="Positions"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Border DataContext="{Binding Value}" BorderBrush="{Binding StatusBorder}" Background="{StaticResource Surface}" BorderThickness="1" Padding="8" Margin="6,4"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock FontSize="{x:Static type:UiTypography.Label}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}"><Run Text="{Binding Id, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DeviceId, Mode=OneWay}"/></TextBlock>
    <Border Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" Padding="4" Margin="0,4"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ShowStatus}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Foreground="{Binding StatusForeground}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Status}"/><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding HasCurrentInput}" Value="False"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Placeholder}"/></DataTrigger><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Exception}"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style><Run Text="{Binding StatusIcon, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding State, Mode=OneWay}"/></TextBlock><TextBlock Tag="RetainedResponsibility" Text="{Binding OriginalState}" FontSize="{x:Static type:UiTypography.Diagnostic}" MaxHeight="36" TextWrapping="Wrap" ToolTip="{Binding Reason}"/></StackPanel></Border>
    <Grid Margin="0,4,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding CurrentSlotAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="本次有效格口" FontSize="{x:Static type:UiTypography.Label}" Foreground="{StaticResource Muted}"/>
      <TextBox Tag="CurrentSlot" Text="{Binding Slot,Mode=OneWay}" IsTabStop="True" FontWeight="{x:Static type:UiTypography.Emphasis}" Foreground="{Binding StatusForeground}" VerticalScrollBarVisibility="Auto">
       <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}"><Setter Property="FontSize" Value="{Binding SlotFontSize}"/><Setter Property="MaxHeight" Value="104"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsCompact,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="FontSize" Value="{Binding CompactSlotFontSize}"/><Setter Property="MaxHeight" Value="64"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
      </TextBox>
     </StackPanel>
     <StackPanel Margin="8,0,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.Column" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding HasCurrentInput}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding CurrentSlotAvailable}" Value="False"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="本次包裹号" FontSize="{x:Static type:UiTypography.Label}" Foreground="{StaticResource Muted}"/>
      <TextBox Tag="CurrentBarcode" Text="{Binding Code,Mode=OneWay}" IsReadOnly="True" FontFamily="{x:Static type:UiTypography.Code}" FontWeight="Normal" TextWrapping="Wrap" BorderThickness="0" MinHeight="0" Padding="0" Margin="0" MaxHeight="64" VerticalScrollBarVisibility="Auto"><TextBox.Style><Style TargetType="TextBox"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Barcode}"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsCompact,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="FontSize" Value="{x:Static type:UiTypography.BarcodeCompact}"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
     </StackPanel>
    </Grid>

    <Expander HeaderTemplate="{StaticResource CompactDisclosure}" Header="观察、原作业与原因详情"><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsCompact,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel><TextBlock Text="{Binding Availability}" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{Binding StatusForeground}" FontSize="{x:Static type:UiTypography.Label}"/><TextBlock Text="{Binding InputSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Admission}" TextWrapping="Wrap"/><TextBlock Text="{Binding MainResult}"/><TextBlock Text="{Binding Background}" TextWrapping="Wrap"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
    <Button Tag="{Binding Id}" Grid.Row="1" Content="选择此位为命令目标" Click="Position_Click" MinHeight="44"/>
   </Grid></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Expander HeaderTemplate="{StaticResource CompactDisclosure}" IsEnabled="{Binding CanStartOperation}" Visibility="{Binding SimulationVisibility}" Grid.Row="1" Header="显式参考输入 · 不接入生产设备" Margin="6,2"><StackPanel><TextBlock Text="实体身份保留至显式新包裹；同码不自动合并，重复点击不创建新实体。"/><WrapPanel><TextBox Text="{Binding ParcelCode,UpdateSourceTrigger=PropertyChanged}" Width="220"/><TextBox Text="{Binding AdmissionId,UpdateSourceTrigger=PropertyChanged}" Width="260"/><Button Content="新包裹身份" Click="New_Click"/><Button Content="模拟相机读码" Click="Emit_Click" IsEnabled="{Binding CanAdmit}"/><TextBox Text="{Binding MeasurementValue,UpdateSourceTrigger=PropertyChanged}" Width="140"/><Button Content="同包裹模拟实测重量" Click="Weight_Click"/></WrapPanel></StackPanel></Expander>
 </Grid>
</UserControl>
