<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.MaintenancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ipc.Application.ParcelFlow.Desktop" FontSize="14" FontWeight="Normal" Background="White">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.ParcelFlow.Desktop;component/ParameterSettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="MaintenanceScope"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Background="#F5F6F8" LastChildFill="True" Visibility="{Binding Visibility, ElementName=BackToSettings}">

   <Button x:Name="BackToSettings" DockPanel.Dock="Left" Content="返回设置" Click="BackToSettings_Click" Style="{StaticResource ParameterQuietAction}" Margin="12,0,8,0" Visibility="Collapsed"/>
   <TextBlock x:Name="ToolTitle" Text="更改保留在当前草稿中" FontSize="13" Foreground="#5A6878" VerticalAlignment="Center" Margin="24,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ParameterConfigurationSummary}"/>
  </DockPanel>
  <local:ParameterSettingsControl x:Name="MainParameterEditor" RuntimeContext="{Binding}" Grid.Row="1" Model="{Binding ParameterEditor}" IsEnabled="{Binding CanEditFormConfiguration}"/>
  <Border Grid.Row="2" Background="White" BorderBrush="#E1E5EB" BorderThickness="0,1,0,0" Padding="20,10">
   <DockPanel LastChildFill="True">
   <Menu DockPanel.Dock="Left" Background="Transparent" Margin="0,0,16,0" FontSize="14" FontWeight="Normal">
    <MenuItem x:Name="AdvancedToggle" Header="设置工具" MinHeight="44" Padding="12,8">
     <MenuItem Header="导入设置模板…" Click="ImportTemplate_Click" IsEnabled="{Binding CanStartOperation}"/>
     <MenuItem Header="导出设置模板…" Click="ExportTemplate_Click" IsEnabled="{Binding CanStartOperation}"/>
     <Separator/>
     <MenuItem Header="加密保存未完成设置" Click="SaveEditor_Click" IsEnabled="{Binding CanConfigure}"/>
     <MenuItem Header="继续未完成设置" Click="ContinueEditor_Click" IsEnabled="{Binding CanStartOperation}"/>
     <MenuItem Header="重新读取设置…" Click="Load_Click" IsEnabled="{Binding CanStartOperation}"/>
     <Separator/>
     <MenuItem Header="高级工具">
      <MenuItem Header="已保存与运行中…" Tag="2" Click="TechnicalTool_Click"/>
      <MenuItem Header="已安装模块描述…" Tag="3" Click="TechnicalTool_Click"/>
      <MenuItem Header="能力实例库存…" Tag="4" Click="TechnicalTool_Click"/>
      <MenuItem Header="安装与卸载组件…" Tag="7" Click="TechnicalTool_Click"/>
      <MenuItem Header="实例与角色绑定…" Tag="0" Click="TechnicalTool_Click"/>
      <MenuItem Header="高级 JSON 编辑…" Tag="1" Click="TechnicalTool_Click"/>
      <MenuItem Header="旧版兼容参数…" Tag="5" Click="TechnicalTool_Click" Visibility="{Binding LegacyPolicyVisibility}"/>
      <Separator/>
      <MenuItem Header="原配置账核对…" Tag="2" Click="TechnicalTool_Click"/>
      <MenuItem Header="原机恢复后核对…" Tag="6" Click="TechnicalTool_Click"/>
      <MenuItem Header="原作业与接收责任…" Tag="8" Click="TechnicalTool_Click"/>
     </MenuItem>
     <MenuItem Header="维护授权与操作说明…" Click="AuthorizeTool_Click"/>
     <MenuItem Header="核对上次保存结果" Click="InspectSave_Click" IsEnabled="{Binding HasUnconfirmedConfigurationSubmission}"/>
     <MenuItem Header="按运行配置受控重连" Click="Reconnect_Click" IsEnabled="{Binding CanStartFreshOperation}"/>
    </MenuItem>
   </Menu>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="ViewChanges" Content="查看更改" Click="ReviewChanges_Click" Style="{StaticResource ParameterQuietAction}" IsEnabled="{Binding CanStartOperation}" Margin="0,0,8,0"/>
     <Button x:Name="SaveChanges" Content="{Binding ConfigurationSaveActionText}" Click="SaveChanges_Click" Style="{StaticResource ParameterPrimaryAction}" IsEnabled="{Binding CanReviewConfiguration}" ToolTip="{Binding ConfigurationDraftStatusText}" ToolTipService.ShowOnDisabled="True" MinWidth="120"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
     <TextBlock Text="{Binding ConfigurationDraftStatusText}" Foreground="#25384B" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding ConfigurationSavedStatusText}" Foreground="#5A6878" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ParameterConfigurationSummary}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TabControl x:Name="TechnicalTabs" Grid.Row="1" Margin="20,8,20,12" Visibility="Collapsed" Background="White" BorderThickness="0">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="{TemplateBinding Background}"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border></ControlTemplate></TabControl.Template>
   <TabItem Header="高级绑定与兼容策略"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" IsEnabled="{Binding CanEditStructuredConfiguration}">
    <TextBlock Text="{Binding ConfigurationEditorState}" TextWrapping="Wrap"/><TextBlock Text="读码来源和投递位保持完整。稳定设备身份只读；可选能力在库存中新增，再选择角色或本位绑定。表单与高级JSON须显式切换编辑来源。" TextWrapping="Wrap" Margin="0,8"/>
    <WrapPanel><Button Content="校验表单完整候选（不保存）" Click="ValidateStructured_Click"/><Button Content="表单生成高级JSON并切换" Click="Advanced_Click"/></WrapPanel>
    <TextBlock Text="全部读码来源 · 选择一行查看原安装模块的参数" FontWeight="Bold" Margin="0,12,0,4"/>
    <DataGrid IsReadOnly="False" x:Name="ReaderInstances" ItemsSource="{Binding ReaderDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="100" MaxHeight="220" RowHeight="44" SelectionChanged="Reader_Changed"><DataGrid.Columns>
     <DataGridTextColumn Header="稳定设备ID" Binding="{Binding Original.DeviceId,Mode=OneWay}" IsReadOnly="True" Width="*"/>
     <DataGridTextColumn Header="原角色" Binding="{Binding Original.Role,Mode=OneWay}" IsReadOnly="True" Width="150"/>
     <DataGridTemplateColumn Header="已安装提供者" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEnabled="False" ItemsSource="{Binding Capability.Providers}" SelectedItem="{Binding Capability.Provider,UpdateSourceTrigger=PropertyChanged}" ToolTip="提供者必须匹配版本、模块及安装清单SHA256"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Implementation, Mode=OneWay}"/><Run Text=" @ "/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Module, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Package.ManifestSha256, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="实例身份" IsReadOnly="True" Binding="{Binding Capability.InstanceId,Mode=OneWay}" Width="180"/>
    </DataGrid.Columns></DataGrid><StackPanel x:Name="ReaderParameterForm"/>
    <TextBlock Text="全部投递位 · 空绑定沿用已显示的默认秤/相机" FontWeight="Bold" Margin="0,12,0,4"/>
    <DataGrid IsReadOnly="False" ItemsSource="{Binding PositionDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44" MaxHeight="240"><DataGrid.Columns>
     <DataGridTextColumn Header="投递位" Binding="{Binding Id,Mode=OneWay}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="稳定读码来源" Binding="{Binding ReaderDeviceId,Mode=OneWay}" IsReadOnly="True" Width="*"/>
     <DataGridTemplateColumn Header="本位秤" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="本位相机" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid>
    <TextBlock Text="Application角色绑定 · 仅显示已安装能力库存；安装和绑定不代表已生效" FontWeight="Bold" Margin="0,12,0,4"/>
    <ItemsControl ItemsSource="{Binding ConfigurationRoles}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4" Visibility="{Binding Visibility}"><TextBlock Text="{Binding Role}" Width="140" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selection,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" MinHeight="44"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="备份、重量、图像与驱动参数统一在四类参数页编辑。此处仅维护实例库存和角色绑定。" TextWrapping="Wrap" Margin="0,16"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="完整候选配置（高级）"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="完整修订包含全部设备、投递位和能力库存。校验不保存；使用底部“保存更改…”审阅并提交。保存后待受控重启，启动时仍检查原责任。" TextWrapping="Wrap"/><TextBlock Text="{Binding ConfigurationEditorState}" TextWrapping="Wrap"/><WrapPanel><Button Content="显式切换高级JSON编辑" Click="Advanced_Click"/><Button Content="将当前高级JSON加载到表单" Click="StructuredFromJson_Click"/><Button Content="校验完整候选" Click="ValidateFull_Click"/></WrapPanel></StackPanel><TextBox x:Name="AdvancedJsonEditor" Text="{Binding ConfigurationDraft,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AdvancedConfigurationReadOnly}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel></TabItem>
   <TabItem Header="运行输入 / 待重启"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <GroupBox Header="{Binding EffectiveConfigurationHeading}"><TextBox Text="{Binding EffectiveConfiguration,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></GroupBox>
    <GroupBox Grid.Column="1" Header="已保存 Pending"><TextBox Text="{Binding PendingConfiguration,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></GroupBox></Grid>
    <GroupBox Grid.Row="1" Header="旧配置账核对" Margin="0,12,0,0"><DockPanel Margin="8">
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="旧账中的Effective不代表资源曾成功启动。先读取原记录、原字节SHA256和当前运行输入；暂停并认证维护后说明核对结论。确认后仍保持软件暂停。" TextWrapping="Wrap"/><TextBlock Text="{Binding ConfigurationConfirmationState}" TextWrapping="Wrap"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="维护核对说明"/><TextBox Text="{Binding ConfigurationConfirmationReason,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="44" MaxHeight="100" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><WrapPanel><Button Content="读取待确认原账" Click="ConfirmationLoad_Click" MinHeight="44"/><Button Content="确认已核对当前运行输入" Click="ConfirmationSave_Click" MinHeight="44" IsEnabled="{Binding CanConfirmConfiguration}"/></WrapPanel></StackPanel>
     <TextBox Text="{Binding ConfigurationConfirmationEvidence,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </DockPanel></GroupBox></Grid></TabItem>
   <TabItem Header="已安装模块参数"><TextBox Text="{Binding InstalledProviderParameters,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></TabItem>
   <TabItem Header="能力库存与参数"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel IsEnabled="{Binding CanEditStructuredConfiguration}"><ComboBox ItemsSource="{Binding NewCapabilityKinds}" SelectedItem="{Binding NewCapabilityKind}" Width="180"/><Button Content="新增未绑定能力实例" Click="AddInstance_Click"/><Button Content="移除所选未绑定实例" Click="RemoveInstance_Click"/></WrapPanel>
    <DataGrid IsReadOnly="False" Grid.Row="1" IsEnabled="{Binding CanEditFormConfiguration}" x:Name="Instances" ItemsSource="{Binding CapabilityDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44" SelectionChanged="Instance_Changed"><DataGrid.Columns>
     <DataGridTextColumn Header="能力" Binding="{Binding Role,Mode=OneWay}" IsReadOnly="True" Width="110"/>
     <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled,UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTemplateColumn Header="旧版绑定"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Bound,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LegacyBindingEditable}" ToolTip="schema3在拓扑与角色中绑定"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="已安装提供者" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEnabled="False" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider,UpdateSourceTrigger=PropertyChanged}" ToolTip="提供者必须匹配版本、模块及安装清单SHA256"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Implementation, Mode=OneWay}"/><Run Text=" @ "/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Module, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Package.ManifestSha256, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="实例身份" IsReadOnly="True" Binding="{Binding InstanceId,Mode=OneWay}" Width="150"/>
     <DataGridTemplateColumn Header="协议目标 / 读码身份" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Target,Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding TargetBoundary}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="合同版本" IsReadOnly="True" Binding="{Binding Contract,Mode=OneWay}" Width="180"/>
    </DataGrid.Columns></DataGrid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterForm" Margin="8" IsEnabled="{Binding CanEditFormConfiguration}"/></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="旧schema1/2策略" Visibility="{Binding LegacyPolicyVisibility}"><ScrollViewer><StackPanel Margin="16" IsEnabled="{Binding CanEditLegacyConfiguration}">
    <TextBlock Text="称重来源 · 配置补全与实测不同；协议强制实测时配置补全拒绝"/><WrapPanel><ComboBox ItemsSource="{Binding WeightSources}" SelectedItem="{Binding DraftWeightSource}" Width="170"/><ComboBox ItemsSource="{Binding WeightUnits}" SelectedItem="{Binding DraftUnit}" Width="90"/><TextBlock Text="精度"/><TextBox Text="{Binding DraftPrecision}" Width="80"/><TextBlock Text="配置值"/><TextBox Text="{Binding DraftConfiguredWeight}" Width="100"/></WrapPanel>
    <WrapPanel><TextBlock Text="本件等待期限(ms)"/><TextBox Text="{Binding DraftWaitMs}" Width="120"/><TextBlock Text="测量新鲜度(ms)"/><TextBox Text="{Binding DraftFreshMs}" Width="120"/></WrapPanel>
    <TextBlock Text="重量有效期：UntilDispatch持续到提交，AtAssociation仅关联时新鲜；真实现场须有资格证据" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding WeightValidities}" SelectedItem="{Binding DraftWeightValidity}" Width="240" HorizontalAlignment="Left"/>
    <TextBlock Text="图片上传 · BeforeMain前置成功后进入主链 / Attached独立恢复" Margin="0,16,0,8"/><ComboBox ItemsSource="{Binding UploadStrategies}" SelectedItem="{Binding DraftUploadStrategy}" Width="240" HorizontalAlignment="Left"/>
    <WrapPanel><TextBlock Text="单件最大字节"/><TextBox Text="{Binding DraftImageBytes}" Width="120"/><TextBlock Text="缓存总字节"/><TextBox Text="{Binding DraftTotalBytes}" Width="120"/><TextBlock Text="待处理件数"/><TextBox Text="{Binding DraftPending}" Width="100"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="恢复交接"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="完整恢复不自动放行业务。先在独立维护完成原机接管；原根退役围栏、受保护登记、当前机器和新根必须一致。换机证据不足保持隔离。" TextWrapping="Wrap"/><WrapPanel><Button Content="读取原机交接证据" Click="InspectRestore_Click"/><Button Content="确认已核对恢复，保持暂停" Click="ConfirmRestore_Click" IsEnabled="{Binding CanConfigure}"/></WrapPanel><TextBox Text="{Binding RestoreInspectionReason,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="恢复外部事实核对说明"/><TextBox Text="{Binding RestoreInspection,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="220" VerticalScrollBarVisibility="Auto"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="安装管理"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="{Binding InstalledPackages}" TextWrapping="Wrap"/><TextBlock Text="离线签名包路径（Windows由受保护提权帮助程序安装后刷新）"/><TextBox Text="{Binding PackagePath,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="原包 SHA256"/><TextBox Text="{Binding PackageSha256,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/><Button Content="验证签名并安装" Click="Install_Click" IsEnabled="{Binding Fresh}" HorizontalAlignment="Left"/><TextBlock Text="安全卸载 · 从实际安装目录返回的精确包身份选择；仍被配置、原件、备份或资源引用时原Store拒绝。" TextWrapping="Wrap" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding InstalledPackageReferences}" SelectedItem="{Binding SelectedInstalledPackage}" MinHeight="44"/><Button Content="安全卸载所选精确包" Click="Uninstall_Click" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Left"/><Expander Header="高级：按原安装操作ID恢复" Margin="0,12,0,0"><StackPanel><TextBlock Text="当前Application没有安装日志枚举接口。仅从原安装日志复制确切操作ID；不猜测身份，也不把业务Unknown当安装恢复。" TextWrapping="Wrap"/><TextBox Text="{Binding OriginalRecoveryOperationId,UpdateSourceTrigger=PropertyChanged}"/><Button Content="恢复原安装操作" Click="RecoverInstall_Click" IsEnabled="{Binding CanConfigure}"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="异常与恢复"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="先在记录中选择原作业；未知只查询，不重发。处置仅限无未知外部责任且PLC尚未尝试；原WCS接受及原意图保留。" TextWrapping="Wrap"/><TextBlock Text="{Binding HistoryCommandTarget}" TextWrapping="Wrap"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="已检查并移除实体的处置说明"/><WrapPanel><Button Content="继续未尝试附加上传" Click="Upload_Click" IsEnabled="{Binding CanContinueUpload}" Visibility="{Binding ImageSettingsVisibility}"/><Button Content="检查后取消未发送意图" Click="Abandon_Click" IsEnabled="{Binding CanAbandon}"/><Button Content="确认已检查过载现场" Click="Overload_Click" IsEnabled="{Binding Fresh}"/><Button Content="受控归档已清偿原件" Click="Archive_Click" IsEnabled="{Binding Fresh}"/><TextBox Text="{Binding IdentityConflictId,UpdateSourceTrigger=PropertyChanged}" Width="230" ToolTip="阻断投影中的原身份冲突ID"/><Button Content="确认已检查身份冲突" Click="Identity_Click" IsEnabled="{Binding Fresh}"/></WrapPanel><TextBlock Text="原接收发生：读取后选择确切ID。暂停并认证维护；只按原Query核对结果，保留旧缺raw证据，不重发。RawDurable原件缺失仍隔离。" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBox Text="{Binding ReceiptOccurrenceId,UpdateSourceTrigger=PropertyChanged}" ToolTip="原Awaiting发生ID"/><WrapPanel><Button Content="读取所选作业接收责任" Click="Receipts_Click" IsEnabled="{Binding Fresh}"/><Button Content="核对原缺回执结果" Click="ReceiptQuery_Click" IsEnabled="{Binding CanConfigure}"/></WrapPanel><TextBox Text="{Binding ReceiptInventory,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="完整备份"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="新备份完整路径（不覆盖已有文件）" FontSize="15"/><TextBlock Text="数据库与同名 .recovery 目录组成完整恢复集；隔离恢复从独立维护入口执行。" TextWrapping="Wrap" Margin="0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="创建完整备份" Click="Backup_Click" IsEnabled="{Binding CanConfigure}"/><TextBox Text="{Binding BackupPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新备份完整路径"/></DockPanel><Button Content="维护授权与操作说明…" Click="AuthorizeTool_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="模板与显示"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="同版安全模板" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="先读取完整配置，检查待导入对象与差异，再应用到当前草稿。模板不包含工位编码、设备地址、目标、秘密、请求编号、备份路径或业务数据。" TextWrapping="Wrap" Margin="0,8"/><WrapPanel IsEnabled="{Binding CanStartOperation}"><Button Content="导出同版安全模板…" Click="ExportTemplate_Click"/><Button Content="导入并预览模板…" Click="ImportTemplate_Click"/></WrapPanel><TextBlock Text="本机显示偏好" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8"/><TextBlock Text="“系统 → 显示偏好”或窗口上方“更多 → 标准 / 紧凑布局”按当前 Windows 用户保存。显示偏好不写业务配置、不启动连接，也不改变准入。" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
