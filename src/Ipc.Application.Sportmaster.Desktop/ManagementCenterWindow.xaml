<Window x:Class="Ipc.Application.Sportmaster.Desktop.ManagementCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:local="clr-namespace:Ipc.Application.Sportmaster.Desktop"
 Title="管理中心" Width="1280" Height="800" MinWidth="760" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True" Background="{DynamicResource Background}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Ipc.Application.Sportmaster.Desktop;component/SupplyStationTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <local:ManagementTabSelectedConverter x:Key="ManagementTabSelected"/>
  <Style x:Key="ManagementTab" TargetType="Button" BasedOn="{StaticResource StationNavigation}">
   <Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="16,8"/>
   <Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource ManagementTabSelected}"><Binding Path="SelectedPage"/><Binding Path="Tag" RelativeSource="{RelativeSource Self}"/></MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="{DynamicResource AccentBackground}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
  </Style>
 </ResourceDictionary></Window.Resources>
 <Grid x:Name="ClientArea" KeyboardNavigation.TabNavigation="Cycle">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="20,12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
   <DockPanel><TextBlock Text="管理中心" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}" VerticalAlignment="Center"/><TextBlock Text="设备与参数管理" FontSize="{x:Static type:UiTypography.Label}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel>
  </Border>
  <Border Grid.Row="1" Padding="16,8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
   <WrapPanel x:Name="ManagementNavigation"><Button Content="设备与诊断" Tag="diagnostics" Click="Navigate_Click" Style="{StaticResource ManagementTab}"/><Button Content="设置" Tag="maintenance" Click="Navigate_Click" Style="{StaticResource ManagementTab}"/><Button Content="调试" Tag="debug" Click="Navigate_Click" Style="{StaticResource ManagementTab}"/><Button Content="日志" Tag="logs" Click="Navigate_Click" Style="{StaticResource ManagementTab}"/></WrapPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid x:Name="AuthorizedBody"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBox Text="{Binding WorkFeedback, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="{DynamicResource AccentBackground}" Foreground="{DynamicResource Ink}" Padding="16,8" MaxHeight="76" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="管理操作结果，可复制"><TextBox.Style><Style TargetType="TextBox"><Style.Triggers><DataTrigger Binding="{Binding WorkFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
    <ContentControl x:Name="ManagementPageHost" Grid.Row="1"/>
   </Grid>
   <Border x:Name="AuthorizationGate" Background="{DynamicResource Background}" Padding="24" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="请重新验证管理密码" FontSize="{x:Static type:UiTypography.PageTitle}" FontWeight="{x:Static type:UiTypography.Emphasis}"/><TextBlock Text="管理授权已结束，当前页面已锁定，未保存的设置保留。供包作业继续运行。" TextWrapping="Wrap" Margin="0,12,0,20"/><Button Content="验证管理密码" Click="Authenticate_Click" MinHeight="44" HorizontalAlignment="Left" Padding="20,8"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="3" Padding="16,8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel LastChildFill="True">
   <WrapPanel DockPanel.Dock="Right"><Button x:Name="RenewAuthorization" Content="延长授权" Click="Renew_Click" MinHeight="44" Margin="0,0,8,0"/><Button x:Name="PasswordSettings" Content="管理密码" Click="Password_Click" MinHeight="44" Margin="0,0,8,0"/><Button x:Name="CloseManagementCenter" Content="关闭" Click="Close_Click" MinHeight="44" MinWidth="80"/></WrapPanel>
   <TextBlock x:Name="AuthorizationStatus" Foreground="{DynamicResource Muted}" FontSize="{x:Static type:UiTypography.Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel></Border>
 </Grid>
</Window>
