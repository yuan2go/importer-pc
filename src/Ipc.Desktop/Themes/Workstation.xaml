<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf">
 <!-- TYPOGRAPHY-01: bundled official OFL desktop faces and shared semantic roles. -->
 <SolidColorBrush x:Key="Background" Color="#F1F4F7"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/><SolidColorBrush x:Key="Soft" Color="#F6F8FA"/>
 <SolidColorBrush x:Key="Ink" Color="#192736"/><SolidColorBrush x:Key="Muted" Color="#536577"/><SolidColorBrush x:Key="Line" Color="#D8E0E7"/>
 <SolidColorBrush x:Key="Accent" Color="#205FCE"/><SolidColorBrush x:Key="AccentHover" Color="#184FAA"/><SolidColorBrush x:Key="AccentPressed" Color="#123D8B"/><SolidColorBrush x:Key="AccentBackground" Color="#EEF4FF"/>
 <SolidColorBrush x:Key="Success" Color="#147450"/><SolidColorBrush x:Key="SuccessBackground" Color="#EDF7F1"/><SolidColorBrush x:Key="Warning" Color="#895509"/><SolidColorBrush x:Key="WarningBackground" Color="#FFF5DF"/><SolidColorBrush x:Key="Danger" Color="#B52F38"/><SolidColorBrush x:Key="DangerBackground" Color="#FDF0F0"/>
 <Style x:Key="FocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="#1559D6" BorderThickness="3" CornerRadius="9" Margin="-5"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Background}"/></Style>
 <Style TargetType="Button">
  <Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="IsDefault" Value="False"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter><Setter TargetName="Frame" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Background" Value="#EDF0F3"/><Setter TargetName="Frame" Property="BorderBrush" Value="#DFE5EB"/><Setter Property="Foreground" Value="#75818D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="MinHeight" Value="48"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource AccentPressed}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="LaneAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="48"/><Style.Triggers><DataTrigger Binding="{Binding PrimaryIsCommand}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style>
 <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Danger}"/><Setter Property="BorderBrush" Value="{StaticResource Danger}"/><Setter Property="Foreground" Value="White"/><Setter Property="MinHeight" Value="48"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#95242C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#781B22"/></Trigger></Style.Triggers></Style>
 <Style TargetType="TextBox"><Setter Property="MinHeight" Value="44"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="4"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/></Style>
 <Style x:Key="ReadonlyValue" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="True"/><Setter Property="IsTabStop" Value="False"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="{x:Static type:UiTypography.Interface}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="CodeValue" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}"><Setter Property="FontFamily" Value="{x:Static type:UiTypography.Code}"/></Style>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,4"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/></Style>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/></Style>
 <Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="44"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/><Setter Property="Background" Value="White"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="{StaticResource Soft}"/></Style>
 <Style x:Key="ContentOnlyTabs" TargetType="TabControl"><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="ContentOnlyTab" TargetType="TabItem"><Setter Property="IsTabStop" Value="False"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/><Setter Property="Background" Value="{StaticResource Soft}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="10,10"/><Setter Property="FontWeight" Value="{x:Static type:UiTypography.Emphasis}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/></Style>
 <Style TargetType="Expander"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
 <Style TargetType="TabControl"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="12"/></Style>
 <Style TargetType="TabItem"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="14,8"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
 <Style TargetType="Menu"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
 <Style TargetType="MenuItem"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
</ResourceDictionary>
