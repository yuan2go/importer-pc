<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:type="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" xmlns:pf="clr-namespace:Ipc.Application.ParcelFlow.Desktop;assembly=Ipc.Application.ParcelFlow.Desktop">
 <pf:ParcelStateTextConverter x:Key="ParcelStateText"/>
 <!-- Native UI derived under explicit user authorization. Typography uses the shared offline OFL resources. -->
 <Style x:Key="StationCard" TargetType="Border" BasedOn="{StaticResource WorkstationCard}"/>
 <Style x:Key="StationLabel" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Label}"/>
  <Setter Property="Margin" Value="0,0,0,6"/>
 </Style>
 <Style x:Key="StationValue" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}">
  <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
  <Setter Property="Margin" Value="0,0,0,12"/>
  <Setter Property="IsTabStop" Value="True"/>
  <Setter Property="AutomationProperties.Name" Value="只读作业标识，可选择复制"/>
 </Style>
 <Style x:Key="StationTaskLabel" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.TaskLabel}"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
 </Style>
 <Style x:Key="StationTaskValue" TargetType="TextBox" BasedOn="{StaticResource ReadonlyValue}">
  <Setter Property="FontFamily" Value="{x:Static type:UiTypography.Code}"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.TaskValue}"/>
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="MaxHeight" Value="64"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
  <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  <Setter Property="Margin" Value="0"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Text" Value="—"/>
  <Setter Property="IsTabStop" Value="False"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding ShowConfirmedTask}" Value="True">
    <Setter Property="Text" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="IsTabStop" Value="True"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="MaxHeight" Value="34"/></DataTrigger>
   <!-- A field RCS did not return, or no task yet, reads as secondary rather than as a value. -->
   <Trigger Property="Text" Value="未返回"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
   <Trigger Property="Text" Value="—"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="FontWeight" Value="{x:Static type:UiTypography.Regular}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="MinHeight" Value="44"/>
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
  <Setter Property="Padding" Value="8,6"/>
  <Setter Property="Margin" Value="0,0,4,0"/>
 </Style>
 <Style x:Key="StationNavigation" TargetType="Button" BasedOn="{StaticResource StationButton}">
  <Setter Property="MinHeight" Value="44"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Padding" Value="8,6"/>
  <Setter Property="Margin" Value="2,0"/>
 </Style>
 <Style x:Key="StationNotice" TargetType="TextBlock">
  <Setter Property="FontSize" Value="{x:Static type:UiTypography.Body}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Style.Triggers>
   <Trigger Property="Text" Value="">
    <Setter Property="Visibility" Value="Collapsed"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <DataTemplate x:Key="PreferenceNoticeBell">
  <Grid>
   <ToggleButton x:Name="Bell" MinWidth="44" MinHeight="44" Padding="8,0" FocusVisualStyle="{StaticResource FocusRing}" ToolTip="本机偏好通知" AutomationProperties.Name="本机偏好通知">
    <Grid Width="22" Height="22">
     <Path Data="M 3,16 L 5,13 L 5,9 A 5,5 0 0 1 15,9 L 15,13 L 17,16 Z M 8,19 Q 10,22 12,19" Stroke="{DynamicResource Ink}" StrokeThickness="1.5"/>
     <Ellipse Width="7" Height="7" Fill="{DynamicResource Warning}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </Grid>
   </ToggleButton>
   <Popup IsOpen="{Binding IsChecked, ElementName=Bell, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Bell}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
    <Border Width="350" Style="{StaticResource StationCard}">
     <StackPanel>
      <TextBlock Text="本机偏好通知" FontWeight="{x:Static type:UiTypography.Emphasis}"/>
      <TextBox Text="{Binding PreferenceNoticeText, Mode=OneWay}" Style="{StaticResource OperatorCopyableNotice}" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="本机偏好通知详情"/>
     </StackPanel>
    </Border>
   </Popup>
  </Grid>
 </DataTemplate>
 <Style x:Key="PreferenceNoticeHost" TargetType="ContentControl">
  <Setter Property="Content" Value="{Binding}"/><Setter Property="ContentTemplate" Value="{StaticResource PreferenceNoticeBell}"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Visibility" Value="Collapsed"/>
  <Style.Triggers><DataTrigger Binding="{Binding HasPreferenceNotices}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="StationTouch" TargetType="Button" BasedOn="{StaticResource StationButton}">
  <Setter Property="MinHeight" Value="{x:Static type:OperatorTokens.TouchHeight}"/>
  <Setter Property="Margin" Value="0"/>
  <Setter Property="Padding" Value="12,8"/>
 </Style>
 <Style x:Key="StationInstruction" TargetType="TextBlock">
  <Style.Triggers>
   <Trigger Property="Text" Value="">
    <Setter Property="Visibility" Value="Collapsed"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StationResultPanel" TargetType="Border">
  <Setter Property="Padding" Value="16,12"/>
  <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
  <Setter Property="Background" Value="{DynamicResource Soft}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding ShowConfirmedTask}" Value="True">
    <Setter Property="Background" Value="{DynamicResource SuccessBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding DisplayPresentation.Tone}" Value="Unknown">
    <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding CenteredRcsRejection}" Value="True">
    <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="8,4"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StationResultHeading" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding ShowConfirmedTask}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
   <DataTrigger Binding="{Binding DisplayPresentation.Tone}" Value="Rejected"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
   <DataTrigger Binding="{Binding DisplayPresentation.Tone}" Value="Unknown"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StationPositionCard" TargetType="Border" BasedOn="{StaticResource StationCard}">
  <Setter Property="Padding" Value="20"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="12"/></DataTrigger>
   <DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Padding" Value="8,0"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StationPositionSection" TargetType="FrameworkElement">
  <Setter Property="Margin" Value="0,0,0,8"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0,0,0,2"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="StationPositionActions" TargetType="StackPanel">
  <Setter Property="Margin" Value="0,8,0,0"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsTight}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers>
 </Style>
</ResourceDictionary>
