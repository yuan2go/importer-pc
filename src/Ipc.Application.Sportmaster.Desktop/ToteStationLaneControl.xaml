<UserControl x:Class="Ipc.Application.Sportmaster.Desktop.ToteStationLaneControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:Ipc.Presentation.Wpf;assembly=Ipc.Presentation.Wpf" Foreground="{DynamicResource Ink}">
 <UserControl.Resources>
  <Style x:Key="ToteCard" TargetType="Border" BasedOn="{StaticResource WorkstationCard}">
   <Setter Property="Padding" Value="9,5"/>
   <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="ToteHeading" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="ToteValue" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,1,0,1"/>
   <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>
 </UserControl.Resources>
 <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <Border x:Name="LaneBanner" Background="{DynamicResource AccentBackground}" Padding="10,5">
     <TextBlock x:Name="LaneName" Foreground="{DynamicResource Accent}" FontWeight="Medium" TextWrapping="Wrap"/>
    </Border>
    <WrapPanel Margin="8,4,8,0">
     <Button IsEnabled="{Binding CanChangeSupply}" Content="{DynamicResource Work.Enable}" Click="Enable_Click" MinHeight="44" Margin="0,0,4,0"
      ui:PaletteBrush.BackgroundKey="{Binding EnableBackgroundKey}" ui:PaletteBrush.ForegroundKey="{Binding EnableForegroundKey}"/>
     <Button IsEnabled="{Binding CanChangeSupply}" Content="{Binding DisableLabel}" Click="Disable_Click" MinHeight="44" Margin="0,0,5,0"
      ui:PaletteBrush.BackgroundKey="{Binding DisableBackgroundKey}" ui:PaletteBrush.ForegroundKey="{Binding DisableForegroundKey}"/>
     <Border x:Name="VehicleBadge" Background="{DynamicResource Soft}" CornerRadius="{DynamicResource RadiusControl}" Padding="6,3" Margin="0,2,4,2" VerticalAlignment="Center">
      <TextBlock x:Name="VehicleText" ui:PaletteBrush.ForegroundKey="{Binding VehicleStatusForegroundKey}" TextWrapping="Wrap" MaxWidth="220"/>
     </Border>
     <Border Background="{DynamicResource Soft}" CornerRadius="{DynamicResource RadiusControl}" Padding="6,3" Margin="0,2,0,2" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
       <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
        <Ellipse.Style><Style TargetType="Ellipse">
         <Setter Property="Fill" Value="{DynamicResource Muted}"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding DeviceForegroundKey}" Value="Success"><Setter Property="Fill" Value="{DynamicResource Success}"/></DataTrigger>
          <DataTrigger Binding="{Binding DeviceForegroundKey}" Value="Danger"><Setter Property="Fill" Value="{DynamicResource Danger}"/></DataTrigger>
          <DataTrigger Binding="{Binding ShowUncalibratedHint}" Value="True"><Setter Property="Fill" Value="{DynamicResource Warning}"/></DataTrigger>
         </Style.Triggers>
        </Style></Ellipse.Style>
       </Ellipse>
       <TextBlock Text="{Binding CameraFooterText}" TextWrapping="Wrap" MaxWidth="245" ui:PaletteBrush.ForegroundKey="{Binding CameraFooterForegroundKey}"/>
      </StackPanel>
     </Border>
    </WrapPanel>
    <WrapPanel Margin="9,3,9,4" TextBlock.Foreground="{DynamicResource Muted}" TextBlock.FontSize="{x:Static ui:UiTypography.Label}">
     <TextBlock x:Name="LanePaceText" Margin="0,0,10,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="LastScanText" TextWrapping="Wrap"/>
    </WrapPanel>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="7,0,7,0">
    <StackPanel>
     <Border x:Name="BlockedBanner" Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}"
      BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="8,4" Margin="0,0,0,5" Visibility="Collapsed">
      <TextBlock x:Name="BlockedReason" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"/>
     </Border>
     <Border Style="{StaticResource ToteCard}">
      <StackPanel>
       <TextBlock Text="{DynamicResource Tote.Scan}" Style="{StaticResource ToteHeading}"/>
       <Grid Margin="0,2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Tote.Barcode}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <ContentControl Grid.Column="1" x:Name="ScanEntry"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource Tote.Sku}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SkuText" Style="{StaticResource ToteValue}"/>
        <TextBlock Grid.Row="2" Text="{DynamicResource Tote.Quantity}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="QuantityText" Style="{StaticResource ToteValue}"/>
       </Grid>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource ToteCard}">
      <StackPanel>
       <TextBlock Text="{DynamicResource Tote.Task}" Style="{StaticResource ToteHeading}"/>
       <Grid Margin="0,2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Tote.Wave}" TextWrapping="Wrap"/>
        <TextBlock Grid.Column="1" Text="{Binding WaveNo}" Style="{StaticResource ToteValue}"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource Tote.TaskId}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaskId}" Style="{StaticResource ToteValue}"/>
        <TextBlock Grid.Row="2" Text="{DynamicResource Tote.Chute}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DisplaySlot,Mode=OneWay}" Style="{DynamicResource ReadonlyValue}"
         HorizontalContentAlignment="Right" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource Accent}" IsTabStop="True"
         AutomationProperties.Name="{Binding DisplaySlotLabel}"/>
       </Grid>
       <TextBlock Text="{Binding RecentChuteBarcode}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
         <DataTrigger Binding="{Binding ShowRecentChute}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </StackPanel>
     </Border>
     <Border x:Name="UnpackCard" Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
      CornerRadius="{DynamicResource RadiusControl}" Padding="9,5" Margin="0,0,0,5" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="{DynamicResource Tote.Unpack}" Foreground="{DynamicResource Warning}" FontWeight="Medium" TextWrapping="Wrap"/>
       <TextBlock x:Name="ScanQuantityText" TextWrapping="Wrap"/>
       <ItemsControl x:Name="UnpackLines"><ItemsControl.ItemTemplate><DataTemplate>
        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"/>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Button IsEnabled="{Binding CanConfirmPlacementRemoval}" Click="ConfirmUnpack_Click" MinHeight="44" Margin="0,4,0,0"
        Foreground="{DynamicResource OperatorOnWarning}" Background="{DynamicResource OperatorWarning}" BorderBrush="{DynamicResource OperatorWarning}"
        AutomationProperties.AutomationId="Tote.ConfirmUnpack">
        <TextBlock Text="{DynamicResource Tote.UnpackConfirm}" TextAlignment="Center" TextWrapping="Wrap"/>
       </Button>
      </StackPanel>
     </Border>
     <Border x:Name="ReadyBanner" Background="{DynamicResource SuccessBackground}" BorderBrush="{DynamicResource SuccessBorder}"
      BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="8,4" Margin="0,0,0,5" Visibility="Collapsed">
      <TextBlock Text="{DynamicResource Work.ChuteReceived}" Foreground="{DynamicResource Success}" TextWrapping="Wrap"/>
     </Border>
     <ContentControl x:Name="UnknownGuide"/>
     <Expander x:Name="ScanHistory" IsExpanded="False" Margin="0,0,0,4" AutomationProperties.Name="{DynamicResource Tote.ScanHistory}">
      <StackPanel Margin="6">
       <ItemsControl x:Name="HistoryRows">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Grid Margin="0,2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/>
          <TextBlock Grid.Column="1" Text="{Binding Barcode}" TextWrapping="Wrap" Margin="0,0,6,0"/>
          <TextBlock Grid.Column="2" Text="{Binding Slot}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,6,0"/>
          <Border Grid.Column="3" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource Soft}" Padding="4,0">
           <TextBlock Text="{Binding Status}" ui:PaletteBrush.ForegroundKey="{Binding Tone}" TextWrapping="Wrap" MaxWidth="105"/>
          </Border>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <Button Content="{DynamicResource Work.NavRecords}" Click="History_Click" MinHeight="44" HorizontalAlignment="Left" Margin="0,3,0,0"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Margin="8,4">
    <WrapPanel>
     <Button x:Name="ClearButton" Content="{DynamicResource Tote.ClearInput}" MinHeight="44" Margin="0,0,5,0"/>
     <ContentControl x:Name="DispatchAction"/>
     <ContentControl x:Name="ConfirmInput"/>
     <ContentControl x:Name="ParcelRemoval"/>
    </WrapPanel>
    <TextBlock x:Name="LaneStatus" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"
     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
    <ContentControl x:Name="Feedback"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
