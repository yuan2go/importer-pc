<UserControl x:Class="Ipc.Application.ParcelFlow.Desktop.MaintenancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="设备与能力维护" FontSize="21" FontWeight="Bold"/><TextBlock Text="安装、启用、业务绑定与运行健康分别管理。先暂停并认证维护；保存只形成待重启修订，旧件参数不变。" TextWrapping="Wrap"/>
   <WrapPanel><TextBox Text="{Binding MaintenanceSubject}" Width="150"/><PasswordBox x:Name="MaintenanceProof" Width="150"/><Button Content="认证维护权限" Click="Authorize_Click"/><Button Content="读取安装与配置" Click="Load_Click"/><Button Content="校验并保存待重启修订" Click="Save_Click" IsEnabled="{Binding CanConfigure}"/><Button Content="受控重连" Click="Reconnect_Click"/></WrapPanel>
  </StackPanel>
  <TabControl Grid.Row="1" Margin="0,12">
   <TabItem Header="完整候选配置"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="完整修订包含全部设备、投递位和能力库存。校验不保存；保存形成Pending，受控重启且原责任清偿后生效。" TextWrapping="Wrap"/><TextBlock Text="{Binding DraftRevisionState}"/><TextBox Text="{Binding ConfigurationReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="必须填写维护变更原因"/><WrapPanel><Button Content="校验完整候选" Click="ValidateFull_Click"/><Button Content="保存完整待重启修订" Click="SaveFull_Click" IsEnabled="{Binding CanConfigure}"/></WrapPanel></StackPanel><TextBox Text="{Binding ConfigurationDraft,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel></TabItem>
   <TabItem Header="已安装模块参数"><TextBox Text="{Binding InstalledProviderParameters}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></TabItem>
   <TabItem Header="能力实例与绑定"><Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DataGrid x:Name="Instances" ItemsSource="{Binding CapabilityDrafts}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44" SelectionChanged="Instance_Changed"><DataGrid.Columns>
     <DataGridTextColumn Header="能力" Binding="{Binding Role}" IsReadOnly="True" Width="110"/>
     <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled,UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridCheckBoxColumn Header="绑定业务" Binding="{Binding Bound,UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTemplateColumn Header="已安装提供者" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Implementation"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="实例身份" Binding="{Binding InstanceId,UpdateSourceTrigger=PropertyChanged}" Width="150"/>
     <DataGridTemplateColumn Header="协议目标 / 读码身份" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsTargetReadOnly}" ToolTip="{Binding TargetBoundary}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="合同版本" Binding="{Binding Contract,UpdateSourceTrigger=PropertyChanged}" Width="180"/>
    </DataGrid.Columns></DataGrid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterForm" Margin="8"/></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="称重与图像策略"><ScrollViewer><StackPanel Margin="16">
    <TextBlock Text="称重来源 · 配置补全与实测不同；协议强制实测时配置补全拒绝"/><WrapPanel><ComboBox ItemsSource="{Binding WeightSources}" SelectedItem="{Binding DraftWeightSource}" Width="170"/><ComboBox ItemsSource="{Binding WeightUnits}" SelectedItem="{Binding DraftUnit}" Width="90"/><TextBlock Text="精度"/><TextBox Text="{Binding DraftPrecision}" Width="80"/><TextBlock Text="配置值"/><TextBox Text="{Binding DraftConfiguredWeight}" Width="100"/></WrapPanel>
    <WrapPanel><TextBlock Text="本件等待期限(ms)"/><TextBox Text="{Binding DraftWaitMs}" Width="120"/><TextBlock Text="测量新鲜度(ms)"/><TextBox Text="{Binding DraftFreshMs}" Width="120"/></WrapPanel>
    <TextBlock Text="重量有效期：UntilDispatch持续到提交，AtAssociation仅关联时新鲜；真实现场须有资格证据" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding WeightValidities}" SelectedItem="{Binding DraftWeightValidity}" Width="240" HorizontalAlignment="Left"/>
    <TextBlock Text="图片上传 · BeforeMain前置成功后进入主链 / Attached独立恢复" Margin="0,16,0,8"/><ComboBox ItemsSource="{Binding UploadStrategies}" SelectedItem="{Binding DraftUploadStrategy}" Width="240" HorizontalAlignment="Left"/>
    <WrapPanel><TextBlock Text="单件最大字节"/><TextBox Text="{Binding DraftImageBytes}" Width="120"/><TextBlock Text="缓存总字节"/><TextBox Text="{Binding DraftTotalBytes}" Width="120"/><TextBlock Text="待处理件数"/><TextBox Text="{Binding DraftPending}" Width="100"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="安装管理"><StackPanel Margin="16"><TextBlock Text="{Binding InstalledPackages}" TextWrapping="Wrap"/><TextBlock Text="离线签名包路径（Windows由受保护提权帮助程序安装后刷新）"/><TextBox Text="{Binding PackagePath,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="原包 SHA256"/><TextBox Text="{Binding PackageSha256,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/><Button Content="验证签名并安装" Click="Install_Click" HorizontalAlignment="Left"/><TextBlock Text="受控恢复：填写extension-recover及原操作ID；卸载：extension-uninstall及精确PackageReference JSON。离线消费者、备份、绑定及资源仍引用时拒绝。" TextWrapping="Wrap"/><TextBox Text="{Binding ExtensionAction,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding ExtensionIdentity,UpdateSourceTrigger=PropertyChanged}"/><Button Content="执行原操作恢复 / 安全卸载" Click="Manage_Click"/></StackPanel></TabItem>
   <TabItem Header="异常与恢复"><StackPanel Margin="16"><TextBlock Text="先在记录中选择原作业；未知只查询，不重发。处置仅限无未知外部责任且PLC尚未尝试；原WCS接受及原意图保留。" TextWrapping="Wrap"/><TextBlock Text="{Binding HistoryCommandTarget}" TextWrapping="Wrap"/><TextBox Text="{Binding InspectionReason,UpdateSourceTrigger=PropertyChanged}" ToolTip="已检查并移除实体的处置说明"/><WrapPanel><Button Content="继续未尝试附加上传" Click="Upload_Click" IsEnabled="{Binding CanContinueUpload}"/><Button Content="检查后取消未发送意图" Click="Abandon_Click" IsEnabled="{Binding CanAbandon}"/><Button Content="确认已检查过载现场" Click="Overload_Click"/><Button Content="受控归档已清偿原件" Click="Archive_Click"/><TextBox Text="{Binding IdentityConflictId,UpdateSourceTrigger=PropertyChanged}" Width="230" ToolTip="阻断投影中的原身份冲突ID"/><Button Content="确认已检查身份冲突" Click="Identity_Click"/></WrapPanel></StackPanel></TabItem>
  </TabControl>
  <DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Content="创建一致备份" Click="Backup_Click"/><TextBox Text="{Binding BackupPath,UpdateSourceTrigger=PropertyChanged}" ToolTip="新备份完整路径；已有文件拒绝覆盖"/></DockPanel>
 </Grid>
</UserControl>
