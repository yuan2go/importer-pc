[
  {
    "Key": "device.ip",
    "Group": "设备 / 连接",
    "Label": "相机 IPv4 地址",
    "Type": "string",
    "Required": true,
    "MaximumLength": 15,
    "Description": "枚举并绑定明确IP，不使用枚举下标或修改相机IP。"
  },
  {
    "Key": "device.serial",
    "Group": "设备 / 身份",
    "Label": "预期序列号（正式必填）",
    "Type": "string",
    "MaximumLength": 32,
    "Description": "正式启用固定本位物理相机；模拟或独立诊断可省略。同一实例重连仍固定原序列号。"
  },
  {
    "Key": "reader.engine",
    "Group": "识别 / 方式",
    "Label": "识码方式",
    "Type": "choice",
    "Default": "zxing-cpp",
    "Choices": [
      "zxing-cpp",
      "mvid-native"
    ],
    "Description": "选择本相机使用的识码方式。海康原生识码使用旧供包台同系列组件，需完整安装包包含该组件；两种方式都由供包台抑制同次放置的重复请求。"
  },
  {
    "Key": "acquisition.trigger",
    "Group": "采集 / 触发",
    "Label": "设备触发要求",
    "Type": "choice",
    "Default": "off",
    "Choices": [
      "existing",
      "on",
      "off"
    ],
    "Description": "本现场连续采集要求已关闭触发。只核对，不修改相机接线或触发源。"
  },
  {
    "Key": "entity.mode",
    "Group": "输入 / 实体关联",
    "Label": "读码结果处理",
    "Type": "choice",
    "Default": "read-result",
    "Choices": [
      "read-result",
      "observe-only"
    ],
    "ReadOnly": false,
    "Description": "识别结果交给供包台筛选；同一次放置只请求一次格口。仅观察不创建作业。"
  },
  {
    "Key": "image.nodes",
    "Group": "采集 / 缓冲",
    "Label": "SDK 图像队列节点",
    "Type": "integer",
    "Default": "3",
    "Minimum": 1,
    "Maximum": 4,
    "Description": "有界SDK图像队列。应用只借用一帧，复制到单帧识别缓冲后立即归还；已识别结果同步交持久输入账，不按条码去重。"
  },
  {
    "Key": "image.maximum-payload-bytes",
    "Group": "采集 / 缓冲",
    "Label": "单帧负载字节上限",
    "Type": "integer",
    "Default": "8388608",
    "Minimum": 1048576,
    "Maximum": 33554432,
    "Description": "按相机报告的单帧大小核对，默认8388608字节（8MiB），范围1～32MiB。每帧检查长度、灰度单图及丢包；超限后故障阻断。"
  },
  {
    "Key": "code.encoding",
    "Group": "识别 / 编码",
    "Label": "条码字符编码",
    "Type": "choice",
    "Default": "utf-8",
    "Choices": [
      "utf-8",
      "ascii",
      "gb18030"
    ],
    "Description": "显式选择原始条码字节编码，严格解码；编码不合法仅拒收本帧，不猜测或替换字符。GB18030兼容GBK中文标签。"
  },
  {
    "Key": "code.formats",
    "Group": "识别 / 码制",
